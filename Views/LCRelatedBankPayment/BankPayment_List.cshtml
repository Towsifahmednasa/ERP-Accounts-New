                                                            Business Unit
                                                        </th>
                                                        <th style="padding:3px !important; text-align:center!important;">Supplier Type</th>
                                                        <th style="padding:3px !important; text-align:center!important;">Supplier</th>
                                                        <th style="padding:3px !important; text-align:center!important;">LC No</th>
                                                        <th style="padding:3px !important; text-align:center!important;">LC Open Date</th>
                                                        <th style="padding:3px !important; text-align:center!important;">Currency</th>
                                                        <th style="padding:3px !important; text-align:center!important;">Conversion Rate</th>
                                                        <th style="padding:3px !important; text-align:center!important;">Payment Type</th>
                                                        <th style="padding:3px !important; text-align:center!important;">ChargeBasisof</th>
                                                        <th style="padding:3px !important; text-align:center!important;">TotalAmountBDT</th>
                                                        <th style="padding:3px !important; text-align:center!important;">TotalAmountFC</th>
                                                        <th style="padding:3px !important; text-align:center!important;">Payment From</th>
                                                        <th style="padding:3px !important; text-align:center!important;">Loan Account</th>
                                                        <th style="padding:3px !important; text-align:center!important;">Bank Account</th>
                                                        @*<th style="padding:3px !important; text-align:center!important;">Entry By</th>
                                                        <th style="padding:3px !important; text-align:center!important;">Entry Date</th>
                                                        <th style="padding:3px !important; text-align:center!important;">Update By</th>
