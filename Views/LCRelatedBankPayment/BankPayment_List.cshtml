</div>



<style>
    .container-fluid {
        margin: 5px; /* Adjust as needed */
    }

    .dataTables_filter {
        float: right !important;
        margin-right: -20px !important;
        margin-bottom: 0px !important;
    }

    .dt-buttons {
        text-align: center !important;
    }
</style>

@section Scripts
{
    <script type="text/javascript">

        $(function () {
            LoadCompany('ddlCompany');
            ShowReport();
        });
        function un(o) {
            return o != null ? o : '';
        }
        function ShowReport() {


            var param = '';
            var comID = $('#ddlCompany').val();

            if (jQuery.type(comID) === "undefined") { }
            else {
                if (comID !== "0" && comID !== null) {
                    param = param + " and prp.BusinessUnitId='" + comID + "'";
                }
            }

            var urlpath = '@Url.Action("Get_BankChargeList", "LCRelatedBankPayment")';
            $.ajax({
                url: urlpath,
                dataType: 'html',
                type: "Get",
                data: { param: param },
                async: false,
                beforeSend: function () {

                    $("#overlay").fadeIn(300);
                },
                success: function (data) {
                    $('#tabH').show();
                    var result = JSON.parse(data);
                    var row = "";
                    $('#dtTableBody').html("");
                    for (var i = 0; i <result.length; i++) {
                        row += "<tr>";
                        row += "<td>" + (i + 1) + "</td>"; // Serial number
                        row += "<td>" + un(result[i].CompanyName) + "</td>";
                        row += "<td>" + un(result[i].SupplierTypeName) + "</td>";
                        row += "<td>" + un(result[i].SupplierName) + "</td>";
                        row += "<td>" + un(result[i].LCNo) + "</td>";
                        row += "<td>" + un(result[i].LCDate) + "</td>";
                        row += "<td>" + un(result[i].CurrencyName) + "</td>";
                        row += "<td>" + un(result[i].Conversionrate) + "</td>";
                        row += "<td>" + un(result[i].TypeName) + "</td>";
                        
                        row += "<td>" + un(result[i].ChargeBasisof) + "</td>";
                        row += "<td>" + un(result[i].TotalAmountBDT) + "</td>";
                        row += "<td>" + un(result[i].TotalAmountFC) + "</td>";
                        row += "<td>" + un(result[i].PaymentFrom) + "</td>";
                        row += "<td>" + un(result[i].LoanAccID) + "</td>";
                        row += "<td>" + un(result[i].COAID) + "</td>";
                        //row += "<td>" + un(result[i].EntryBy) + "</td>";
                        //row += "<td>" + un(result[i].EntryDate) + "</td>";
                        //row += "<td>" + un(result[i].Updateby) + "</td>";
                        //row += "<td>" + un(result[i].Updatedate) + "</td>";
                        row += "<td><button style='border-style:none;'   onclick='editClick(" + result[i].BankChargeId + ")'><i class='fa fa-pencil' style='color:#00BFFF'></i></button> </td>";
                        row += "</tr>";
                    }
                    $('#dtTableBody').html(row);
                },
                complete: function () {
                    if ($.fn.dataTable.isDataTable('.jdtDataTable')) {
                        table = $('#dtTb').DataTable({
                            paging: true,
                            retrieve: true,
                            "bInfo": true,
                            "bFilter": true,
                            processing: true,

                            dom: '<"container-fluid"<"row"<"col"l><"col"B><"col"f>>>rtip',


                            lengthChange: true,
                            language: {
                                searchPlaceholder: "Search records",
                                search: ' ',
                                "emptyTable": "No Data Found!"
                            },



                            buttons: [
                                {
                                    extend: 'copyHtml5',
                                    text: '<i class="fa fa-files-o"></i>',
                                    titleAttr: 'Copy', className: 'btn  btn-sm'
                                },
                                {
                                    extend: 'excelHtml5',
                                    text: '<i class="fa fa-file-excel-o"></i>',
                                    titleAttr: 'Excel', className: 'btn  btn-sm'
                                },
                                {
                                    extend: 'csvHtml5',
                                    text: '<i class="fa fa-file-text-o"></i>',
                                    titleAttr: 'CSV', className: 'btn  btn-sm'
                                },
                                {
                                    extend: 'pdfHtml5',
                                    text: '<i class="fa fa-file-pdf-o"></i>',
                                    titleAttr: 'PDF', className: 'btn  btn-sm'
                                }
                            ]
                        });
                    }
                    else {
                        table = $('.jdtDataTable').DataTable({

                            "bInfo": true,
                            "bFilter": true,
                            processing: true,

                            dom: '<"container-fluid"<"row"<"col"l><"col"B><"col"f>>>rtip',


                            lengthChange: true,
                            language: {
                                searchPlaceholder: "Search records",
                                search: ' ',
                                "emptyTable": "No Data Found!"
                            },

                            buttons: [
                                {
                                    extend: 'copyHtml5',
                                    text: '<i class="fa fa-files-o"></i>',
                                    titleAttr: 'Copy', className: 'btn  btn-sm'
                                },
                                {
                                    extend: 'excelHtml5',
                                    text: '<i class="fa fa-file-excel-o"></i>',
                                    titleAttr: 'Excel', className: 'btn  btn-sm'
                                },
                                {
                                    extend: 'csvHtml5',
                                    text: '<i class="fa fa-file-text-o"></i>',
                                    titleAttr: 'CSV', className: 'btn  btn-sm'
                                },
                                {
                                    extend: 'pdfHtml5',
                                    text: '<i class="fa fa-file-pdf-o"></i>',
                                    titleAttr: 'PDF', className: 'btn  btn-sm'
                                }
                            ]
                        });
                    }

                    $('#dtTb_length select').removeClass('form-select form-select-sm');

                    setTimeout(function () {
                        $("#overlay").fadeOut(300);
                    }, 500);
                }
            });
        }

         function editClick(id) {
             location.href = '@Url.Action("L_Entry", "Loan")?id=' + id + '';
        }
    </script>

}


