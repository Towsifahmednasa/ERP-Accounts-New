              <td style="color: #5b42f3 !important; text-align: center !important; vertical-align: middle; font-size: 18px !important; font-weight: bold !important;"> Total: </td>
              <td style="color: #5b42f3 !important; padding: 3px !important; text-align: center !important; font-size: 18px !important; font-weight: bold !important;">${parseFloat(totalCharge).toFixed(4)}</td>
          </tr>
        `;

                        $('#table_Charge_HeadBody').append(row);


                    }
                });


                // Load Landed Cost

                $('#table_Landed_CostBody').empty();

                $.ajax({
                    url: "/LCReport/LoadLandedCostInfo",
                    contentType: "application/json; charset=utf-8",
                    dataType: 'json',
                    type: "GET",  // Use uppercase 'GET'
                    data: { lcId: lCNoId },
                    async: false,  // Consider using asynchronous operations to improve performance
                    success: function (result) {

                        var data = JSON.parse(result);

                        var row = "";

                        row += `<tr style="background: #BECFD9 !important;">
         <th style="padding:4px !important; text-align:center !important; width: 2%;"># SL</th>
         <th style="padding:4px !important; text-align:center !important; width: 5%;">PO No</th>
         <th style="padding:4px !important; text-align:center !important; width: 5%;">PI No</th>
         <th style="padding:4px !important; text-align:center !important; width: 7%;"> Item Code </th>
         <th style="padding:4px !important; text-align:center !important; width: 7%;"> Item Name </th>
         <th style="padding:4px !important; text-align:center !important; width: 5%;">PI Quantity </th>
         <th style="padding:4px !important; text-align:center !important; width: 5%;">LC Quantity </th>
         <th style="padding:4px !important; text-align:center !important; width: 5%;"> Total Price (TP) </th>
         <th style="padding:4px !important; text-align:center !important; width: 6%;"> Charge Amount (CA)  </th>
         <th style="padding:4px !important; text-align:center !important; width: 6%;"> Total Cost (TP + CA) </th>
         <th style="padding:4px !important; text-align:center !important; width: 7%;"> Cost Per Unit (BDT) </th>
     </tr>`;

                        var count = 1;

                        var lcTotalPrice = 0;
                        var chargeAmount = 0;
                        var totalLandedCost = 0;

                        $.each(data, function (index, firstData) {

                            row += `<tr>
              <td style="padding:3px !important; text-align:center!important;">${count}</td>
              <td style="padding:3px !important; text-align:center!important;">${firstData.PurchaseOrderLocalCode}</td>
              <td style="padding:3px !important; text-align:center!important;">${firstData.PINo}</td>
              <td style="padding:3px !important; text-align:center!important;">${firstData.ItemDescriptionCode}</td>
              <td style="padding:3px !important; text-align:center!important;">${firstData.ItemDescription}</td>
              <td style="padding:3px !important; text-align:center!important;">${firstData.PIQuantity}</td>
              <td style="padding:3px !important; text-align:center!important;">${firstData.LCQuantity}</td>
              <td style="padding:3px !important; text-align:center!important;">${parseFloat(firstData.LcTotalPrice).toFixed(4)}</td>
              <td style="padding:3px !important; text-align:center!important;">${parseFloat(firstData.ChargeAmount).toFixed(4)}</td>
              <td style="padding:3px !important; text-align:center!important;">${parseFloat(firstData.TotalLandedCost).toFixed(4)}</td>
              <td style="padding:3px !important; text-align:center!important;">${parseFloat(firstData.LandedCostPerUnit).toFixed(4)}</td>
          </tr>`;


                            lcTotalPrice += parseFloat(firstData.LcTotalPrice);
                            chargeAmount += parseFloat(firstData.ChargeAmount);
                            totalLandedCost += parseFloat(firstData.TotalLandedCost);

                            count++;

                        });

                        row += `
          <tr style="padding: 2px !important; background-color: #BECFD9 !important;">
              <td colspan="6" style="text-align: center !important; vertical-align: middle; font-size: 18px !important; font-weight: bold !important;"> &nbsp; </td>
              <td style="color: #5b42f3 !important; text-align: center !important; vertical-align: middle; font-size: 18px !important; font-weight: bold !important;"> Total: </td>
              <td style="color: #5b42f3 !important; padding: 3px !important; text-align: center !important; font-size: 18px !important; font-weight: bold !important;">${parseFloat(lcTotalPrice).toFixed(4)}</td>
              <td style="color: #5b42f3 !important; padding: 3px !important; text-align: center !important; font-size: 18px !important; font-weight: bold !important;">${parseFloat(chargeAmount).toFixed(4)}</td>
              <td style="color: #5b42f3 !important; padding: 3px !important; text-align: center !important; font-size: 18px !important; font-weight: bold !important;">${parseFloat(totalLandedCost).toFixed(4)}</td>
              <td style="text-align: center !important; vertical-align: middle; font-size: 18px !important; font-weight: bold !important;"> &nbsp; </td>
         </tr>
        `;

                        $('#table_Landed_CostBody').append(row);


                    }
                });

                $('#piLargeModal').modal('show');
            });


    </script>
}
