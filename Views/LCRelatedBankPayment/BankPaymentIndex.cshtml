        function SaveValidation() {
            var isValid = true;

            $('#divCompany').hide();
            $('#divSupplierType').hide();
            $('#divSupplier').hide();
            $('#divLCNo').hide();

            $('#divPaymentType').hide(); // Add a div for PaymentType validation
            $('#divPaymentFrom').hide(); // Add a div for PaymentFrom validation

            // Validate Company field
            if ($('#ddlCompany').val() == 0 || $('#ddlCompany').val() == '') {
                ValidationColorChangeNew("ddlCompany", "divCompany", "Company Required", true);
                $('#divCompany').show();
                isValid = false;
            }

            // Validate Supplier Type field
            if ($('#ddlSupplierType').val() == 0 || $('#ddlSupplierType').val() == '') {
                ValidationColorChangeNew("ddlSupplierType", "divSupplierType", "Supplier Type Required", true);
                $('#divSupplierType').show();
                isValid = false;
            }

            // Validate Supplier field
            if ($('#ddlSupplier').val() == 0 || $('#ddlSupplier').val() == '') {
                ValidationColorChangeNew("ddlSupplier", "divSupplier", "Supplier Required", true);
                $('#divSupplier').show();
                isValid = false;
            }

            // Validate LC No field
            if ($('#ddlLCNo').val() == 0 || $('#ddlLCNo').val() == '') {
                ValidationColorChangeNew("ddlLCNo", "divLCNo", "LC No Required", true);
                $('#divLCNo').show();
                isValid = false;
            }

            var selectedPaymentType = $("input[name='PaymentType']:checked").val();
            if (!selectedPaymentType) {
                ValidationColorChangeNew("PaymentType", "divPaymentType", "Payment Type is required", true);
                $('#divPaymentType').show();
                isValid = false;
            }

            // Validate Payment From radio buttons
            var selectedPaymentFrom = $("input[name='PaymentFrom']:checked").val();
            if (!selectedPaymentFrom) {
                ValidationColorChangeNew("PaymentFrom", "divPaymentFrom", "Payment From is required", true);
                $('#divPaymentFrom').show();
                isValid = false;
            }

            var selectedPaymentTypeText = $("input[name='PaymentType']:checked").next('label').text();
            var selectedPaymentFromText = $("input[name='PaymentFrom']:checked").next('label').text();


            if (selectedPaymentFromText === 'Bank Account') {
                var bankAccountValue = $('#ddlBankAccount').val();
                if (bankAccountValue == 0 || bankAccountValue === '') {
                    alert('Please select a Bank Account.');
                    return; // Stop execution if no bank account is selected
                }
            }

            if (selectedPaymentFromText === 'Loan Account') {
                var loanAccountValue = $('#ddlloanAccount').val();
                if (loanAccountValue == 0 || loanAccountValue === '') {
                    alert('Please select a Loan Account.');
                    return; // Stop execution if no loan account is selected
                }
            }

            if (selectedPaymentTypeText === 'Importer Payment') {
                var rowSelected = false;

                // Iterate over all rows in the table and check if any checkbox is selected
                $('#table_CI_HeadBody tr').each(function () {
                    var checkbox = $(this).find('.rowCheckbox'); // Find the checkbox in the current row
                    if (checkbox.prop('checked')) {
                        rowSelected = true; // If any checkbox is selected, set rowSelected to true
                        return false; // Exit loop early as we've found a selected checkbox
                    }
                });

                // If no row is selected, show an error message
                if (!rowSelected) {
                    alert('Please select at least one row.');
                    return; // Stop further execution
                }
            }

            if (selectedPaymentTypeText === 'Bank Charge') {

                var txtChargeBasisof = $('#txtChargeBasisof').val();
                if (txtChargeBasisof === '') {
                    alert('Charge Basis of is required.');
                    return; // Stop execution if no loan account is selected
                }
            }

            return isValid;
        }

        function Save() {


            if (SaveValidation()) {
                swal({
                    title: "Are you sure?",
                    text: "",
                    type: "warning",
                    showCancelButton: true,
                    confirmButtonColor: '#DD6B55',
                    confirmButtonText: 'Yes, I am sure!',
                    cancelButtonText: "No, cancel it!",
                    closeOnConfirm: false,
                    closeOnCancel: false
                },
                    function (isConfirm) {
                        if (isConfirm) {
                            SaveData();
                        } else {
                            swal("Cancelled", ")", "error");
                            e.preventDefault();
                        }
                    });
            };
        }


