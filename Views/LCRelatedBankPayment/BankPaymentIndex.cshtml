@* Ported from Accounts\CSTL_Pro_to_Pay\Views\LCRelatedBankPayment\BankPaymentIndex.cshtml - page markup and inline scripts unchanged; presentation comes from the Fiori shell/stylesheet. *@

@{
    ViewBag.Title = "Bank Charge Entry";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<style>
    .font-weight-bold {
        font-weight: bold;
    }

    .error-message {
        font-size: 0.875rem; /* Small font for error message */

        color: red; /* Red color for error message */
    }
</style>
<div id="popDiv"></div>
<div class="page-wrapper">
    <div class="page-content">
        <div class="row">
            <div class="col">
                <div class="card border-top border-0 border-4 border-dark mt-3" style="margin-top: 3px !important">
                    <div class="card-body" style="border-style: none !important;">
                        <div class="border p-2 rounded">

                            <div class="page-breadcrumb d-none d-sm-flex align-items-center headerBorderBottom">
                                <div class="breadcrumb-title pe-3">
                                    <div class="card-title d-flex align-items-center">
                                        <div>
                                            <i class="bx bxs-right-arrow-square me-1 font-22 text-inverse"></i>
                                        </div>

                                        <h5 class="mb-0 text-dark cstlfs">Bank Charge Entry</h5>
                                    </div>
                                </div>

                                <div class="ms-auto">
                                    <div class="btn-group">

                                        <a class="small blue button" href="@Url.Action("BankPayment_List", "LCRelatedBankPayment")">
                                            <span class="fa fa-share"></span>  Back to List
                                        </a>
                                    </div>
                                </div>
                            </div>
                            <div class="row" style="margin-top:10px">
                                <!-- Column 1 -->
                                <div class="col-md-4">

                                </div>
                                <div class="col-md-4">
                                    <!-- Business Unit -->
                                    <div class="form-group">
                                        <div class="row">
                                            <div class="col-md-4">
                                                <label for="ddlCompany" class="font-weight-bold col-form-label">Business Unit: <span class="required" style="color: red;"> *</span></label>
                                            </div>
                                            <div class="col-md-8">
                                                <select class="form-select form-select-sm select2" id="ddlCompany" style="width: 100%;"></select>
                                                <div id="divCompany" class="error-message" style="display: none;"></div>
                                            </div>
                                        </div>
                                    </div>



                                    <!-- Supplier Type -->
                                    <div class="form-group">
                                        <div class="row">
                                            <div class="col-md-4">
                                                <label for="ddlSupplierType" class="font-weight-bold col-form-label">Supplier Type: <span style="color: red;">*</span></label>
                                            </div>
                                            <div class="col-md-8">
                                                <select class="form-select form-select-sm select2" onchange="LoadTypewiseSupplier(0)" id="ddlSupplierType" style="width: 100%;"></select>
                                                <div id="divSupplierType" class="error-message" style="display: none;"></div>
                                            </div>
                                        </div>
                                    </div>

                                    <!-- Supplier -->
                                    <div class="form-group">
                                        <div class="row">
                                            <div class="col-md-4">
                                                <label for="ddlSupplier" class="font-weight-bold col-form-label">Supplier: <span style="color: red;">*</span></label>
                                            </div>
                                            <div class="col-md-8">
                                                <select class="form-select form-select-sm select2" id="ddlSupplier" style="width: 100%;"></select>
                                                <div id="divSupplier" class="error-message" style="display: none;"></div>
                                            </div>
                                        </div>
                                    </div>

                                    <!-- LC No -->
                                    <div class="form-group">
                                        <div class="row">
                                            <div class="col-md-4">
                                                <label for="ddlLCNo" class="font-weight-bold col-form-label">LC No: <span style="color: red;">*</span></label>
                                            </div>
                                            <div class="col-md-8">
                                                <select class="form-select form-select-sm select2" id="ddlLCNo" style="width: 100%;"></select>
                                                <div id="divLCNo" class="error-message" style="display: none;"></div>
                                                <a href="#" class="" style="display: none; margin-left: 10px;" id="lcLink" target="_blank">#</a>
                                            </div>
                                        </div>
                                    </div>


                                    <!-- LC Open Date -->
                                    <div class="form-group">
                                        <div class="row">
                                            <div class="col-md-4">
                                                <label for="LCOpenDate" class="font-weight-bold col-form-label">LC Open Date:</label>
                                            </div>
                                            <div class="col-md-8">
                                                <input type="text" class="form-control form-control-sm" readonly id="LCOpenDate" style="width: 100%;" />
                                            </div>
                                        </div>
                                    </div>


                                    <!-- Currency -->
                                    <div class="form-group">
                                        <div class="row">
                                            <div class="col-md-4">
                                                <label for="ddlCurrency" class="font-weight-bold col-form-label">Currency:  <span style="color: red;">*</span></label>
                                            </div>
                                            <div class="col-md-8">
                                                <select disabled class="form-select form-select-sm select2" id="ddlCurrency" style="width: 100%;"></select>
                                                <div id="divCurrency" class="error-message" style="display: none;"></div>
                                            </div>
                                        </div>
                                    </div>


                                    <div class="form-group">
                                        <div class="row">
                                            <div class="col-md-4">
                                                <label for="LCOpenDate" class="font-weight-bold col-form-label">Conversion Rate:</label>
                                            </div>
                                            <div class="col-md-8">
                                                <input type="text" class="form-control form-control-sm" readonly id="txtConversionRate" style="width: 100%;" />
                                            </div>
                                        </div>
                                    </div>


                                    <div class="form-group">
                                        <div class="row">
                                            <div class="col-md-4">
                                                <label for="LCOpenDate" class="font-weight-bold col-form-label">New Conversion Rate:</label>
                                            </div>
                                            <div class="col-md-8">
                                                <input type="number" class="form-control form-control-sm" id="txtNewConversionRate" style="width: 100%;" />
                                            </div>
                                        </div>
                                    </div>


                                    <div class="form-group">
                                        <div class="row">
                                            <div class="col-md-4">
                                                <label for="rbPaymentType" class="font-weight-bold col-form-label">Payment Type:</label>
                                            </div>
                                            <div class="col-md-8">
                                                <div id="rbPaymentType"></div>

                                                <!-- Error message for validation (optional) -->
                                                <div id="divPaymentType" class="error-message" style="display: none;"></div>

                                            </div>
                                        </div>
                                    </div>

                                    <div class="form-group" id="divChargeBasis" style="display: none;">
                                        <div class="row">
                                            <div class="col-md-4">
                                                <label for="LCOpenDate" class="font-weight-bold col-form-label">Charge Basis of:</label>
                                            </div>
                                            <div class="col-md-8">
                                                <input type="text" class="form-control form-control-sm" id="txtChargeBasisof" style="width: 100%;" />
                                            </div>
                                        </div>
                                    </div>




                                    <br />

                                </div>

                            </div>

                            <br />

                            <div class="row mt-2" id="divCI" style="display: none;">


                                <div class="table-responsive" style="width: 70% !important; margin: 0 auto !important">

                                    <table class="table table-bordered table-striped table-hover" style=" width: 97% !important; margin: auto !important;">

                                        <tr>
                                            <th colspan="6"> <span style="color: #5b42f3 !important; font-size: 18px !important;"> CI Info  </span> </th>
                                        </tr>


                                        <tr>
                                            <th>SL#</th>
                                            <th>
                                                <input type="checkbox" id="selectAllCheckbox" class="form-check-input" />

                                            </th>
                                            <th>CI No.</th>

                                            <th>CI Date</th>
                                            <th>CI Amount (BDT)</th>
                                            <th>New CI Amount (BDT)</th>
                                        </tr>

                                        <tbody id="table_CI_HeadBody">
                                        </tbody>

                                        <tfoot>
                                            <tr>
                                                <td colspan="4" style="text-align: right; font-weight: bold;">Total Amount :</td>
                                                <td><label style="text-align: center; font-weight: bold;" id="lblTotalAmountFC">0.00</label></td>
                                                <td><label style="text-align: center; font-weight: bold;" id="lblTotalAmountBDT">0.00</label></td>
                                            </tr>
                                        </tfoot>


                                    </table>

                                </div>

                            </div>


                            <div class="row" style="margin-top:10px">
                                <!-- Column 1 -->
                                <div class="col-md-4">

                                </div>
                                <div class="col-md-4">
                                    <!-- Business Unit -->
                                    <div class="form-group">
                                        <div class="row">
                                            <div class="col-md-4">
                                                <label for="paymentFrom" class="font-weight-bold col-form-label">Payment From:</label>
                                            </div>
                                            <div class="col-md-8">
                                                <!-- Radio buttons for Payment From -->
                                                <div id="rbPaymentFrom" class="form-check">
                                                    <!-- Radio buttons will be dynamically added here -->
                                                    <div class="form-check form-check-inline">
                                                        <input class="form-check-input" type="radio" name="PaymentFrom" id="PaymentFrom1" value="Bank Account">
                                                        <label class="form-check-label" for="PaymentFrom1">Bank Account</label>
                                                    </div>
                                                    <div class="form-check form-check-inline">
                                                        <input class="form-check-input" type="radio" name="PaymentFrom" id="PaymentFrom2" value="Loan Account">
                                                        <label class="form-check-label" for="PaymentFrom2">Loan Account</label>
                                                    </div>
                                                </div>

                                                <div id="divPaymentFrom" class="error-message" style="display: none;"></div>
                                            </div>
                                        </div>
                                    </div>


                                    <div class="form-group" id="ddlBank">
                                        <div class="row">
                                            <div class="col-md-4">
                                                <label for="bankAccount" class="font-weight-bold col-form-label">Bank Account:</label>
                                            </div>
                                            <div class="col-md-8">
                                                <select class="form-select form-select-sm select2" style="width:100%!important" id="ddlBankAccount">
                                                </select>
                                            </div>
                                        </div>
                                    </div>

                                    <!-- Loan Account Dropdown -->
                                    <div class="form-group" id="ddlLoan">
                                        <div class="row">
                                            <div class="col-md-4">
                                                <label for="loanAccount" class="font-weight-bold col-form-label">Loan Account:</label>
                                            </div>
                                            <div class="col-md-8">


                                                <select class="form-select form-select-sm select2" style="width:100%!important" id="ddlloanAccount"></select>
                                            </div>
                                        </div>
                                    </div>

                                </div>
                            </div>


                            <div class="row">
                                <div style="padding-top: 1.5%">
                                    <div class="wrapper">
                                        <div class="row">
                                            <div class="col-md-5" style="margin: 0 44.5% !important;">
                                                <div class="form-group">
                                                    <button class="small blue button" id="btnSave" onclick="Save()">   Submit</button>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>


