<input id="LoanInfoID" value="@ViewBag.Id" style="display:none" />
@section Scripts
{

    <script type="text/javascript">

            $(document).ready(function () {
                var today = new Date().toISOString().split('T')[0]; // Get current date in YYYY-MM-DD format
                $('#LoanCreateDate').val(today); // Set value of LoanCreateDate input field


                $('#ddlBank').hide();
                $('#ddlLoan').hide();

                // When the radio button for Bank Account is selected
                $('#PaymentFrom1').change(function () {
                    if ($(this).is(':checked')) {
                        $('#ddlBank').show();  // Show the bank dropdown
                        $('#ddlLoan').hide();  // Hide the loan dropdown
                    }
                });

                // When the radio button for Loan Account is selected
                $('#PaymentFrom2').change(function () {
