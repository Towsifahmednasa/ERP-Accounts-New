            $('#txtNewConversionRate').on('input', function () {
                var conversionRate = parseFloat($(this).val());

                // Call the function to update CiAmountBDT
                updateCiAmountBDT(conversionRate);
            });

            // Event listener for changes to the new conversion rate
            function updateCiAmountBDT(conversionRate) {
                var oldtxtConversionRate = $('#txtConversionRate').val();
                if (!isNaN(conversionRate) && conversionRate > 0) {
                    // Loop through each row in the table and update the CiAmountBDT
                    $('#table_CI_HeadBody tr').each(function () {
                        var ciAmount = parseFloat($(this).find('#CiAmount').val());

                        if (!isNaN(ciAmount)) {
                            var ciAmountBDT = (ciAmount / oldtxtConversionRate) * conversionRate;
                            $(this).find('#CiAmountBDT').val(ciAmountBDT.toFixed(4));  // Set the new BDT amount with 4 decimals
                        }
                    });
                }
                calculateTotalAmount();
            }


            function calculateTotalAmount() {
                var totalAmountBDT = 0;
                var totalAmountFC = 0;

                // Loop through each row and accumulate the total for BDT and FC
                $('#table_CI_HeadBody tr').each(function () {
                    var ciAmountBDT = parseFloat($(this).find('#CiAmountBDT').val());
                    var ciAmountFC = parseFloat($(this).find('#CiAmount').val());

                    // Accumulate totals, ensure they are valid numbers
                    if (!isNaN(ciAmountBDT)) {
                        totalAmountBDT += ciAmountBDT;
                    }
                    if (!isNaN(ciAmountFC)) {
                        totalAmountFC += ciAmountFC;
                    }
                });

                // Update the footer with the calculated totals
                $('#lblTotalAmountBDT').text(totalAmountBDT.toFixed(4));  // Format to 2 decimal places
                $('#lblTotalAmountFC').text(totalAmountFC.toFixed(4));  // Format to 2 decimal places
            }


