@* Ported from Accounts\CSTL_Pro_to_Pay\Views\CashAccount\Index.cshtml - page markup and inline scripts unchanged; presentation comes from the Fiori shell/stylesheet. *@

@{
    ViewBag.Title = "Cash Account List";
    Layout = "~/Views/Shared/_Layout.cshtml";
}



<div class="page-wrapper">
    <div class="page-content">
        <div class="row">
            <div class="col">
                <div class="card border-top border-0 border-4 border-success mt-3" style="margin-top: 3px !important">
                    <div class="card-body" style="border-style: none !important;">
                        <div class="border p-2 rounded">

                            <div class="page-breadcrumb d-none d-sm-flex align-items-center">
                                <div class="breadcrumb-title pe-3">
                                    <div class="card-title d-flex align-items-center">
                                        <div>
                                            <i class="bx bxs-right-arrow-square me-1 font-22 text-inverse"></i>
                                        </div>
                                        <h5 class="mb-0 text-dark cstlfs">
                                            <span class=""> Cash Account List</span>
                                        </h5>
                                    </div>
                                </div>

                                <div class="ms-auto">
                                    <div class="btn-group">
                                        <a class="small blue button" href="@Url.Action("Create", "CashAccount")">
                                            <span class="fa fa-plus"></span> Add New

                                        </a>

                                    </div>
                                </div>
                            </div>


                            <!-- /.card-header -->
                            <!-- form start -->

                            <div class="accordion accordion-flush" id="accordionFlushExample">
                                <div class="accordion-item">
                                    <h2 class="accordion-header" id="flush-headingOne">
                                        <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#flush-collapseOne" aria-expanded="false" aria-controls="flush-collapseOne">
                                            <i style="font-size: 1.4em !important" class="fadeIn animated bx bx-menu-alt-left"></i><span style="font-size: 1.1em !important">Filter</span>
                                        </button>

                                    </h2>
                                    <div id="flush-collapseOne" class="accordion-collapse collapse" aria-labelledby="flush-headingOne" data-bs-parent="#accordionFlushExample">
                                        <div class="accordion-body">

                                            <div class="row">
                                                <div class="col-md-4">

                                                    <div class="form-group">
                                                        <div class="row">
                                                            <div class="col-md-4">   <label for="ddlCompany" class="bold col-form-label">Company:  </label></div>
                                                            <div class="col-md-8" id="divCompany">
                                                                <select class="form-select form-select-sm mb-3 select2 ddlCompany" style="width: 100%;" id="ddlCompany">
                                                                </select>
                                                            </div>
                                                        </div>
                                                    </div>









                                                </div>




                                            </div>
                                            <div>

                                                <div class="wrapper">
                                                    <div class="row">
                                                        <div class="col-md-5" style="margin: 0 44.5% !important;">
                                                            <div class="form-group">

                                                                <button class="small blue button" onclick="ShowReport()">
                                                                    <i class="fa fa-search" aria-hidden="true"></i>
                                                                    Search
                                                                </button>
                                                            </div>
                                                        </div>
                                                    </div>
                                                </div>

                                            </div>


                                        </div>
                                    </div>
                                </div>
                            </div>



                            <div class="row">
                                <div class="col-md-12">
                                    <div class="card-body">
                                        <table id="dtTb" class="table table-bordered table-striped table-hover jdtDataTable">
                                            <thead>
                                                <tr>
                                                    <th>#</th>

                                                    <th>Company Name</th>

                                                    <th>Account Name</th>

                                                    <th>Description</th>
                                                    <th>Ledger Head</th>
                                                    <th>Control Ledger</th>
                                                    <th>Sub-Control Ledger</th>
                                                    <th>Sub Sub Control Ledger</th>

                                                    <th>Action</th>

                                                </tr>
                                            </thead>
                                            <tbody id="manuallist">
                                            </tbody>
                                        </table>
                                    </div>
                                </div>



                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<style>
    .container-fluid {
        margin: 5px; /* Adjust as needed */
    }

    .dataTables_filter {
        float: right !important;
        margin-right: -20px !important;
        margin-bottom: 0px !important;
    }

    .dt-buttons {
        text-align: center !important;
    }
</style>

@section Scripts
{
    <script type="text/javascript">
        function un(o) {
            return o != null ? o : '';
        }

        $(document).ready(function () {
            //LoadDate_P('#txtFromDate');
            //LoadDate_C('#txtToDate');

            LoadCompany('ddlCompany');
            //$("#ddlCompany").val("1");
            ShowReport();
        });



         function ShowReport() {
          //
            var fromdate;
            var todate;
            var companyId = '0';


             
            if ($('#ddlCompany').val() == "0") {
                companyId = '0';
            }
            else {
                companyId = $('#ddlCompany').val();
            }


            var urlpath = '@Url.Action("CashAccountList", "CashAccount")';
            $.ajax({
                url: urlpath,
                dataType: 'html',
                type: "Get",
                data: { fromdate: fromdate, todate: todate, CompanyId: companyId},
                async: false,
                beforeSend: function () {

                     $("#overlay").fadeIn(300);


                },
                success: function (data) {

                    data = JSON.parse(data);
                    $("#manuallist").html("");
                    if (data.length > 0) {



                        var row = "";
                        var count = 1;
                        $("#manuallist").html("");

                        var count = 1;
                        for (var i = 0; i < data.length; i++) {

                            row += "<tr>";
                            row += "<td  >" + count + "</td>";
                            row += "<td  >" + data[i].CompanyName + "</td>";
               
                            row += "<td  >" + data[i].AccountName + "</td>";

                            row += "<td  >" + un(data[i].Description) + "</td>";
                            row += "<td  >" + data[i].GLName + "</td>";
                            row += "<td  >" + data[i].ControlLName + "</td>";
                            row += "<td  >" + data[i].SubsidiryLName + "</td>";
                            row += "<td  >" + data[i].SubSubControlLedgerName + "</td>";
                            row += "<td><button style='border-style:none'   onclick='editClick(" + data[i].CashAccountId + ")'><i class='fa fa-pencil' style='color:#00BFFF'></i></button> </td>";

                     
                            row += "</tr>";

                            count = count + 1;

                        }
                        $("#manuallist").html(row);
                    }
                },
                complete: function () {
                    if ($.fn.dataTable.isDataTable('.jdtDataTable')) {
                        table = $('#dtTb').DataTable({
                            paging: true,
                            retrieve: true,
                            "bInfo": true,
                            "bFilter": true,
                            processing: true,

                            dom: '<"container-fluid"<"row"<"col"l><"col"B><"col"f>>>rtip',

                            lengthMenu: [[10, 25, 50, 100, -1], [10, 25, 50, 100, "All"]],
                            lengthChange: true,
                            language: {
                                searchPlaceholder: "Search records",
                                search: ' ',
                                "emptyTable": "No Data Found!"
                            },



                            buttons: [
                                {
                                    extend: 'copyHtml5',
                                    text: '<i class="fa fa-files-o"></i>',
                                    titleAttr: 'Copy', className: 'btn  btn-sm'
                                },
                                {
                                    extend: 'excelHtml5',
                                    text: '<i class="fa fa-file-excel-o"></i>',
                                    titleAttr: 'Excel', className: 'btn  btn-sm'
                                },
                                {
                                    extend: 'csvHtml5',
                                    text: '<i class="fa fa-file-text-o"></i>',
                                    titleAttr: 'CSV', className: 'btn  btn-sm'
                                },
                                {
                                    extend: 'pdfHtml5',
                                    text: '<i class="fa fa-file-pdf-o"></i>',
                                    titleAttr: 'PDF', className: 'btn  btn-sm'
                                }
                            ]
                        });
                    }
                    else {
                        table = $('.jdtDataTable').DataTable({

                            "bInfo": true,
                            "bFilter": true,
                            processing: true,

                            dom: '<"container-fluid"<"row"<"col"l><"col"B><"col"f>>>rtip',

                            lengthMenu: [[10, 25, 50, 100, -1], [10, 25, 50, 100, "All"]],
                            lengthChange: true,
                            language: {
                                searchPlaceholder: "Search records",
                                search: ' ',
                                "emptyTable": "No Data Found!"
                            },

                            buttons: [
                                {
                                    extend: 'copyHtml5',
                                    text: '<i class="fa fa-files-o"></i>',
                                    titleAttr: 'Copy', className: 'btn  btn-sm'
                                },
                                {
                                    extend: 'excelHtml5',
                                    text: '<i class="fa fa-file-excel-o"></i>',
                                    titleAttr: 'Excel', className: 'btn  btn-sm'
                                },
                                {
                                    extend: 'csvHtml5',
                                    text: '<i class="fa fa-file-text-o"></i>',
                                    titleAttr: 'CSV', className: 'btn  btn-sm'
                                },
                                {
                                    extend: 'pdfHtml5',
                                    text: '<i class="fa fa-file-pdf-o"></i>',
                                    titleAttr: 'PDF', className: 'btn  btn-sm'
                                }
                            ]
                        });
                    }

                    $('#dtTb_length select').removeClass('form-select form-select-sm');

                    setTimeout(function () {
                        $("#overlay").fadeOut(300);
                    }, 500);

                    //table.buttons().container()
                    //    .appendTo('#dtTb_wrapper .col-md-6:eq(0)');
                }
            });
        }

        function editClick(id) {
            location.href = '../CashAccount/Create?id=' + id + '';
        }

         function LoadReportFinal(id) {
            var urlpath = '@Url.Action("VoucherPrintReports", "Report")';
            var reportValue = "VoucherPrint";
            var voucherMasterId = id;
            var jsonData = {};
            jsonData["ReportValue"] = reportValue;
            jsonData["VoucherMasterId"] = voucherMasterId;
            $.ajax({
                url: urlpath,
                data: jsonData,
                dataType: 'json',
                type: "Get",
                success: function (data) {
                    if (data.isSuccess) {

                       //OpenPopUp('BasicReportViewer.aspx');
                        window.open("/CrystalViewer/CrystalViewer.aspx", "_blank", "WIDTH=1024,HEIGHT=768,scrollbars=no, menubar=no,resizable=yes,directories=no,location=no");
                    }
                }
            });
        }
    </script>

}


