        function SaveDate() {

            if (Validation()) {
                $("#overlay").fadeIn(300);
                var jsonObjs = [];

                var jsonData = {};

                 
                try {
                $('#tblIssueQC tbody tr').each(function () {
                    var idr = $(this).attr('id');
                    var id = idr.substring(3);





                    if ($('#chk_' + id).is(':checked')) {
                        var theObj = {};


                        theObj["VoucherMasterId"] = $('#chk_' + id).val();



                        theObj["ReconcileDate"] = $('#txtReconcileDate_' + id).val();



                        jsonObjs.push(theObj);
                    }





                });



                } catch (error) {
                    // Handle the error here
                    console.log('An error occurred:', error);
                }


           




                alert(jsonObjs);

                jsonData["aMaster"] = jsonObjs;


            var urlpath = '@Url.Action("SaveReconcileBank", "ReconcileBankAccount")';
            $.ajax({
                contentType: "application/json",
                data: JSON.stringify(jsonData),
                dataType: 'json',
                url: urlpath,
                type: "POST",
                beforeSend: function () {
                    $("#overlay").fadeIn(300);
                }
            })
                .success(function (result) {
                    setTimeout(function () {
                        $("#overlay").fadeOut(300);
                    }, 500);
