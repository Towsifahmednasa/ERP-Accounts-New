                                                                        <div class="col-md-8" id="divCompany">
                                                                            <select class="form-select form-select-sm mb-3 select2 ddlCompany" style="width: 100%;" id="ddlCompany">
                                                                            </select>
                                                                        </div>
                                                                    </div>
                                                                </div>
                                                            </div>




                                                            <div class="col-md-4">
                                                                <div class="form-group">
                                                                    <div class="row">
                                                                        <div class="col-md-4">   <label for="ddlCompany" class="bold col-form-label">Ledger Head:  </label></div>
                                                                        <div class="col-md-8" id="divCompany">
                                                                            <select class="form-select form-select-sm mb-3 select2" style="width: 100%;" onchange="LoadControlLedger()" id="ddlLedgerHead"></select>
                                                                        </div>
                                                                    </div>
                                                                </div>
                                                                <div class="form-group">
                                                                    <div class="row">
                                                                        <div class="col-md-4">   <label for="ddlCompany" class="bold col-form-label">Control Ledger:  </label></div>
                                                                        <div class="col-md-8" id="divCompany">
                                                                            <select class="form-select form-select-sm mb-3 select2" style="width: 100%;" onchange="LoadSubsidaryLedger()" id="ddlControlLedger"></select>
                                                                        </div>
                                                                    </div>
                                                                </div>
                                                            </div>



                                                            <div class="col-md-4">

                                                                <div class="form-group">
                                                                    <div class="row">
                                                                        <div class="col-md-4">   <label for="ddlCompany" class="bold col-form-label">Sub Control Ledger:  </label></div>
                                                                        <div class="col-md-8" id="divCompany">
                                                                            <select class="form-select form-select-sm mb-3 select2" style="width: 100%;" onchange="LoadSubSubControlLedger()" id="ddlSubControlLedger"></select>
                                                                        </div>
                                                                    </div>
                                                                </div>

                                                                <div class="form-group">
                                                                    <div class="row">
                                                                        <div class="col-md-4">   <label for="ddlCompany" class="bold col-form-label">Sub Sub Control Ledger:  </label></div>
                                                                        <div class="col-md-8" id="divCompany">
                                                                            <select class="form-select form-select-sm mb-3 select2" style="width: 100%;" id="ddlSubSubControlLedger"></select>
                                                                        </div>
                                                                    </div>
                                                                </div>
                                                            </div>










                                                        </div>
                                                        <div>

                                                            <div class="wrapper">
                                                                <div class="row">
                                                                    <div class="col-md-5" style="margin: 0 44.5% !important;">
                                                                        <div class="form-group">

                                                                            <button class="small blue button" onclick="ShowReport()">
                                                                                <i class="fa fa-search" aria-hidden="true"></i>
                                                                                Search
                                                                            </button>
                                                                        </div>
                                                                    </div>
                                                                </div>
                                                            </div>

                                                        </div>


                                                    </div>


                                                </div>
                                            </div>
                                        </div>
                                    </div>


                                    <table id="dtTb" class="table table-bordered table-striped table-hover jdtDataTable">
                                        <thead>
                                            <tr>
                                                <th>SL#</th>
                                                <th>Company</th>
                                                <th>Ledger Head</th>
                                                <th>Control Ledger</th>
                                                <th>
                                                    Sub-Control Ledger
                                                </th>

                                                <th>
                                                    Sub Sub Control Ledger
                                                </th>

                                                <th>Chart Of Account</th>
                                                <th>Description</th>
                                                <th>Status</th>
                                                <th>Action</th>

                                            </tr>
                                        </thead>
                                        <tbody id="manuallist">
                                        </tbody>
                                    </table>
                                </div>
