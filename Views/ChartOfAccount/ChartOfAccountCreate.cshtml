function GetAccountCodebySubSubControlLedger() {
    var id = $('#ddlSubSubControlLedger').val();
    if (!id || id === "0") {
        $('#txtExtraAccountCode').val('');
        $('#hiddenExtraAccountCode').val('');
        return;
    }

    var urlpath = '@Url.Action("GetAccountCodebySubSubControlLedgerId", "ChartOfAccount")';

    $.ajax({
        url: urlpath,
        type: "GET",
        dataType: 'json',
        data: { id: id },
        success: function (data) {
            console.log("Returned data:", data);
            var result = JSON.parse(data);

        
            $('#txtExtraAccountCode').val(result[0].AccountCode);
            $('#hiddenExtraAccountCode').val(result[0].AccountCode);
          
        },
        error: function (xhr, status, error) {
            console.error("Error fetching account code:", error);
            $('#txtExtraAccountCode').val('');
            $('#hiddenExtraAccountCode').val('');
        }
    });
}


