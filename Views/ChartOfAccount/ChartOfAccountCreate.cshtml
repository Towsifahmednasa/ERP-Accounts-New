        function LoadCompany() {
            $.ajax({
                url: "/ChartOfAccount/Get_Company_DDL",
                contentType: "application/json; charset=utf-8",
                dataType: 'json',
                type: "Get",
                async: false,
                success: function (data) {
                    var result = JSON.parse(data);
                    $('#ddlcompany').empty();
                    $('#ddlcompany').append("<option value='0'>-- Select All --</option>"); // Select All option
                    for (var i = 0; i < result.length; i++) {
                        $('#ddlcompany').append($("<option></option>").val(result[i].CompanyId).html(result[i].CompanyName));
                    }
                }
            });
        }
        //$('#ddlcompany').change(function () {
        //    if ($(this).val().includes('selectall')) {
        //        $('#ddlcompany option').prop('selected', true); // Select all
        //    }
        //});


        $("#ddlcompany").on("change", function (e) {

            if ($(this).val().includes('0')) {
                // Select all except the option with value '0'
                $('#ddlcompany option:not([value="0"])').prop('selected', true);
                // Remove selection from "Select All"
                $('#ddlcompany option[value="0"]').prop('selected', false);
            }
            var CompanyId = $("#ddlcompany").val();
            if (CompanyId > 0) {

                GetMaltiUpazilaCoordinatorForEdit(CompanyId,0);
            }
        });

         function LoadRefPartial() {
            var urlpath = '@Url.Action("LoadReferanceInPartialView", "ChartOfAccount")';
             var glid = $('#masterId').val();;


            $.ajax({
                url: urlpath,
                dataType: 'html',
                type: "Get",
                async: true,
                data:{glid:glid},
                beforeSend: function () {
                    $('#detailsR').empty();
                    $("#overlay").fadeIn(300);


                },
                success: function (data) {

                    $('#detailsR').append(data);
                    // $('#reportTable1').dataTable();
                },
