        function SaveValidation() {

            var isValid = true;


            if ($('#ddlcompany').val() == 0 || $('#ddlcompany').val() == '') {
                ValidationColorChangeNew("ddlcompany", "divCompany", "Company Required", true);

                isValid = false;
            }
            //var dv = $('#multiSelectId').val();

            //if (dv == '' || dv == null) {
            //    ValidationColorChangeNew("multiSelectId", "divBusinessUnit", "Business Unit Required", true);

            //    isValid = false;
            //}
            $('#ddlcompany').val() == 0 || $('#ddlcompany').val() == ''

            if ($('#ddlSubControlLedger').val() == 0 || $('#ddlSubControlLedger').val() == '' || $('#ddlSubControlLedger').val() == null) {
                ValidationColorChangeNew("ddlSubControlLedger", "divSubControlLedger", "Sub Control Ledger Required", true);

                isValid = false;
            }


            if ($('#ddlSubSubControlLedger').val() == 0 || $('#ddlSubSubControlLedger').val() == '' || $('#ddlSubSubControlLedger').val() == null) {
                ValidationColorChangeNew("ddlSubSubControlLedger", "divSubSubControlLedger", "Sub Sub Control Ledger Required", true);

                isValid = false;
            }




            if ($('#txtAccountName').val() == '' || $('#txtAccountName').val() == null) {
                ValidationColorChangeNew("txtAccountName", "divAccountName", "Account Name Required", false);

                isValid = false;
            }

            let prefix = $('#lblAccountCode').text().trim();
            let codeVal = $('#txtExtraAccountCode').val();
            if (!/^\d{3}$/.test(codeVal)) {
                ValidationColorChangeNew("txtExtraAccountCode", "divAccountCode", "Account Code must be exactly 3 digits", false);
                isValid = false;
            } else {
                ValidationColorChangeNew("txtExtraAccountCode", "divAccountCode", "", true); // Clear validation if valid
            }

            // কোড বানানো
            let AccountfullCode = prefix + codeVal;

            var isValid = true; // Assume valid by default
            var isCIdSelected = false; // Flag to check if at least one CId is selected


                if ($('#ddlLedgerHead').val() == '4') {
                    $('#reportTableC tbody tr').each(function () {
                        var idr = $(this).attr('id');
                        var id = idr.substring(3);

                        if ($('#chkC_' + id).is(':checked')) {
                            var IsChecked = $('#chkC_' + id).is(':checked');
                            var CId = $('#chkC_' + id).val();
                            var IsCos = $('#isC_' + id).val();

                            // If any CId is selected, mark the flag as true
                            isCIdSelected = true;
                        }
                    });

                    // Check if no CId was selected
                    if (!isCIdSelected) {
                        alert('Please select at least one Cost Center.');
                        isValid = false;
                    }
                }




            return isValid;
        }
