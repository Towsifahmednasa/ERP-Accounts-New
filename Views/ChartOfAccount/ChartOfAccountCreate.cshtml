        function GetData(id) {
            var urlpath = '@Url.Action("Get_ChartofAccount_ById", "ChartOfAccount")';
            $.ajax({
                url: urlpath,
                dataType: 'json',
                data: {id : id},
                type: "Get",
                async: true,
                success: function (data) {
                    var result = JSON.parse(data);


                    let arr = result[0].CompanyName.split(',');

                    $('#ddlcompany').val(arr).change();

                    $('#ddlLedgerHead').val(result[0].GLHeadId).change();
                    $('#ddlControlLedger').val(result[0].ControlLId).change();
                    $('#ddlSubControlLedger').val(result[0].SubsidiryLId).change();
                    $('#ddlSubSubControlLedger').val(result[0].SubSubControlLedgerId).change();

                    $('#txtAccountName').val(result[0].AccountName);
                    $('#txtRemarks').val(result[0].Description);


                    if (result[0].IsCostCenter) {
                        $('#CostCenter').prop('checked', true);




                            $(".answerC").show();
                        LoadCostCenterPartial();



                    } else {
                        $('#CostCenter').prop('checked', false);


                        $(".answerC").hide();
                    }

                    if (result[0].IsReference) {
                        $('#ref').prop('checked', true);

                        $(".answerR").show();
                        LoadRefPartial();


                    } else {
                        $('#ref').prop('checked', false);
                        $(".answerR").hide();
                    }

                    if (result[0].IsSubsidiary) {
                        $('#subsidiary').prop('checked', true);

                        $(".answerS").show();
                        LoadSubPartial();
                    } else {
                        $('#subsidiary').prop('checked', false);
                        $(".answerS").hide();
                    }



                    if (result[0].IsActive) {
                        $('#customSwitch1').prop('checked', true);
                    } else {
                        $('#customSwitch1').prop('checked', false);
                    }
                },
                complete: function () {
                    $("#btnSave").html("Update");
                    //$('#territorySelect').attr('disabled', true);
                }
            });
        }


