        function setAccountCodeFromDropdown(dropdownId, labelId) {
            var dropdown = document.getElementById(dropdownId);
            var selectedText = dropdown.options[dropdown.selectedIndex].text;
            var selectedValue = dropdown.value;

            if (selectedValue && selectedValue !== "0") {
                var accountCode = selectedText.split(":")[0].trim();
                document.getElementById(labelId).innerText = accountCode;
            } else {
                document.getElementById(labelId).innerText = "🔢 N/A";
            }
        }


