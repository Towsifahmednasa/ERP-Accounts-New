@* Ported from Accounts\CSTL_Pro_to_Pay\Views\SubSubControlLedger\SSCLList.cshtml - page markup and inline scripts unchanged; presentation comes from the Fiori shell/stylesheet. *@

@{
    ViewBag.Title = "Sub Sub Control Ledger List";
    Layout = "~/Views/Shared/_Layout.cshtml";
}




<div id="popDiv"></div>
<div class="page-wrapper">
    <div class="page-content">
        <div class="row">
            <div class="col">
                <div class="card border-top border-0 border-4 border-success mt-3" style="margin-top: 3px !important">
                    <div class="card-body" style="border-style: none !important;">
                        <div class="border p-2 rounded">

                            <div class="page-breadcrumb d-none d-sm-flex align-items-center headerBorderBottom">
                                <div class="breadcrumb-title pe-3">
                                    <div class="card-title d-flex align-items-center">
                                        <div>
                                            <i class="bx bxs-right-arrow-square me-1 font-22 text-inverse"></i>
                                        </div>
                                        <h5 class="mb-0 text-dark cstlfs">
                                            <span class="">
                                                Sub Sub Control Ledger List
                                            </span>
                                        </h5>
                                    </div>
                                </div>
                                <div class="ms-auto">
                                    <div class="btn-group">
                                        <a class="small blue button" href="@Url.Action("SSCLCreate", "SubSubControlLedger")">
                                            <span class="fa fa-plus"></span> Add New

                                        </a>

                                    </div>
                                </div>
                            </div>


                            <div class="row">
                                <div class="col-md-12">
                                    <div class="card-body">
                                        <table id="dtTb" class="table table-bordered table-striped table-hover jdtDataTable">
                                            <thead>
                                                <tr>
                                                    <th>SL#</th>

                                                    <th>Ledger Head</th>
                                                    <th>Control Ledger</th>
                                                    <th>
                                                        Sub-Control Ledger
                                                    </th>

                                                    <th>Sub Sub Control Ledger</th>
                                                    <th>Description</th>
                                                    <th>Status</th>
                                                    <th>Action</th>

                                                </tr>
                                            </thead>
                                            <tbody id="manuallist">
                                            </tbody>
                                        </table>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .container-fluid {
        margin: 5px; /* Adjust as needed */
    }

    .dataTables_filter {
        float: right !important;
        margin-right: -20px !important;
        margin-bottom: 0px !important;
    }

    .dt-buttons {
        text-align: center !important;
    }
</style>



@section Scripts
{
    <script type="text/javascript">

        $(function () {
            ShowReport();
        });

        function un(o) {
            return o != null ? o : '';
        }

         function ShowReport() {
            var urlpath = '@Url.Action("Get_SSCLList", "SubSubControlLedger")';
            $.ajax({
                url: urlpath,
                dataType: 'html',
                type: "Get",
                data: { },
                async: false,
                beforeSend: function () {
                    $("#overlay").fadeIn(300);
                },
                success: function (data) {


                    data = JSON.parse(data);
                    $("#manuallist").html("");
                    if (data.length > 0) {



                        var row = "";
                        var count = 1;
                        $("#manuallist").html("");

                        var count = 1;
                        for (var i = 0; i < data.length; i++) {



                            row += "<tr>";
                            row += "<td style='text-align:center'>" + count + "</td>";

                            row += "<td style='text-align:center'>" + data[i].GLName + "</td>";
                            row += "<td style='text-align:center'>" + data[i].ControlLName + "</td>";
                            row += "<td style='text-align:center'>" + data[i].SubsidiryLName + "</td>";
                            row += "<td style='text-align:center'>" + un(data[i].SubSubControlLedgerName) + "</td>";
                            row += "<td style='text-align:center'>" + un(data[i].Description) + "</td>";




                            if (data[i].IsActive == true) {
                                row += "<td><span class='badge bg-success'>Active</span></td>";
                            } else {
                                row += "<td><span class='badge bg-danger'>Inactive</span></td>";
                            }

                            row += "<td><button style='border-style:none'   onclick='editClick(" + data[i].SubSubControlLedgerId + ")'><i class='fa fa-pencil' style='color:#00BFFF'></i></button> </td>";



                            row += "</tr>";
                            count = count + 1;

                        }
                        $("#manuallist").html(row);
                    }
                },
                complete: function () {
                    if ($.fn.dataTable.isDataTable('.jdtDataTable')) {
                        table = $('#dtTb').DataTable({
                            paging: true,
                            retrieve: true,
                            "bInfo": true,
                            "bFilter": true,
                            processing: true,

                            dom: '<"container-fluid"<"row"<"col"l><"col"B><"col"f>>>rtip',


                            lengthChange: true,
                            language: {
                                searchPlaceholder: "Search records",
                                search: ' ',
                                "emptyTable": "No Data Found!"
                            },



                            buttons: [
                                {
                                    extend: 'copyHtml5',
                                    text: '<i class="fa fa-files-o"></i>',
                                    titleAttr: 'Copy', className: 'btn  btn-sm'
                                },
                                {
                                    extend: 'excelHtml5',
                                    text: '<i class="fa fa-file-excel-o"></i>',
                                    titleAttr: 'Excel', className: 'btn  btn-sm'
                                },
                                {
                                    extend: 'csvHtml5',
                                    text: '<i class="fa fa-file-text-o"></i>',
                                    titleAttr: 'CSV', className: 'btn  btn-sm'
                                },
                                {
                                    extend: 'pdfHtml5',
                                    text: '<i class="fa fa-file-pdf-o"></i>',
                                    titleAttr: 'PDF', className: 'btn  btn-sm'
                                }
                            ]
                        });
                    }
                    else {
                        table = $('.jdtDataTable').DataTable({

                            "bInfo": true,
                            "bFilter": true,
                            processing: true,

                            dom: '<"container-fluid"<"row"<"col"l><"col"B><"col"f>>>rtip',


                            lengthChange: true,
                            language: {
                                searchPlaceholder: "Search records",
                                search: ' ',
                                "emptyTable": "No Data Found!"
                            },

                            buttons: [
                                {
                                    extend: 'copyHtml5',
                                    text: '<i class="fa fa-files-o"></i>',
                                    titleAttr: 'Copy', className: 'btn  btn-sm'
                                },
                                {
                                    extend: 'excelHtml5',
                                    text: '<i class="fa fa-file-excel-o"></i>',
                                    titleAttr: 'Excel', className: 'btn  btn-sm'
                                },
                                {
                                    extend: 'csvHtml5',
                                    text: '<i class="fa fa-file-text-o"></i>',
                                    titleAttr: 'CSV', className: 'btn  btn-sm'
                                },
                                {
                                    extend: 'pdfHtml5',
                                    text: '<i class="fa fa-file-pdf-o"></i>',
                                    titleAttr: 'PDF', className: 'btn  btn-sm'
                                }
                            ]
                        });
                    }

                    $('#dtTb_length select').removeClass('form-select form-select-sm');

                    setTimeout(function () {
                        $("#overlay").fadeOut(300);
                    }, 500);
                }
            });
        }


        function editClick(id) {
            location.href = '@Url.Action("SSCLCreate", "SubSubControlLedger")?id=' + id + '';
        }
    </script>

}
