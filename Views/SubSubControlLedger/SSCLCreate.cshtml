@* Ported from Accounts\CSTL_Pro_to_Pay\Views\SubSubControlLedger\SSCLCreate.cshtml - page markup and inline scripts unchanged; presentation comes from the Fiori shell/stylesheet. *@

@{
    ViewBag.Title = "Sub Sub Control Ledger Entry";
    Layout = "~/Views/Shared/_Layout.cshtml";
}



<div id="popDiv"></div>
<div class="page-wrapper">
    <div class="page-content">
        <div class="row">
            <div class="col">
                <div class="card border-top border-0 border-4 border-dark mt-3" style="margin-top: 3px !important">
                    <div class="card-body" style="border-style: none !important;">
                        <div class="border p-2 rounded">

                            <div class="page-breadcrumb d-none d-sm-flex align-items-center headerBorderBottom">
                                <div class="breadcrumb-title pe-3">
                                    <div class="card-title d-flex align-items-center">
                                        <div>
                                            <i class="bx bxs-right-arrow-square me-1 font-22 text-inverse"></i>
                                        </div>

                                        <h5 class="mb-0 text-dark cstlfs">Sub Sub Control Ledger Entry</h5>
                                    </div>
                                </div>

                                <div class="ms-auto">
                                    <div class="btn-group">

                                        <a class="small blue button" href="@Url.Action("SSCLList", "SubSubControlLedger")">
                                            <span class="fa fa-share"></span>  Back to List
                                        </a>
                                    </div>
                                </div>
                            </div>


                            <!-- /.card-header -->
                            <!-- form start -->






                           

                            <div class="row mt-2">

                                <div class="col-md-4 mb-1"></div>
                                <div class="col-md-4">
                                    <div class="form-group row" style="margin-bottom: 3px !important;">
                                        <label style="text-align: right !important; font-size:small !important" class="col-md-4 bold col-form-label">Ledger Head:<span style="color: orangered !important;"> *</span></label>
                                        <div class="col-md-8" id="divLedgerHead">
                                            <select class="form-select form-select-sm mb-3 select2" style="width: 100%;" onchange="LoadControlLedger()" id="ddlLedgerHead"></select>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-md-4 mb-1"></div>
                            </div>



                            <div class="row mt-2">

                                <div class="col-md-4 mb-1"></div>
                                <div class="col-md-4">
                                    <div class="form-group row" style="margin-bottom: 3px !important;">
                                        <label style="text-align: right !important; font-size:small !important" class="col-md-4 bold col-form-label">Control Ledger:<span style="color: orangered !important;"> *</span></label>
                                        <div class="col-md-8" id="divControlLedger">
                                            <select class="form-select form-select-sm mb-3 select2" style="width: 100%;" onchange="LoadSubsidaryLedger()" id="ddlControlLedger"></select>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-md-4 mb-1"></div>
                            </div>



                            <div class="row mt-2">

                                <div class="col-md-4 mb-1"></div>
                                <div class="col-md-4">
                                    <div class="form-group row" style="margin-bottom: 3px !important;">
                                        <label style="text-align: right !important; font-size:small !important" class="col-md-4 bold col-form-label">Sub Control Ledger:<span style="color: orangered !important;"> *</span></label>
                                        <div class="col-md-8" id="divSubControlLedger">
                                            <select class="form-select form-select-sm mb-3 select2" style="width: 100%;" id="ddlSubControlLedger"></select>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-md-4 mb-1"></div>
                            </div>



                            <div class="row mt-2">

                                <div class="col-md-4 mb-1"></div>
                                <div class="col-md-4">
                                    <div class="form-group row" style="margin-bottom: 3px !important;">
                                        <label style="text-align: right !important; font-size: small !important" class="col-md-4 bold col-form-label">Sub Sub Control Ledger Name:<span style="color: orangered !important;"> *</span></label>
                                        <div class="col-md-8" id="divAccountName">
                                            <input type="text" id="txtAccountName" class="form-control form-control-sm" />
                                        </div>
                                    </div>
                                </div>
                                <div class="col-md-4 mb-1"></div>
                            </div>



                            <div class="row mt-2">

                                <div class="col-md-4 mb-1"></div>
                                <div class="col-md-4">
                                    <div class="form-group row" style="margin-bottom: 3px !important;">
                                        <label style="text-align: right !important; font-size: small !important" class="col-md-4 bold col-form-label">Remarks: </label>
                                        <div class="col-md-8">

                                            <textarea id="txtRemarks" name="txtRemarks" rows="4" cols="50" class="form-control form-control-sm"> </textarea>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-md-4 mb-1"></div>
                            </div>



                            <div class="row mt-2">

                                <div class="col-md-4 mb-1"></div>
                                <div class="col-md-4">
                                    <div class="form-group row" style="margin-bottom: 3px !important;">
                                        <label style="text-align: right !important; font-size: small !important" class="col-md-4 bold col-form-label"><span style="color: orangered !important;"> </span></label>
                                        <div class="col-md-8">
                                            <div class="form-check form-switch">
                                                <input class="form-check-input" type="checkbox" id="customSwitch1" checked>
                                                <label class="custom-control-label" for="customSwitch1">Active</label>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-md-4 mb-1"></div>
                            </div>


                            <div style="padding-top: 1.5%">

                                <div class="wrapper">
                                    <div class="row">
                                        <div class="col-md-5" style="margin: 0 44.5% !important;">
                                            <div class="form-group">

                                                <button class="small blue button" id="Reject" onclick="Save()">
                                                    <i class="fa fa-paper-plane" aria-hidden="true"></i>
                                                   Submit
                                                </button>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                            </div>
                        </div>
                    </div>
                </div>


                <!-- Modal -->
                <!-- /.card-header -->
                <!-- form start -->
                <!-- /.row -->
            </div><!-- /.container-fluid -->

        </div>
    </div>
</div>


<input id="masterId" value="@ViewBag.Id" style="display:none" />



@section Scripts
{
    <script type="text/javascript">


        var Mode = 'E';
        let id = $('#masterId').val();
        $(function () {

            LoadLadgerHead()
            if (id > 0) {
                Mode = 'U';
                GetData(id);
            } else {

                Mode = 'E';


            }

        });

        function LoadLadgerHead() {
            $.ajax({
                url: "/Utility/GetLadgerHead",
                contentType: "application/json; charset=utf-8",
                dataType: 'json',
                type: "Get",
                data: {},
                async: false,
                success: function (data) {

                    $('#ddlLedgerHead').empty();
                    $('#ddlLedgerHead').append("<option value='0'>--Select  Ledger Head--</option>");

                    for (var i = 0; i < data.length; i++) {

                        $('#ddlLedgerHead').append($("<option></option>").val(data[i].GLHeadId).html(data[i].GLName));
                    }
                }
            });
        }
        function LoadControlLedger() {
            var companyId = $("#ddlLedgerHead").val();

            if (companyId > 0) {
                $.ajax({
                    url: "/SubControl/Get_ControlLedger_By_Ledger_DDL",
                    contentType: "application/json; charset=utf-8",
                    dataType: 'json',
                    type: "Get",
                    data: { LedgerId: companyId, mode: Mode },
                    async: false,
                    success: function (data) {
                        var result = JSON.parse(data);
                        $('#ddlControlLedger').empty();
                        $('#ddlControlLedger').append("<option value='0'>--Select Control Ledger--</option>");
                        for (var i = 0; i < data.length; i++) {
                            $('#ddlControlLedger').append($("<option></option>").val(result[i].ControlLId).html(result[i].ControlLName));
                        }
                    }
                });
            }



        }
        function LoadSubsidaryLedger() {
            var ControlLedgerId = $("#ddlControlLedger").val();
            $.ajax({
                url: "/Utility/LoadSubsidaryByControlLedgerId",
                contentType: "application/json; charset=utf-8",
                dataType: 'json',
                type: "Get",
                data: { ControlLedgerId: ControlLedgerId, mode: Mode },
                async: false,
                success: function (data) {

                    $('#ddlSubControlLedger').empty();
                    $('#ddlSubControlLedger').append("<option value='0'>--Select Control Ledger--</option>");

                    for (var i = 0; i < data.length; i++) {

                        $('#ddlSubControlLedger').append($("<option></option>").val(data[i].SubsidiryLId).html(data[i].SubsidiryLName));
                    }
                }
            });
        }


          function SaveValidation() {

            var isValid = true;


           

            if ($('#ddlSubControlLedger').val() == 0 || $('#ddlSubControlLedger').val() == '' || $('#ddlSubControlLedger').val() == null) {
                ValidationColorChangeNew("ddlSubControlLedger", "divSubControlLedger", "Sub Control Ledger Required", true);

                isValid = false;
            }

            if ($('#txtAccountName').val() == '' || $('#txtAccountName').val() == null) {
                ValidationColorChangeNew("txtAccountName", "divAccountName", "Sub Sub Control Ledger Name Required", false);

                isValid = false;
            }
            return isValid;
        }
        function Save() {



            if (SaveValidation()) {
                swal({
                    title: "Are you sure?",
                    text: " ",
                    type: "warning",
                    showCancelButton: true,
                    confirmButtonColor: '#DD6B55',
                    confirmButtonText: 'Yes, I am sure!',
                    cancelButtonText: "No, cancel it!",
                    closeOnConfirm: false,
                    closeOnCancel: false
                },
                    function (isConfirm) {

                        if (isConfirm) {
                            FinalSave();
                        } else {
                            swal("Cancelled", " )", "error");
                            e.preventDefault();
                        }
                    });
            };


        }
        function FinalSave() {




           
            var jsonData = {};
            

            jsonData["SubSubControlLedgerId"] = $('#masterId').val();
          jsonData["SubsidiaryLId"] = $('#ddlSubControlLedger').val();
            jsonData["SubSubControlLedgerName"] = $('#txtAccountName').val().trim();
            jsonData["Description"] = $('#txtRemarks').val().trim();
          

            
            jsonData["IsActive"] = $('#customSwitch1').is(':checked');


             


          var urlpath = '@Url.Action("Save_SSCL", "SubSubControlLedger")';
        $.ajax({
            contentType: "application/json; charset=utf-8",
            data: JSON.stringify(jsonData),
            dataType: 'json',
            url: urlpath,
            type: "POST",
            beforeSend: function () {
                _open_LoadingPopUp_WithMsg("popDiv", "Please wait. Data is Saving...");
            }
              }).success(function (result) {
                _close_LoadingPopUp_WithMsg();
                    if (result.pk > 0) {
                        swal({
                            title: " Saved Successfully!",
                            text: '',
                            type: "success",
                            showCancelButton: false,
                            cancelButtonClass: 'btn-secondary waves-effect',
                            confirmButtonClass: 'btn-success waves-effect waves-light',
                            confirmButtonText: 'Yes!',
                            closeOnConfirm: false
                        }, function () {

                                window.location.href = '@Url.Action("SSCLList", "SubSubControlLedger")';



                        });


                    }
                });


        }


        function GetData(id) {
            var urlpath = '@Url.Action("Get_SSCLById", "SubSubControlLedger")';
            $.ajax({
                url: urlpath,
                dataType: 'json',
                data: {id : id},
                type: "Get",
                async: true,
                success: function (data) {
                    var result = JSON.parse(data);

                     

                    $('#ddlLedgerHead').val(result[0].GLHeadId).change();
                    $('#ddlControlLedger').val(result[0].ControlLId).change();
                    $('#ddlSubControlLedger').val(result[0].SubsidiryLId).change();

                    $('#txtAccountName').val(result[0].SubSubControlLedgerName);
                    $('#txtRemarks').val(result[0].Description);


                     

                    if (result[0].IsActive) {
                        $('#customSwitch1').prop('checked', true);
                    } else {
                        $('#customSwitch1').prop('checked', false);
                    }
                },
                complete: function () {
                    $("#btnSave").html("Update");
                    //$('#territorySelect').attr('disabled', true);
                }
            });
        }

    </script>
}