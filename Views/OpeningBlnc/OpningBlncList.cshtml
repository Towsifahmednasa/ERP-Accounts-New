@* Ported from Accounts\CSTL_Pro_to_Pay\Views\OpeningBlnc\OpningBlncList.cshtml - page markup and inline scripts unchanged; presentation comes from the Fiori shell/stylesheet. *@

@{
    ViewBag.Title = "Opening Balance List";
    Layout = "~/Views/Shared/_Layout.cshtml";
}


<style>
    .container-fluid {
        margin: 5px; /* Adjust as needed */
    }

    .dataTables_filter {
        float: right !important;
        margin-right: -20px !important;
        margin-bottom: 0px !important;
    }

    .dt-buttons {
        text-align: center !important;
    }
</style>

<div class="page-wrapper">
    <div class="page-content">
        <div class="row">
            <div class="col">
                <div class="card border-top border-0 border-4 border-dark mt-3" style="margin-top: 3px !important">
                    <div class="card-body" style="border-style: none !important;">
                        <div class="border p-2 rounded">

                            <div class="page-breadcrumb d-none d-sm-flex align-items-center headerBorderBottom">
                                <div class="breadcrumb-title pe-3">
                                    <div class="card-title d-flex align-items-center">
                                        <div>
                                            <i class="bx bxs-right-arrow-square me-1 font-22 text-inverse"></i>
                                        </div>
                                        <h5 class="mb-0 text-dark cstlfs">
                                            <span class="">Opening Balance List</span>
                                        </h5>
                                    </div>
                                </div>
                                <div class="ms-auto">
                                    <div class="btn-group">
                                        <a class="small blue button" href="@Url.Action("OpningBlncEntry", "OpeningBlnc")">
                                            <span class="fa fa-plus"></span> Add New

                                        </a>

                                    </div>
                                </div>
                            </div>


                            <!-- /.card-header -->
                            <!-- form start -->


                            <div class="row">
                                <div class="col-md-12">
                                    <div class="card-body">

                                        <div class="row">
                                            <div class="col-md-4">
                                            </div>
                                            <div class="col-md-4">

                                                <div class="form-group">
                                                    <div class="row">
                                                        <div class="col-md-4">   <label for="ddlCompany" class="bold col-form-label">Company:  </label></div>
                                                        <div class="col-md-8" id="divCompany">
                                                            <select class="form-select form-select-sm mb-3 select2 ddlCompany" style="width: 100%;" id="ddlCompany" onchange="LoadDDlbyCom()">
                                                            </select>
                                                        </div>
                                                    </div>
                                                </div>

                                                <div class="form-group" id="divFinansialYear">
                                                    <div class="row">
                                                        <div class="col-md-4">   <label for="ddlFinansialYear" class="bold col-form-label">Financial Year: </label></div>
                                                        <div class="col-md-8">    <select class="form-select form-select-sm mb-3 select2" style="width: 100%;" id="ddlFinansialYear"></select> </div>
                                                    </div>
                                                </div>



                                                <div class="form-group" style="margin-top:10px;">
                                                    <div class="row">
                                                        <div class="col-md-4"></div>
                                                        <div class="col-md-4">
                                                            <button class="small blue button" onclick="Get_Reference()">
                                                                <i class="fa fa-search" aria-hidden="true"></i>
                                                                Search
                                                            </button>
                                                        </div>
                                                    </div>
                                                </div>


                                            </div>
                                        </div>

                                        <table style="margin-top:10px;" id="dtTb" class="table table-bordered table-striped table-hover jdtDataTable">
                                            <thead>
                                                <tr>
                                                    <th>SL#</th>

                                                    <th>Company</th>
                                                    <th>Fiscal Year</th>
                                                    <th>Chart of Accounts</th>

                                                    <th>Amount</th>
                                                    <th>Currency</th>
                                                    <th>Remarks</th>

                                                    <th>Entry By</th>
                                                    <th>Entry Date</th>
                                                    <th>Update By</th>
                                                    <th>Update Date</th>

                                                    <th>Action</th>
                                                </tr>
                                            </thead>
                                            <tbody id="dtTableBody">
                                            </tbody>
                                        </table>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>




@section Scripts
{
    <script type="text/javascript">

        $(function () {

            LoadCompany('ddlCompany');
           // Get_Reference();
        });


        function LoadDDlbyCom() {

            LoadFinansialYear();

        }

        function LoadFinansialYear() {
            var companyId = $("#ddlCompany").val();
            $.ajax({
                url: "/Utility/GetFinansialYearComId",
                contentType: "application/json; charset=utf-8",
                dataType: 'json',
                type: "Get",
                data: { companyId: companyId },
                async: false,
                success: function (data) {

                    $('#ddlFinansialYear').empty();
                    $('#ddlFinansialYear').append("<option value='0'>--Select Financial Year--</option>");

                    for (var i = 0; i < data.length; i++) {

                        $('#ddlFinansialYear').append($("<option></option>").val(data[i].FinancialYearId).html(data[i].FinancialYearDesc));
                    }
                }
            });
        }

        function un(o) {
            return o != null ? o : '';
        }

        function Get_Reference() {

            var companyID = $("#ddlCompany").val();
            var Yearid = $('#ddlFinansialYear').val();

            var urlpath = '@Url.Action("Get_OpningBlncList", "OpeningBlnc")';
            $.ajax({
                url: urlpath,
                dataType: 'html',
                data: { companyID: companyID, Yearid: Yearid },
                type: "Get",
                async: false,
                beforeSend: function () {

                    $("#overlay").fadeIn(300);


                },
                success: function (data) {
                    $('#tabH').show();
                    var result = JSON.parse(data);
                    var row = "";
                    $('#dtTableBody').html("");
                    for (var i = 0; i <result.length; i++) {
                        row += "<tr>";
                        row += "<td>" + (i + 1) + "</td>";
                        row += "<td>" + un(result[i].CompanyName) + "</td>";
                        row += "<td>" + un(result[i].FinancialYearDesc) + "</td>";
                        row += "<td>" + un(result[i].AccountName) + "</td>";
                        row += "<td>" + un(result[i].Amount) + "</td>";
                        row += "<td>" + un(result[i].CurrencyName) + "</td>";
                        row += "<td>" + un(result[i].Remarks) + "</td>";

                        row += "<td  >" + un(result[i].EntryBy) + "</td>";
                        row += "<td  >" + un(result[i].EntryDate) + "</td>";
                        row += "<td  >" + un(result[i].UpdateBy) + "</td>";
                        row += "<td  >" + un(result[i].UpdateDate) + "</td>";



                        row += "<td><button style='border-style:none;'   onclick='editClick(" + result[i].OpeningBalanceId + ")'><i class='fa fa-pencil' style='color:#00BFFF'></i></button> </td>";
                    }
                    $('#dtTableBody').html(row);
                },
                complete: function () {

                    if ($.fn.dataTable.isDataTable('.jdtDataTable')) {
                        table = $('#dtTb').DataTable({
                            paging: true,
                            retrieve: true,
                            "bInfo": true,
                            "bFilter": true,
                            processing: true,

                            dom: '<"container-fluid"<"row"<"col"l><"col"B><"col"f>>>rtip',


                            lengthChange: true,
                            language: {
                                searchPlaceholder: "Search records",
                                search: ' ',
                                "emptyTable": "No Data Found!"
                            },



                            buttons: [
                                {
                                    extend: 'copyHtml5',
                                    text: '<i class="fa fa-files-o"></i>',
                                    titleAttr: 'Copy', className: 'btn  btn-sm'
                                },
                                {
                                    extend: 'excelHtml5',
                                    text: '<i class="fa fa-file-excel-o"></i>',
                                    titleAttr: 'Excel', className: 'btn  btn-sm'
                                },
                                {
                                    extend: 'csvHtml5',
                                    text: '<i class="fa fa-file-text-o"></i>',
                                    titleAttr: 'CSV', className: 'btn  btn-sm'
                                },
                                {
                                    extend: 'pdfHtml5',
                                    text: '<i class="fa fa-file-pdf-o"></i>',
                                    titleAttr: 'PDF', className: 'btn  btn-sm'
                                }
                            ]
                        });
                    }
                    else {
                        table = $('.jdtDataTable').DataTable({

                            "bInfo": true,
                            "bFilter": true,
                            processing: true,

                            dom: '<"container-fluid"<"row"<"col"l><"col"B><"col"f>>>rtip',


                            lengthChange: true,
                            language: {
                                searchPlaceholder: "Search records",
                                search: ' ',
                                "emptyTable": "No Data Found!"
                            },

                            buttons: [
                                {
                                    extend: 'copyHtml5',
                                    text: '<i class="fa fa-files-o"></i>',
                                    titleAttr: 'Copy', className: 'btn  btn-sm'
                                },
                                {
                                    extend: 'excelHtml5',
                                    text: '<i class="fa fa-file-excel-o"></i>',
                                    titleAttr: 'Excel', className: 'btn  btn-sm'
                                },
                                {
                                    extend: 'csvHtml5',
                                    text: '<i class="fa fa-file-text-o"></i>',
                                    titleAttr: 'CSV', className: 'btn  btn-sm'
                                },
                                {
                                    extend: 'pdfHtml5',
                                    text: '<i class="fa fa-file-pdf-o"></i>',
                                    titleAttr: 'PDF', className: 'btn  btn-sm'
                                }
                            ]
                        });
                    }

                    $('#dtTb_length select').removeClass('form-select form-select-sm');

                    setTimeout(function () {
                        $("#overlay").fadeOut(300);
                    }, 500);
                    //table.buttons().container()
                    //    .appendTo('#dtTb_wrapper .col-md-6:eq(0)');
                }
            });
        }

         function editClick(id) {
             location.href = '@Url.Action("OpningBlncEntry", "OpeningBlnc")?id=' + id + '';
        }
    </script>

}


