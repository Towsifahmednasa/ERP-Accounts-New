        function Load_Reference_Number(elementId) {
            var purchaseOrder = $('#ddlCompany').val() || 0;
            var supplierId = $('#ddlSupplier').val() || 0;

            if (purchaseOrder > 0 && supplierId > 0) {
                $.ajax({
                    url: "/Loan/Load_LC_Reference_Number",
                    contentType: "application/json; charset=utf-8",
                    dataType: 'json',
                    type: "GET",
                    data: { companyId: purchaseOrder, supplierId: supplierId },
                    async: false,
                    success: function (data) {
                        // Clear existing options and add a default option
                        $('#' + elementId).empty();
                        $('#' + elementId).append("<option value='0'>Select from list</option>");

                        // Populate the LCNo dropdown with data from the response
                        for (var i = 0; i < data.length; i++) {
                            $('#' + elementId).append(
                                $("<option></option>")
                                    .val(data[i].LCPreparationId)
                                    .html(data[i].ReferenceNo)
                                    .attr("data-lcdate", data[i].LCDate) // Store LCDate in data attribute
                            );
                        }
                    },
                    error: function () {
                        alert("An error occurred while loading LC reference numbers.");
                    }
                });
            }
        }

        // Attach a change event to ddlLCNo once to update LCOpenDate
            $('#ddlLCNo').on('change', function () {

                $('#lcLink').hide();

            // Retrieve the LCDate from the selected option


            var selectedDate = $(this).find('option:selected').data('lcdate');

            // Set the LCOpenDate input field with the selected LCDate
            $('#LCOpenDate').val(selectedDate || ''); // Show selected date or clear if none


            var selectedValue = $(this).val(); // Get the selected value
            var selectedText = $(this).find("option:selected").text(); // Get the selected text

            if (selectedValue == "0") {
                // Hide the link and reset the width of the dropdown
                $('#lcLink').hide();
              /*  $(this).css('width', '70%');*/
               /* $(this).next('.select2-container').css('width', '70%');*/
            } else {
                // Adjust the width of the dropdown to 80%
                //$(this).css('width', '50%');
                //$(this).next('.select2-container').css('width', '50%');

                // Get the last 3 characters of the selected text
                var lastThreeChars = selectedText.slice(-3).trim();

                // Create a dynamic link based on the selected value/text
                var hrefLink = 'https://example.com/lc-reference/' + selectedValue;

                // Set the new href link in the anchor element
                $('#lcLink').attr('href', hrefLink);

                // Update the link text to show the last 3 characters
                $('#lcLink').text('# ' + lastThreeChars);

                // Add tooltip (full selected text) to the link
                $('#lcLink')
                    .attr('data-bs-toggle', 'modal') // Add Bootstrap modal toggle
                    .attr('data-bs-target', '#poLargeModal') // Target the modal by ID
                    .attr('data-id', selectedValue) // Set data-id with selectedValue
                    .attr('style', 'text-decoration: underline; cursor: pointer; white-space: nowrap; color: #03560F; font-weight: bold; margin-left: 10px;') // Styling for the link
                    .addClass('pipopupLink') // Add CSS classes dynamically
                    .text('View Details') // Set the link text to "View Details"
                    .attr('title', selectedText) // Add tooltip with full selected text
                    .show(); // Show the link

                // Show the link
                $('#lcLink').show();

            }
            });



