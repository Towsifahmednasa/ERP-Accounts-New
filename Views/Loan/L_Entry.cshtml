@* Ported from Accounts\CSTL_Pro_to_Pay\Views\Loan\L_Entry.cshtml - page markup and inline scripts unchanged; presentation comes from the Fiori shell/stylesheet. *@

@{
    ViewBag.Title = "Loan Info Entry";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<style>
    .font-weight-bold {
        font-weight: bold;
    }

    .error-message {
        font-size: 0.875rem; /* Small font for error message */

        color: red; /* Red color for error message */
    }
</style>
<div id="popDiv"></div>
<div class="page-wrapper">
    <div class="page-content">
        <div class="row">
            <div class="col">
                <div class="card border-top border-0 border-4 border-dark mt-3" style="margin-top: 3px !important">
                    <div class="card-body" style="border-style: none !important;">
                        <div class="border p-2 rounded">

                            <div class="page-breadcrumb d-none d-sm-flex align-items-center headerBorderBottom">
                                <div class="breadcrumb-title pe-3">
                                    <div class="card-title d-flex align-items-center">
                                        <div>
                                            <i class="bx bxs-right-arrow-square me-1 font-22 text-inverse"></i>
                                        </div>

                                        <h5 class="mb-0 text-dark cstlfs">Loan Info Entry</h5>
                                    </div>
                                </div>

                                <div class="ms-auto">
                                    <div class="btn-group">

                                        <a class="small blue button" href="@Url.Action("L_List", "Loan")">
                                            <span class="fa fa-share"></span>  Back to List
                                        </a>
                                    </div>
                                </div>
                            </div>
                            <div class="row" style="margin-top:10px">
                                <!-- Column 1 -->
                                <div class="col-md-4">

                                </div>
                                <div class="col-md-4">
                                    <!-- Business Unit -->
                                    <div class="form-group">
                                        <div class="row">
                                            <div class="col-md-4">
                                                <label for="ddlCompany" class="font-weight-bold col-form-label">Business Unit: <span class="required" style="color: red;"> *</span></label>
                                            </div>
                                            <div class="col-md-8">
                                                <select class="form-select form-select-sm select2" id="ddlCompany" style="width: 100%;"></select>
                                                <div id="divCompany" class="error-message" style="display: none;"></div>
                                            </div>
                                        </div>
                                    </div>


                                    <!-- Profit Center -->
                                    <div class="form-group">
                                        <div class="row">
                                            <div class="col-md-4">
                                                <label for="ddlProfitCenter" class="font-weight-bold col-form-label">Profit Center: <span style="color: red;">*</span></label>
                                            </div>
                                            <div class="col-md-8">
                                                <select class="form-select form-select-sm select2" id="ddlProfitCenter" style="width: 100%;"></select>
                                                <div id="divProfitCenter" class="error-message" style="display: none;"></div>
                                            </div>
                                        </div>
                                    </div>

                                    <!-- Supplier Type -->
                                    <div class="form-group">
                                        <div class="row">
                                            <div class="col-md-4">
                                                <label for="ddlSupplierType" class="font-weight-bold col-form-label">Supplier Type: <span style="color: red;">*</span></label>
                                            </div>
                                            <div class="col-md-8">
                                                <select class="form-select form-select-sm select2" onchange="LoadTypewiseSupplier(0)" id="ddlSupplierType" style="width: 100%;"></select>
                                                <div id="divSupplierType" class="error-message" style="display: none;"></div>
                                            </div>
                                        </div>
                                    </div>

                                    <!-- Supplier -->
                                    <div class="form-group">
                                        <div class="row">
                                            <div class="col-md-4">
                                                <label for="ddlSupplier" class="font-weight-bold col-form-label">Supplier: <span style="color: red;">*</span></label>
                                            </div>
                                            <div class="col-md-8">
                                                <select class="form-select form-select-sm select2" id="ddlSupplier" style="width: 100%;"></select>
                                                <div id="divSupplier" class="error-message" style="display: none;"></div>
                                            </div>
                                        </div>
                                    </div>

                                    <!-- LC No -->
                                    <div class="form-group">
                                        <div class="row">
                                            <div class="col-md-4">
                                                <label for="ddlLCNo" class="font-weight-bold col-form-label">LC No: <span style="color: red;">*</span></label>
                                            </div>
                                            <div class="col-md-8">
                                                <select class="form-select form-select-sm select2" onchange="GetCINoByLCNo(0)" id="ddlLCNo" style="width: 100%;"></select>
                                                <div id="divLCNo" class="error-message" style="display: none;"></div>
                                                <a href="#" class="" style="display: none; margin-left: 10px;" id="lcLink" target="_blank">#</a>
                                            </div>
                                        </div>
                                    </div>

                                    <!-- CI No -->
                                    <div class="form-group">
                                        <div class="row">
                                            <div class="col-md-4">
                                                <label for="ddlCINo" class="font-weight-bold col-form-label">CI No:</label>
                                            </div>
                                            <div class="col-md-8">
                                                <select class="form-select form-select-sm select2" id="ddlCINo" style="width: 100%;"></select>
                                            </div>
                                        </div>
                                    </div>

                                    <!-- LC Open Date -->
                                    <div class="form-group">
                                        <div class="row">
                                            <div class="col-md-4">
                                                <label for="LCOpenDate" class="font-weight-bold col-form-label">LC Open Date:</label>
                                            </div>
                                            <div class="col-md-8">
                                                <input type="text" class="form-control form-control-sm" readonly id="LCOpenDate" style="width: 100%;" />
                                            </div>
                                        </div>
                                    </div>


                                </div>

                            </div>




                            <div class="row" style="margin-top:10px;padding:10px">
                                <div class="form-group mb-2">
                                    <div class="row">
                                        <div class="col-md-12">
                                            <h5 style="font-size: 1.125em; margin: 0 !important; margin-left: 0% !important; padding: 10px !important; color: #5b42f3 !important;"> <i class="fa fa-cube" aria-hidden="true"></i> Loan Information </h5>
                                            <hr style="margin: 0 !important;" />
                                        </div>

                                    </div>
                                </div>

                                <!-- Column 1 -->
                                <div class="col-md-4">
                                    <!-- Loan Issuing Bank -->
                                    <div class="form-group">
                                        <div class="row">
                                            <div class="col-md-4">
                                                <label for="ddlLCIssuingBank" class="font-weight-bold col-form-label">Loan Issuing Bank:  <span style="color: red;">*</span></label>
                                            </div>
                                            <div class="col-md-8">
                                                <select class="form-select form-select-sm select2" onchange="LoadBankWiseBranch(0)" id="ddlLCIssuingBank" style="width: 100%;"></select>
                                                <div id="divLCIssuingBank" class="error-message" style="display: none;"></div>
                                            </div>
                                        </div>
                                    </div>

                                    <!-- Loan Issuing Branch -->
                                    <div class="form-group">
                                        <div class="row">
                                            <div class="col-md-4">
                                                <label for="ddlBranch" class="font-weight-bold col-form-label">Loan Issuing Branch:  <span style="color: red;">*</span></label>
                                            </div>
                                            <div class="col-md-8">
                                                <select class="form-select form-select-sm select2" id="ddlBranch" style="width: 100%;"></select>
                                                <div id="divBranch" class="error-message" style="display: none;"></div>
                                            </div>
                                        </div>
                                    </div>

                                    <!-- Currency -->
                                    <div class="form-group">
                                        <div class="row">
                                            <div class="col-md-4">
                                                <label for="ddlCurrency" class="font-weight-bold col-form-label">Currency:  <span style="color: red;">*</span></label>
                                            </div>
                                            <div class="col-md-8">
                                                <select class="form-select form-select-sm select2" id="ddlCurrency" style="width: 100%;"></select>
                                                <div id="divCurrency" class="error-message" style="display: none;"></div>
                                            </div>
                                        </div>
                                    </div>

                                    <!-- Conversion Rate -->
                                    <div class="form-group">
                                        <div class="row">
                                            <div class="col-md-4">
                                                <label for="ConversionRate" class="font-weight-bold col-form-label">Conversion Rate:  <span style="color: red;">*</span></label>
                                            </div>
                                            <div class="col-md-8">
                                                <input type="number" step="0.01" id="ConversionRate" class="form-control form-control-sm" style="width: 100%;" />
                                                <div id="divConversionRate" class="error-message" style="display: none;"></div>
                                            </div>
                                        </div>
                                    </div>

                                    <!-- Loan No -->
                                    <div class="form-group">
                                        <div class="row">
                                            <div class="col-md-4">
                                                <label for="LoanNo" class="font-weight-bold col-form-label">Loan No:  <span style="color: red;">*</span></label>
                                            </div>
                                            <div class="col-md-8">
                                                <input type="text" id="LoanNo" class="form-control form-control-sm" style="width: 100%;" />

                                                <div id="divLoanNo" class="error-message" style="display: none;"></div>
                                            </div>
                                        </div>
                                    </div>

                                    <!-- Loan Tenor (Days) -->
                                    <div class="form-group">
                                        <div class="row">
                                            <div class="col-md-4">
                                                <label for="LoanTenorDays" class="font-weight-bold col-form-label">Loan Tenor (Days):  <span style="color: red;">*</span></label>
                                            </div>
                                            <div class="col-md-8">
                                                <input type="number" id="LoanTenorDays" class="form-control form-control-sm" style="width: 100%;" />

                                                <div id="divLoanTenorDays" class="error-message" style="display: none;"></div>
                                            </div>
                                        </div>
                                    </div>

                                    <!-- Loan Category -->
                                    <div class="form-group">
                                        <div class="row">
                                            <div class="col-md-4">
                                                <label for="ddlLoanCategory" class="font-weight-bold col-form-label">Loan Type:  <span style="color: red;">*</span></label>
                                            </div>
                                            <div class="col-md-8">
                                                <select class="form-select form-select-sm select2" id="ddlLoanCategory" style="width: 100%;"></select>
                                                <div id="divLoanCategory" class="error-message" style="display: none;"></div>
                                            </div>
                                        </div>
                                    </div>

                                    <!-- Loan Create Date -->
                                    <div class="form-group">
                                        <div class="row">
                                            <div class="col-md-4">
                                                <label for="LoanCreateDate" class="font-weight-bold col-form-label">Loan Create Date:  <span style="color: red;">*</span></label>
                                            </div>
                                            <div class="col-md-8">
                                                <input type="date" id="LoanCreateDate" class="form-control form-control-sm" style="width: 100%;" />
                                                <div id="divLoanCreateDate" class="error-message" style="display: none;"></div>
                                            </div>
                                        </div>
                                    </div>

                                    <!-- Loan Effective Date -->
                                    <div class="form-group">
                                        <div class="row">
                                            <div class="col-md-4">
                                                <label for="LoanEffectiveDate" class="font-weight-bold col-form-label">Loan Effective Date:  <span style="color: red;">*</span></label>
                                            </div>
                                            <div class="col-md-8">
                                                <input type="date" id="LoanEffectiveDate" class="form-control form-control-sm" style="width: 100%;" />

                                                <div id="divLoanEffectiveDate" class="error-message" style="display: none;"></div>
                                            </div>
                                        </div>
                                    </div>


                                </div>


                                <!-- Column 2 -->
                                <div class="col-md-4">

                                    <!-- Loan Create Date -->
                                    <!-- Loan Amount -->
                                    <div class="form-group">
                                        <div class="row">
                                            <div class="col-md-4">
                                                <label for="LoanAmount" class="font-weight-bold col-form-label">Loan Amount:  <span style="color: red;">*</span></label>
                                            </div>
                                            <div class="col-md-8">
                                                <input type="number" step="0.01" id="LoanAmount" class="form-control form-control-sm" style="width: 100%;" />

                                                <div id="divLoanAmount" class="error-message" style="display: none;"></div>
                                            </div>
                                        </div>
                                    </div>

                                    <!-- Grace Period (Days) -->
                                    <div class="form-group">
                                        <div class="row">
                                            <div class="col-md-4">
                                                <label for="GracePeriodDays" class="font-weight-bold col-form-label">Grace Period (Days): <span style="color: red;">*</span></label>
                                            </div>
                                            <div class="col-md-8">
                                                <input type="number" id="GracePeriodDays" class="form-control form-control-sm" style="width: 100%;" />
                                                <div id="divGracePeriodDays" class="error-message" style="display: none;"></div>
                                            </div>
                                        </div>
                                    </div>

                                    <!-- Advanced Interest Payment (Checkbox) -->
                                    <div class="form-group">
                                        <div class="row">
                                            <div class="col-md-4">
                                                <label class="font-weight-bold col-form-label" style="width: 40%;"></label>
                                            </div>
                                            <div class="col-md-8">
                                                <div class="form-check">
                                                    <input type="checkbox" id="AdvancedInterestPayment" class="form-check-input me-2" />
                                                    <label for="AdvancedInterestPayment" class="form-check-label font-weight-bold">Advanced Interest Payment?</label>
                                                </div>
                                            </div>
                                        </div>
                                    </div>

                                    <!-- Interest Type -->
                                    <div class="form-group">
                                        <div class="row">
                                            <div class="col-md-4">
                                                <label for="ddlInterestType" class="font-weight-bold col-form-label">Interest Type:  <span style="color: red;">*</span></label>
                                            </div>
                                            <div class="col-md-8">
                                                <select class="form-select form-select-sm select2" id="ddlInterestType" style="width: 100%;"></select>
                                                <div id="divInterestType" class="error-message" style="display: none;"></div>
                                            </div>
                                        </div>
                                    </div>

                                    <!-- Interest Method -->
                                    <div class="form-group">
                                        <div class="row">
                                            <div class="col-md-4">
                                                <label for="ddlInterestMethod" class="font-weight-bold col-form-label">Interest Method:  <span style="color: red;">*</span></label>
                                            </div>
                                            <div class="col-md-8">
                                                <select class="form-select form-select-sm select2" id="ddlInterestMethod" style="width: 100%;"></select>
                                                <div id="divInterestMethod" class="error-message" style="display: none;"></div>
                                            </div>
                                        </div>
                                    </div>

                                    <!-- Installment No -->
                                    <div class="form-group">
                                        <div class="row">
                                            <div class="col-md-4">
                                                <label for="InstallmentNo" class="font-weight-bold col-form-label">Installment No:  <span style="color: red;">*</span></label>
                                            </div>
                                            <div class="col-md-8">
                                                <input type="number" id="InstallmentNo" class="form-control form-control-sm" style="width: 100%;" />
                                            </div>
                                        </div>
                                    </div>

                                    <!-- Funded (Checkbox) -->
                                    <div class="form-group">
                                        <div class="row">
                                            <div class="col-md-4">
                                                <label class="font-weight-bold col-form-label" style="width: 40%;"></label>
                                            </div>
                                            <div class="col-md-8">
                                                <div class="form-check">
                                                    <input type="checkbox" id="Funded" class="form-check-input me-2" />
                                                    <label for="Funded" class="form-check-label font-weight-bold">Funded</label>
                                                </div>
                                            </div>
                                        </div>
                                    </div>

                                    <!-- Loan Agreement (Checkbox) -->
                                    <div class="form-group">
                                        <div class="row">
                                            <div class="col-md-4">
                                                <label class="font-weight-bold col-form-label" style="width: 40%;"></label>
                                            </div>
                                            <div class="col-md-8">
                                                <div class="form-check">
                                                    <input type="checkbox" id="LoanAgreement" class="form-check-input me-2" />
                                                    <label for="LoanAgreement" class="form-check-label font-weight-bold">Loan Agreement?</label>
                                                </div>
                                            </div>
                                        </div>
                                    </div>

                                </div>

                                <!-- Column 3 -->
                                <div class="col-md-4">
                                    <!-- Interest and Agreement Information -->



                                    <div class="form-group d-flex align-items-center mb-3">
                                        <label asp-for="ReimbursementBank" class="font-weight-bold me-2" style="width: 40%;">Reimbursement Bank:</label>
                                        <select class="form-select form-select-sm select2" style="width: 60%;" id="ddlReimbursementBank"></select>
                                    </div>

                                    <!-- Margin Adjusted -->
                                    <div class="form-group d-flex align-items-center mb-3">
                                        <label asp-for="MarginAdjusted" class="font-weight-bold me-2" style="width: 40%;">Margin Adjusted:</label>
                                        <input asp-for="MarginAdjusted" id="MarginAdjusted" class="form-control form-control-sm" type="number" step="0.01" style="width: 60%;" />
                                    </div>

                                    <!-- Interest Rate -->
                                    <div class="form-group d-flex align-items-center mb-3">
                                        <label asp-for="InterestRate" class="font-weight-bold me-2" style="width: 40%;">Interest Rate:</label>
                                        <input asp-for="InterestRate" id="InterestRate" class="form-control form-control-sm" type="number" step="0.01" style="width: 60%;" />
                                    </div>

                                    <!-- Loan Purpose -->
                                    <div class="form-group d-flex align-items-center mb-3">
                                        <label asp-for="LoanPurpose" class="font-weight-bold me-2" style="width: 40%;">Loan Purpose:  <span style="color: red;">*</span></label>
                                        <textarea asp-for="LoanPurpose" id="LoanPurpose" class="form-control form-control-sm" style="width: 60%;"></textarea>

                                    </div>

                                    <div class="form-group d-flex align-items-center mb-3" id="ddivLoanPurpose" style="display: none;">
                                        <label asp-for="divLoanPurpose" class="font-weight-bold me-2" style="width: 40%;">  </label>

                                        <div id="divLoanPurpose" class="error-message" style="width: 60%;display: none;"></div>
                                    </div>

                                    <!-- Interest Amount -->
                                    <div class="form-group d-flex align-items-center mb-3">
                                        <label asp-for="InterestAmount" class="font-weight-bold me-2" style="width: 40%;">Interest Amount:</label>
                                        <input asp-for="InterestAmount" id="InterestAmount" class="form-control form-control-sm" type="number" step="0.01" style="width: 60%;" />
                                    </div>

                                    <!-- Total Charge Amount -->
                                    <div class="form-group d-flex align-items-center mb-3">
                                        <label asp-for="TotalChargeAmount" class="font-weight-bold me-2" style="width: 40%;">Total Charge Amount:</label>
                                        <input asp-for="TotalChargeAmount" id="TotalChargeAmount" class="form-control form-control-sm" type="number" step="0.01" style="width: 60%;" />
                                    </div>

                                    <!-- Total Expense -->
                                    <div class="form-group d-flex align-items-center mb-3">
                                        <label asp-for="TotalExpense" class="font-weight-bold me-2" style="width: 40%;">Total Expense:</label>
                                        <input asp-for="TotalExpense" id="TotalExpense" class="form-control form-control-sm" type="number" step="0.01" style="width: 60%;" />
                                    </div>

                                    <!-- Total Payable Amount -->
                                    <div class="form-group d-flex align-items-center mb-3">
                                        <label asp-for="TotalPayableAmount" class="font-weight-bold me-2" style="width: 40%;">Total Payable Amount:</label>
                                        <input asp-for="TotalPayableAmount" id="TotalPayableAmount" class="form-control form-control-sm" type="number" step="0.01" style="width: 60%;" />
                                    </div>
                                </div>
                            </div>
                            <div class="row">
                                <div style="padding-top: 1.5%">
                                    <div class="wrapper">
                                        <div class="row">
                                            <div class="col-md-5" style="margin: 0 44.5% !important;">
                                                <div class="form-group">
                                                    <button class="small blue button" id="btnSave" onclick="Save()">   Submit</button>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>


<div class="modal fade" id="poLargeModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-xl" style="max-width: 1460px !important;">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title"> LC Report </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">

                <div class="row" id="repotDiv">

                    <div class="col-md-12">


                        <div class="row mt-2 mb-2">


                            <table class="table table-bordered table-striped" style=" width: 97% !important; margin: auto !important;">
                                <tr>
                                    <th colspan="8">
                                        <span style="color: #5b42f3 !important; font-size: 18px !important; text-align: left !important"> 01) LC (Letter of Credit) Info </span>
                                    </th>
                                </tr>
                                <tr>
                                    <td colspan="8">&nbsp;</td>
                                </tr>
                                <tr>
                                    <td style="width: 15%; font-weight: bold !important; text-align: right !important;"> LC No: </td>
                                    <td style="width: 18%;"> <label id="lblLCNo_p"> &nbsp; </label> </td>



                                    <td style="width: 15%; font-weight: bold !important; text-align: right !important;"> Central Bank Ref: </td>
                                    <td style="width: 18%;"><label id="lblCentralBankRefNo_p"> &nbsp; </label> </td>

                                    <td style="width: 15%; font-weight: bold !important; text-align: right !important;"> Currency: </td>
                                    <td style="width: 18%;"> <label id="lblCurrency_p"> &nbsp; </label> </td>
                                </tr>
                                <!-- Adding new fields with labels -->
                                <tr>
                                    <td style="width: 15%; font-weight: bold !important; text-align: right !important;"> LC Preparation Date: </td>
                                    <td style="width: 18%;"><label id="lblLCDate_p"> &nbsp; </label> </td>

                                    <td style="width: 15%; font-weight: bold !important; text-align: right !important;"> LC Expiry Date: </td>
                                    <td style="width: 18%;"><label id="lblLCExpiryDate_p"> &nbsp; </label> </td>

                                    <td style="width: 15%; font-weight: bold !important; text-align: right !important;"> Reference No: </td>
                                    <td style="width: 18%;"><label id="lblReferenceNo_p"> &nbsp; </label> </td>
                                </tr>

                                <tr>
                                    <td style="width: 15%; font-weight: bold !important; text-align: right !important;"> Initiate Date: </td>
                                    <td style="width: 18%;"><label id="lblLcInitiate_p"> &nbsp; </label> </td>

                                    <td style="width: 15%; font-weight: bold !important; text-align: right !important;"> Request Date: </td>
                                    <td style="width: 18%;"><label id="lblLcRequestDate_p"> &nbsp; </label> </td>

                                    <td style="width: 15%; font-weight: bold !important; text-align: right !important;"> Application Date: </td>
                                    <td style="width: 18%;"><label id="lblLcApplicationDate_p"> &nbsp; </label> </td>
                                </tr>

                                <tr>
                                    <td style="width: 15%; font-weight: bold !important; text-align: right !important;"> Last Shipment Date: </td>
                                    <td style="width: 18%;"><label id="lblLastShipmentDate_p"> &nbsp; </label> </td>

                                    <td style="width: 15%; font-weight: bold !important; text-align: right !important;"> E.T.D Date: </td>
                                    <td style="width: 18%;"><label id="lblETDDate_p"> &nbsp; </label> </td>

                                    <td style="width: 15%; font-weight: bold !important; text-align: right !important;"> Tenor: </td>
                                    <td style="width: 18%;"><label id="lblTenor_p"> &nbsp; </label> </td>
                                </tr>

                                <tr>
