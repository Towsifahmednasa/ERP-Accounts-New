                    }
                },
                complete: function () {
                    $("#btnSave").html("Update");
                    //$('#territorySelect').attr('disabled', true);
                }
            });
        }*@




    function GetData(id) {
            var urlpath = '@Url.Action("GetSubsidairyType_ById", "Ref_Sub_Type")';
            $.ajax({
                url: urlpath,
                dataType: 'json',
                data: { id: id },
                type: "Get",
                async: true,
                success: function (data) {


                    $("#btnSave").html("Update");

                    $('#txtReferenceType').val(data.SubsidiaryType);
                  
                    if (data.IsActive) {
                        $('#customSwitch1').prop('checked', true);
                    } else {
                        $('#customSwitch1').prop('checked', false);
                    }


                }
              
            });
        }

    </script>

}


