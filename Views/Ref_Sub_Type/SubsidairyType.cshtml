            var urlpath = '@Url.Action("GetSubsidairyType_ById", "Ref_Sub_Type")';
            $.ajax({
                url: urlpath,
                dataType: 'json',
                data: {id : id},
                type: "Get",
                async: true,
                success: function (data) {
                    var result = JSON.parse(data);

                    $('#ReferenceType').val(result.SubsidiryLName);
                    if (result[0].IsActive) {
                        $('#customSwitch1').prop('checked', true);
                    } else {
