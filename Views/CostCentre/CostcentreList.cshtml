         function editClick(id) {
             location.href = '@Url.Action("CostcentreInformation", "CostCentre")?id=' + id + '';
        }




function delClick(id) {
    swal({
        title: "Are you sure?",
        text: "You will not be able to recover this record!",
        type: "warning",
        showCancelButton: true,
        cancelButtonText: 'No, cancel!',
        cancelButtonColor: '#FF0000',
        confirmButtonColor: '#3498DB',
        confirmButtonText: 'Yes, delete it!',
        closeOnConfirm: false,
        closeOnCancel: false
    },
    function (isConfirm) {
        if (isConfirm) {
            $.ajax({
                url: "/CostCentre/Del_CostCenter_Info_By_Id",
                dataType: 'json',
                data: { id: id },
                type: "POST",
                async: true
            }).done(function (result) {
                setTimeout(function () {
                    $("#overlay").fadeOut(300);
                }, 500);

                if (result.msg != "") {
                    swal({
                        title: "Deleted Successfully!",
                        text: '',
                        type: "success",
                        showCancelButton: false,
                        cancelButtonClass: 'btn-danger waves-effect waves-light',
                        confirmButtonClass: 'btn-primary waves-effect waves-light',
                        confirmButtonText: 'Yes!',
                        closeOnConfirm: false
                    }, function () {
                        window.location.href = '@Url.Action("CostcentreList", "CostCentre")';
                    });
                } else {
                    Swal.fire({
                        icon: 'error',
                        title: 'Oops...',
                        text: 'Something went wrong!',
                    });
                }
            }).fail(function () {
                Swal.fire({
                    icon: 'error',
                    title: 'Oops...',
                    text: 'Something went wrong!',
                });
            });
        } else {
            swal("Cancelled", "Your record is safe :)", "error");
        }
    });
}
