        function un(o) {
            return o != null ? o : '';
        }



        function formatJsonDate(jsonDate) {
            if (!jsonDate) {
                return "N/A";
            }

            // Manually parse the date from the format "MM/DD/YYYY hh:mm:ss AM/PM"
            var dateParts = jsonDate.split(' ');
            var datePart = dateParts[0].split('/');
            var timePart = dateParts[1].split(':');
            var ampm = dateParts[2];

            var month = parseInt(datePart[0]) - 1; // Months are zero-based in JavaScript
            var day = parseInt(datePart[1]);
            var year = parseInt(datePart[2]);

            var hours = parseInt(timePart[0]);
            var minutes = parseInt(timePart[1]);

            // Handle AM/PM format
            if (ampm === 'PM' && hours < 12) {
                hours += 12;
            } else if (ampm === 'AM' && hours === 12) {
                hours = 0;
            }

            var date = new Date(year, month, day, hours, minutes);

            // Check if the date is valid
            if (isNaN(date.getTime())) {
                return "Invalid Date";
            }

            // Get the month name
            var monthNames = ["Jan", "Feb", "Mar", "Apr", "May", "Jun",
                "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"];
            var monthName = monthNames[month];

            // Format the date string
            var formattedDate = `${monthName} ${day}, ${year} ${hours % 12 || 12}:${minutes < 10 ? '0' + minutes : minutes} ${ampm}`;

            return formattedDate;
        }




         function Get_Reference() {
            var urlpath = '@Url.Action("Get_CostCentre_R", "CostCentre")';
            $.ajax({
                url: urlpath,
                dataType: 'json',
                type: "Get",
                async: false,
                beforeSend: function () {

                    $("#overlay").fadeIn(300);


                },
                success: function (data) {
                    $('#tabH').show();
                    var result = JSON.parse(data);
                    console.log(result);
                    var row = "";
                    $('#dtTableBody').html("");
                    for (var i = 0; i <result.length; i++) {
                        row += "<tr>";
                        row += "<td>" + (i + 1) + "</td>";
                        row += "<td>" + un(result[i].CompanyName) + "</td>";
                        row += "<td>" + un(result[i].Description) + "</td>";
                        row += "<td>" + un(result[i].CostCenterStartDate) + "</td>";
                        if (result[i].IsActive == true) {
                            row += "<td><span class='badge bg-success'>Active</span></td>";
                        } else {
