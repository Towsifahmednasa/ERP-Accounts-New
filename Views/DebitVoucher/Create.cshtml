@* Ported from Accounts\CSTL_Pro_to_Pay\Views\DebitVoucher\Create.cshtml - page markup and inline scripts unchanged; presentation comes from the Fiori shell/stylesheet. *@
@using New_Accounts.Utility
@{
    ViewBag.Title = "Debit/Payment Voucher";
    Layout = "~/Views/Shared/_Layout.cshtml";
    var flag = @ViewBag.eflag;
}

 

<div class="page-wrapper" >
    <div class="page-content">
        <div class="row">
            <div class="col">
                <div class="card border-top border-0 border-4 border-dark mt-3" style="margin-top: 3px !important">
                    <div class="card-body" style="border-style: none !important;">
                        <div class="border p-2 rounded">

                            <div class="page-breadcrumb d-none d-sm-flex align-items-center">
                                <div class="breadcrumb-title pe-3">
                                    <div class="card-title d-flex align-items-center">
                                        <div>
                                            <i class="bx bxs-right-arrow-square me-1 font-22 text-inverse"></i>
                                        </div>
                                        <h5 class="mb-0 text-dark cstlfs">
                                            <a href="@Url.Action("Create", "DebitVoucher", new {id = 0})">
                                                <h3 class="card-title">
                                                    @if (ViewBag.VoucherId == 0)
                                                    {
                                                        <span class=""> New Debit/Payment Voucher</span>

                                                    }
                                                    else if (ViewBag.eflag == "ap")
                                                    {
                                                        <span class=""> Approve Debit/Payment Voucher</span>
                                                        <span id="txtRequisition"></span>
                                                    }
                                                    else
                                                    {
                                                        <span class=""> Edit Debit/Payment Voucher</span>
                                                    }
                                                </h3>
                                            </a>
                                        </h5>
                                    </div>
                                </div>

                                <div class="ms-auto">
                                    <div class="btn-group">

                                        @if (ViewBag.eflag == "ed")
                                        {
                                            <a class="btn btn-outline-warning" href="@Url.Action("Index", "DebitVoucher")">
                                                <span class="fa fa-list"></span> Go To Debit/Payment Voucher List

                                            </a>
                                        }
                                        else
                                        {
                                            <a class="btn btn-outline-warning" href="@Url.Action("DebitVoucherApproval", "DebitVoucher")">
                                                <span class="fa fa-list"></span> Pending Debit/Payment Voucher List
                                            </a>
                                        }

                                    </div>
                                </div>
                            </div>


                            <!-- /.card-header -->
                            <!-- form start -->

                            <div class="row">
                                <div class="col-md-3">
                                    <div class="form-group" id="divCompany">
                                        <label for="ddlCompany">Company</label>
                                        <select class="form-select form-select-sm mb-3 select2" style="width: 100%;" id="ddlCompany" onchange="LoadBusinessUnit()"></select>
                                    </div>
                                </div>
                                <div class="col-md-3">
                                    <div class="form-group" id="divBusinessUnit">
                                        <label for="ddlBusinessUnit">Business Unit</label>
                                        <select class="form-select form-select-sm mb-3 select2" style="width: 100%;" id="ddlBusinessUnit"></select>
                                    </div>
                                </div>
                                <div class="col-md-3">
                                    <div class="form-group" id="divFiscalYear">
                                        <label for="ddlFiscalYear">Fiscal Year</label>
                                        <select class="form-select form-select-sm mb-3 select2" style="width: 100%;" id="ddlFiscalYear"></select>
                                    </div>
                                </div>
                                <div class="col-md-3">
                                    <div class="form-group" id="divVoucherDate">
                                        <label for="txtVoucherDate">Voucher Date</label>
                                        <input type="text" id="txtVoucherDate" class="form-control datepicker" value="@DateTime.Now.ToString("dd-MMM-yyyy")" />
                                    </div>
                                </div>

                            </div>
                            <div class="row">
                                <div class="col-md-3">
                                    <div class="form-group" id="divCurrency">
                                        <label for="ddlCurrency">Currency</label>
                                        <select class="form-select form-select-sm mb-3 select2" style="width: 100%;" id="ddlCurrency"></select>
                                    </div>
                                </div>
                                <div class="col-md-3">
                                    <div class="form-group" id="divCurrencyRate">
                                        <label for="txtCurrencyRate">Currency Rate</label>
                                        <input type="text" id="txtCurrencyRate" class="form-control form-control-sm" value="1" />
                                    </div>
                                </div>
                                <div class="col-md-3">
                                    <label for="cashRadio">Payment Type</label>
                                    <div class="form-group clearfix">
                                        <div class="icheck-success d-inline col-md-6">
                                            <input type="radio" id="bankRadio" name="paymentType" value="1" checked="" onchange="BankWishEffect()">
                                            <label for="bankRadio">Bank</label>
                                        </div>
                                        <div class="icheck-success d-inline col-md-6">
                                            <input type="radio" id="cashRadio" name="paymentType" value="2" onchange="CashWishEffect()">
                                            <label for="cashRadio">Cash</label>
                                        </div>
                                    </div>
                                </div>
                                <div class="col-md-3">
                                    <div class="form-group" id="divFromAccount">
                                        <label for="ddlFromAccount">From Account <span style="color: #8b0000;font-weight: bold" id="ClosingBalance"></span></label>
                                        <select class="form-select form-select-sm mb-3 select2" style="width: 100%;" id="ddlFromAccount" onchange="LoadBankBranchInfo()"></select>
                                    </div>
                                </div>


                            </div>
                            <div class="row">
                                <div class="col-md-3">
                                    <div class="form-group" id="divBank">
                                        <label for="ddlBank">Bank</label>
                                        <select id="ddlBank" class="form-select form-select-sm mb-3 select2"></select>
                                    </div>
                                </div>
                                <div class="col-md-3">
                                    <div class="form-group" id="divBranch">
                                        <label for="ddlBranch">Branch</label>
                                        <select id="ddlBranch" class="form-select form-select-sm mb-3 select2"></select>
                                    </div>
                                </div>
                                <div class="col-md-3">
                                    <div class="form-group" id="divChequeNo">
                                        <label for="txtChequeNo">Cheque No</label>
                                        <input type="text" id="txtChequeNo" value="" class="form-control form-control-sm" autocomplete="off" />
                                    </div>
                                </div>
                                <div class="col-md-3">
                                    <div class="form-group" id="divChequeDate">
                                        <label for="txtChequeDate">Cheque Date</label>
                                        <input type="text" id="txtChequeDate" value="" class="form-control form-control-sm" autocomplete="off" />
                                    </div>
                                </div>
                            </div>
                            <div class="row">
                                <div class="col-md-3">
                                    <div class="form-group" id="divRefNo">
                                        <label for="txtRefNo">Reference No</label>
                                        <input type="text" id="txtRefNo" value="" class="form-control form-control-sm" autocomplete="off" />
                                    </div>
                                </div>
                                <div class="col-md-3">
                                    <div class="form-group" id="divRefDate">
                                        <label for="txtRefDate">Reference Date</label>
                                        <input type="text" id="txtRefDate" value="" class="form-control form-control-sm" autocomplete="off" />
                                    </div>
                                </div>
                                <div class="col-md-2">
                                    <div class="form-group" id="divPaymentAmount">
                                        <label for="txtPaymentAmount">Payment Amount</label>
                                        <input type="number" id="txtPaymentAmount" value="" class="form-control" readonly="readonly" />
                                        <input type="hidden" id="txtPaymentAmounthidden" value="" class="form-control form-control-sm" />
                                    </div>
                                </div>
                                <div class="col-md-2">
                                    <div class="form-group" id="divDiscount">
                                        <label for="txtDiscount">Discount</label>
                                        <input type="number" id="txtDiscount" value="" class="form-control form-control-sm" onkeyup="PaymentValue()" />
                                        <input type="hidden" id="txtDiscounthidden" value="" class="form-control" />
                                    </div>
                                </div>
                                <div class="col-md-2">
                                    <div class="form-group" id="divTax">
                                        <label for="txtTax">Tax</label>
                                        <input type="number" id="txtTax" value="" class="form-control form-control-sm" onkeyup="PaymentValue()" />
                                        <input type="hidden" id="txtTaxhidden" value="" class="form-control form-control-sm" />
                                    </div>
                                </div>

                            </div>

                            <div class="row table-responsive" style="padding-top:10px">
                                <div class="col-md-12">
                                    <div class="card-body">
                                        <table class="table table-bordered table-striped table-hover" id="debitVoucher">
                                            <thead>
                                                <tr>
                                                    @*<th>#</th>*@
                                                    <th style="width: 320px">GL Code</th>
                                                    @*<th>GL Description</th>*@
                                                    <th style="width: 180px">Cost Center</th>
                                                    @*<th>Ref Type</th>*@
                                                    <th style="width: 320px">Ref No</th>
                                                    <th style="width: 100px">Amount</th>
                                                    <th>Remarks</th>
                                                    <th class="action">Action</th>
                                                </tr>
                                            </thead>
                                            <tbody></tbody>
                                        </table>
                                    </div>
                                </div>
                            </div>
                            <div class="row" style="padding-top:10px">
                                <div class="col-md-6">
                                </div>
                                <div class="col-md-6">

                                    <div class="form-group row">
                                        <div class="col-sm-2">
                                        </div>
                                        <label for="lblRestAmount" class="col-sm-2 control-label">Total Amount :</label>
                                        <div class="col-sm-3">
                                            <label id="lblTotalAmountAmount">0</label>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="row" style="padding-top:10px">
                                <div class="col-md-3">
                                </div>
                                <div class="col-md-6">
                                    <div class="form-group row">
                                        <label for="lblNarration" class="col-sm-2 control-label">Narration :</label>
                                        <div class="col-sm-3" id="divNarration">
                                            <textarea id="txtaNarration" rows="4" cols="50" style="text-align:left"></textarea>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="card-footer">
                            @if (@ViewBag.eflag == "ed")
                            {
                                <button class="btn btn-primary" onclick="SaveDebitVoucher()">Submit</button>
                                <a class="btn btn-outline-danger float-right" href="@Url.Action("Index", "DebitVoucher")">Cancel</a>
                            }
                            @if (@ViewBag.eflag == "ap")
                            {
                                <button class="btn btn-primary" onclick="SaveDebitVoucher()">Approve</button>
                                <button class="btn btn-danger" id="Reject" onclick="Reject()">Reject</button>
                                <a class="btn btn-outline-danger float-right" href="@Url.Action("DebitVoucherApproval", "DebitVoucher")">Cancel</a>
                            }


                        </div>
                    </div>
                </div>
                <!-- /.row -->
            </div><!-- /.container-fluid -->
            <input id="voucherId" type="number" style="display: none;" value="@ViewBag.VoucherId">
            <input id="eflag" type="text" style="display: none;" value="@ViewBag.eflag">
            <input type="hidden" id="FromAccClosingBalance" />
        </div>
    </div>
</div>

                            @section Scripts
{

                                <script>
        var DebitVoucherGLList = {};
        var DeleteGLDetails = [];
        var DeleteGLDetailsTransaction = [];
        $(document).ready(function () {
            LoadCompany('ddlCompany');
            $("#ddlCompany").val("7");
            LoadBusinessUnit();
            $("#ddlBusinessUnit").val("1");
            LoadFinancialYear();
            LoadCurrency();
            $("#ddlCurrency").val("1");
            $('#txtOrderDate').datepicker({
                endDate: new Date(),
                autoclose: true,
                todayHighlight: true,
                format: 'dd-M-yyyy'
            });
            LoadDate('#txtDeliveryDate');
            LoadDate('#txtChequeDate');
            LoadDate('#txtRefDate');
            GetDebitVoucherGL();
            LoadBankName('ddlBank');
            BankWishEffect();




            var voucherId = $('#voucherId').val();
            if (voucherId > 0) {
                GetVoucherMaster(voucherId);
            } else {
                AddRow();
            }
            //$('#ddlBank').change(function() {
            //    var bankid = $(this).val();
            //    LoadBankBranch('ddlBranch', bankid);

            //});
        });


        function BankWishEffect() {
             
            if ($('#bankRadio').is(':checked')) {
                $("#ddlBank").prop("disabled", true);
                $("#ddlBranch").prop("disabled", true);
                $("#txtChequeNo").prop("disabled", false);
                $("#txtChequeDate").prop("disabled", false);
                $("#txtRefNo").prop("disabled", true);
                $("#txtRefDate").prop("disabled", true);

                $("#txtRefNo").val('');
                $("#txtRefDate").val('');


                $.ajax({
                    url: "/Utility/GetGLBankAccounts",
                    contentType: "application/json; charset=utf-8",
                    dataType: 'json',
                    type: "Get",
                    data: {},
                    async: false,
                    success: function (data) {

                        $('#ddlFromAccount').empty();
                        $('#ddlFromAccount').append("<option value='0'>--Select From Account--</option>");

                        for (var i = 0; i < data.length; i++) {

                            $('#ddlFromAccount').append($("<option></option>").val(data[i].CALayerSevenId).html(data[i].AccountNo));
                        }
                    }
                });
            }
        }
        $("#ddlFromAccount").change(function () {

            var glId = $("#ddlFromAccount").val();
            var urlpath1 = '@Url.Action("GetClosingBalanceOfGL", "JournalVoucher")';
            $.ajax({
                url: urlpath1,
                type: "Get",
                dataType: 'json',
                data: { glId: glId, refdetailid: null },
                async: false,
                success: function (data) {
                     

                    $('#FromAccClosingBalance').val(data.Balance.toFixed(2));
                    $('#ClosingBalance').html("(Closing Balance:" + data.Balance.toFixed(2) + ")");


                }
            });
        });
        function CashWishEffect() {
             
            if ($('#cashRadio').is(':checked')) {
                $("#ddlBank").prop("disabled", true);
                $("#ddlBranch").prop("disabled", true);
                $("#txtChequeNo").prop("disabled", true);
                $("#txtChequeDate").prop("disabled", true);
                $("#txtRefNo").prop("disabled", false);
                $("#txtRefDate").prop("disabled", false);

                $("#ddlBank").val(0);
                $("#ddlBranch").val(0);
                $("#txtChequeNo").val('');
                $("#txtChequeDate").val('');


                $.ajax({
                    url: "/Utility/GetGLCashAccounts",
                    contentType: "application/json; charset=utf-8",
                    dataType: 'json',
                    type: "Get",
                    data: {},
                    async: false,
                    success: function (data) {
                        $('#ddlFromAccount').empty();
                        $('#ddlFromAccount').append("<option value='0'>--Select From Account--</option>");
                        for (var i = 0; i < data.length; i++) {
                            $('#ddlFromAccount').append($("<option></option>").val(data[i].CALayerSevenId).html(data[i].AccountName));
                        }
                    }
                });
            }
        }

        function LoadBankBranchInfo() {
            var CALayerSevenId = $("#ddlFromAccount").val();
            var urlpath = '@Url.Action("GetBankBranch", "DebitVoucher")';
            $.ajax({
                url: urlpath,
                type: "Get",
                dataType: 'json',
                data: { CALayerSevenId: CALayerSevenId },
                async: false,
                success: function (data) {
                     
                    if ($('#bankRadio').is(':checked')) {
                        $('#ddlBank').val(data.BankId);
                        LoadBankBranch('ddlBranch', data.BankId);
                        $('#ddlBranch').val(data.BranchId);
                    } else {
                        $('#ddlBank').val(0);
                        $('#ddlBranch').val(0);
                    }

                }
            });

        }


        function LoadBusinessUnit() {
            var companyId = $("#ddlCompany").val();
            $.ajax({
                url: "/Utility/LoadBusinessUnit",
                contentType: "application/json; charset=utf-8",
                dataType: 'json',
                type: "Get",
                data: { companyId: companyId },
                async: false,
                success: function (data) {

                    $('#ddlBusinessUnit').empty();
                    $('#ddlBusinessUnit').append("<option value='0'>--Select Business Unit--</option>");

                    for (var i = 0; i < data.length; i++) {

                        $('#ddlBusinessUnit').append($("<option></option>").val(data[i].BUId).html(data[i].Name));
                    }
                }
            });
        }
        function LoadFinancialYear() {
            $.ajax({
                url: "/Utility/GetFinancialYear",
                contentType: "application/json; charset=utf-8",
                dataType: 'json',
                type: "Get",
                data: {},
                async: false,
                success: function (data) {

                    $('#ddlFiscalYear').empty();
                    //$('#ddlFiscalYear').append("<option value='0'>--Select Business Unit--</option>");

                    for (var i = 0; i < data.length; i++) {

                        $('#ddlFiscalYear').append($("<option></option>").val(data[i].FinancialYearId).html(data[i].FYear));
                    }
                }
            });
        }
        function LoadCurrency() {
            $.ajax({
                url: "/Utility/GetCurrency",
                contentType: "application/json; charset=utf-8",
                dataType: 'json',
                type: "Get",
                data: {},
                async: false,
                success: function (data) {

                    $('#ddlCurrency').empty();
                    $('#ddlCurrency').append("<option value='0'>--Select Currency--</option>");

                    for (var i = 0; i < data.length; i++) {

                        $('#ddlCurrency').append($("<option></option>").val(data[i].CurrencyId).html(data[i].CurrencyCode));
                    }
                }
            });
        }

        function GetVoucherMaster(id) {

            var urlpath = '@Url.Action("GetVoucherByMasterId", "DebitVoucher")';
            $.ajax({
                url: urlpath,
                dataType: 'json',
                type: "Get",
                data: { id: id },
                async: false,
                success: function (data) {
                    $("#ddlCompany").val(data.CompanyId).trigger('change');
                    $("#ddlCompany").prop("disabled", true);
                    LoadBusinessUnit();
                    $("#ddlBusinessUnit").val(data.BUId).trigger('change');
                    $("#ddlBusinessUnit").prop("disabled", true);
                    $("#ddlFiscalYear").val(data.FinancialYearId).trigger('change');
                    $("#ddlFiscalYear").prop("disabled", true);
                    $('#txtVoucherDate').val(ToJavaScriptDate(data.VoucherDate));
                    $("#txtVoucherDate").prop("disabled", true);
                    $("#ddlCurrency").val(data.CurrencyId).trigger('change');
                    $("#ddlCurrency").prop("disabled", true);
                    $('#txtCurrencyRate').val(data.CurrencyConRate);
                    $("#txtCurrencyRate").prop("disabled", true);

                    if (data.VoucherTypeId == 3)
                    {
                        $('#bankRadio').prop('checked', true);
                    }
                    if (data.VoucherTypeId == 4) {
                        $('#cashRadio').prop('checked', true);
                    }
                    $("#bankRadio").prop("disabled", true);
                    $("#cashRadio").prop("disabled", true);
                    $("#ddlFromAccount").prop("disabled", true);

                    LoadBankName('ddlBank');
                    $('#ddlBank').val(data.BankId);
                    $("#ddlBank").prop("disabled", true);
                    LoadBankBranch('ddlBranch', data.BankId);
                    $('#ddlBranch').val(data.BranchId);
                    $("#ddlBranch").prop("disabled", true);

                    $('#txtChequeNo').val(data.ChequeNo);
                    if (data.ChequeDate != "" && data.ChequeDate != null)
                    {
                        $('#txtChequeDate').val(ToJavaScriptDate(data.ChequeDate));
                    }


                    $('#txtRefNo').val(data.RefNo);
                    if (data.RefDate != "" && data.RefDate != null)
                    {
                        $('#txtRefDate').val(ToJavaScriptDate(data.RefDate));
                    }

                    $('#lblTotalAmountAmount').html(data.TotalAmount);
                    $('#txtaNarration').val(data.Narration);


                    BankWishEffect()
                    CashWishEffect()

                    $('#txtChequeNo').val(data.ChequeNo);
                    if (data.ChequeDate != "" && data.ChequeDate != null) {
                        $('#txtChequeDate').val(ToJavaScriptDate(data.ChequeDate));
                    }


                    $('#txtRefNo').val(data.RefNo);
                    if (data.RefDate != "" && data.RefDate != null) {
                        $('#txtRefDate').val(ToJavaScriptDate(data.RefDate));
                    }
                     
                    //GetProducts();
                    //var typeid = $("#ddlCustomerType").val();

                    for (var i = 0; i < data.VoucherDetails.length; i++) {
                         
                        var tr = $('#debitVoucher tbody tr').length + 1;
                        AddRow();
                        if (data.VoucherDetails[i].DrCr == "Cr")
                        {
                            var glId = isNaN(parseFloat(data.VoucherDetails[i].CALayerSevenId)) ? 0 : parseFloat(data.VoucherDetails[i].CALayerSevenId);
                            if (glId != 1268 && glId != 1083)
                            {
                                $("#SevenLayerCr_" + tr).val(data.VoucherDetails[i].CALayerSevenId);
                                $('#ddlFromAccount').val(data.VoucherDetails[i].CALayerSevenId).trigger('change');
                                $('#txtPaymentAmounthidden').val(data.VoucherDetails[i].CALayerSevenId)
                               // $('#amount_' + tr).val(data.VoucherDetails[i].CrAmt.toFixed(2));
                                $('#txtPaymentAmount').val(data.VoucherDetails[i].CrAmt.toFixed(2));
                                $('#details_' + tr).val(data.VoucherDetails[i].VoucherDetailId);
                                $('#details_transaction_' + tr).val(data.VoucherDetails[i].VoucherTransectionId);
                                $('#DrCr_' + tr).val(data.VoucherDetails[i].DrCr);
                                $("#tr_" + tr).css("display", "none");
                            }
                            if (glId == 1268) {
                                $("#SevenLayerCr_" + tr).val(data.VoucherDetails[i].CALayerSevenId);
                                $('#txtDiscounthidden').val(data.VoucherDetails[i].CALayerSevenId)
                                //$('#ddlFromAccount').val(data.VoucherDetails[i].CALayerSevenId).trigger('change');
                                //$('#amount_' + tr).val(data.VoucherDetails[i].CrAmt.toFixed(2));
                                $('#txtDiscount').val(data.VoucherDetails[i].CrAmt.toFixed(2));
                                $('#details_' + tr).val(data.VoucherDetails[i].VoucherDetailId);
                                $('#details_transaction_' + tr).val(data.VoucherDetails[i].VoucherTransectionId);
                                $('#DrCr_' + tr).val(data.VoucherDetails[i].DrCr);
                                $("#tr_" + tr).css("display", "none");
                            }
                            if (glId == 1083) {
                                $("#SevenLayerCr_" + tr).val(data.VoucherDetails[i].CALayerSevenId);
                                $('#txtTaxhidden').val(data.VoucherDetails[i].CALayerSevenId)
                                //$('#ddlFromAccount').val(data.VoucherDetails[i].CALayerSevenId).trigger('change');
                               // $('#amount_' + tr).val(data.VoucherDetails[i].CrAmt.toFixed(2));
                                $('#txtTax').val(data.VoucherDetails[i].CrAmt.toFixed(2));
                                $('#details_' + tr).val(data.VoucherDetails[i].VoucherDetailId);
                                $('#details_transaction_' + tr).val(data.VoucherDetails[i].VoucherTransectionId);
                                $('#DrCr_' + tr).val(data.VoucherDetails[i].DrCr);
                                $("#tr_" + tr).css("display", "none");
                            }

                        }
                        if (data.VoucherDetails[i].DrCr == "Dr")
                        {


                            $("#glId_" + tr).val(data.VoucherDetails[i].CALayerSevenId).trigger('change');
                            $('#glId_' + tr).prop("disabled", true);
                            $("#costCenter_" + tr).val(data.VoucherDetails[i].CostCenterId).trigger('change');
                            $("#referenceNo_" + tr).val(data.VoucherDetails[i].RefDetailsId).trigger('change');
                            $('#amount_' + tr).val(data.VoucherDetails[i].DrAmt.toFixed(2));
                            $('#remarks_' + tr).val(data.VoucherDetails[i].Remarks);

                            $('#details_' + tr).val(data.VoucherDetails[i].VoucherDetailId);
                            $('#details_transaction_' + tr).val(data.VoucherDetails[i].VoucherTransectionId);
                            $('#DrCr_' + tr).val(data.VoucherDetails[i].DrCr);

                        }

                        if (data.IsPage == false) {
                            $('#costCenter_' + tr).prop("disabled", true);
                            $('#referenceNo_' + tr).prop("disabled", true);
                            $('#amount_' + tr).prop("disabled", true);
