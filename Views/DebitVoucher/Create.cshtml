                var id = idr.substring(3);
                $('#ts_' + id).html(index + 1);


            });
        }

        function LoadGLInRow(elementId) {

            $('#' + elementId + '').append("<option value='0'>--Select GL--</option>");
            for (var i = 0; i < DebitVoucherGLList.length; i++) {

                $('#' + elementId + '').append($("<option></option>").val(DebitVoucherGLList[i].CALayerSevenId).html(DebitVoucherGLList[i].CALayerSevenName));
            }


        }




        function GetDebitVoucherGL() {


            var urlpath = '@Url.Action("GetDebitVoucherGL", "Utility")';
            $.ajax({
                url: urlpath,
                type: "Get",
                data: {},
                async: false,
                success: function (data) {

                    DebitVoucherGLList = data;

                }
            });
        }


        function Reject() {

            swal({
                title: "Are you sure?",
                text: "",
                type: "success",
                showCancelButton: true,
                cancelButtonClass: 'btn-secondary waves-effect',
                confirmButtonClass: 'btn-success waves-effect waves-light',
                confirmButtonText: 'Yes!',
                closeOnConfirm: false
            }, function () {
                $('.confirm').prop("disabled", true);
                $('.cancel').prop("disabled", true);
                RejectFinal();
            });

        }
        function RejectFinal() {



            var id = $('#voucherId').val();
             
            var urlpath = '@Url.Action("Reject", "DebitVoucher")';

            $.ajax({

                //contentType: "application/json",
                data: { id: id },
                dataType: "json",
                url: urlpath,
                type: "POST"
            })
                .success(function (result) {
                    console.log(result);
                    if (result.isSuccess == true) {
                        swal({
                            title: " Reject Successfull",
                            text: '',
                            type: "success",
                            showCancelButton: false,
                            cancelButtonClass: 'btn-secondary waves-effect',
                            confirmButtonClass: 'btn-success waves-effect waves-light',
                            confirmButtonText: 'Yes!',
                            closeOnConfirm: false
                        }, function () {
                            window.location.href = '@Url.Action("DebitVoucherApproval", "DebitVoucher")';
                        });
                    }

                });
        }
