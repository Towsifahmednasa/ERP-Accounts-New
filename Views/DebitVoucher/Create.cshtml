            if ($('#ddlFromAccount').val() == 0 || $('#ddlFromAccount').val() == '') {
                ValidationColorChangeNew("ddlFromAccount", "divFromAccount", "Account Required", false);
                isValid = false;
            }


            var p = parseFloat($('#txtPaymentAmount').val());
            var q= parseFloat($('#FromAccClosingBalance').val());

          if ( p > q) {

                ValidationColorChangeNew('txtPaymentAmount', 'divPaymentAmount', 'Amount Should Less Than Or Equal From Accounts Closing Balance', true);
                isValid = false;


            }


            if ($('#bankRadio').is(':checked')) {

                if ($('#ddlBank').val() == 0 || $('#ddlBank').val() == '') {
                    ValidationColorChangeNew("ddlBank", "divBank", "Bank Required", false);
                    isValid = false;
                }
                if ($('#ddlBranch').val() == 0 || $('#ddlBranch').val() == '') {
                    ValidationColorChangeNew("ddlBranch", "divBranch", "Branch Required", false);
                    isValid = false;
                }
                if ($('#eflag').val() == 'ap') {

                } else {
                    if ($('#txtChequeNo').val() == '' || $('#txtChequeNo').val() == null) {
                        ValidationColorChangeNew("txtChequeNo", "divChequeNo", "Cheque No Required", false);
                        isValid = false;
                    }
                    if ($('#txtChequeDate').val() == '' || $('#txtChequeDate').val() == null) {
                        ValidationColorChangeNew("txtChequeDate", "divChequeDate", "Cheque Date Required", false);
                        isValid = false;
                    }
                }


            }

            //if ($('#cashRadio').is(':checked')) {

            //    if ($('#txtRefNo').val() == '' || $('#txtRefNo').val() == null) {
            //        ValidationColorChangeNew("txtRefNo", "divRefNo", "Reference No Required", false);
            //        isValid = false;
            //    }
            //    if ($('#txtRefDate').val() == '' || $('#txtRefDate').val() == null) {
            //        ValidationColorChangeNew("txtRefDate", "divRefDate", "Reference Date Required", false);
            //        isValid = false;
            //    }

            //}


            if ($('#txtaNarration').val().trim() == '' || $('#txtaNarration').val().trim() == null) {
                ValidationColorChangeNew("txtaNarration", "divNarration", "Narration Required", false);
                isValid = false;
            }

            if ($('#txtPaymentAmount').val() == '' || $('#txtPaymentAmount').val() == null || $('#txtPaymentAmount').val() == 0) {
                ValidationColorChangeNew("txtPaymentAmount", "divPaymentAmount", "Payment Amount Required", false);
                isValid = false;
            }

            if ($('#debitVoucher tbody tr').length == 0 || $('#debitVoucher tbody tr').length == '') {
                isValid = false;
                message = "GL Required";
            }


            $('#debitVoucher tbody tr').each(function () {


                var idr = $(this).attr('id');
                var id = idr.substring(3);

                var glId = isNaN(parseFloat($('#glId_' + id).val())) ? 0 : parseFloat($('#glId_' + id).val());
                var amount = isNaN(parseFloat($('#amount_' + id).val())) ? 0 : parseFloat($('#amount_' + id).val());
                var isreferance = isNaN(parseFloat($('#isReferance_' + id).val())) ? 0 : parseFloat($('#isReferance_' + id).val());
                var referanceNo = isNaN(parseFloat($('#referenceNo_' + id).val())) ? 0 : parseFloat($('#referenceNo_' + id).val());
                var drcr = $('#DrCr_' + id).val();

                if (drcr == "Dr") {
                    if (glId === 0) {
                        isValid = false;
                        message = "Please select GL";
                        $('#glId_' + id).css('border-bottom', '2px solid red');
                        return;
                    }

                    if (amount === 0) {
                        isValid = false;
                        message = "Pay Amount Cannot be 0 ";
                        $('#amount_' + id).css('border-bottom', '2px solid red');
                        return;
                    }
                }

                if (glId > 0 && isreferance === 1) {
                    if (referanceNo === 0) {
                        isValid = false;
                        message = "Please select Referance";
                        $('#referenceNo_' + id).css('border-bottom', '2px solid red');
                        return;
                    }

                }


            });
            var paymentAmount = isNaN(parseFloat($('#txtPaymentAmount').val())) ? 0 : parseFloat($('#txtPaymentAmount').val());
            var discount = isNaN(parseFloat($('#txtDiscount').val())) ? 0 : parseFloat($('#txtDiscount').val());
            var tax = isNaN(parseFloat($('#txtTax').val())) ? 0 : parseFloat($('#txtTax').val());
            var totalCr = paymentAmount + discount + tax;
            var totalDr = parseFloat($('#lblTotalAmountAmount').html());
            var differenc = totalCr - totalDr;
            if (differenc > 0 || differenc < 0)
            {
                isValid = false;
                message = " Debit and Credit value difference should be 0.";
            }

            if (isValid == false) {
                ShowMessage(message);

            }
            return isValid;


        }

