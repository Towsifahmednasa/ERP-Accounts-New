                    var remarks = $('#remarks_' + id).val();
                    var drcr = $('#DrCr_' + id).val();

                    if (drcr == "Dr") {
                        var delObj = {};
                        delObj["VoucherDetailId"] = detailsId;
                        delObj["VoucherMasterId"] = voucherMasterId;
                        delObj["CALayerSevenId"] = glId;
                        delObj["DrCr"] = drcr;
                        if (drcr == 'Cr') {
                            delObj["CrAmt"] = amount;
                            delObj["CrAmtBDT"] = amount * currencyRate;
                        }
                        if (drcr == 'Dr') {
                            delObj["DrAmt"] = amount;
                            delObj["DrAmtBDT"] = amount * currencyRate;
                        }


                        delObj["IsDelete"] = true;
                        delObj["eflag"] = $('#eflag').val();
                        DeleteGLDetails.push(delObj);
                    }

                }
                $('#tr_' + id).remove();
                SerialTable();
                CalculateAll();
                PaymentValue();
            } else {
                return;
            }

        }

