        function RemoveRow(id) {
             
            var voucherMasterId = $('#voucherId').val();
            var currencyRate = $('#txtCurrencyRate').val();

            var trLength = $('#debitVoucher tbody tr:visible').length;
            var voucherMasterId = $('#voucherId').val();
            if (trLength == 1 && voucherMasterId == 0) {
                $('#glId_' + id).val(0).trigger('change');
                $('#costCenter_' + id).val(0).trigger('change');
                $('#referenceNo_' + id).val(0).trigger('change');
                $('#amount_' + id).val(0);
                $('#remarks_' + id).val('');
                $('#txtPaymentAmount').val('');
                $('#txtDiscount').val('');
                $('#txtTax').val('');
                CalculateAll();
                //PaymentValue();
            }

            if (trLength > 1) {

                var detailsId = $('#details_' + id).val();
                if (detailsId > 0) {
                    var glId = isNaN(parseFloat($('#glId_' + id).val())) ? 0 : parseFloat($('#glId_' + id).val());

