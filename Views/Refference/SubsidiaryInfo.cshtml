@section Scripts
{
    <script type="text/javascript">
        $(function () {
            //$("#divSelect").hide();
            //$("#divAdd").hide();

            LoadSubsidiaryType();
        });
        //$("input[type='radio']").click(function () {
        //    var radioValue = $("input[name='rbSelect']:checked").val();
        //    if (radioValue == 'Select') {
        //        $("#divSelect").show();
        //        $("#divAdd").hide();
        //    }

        //    if (radioValue == 'NewAdd') {
        //        $("#divSelect").hide();
        //        $("#divAdd").show();

        //    }
        //});


        function un(o) {
            return o != null ? o : '';
        }
        function LoadSubsidiaryType() {
            $.ajax({
                url: "/Utility/GetSubsidiaryType",
                contentType: "application/json; charset=utf-8",
                dataType: 'json',
                type: "Get",
                data: {},
                async: false,
                success: function (data) {

                    $('#ddlSubsidiaryType').empty();
                    $('#ddlSubsidiaryType').append("<option value='0'>--Select  Subsidiary Type--</option>");

                    for (var i = 0; i < data.length; i++) {

                        $('#ddlSubsidiaryType').append($("<option></option>").val(data[i].SubsidiaryTypeId).html(data[i].SubsidiaryType));
                    }
                }
            });
        }



        function LoadDataBySubsidiaryType() {
            var urlpath = '@Url.Action("LoadSubsidiaryInfoInPartialView", "Refference")';

            var SubsidiaryType = //$("#ddlSubsidiaryType:selected").text();
                $("#ddlSubsidiaryType option:selected").text();
            $("#lblSubType").empty();
            $("#lblSubType").append(SubsidiaryType+" List");

            $.ajax({
                url: urlpath,
                dataType: 'html',
                type: "Get",
                async: true,
                data: { SubsidiaryType: SubsidiaryType},
                beforeSend: function () {
                    $('#detailsR').empty();
                    $("#overlay").fadeIn(300);


                },
                success: function (data) {
                    
                    $('#detailsR').append(data);
                    // $('#reportTable1').dataTable();
                },
                complete: function () {
                    setTimeout(function () {
                        $("#overlay").fadeOut(300);
                    }, 500);
                }
            });



            var urlpath3 = '@Url.Action("LoadSubsidiaryTableInfo", "Refference")';

            $.ajax({
                url: urlpath3,
                dataType: 'json',
                type: "Get",
                async: true,
                data: { SubsidiaryType: SubsidiaryType },
                beforeSend: function () {
                    $("#overlay").fadeIn(300);


                },
                success: function (data) {
                    
                 
                    var result = JSON.parse(data);
                    var row = "";
                    $('#dtTableBody').html("");
                    for (var i = 0; i < result.length; i++) {
                        row += "<tr>";
                      
                      

                        row += "<td>" + un(result[i].Description) + "</td>";

                        if (un(result[i].isReadOnly) == 1) {
                            row += "<td><button type='button'  onclick = 'productDelete(this);' disabled='disabled' class= 'btn btn-default btn-sm' > " + "<i class='fa fa-times' aria-hidden='true'></i>" + "</button> </td>";
                        }

                        else {
                            row += "<td><button type='button'  onclick = 'productDelete(this);'  class= 'btn btn-default btn-sm' > " + "<i class='fa fa-times' aria-hidden='true'></i>" + "</button> </td>";
                        }
                     
                    }
                    $('#dtTableBody').html(row);
                  
                  
                  
                   
                },
                complete: function () {
                    setTimeout(function () {
                        $("#overlay").fadeOut(300);
                    }, 500);
                }
            });
        }

        function DescriptionValidation() {

            var isValid = true;



                if ($('#txtDescription').val() == '' || $('#txtDescription').val() == null) {
                ValidationColorChangeNew("txtDescription", "divDescription", "Description Required", true);

                isValid = false;
            }
            return isValid;
        }

        function DescriptionAddToTable() {

            if (DescriptionValidation() == true) {
            // First check if a <tbody> tag exists, add one if not
            if ($("#tblDescription tbody").length == 0) {
                $("#tblDescription").append("<tbody></tbody>");
            }

            // Append product to the table
            $("#tblDescription tbody").append("<tr>" +
                "<td>" + $("#txtDescription").val() + "</td>" +

                "<td>" +
                "<button type='button'  onclick = 'productDelete(this);'  class= 'btn btn-default btn-sm' > " + "<i class='fa fa-times' aria-hidden='true'></i>" + "</button>" + "</td>" +
                "</tr>");

                $("#txtDescription").val("");
            }
        }
        function productDelete(ctl) {
            $(ctl).parents("tr").remove();
        }


        //function CheckAll() {
        //    if ($('#checkAll').is(':checked')) {

        //        $('.chk').prop('checked', true);
        //    } else {
        //        $('.chk').prop('checked', false);
        //    }
        //}

        function CheckAll() {
            if ($('#checkAll').is(':checked')) {
                $('.chk:not(:disabled)').prop('checked', true);
            } else {
                $('.chk:not(:disabled)').prop('checked', false);
            }
        }

        function Save() {

            SaveSelected();
            //if (SaveValidation()) {

            //}
        }


          function SaveSelected() {
              var jsonObj = [];
           /*   var Selectted = false;*/
            /*  var radioValue = $("input[name='rbSelect']:checked").val();*/



                  $('#reportTableR tbody tr').each(function () {
                      var idr = $(this).attr('id');
                      var id = idr.substring(3);


                      if ($('#chk_' + id).is(':checked')) {
                          var jsonData = {};
                          var idr = $(this).attr('id');
                          var id = idr.substring(3);
                          // alert(idr);
                          // alert(id);


                          //var isrefrence = $('#isrefrence_' + id).val();

                          //if ( isrefrence != 0) {
                          //    id = isrefrence;
                          //}
                          //alert(isrefrence);
                          var SubsidiaryTypeId = $("#ddlSubsidiaryType").val();

                          jsonData["S_Info_Id"] = id;
                          jsonData["IsSelect"] = true;
                          jsonData["SubsidiaryTypeId"] = SubsidiaryTypeId;

                          jsonObj.push(jsonData);
                      }
                  });






                  $("#tblDescription > tbody > tr").each(function () {

                      var jsonData = {};


                      var des = $(this).find('td').eq(0).text()

                      var SubsidiaryTypeId = $("#ddlSubsidiaryType").val();

                      jsonData["Description"] = des;
                      jsonData["IsSelect"] = false;
                      jsonData["SubsidiaryTypeId"] = SubsidiaryTypeId;

                      jsonObj.push(jsonData);
                  });



            var urlpath = '@Url.Action("SaveSubInfoDetails", "ChartOfAccount")';

            $.ajax({
                url: urlpath,
                contentType: "application/json; charset=utf-8",
                data: JSON.stringify(jsonObj),
                dataType: 'json',
                type: "POST",
                beforeSend: function () {
                    
                    $("#overlay").fadeIn(300);


                },
                success: function (result) {
                    

                    if (result == true) {
                        swal({
                            title: 'Save Successfully!!',
                            type: 'success',
                            closeOnCancel: true

                        },
                            function () {
                                $('#details').empty();
                                window.location.href = '@Url.Action("SubsidiaryInfo", "Refference")';

                            });

                    }


                },
                complete: function () {
                    setTimeout(function () {
                        $("#overlay").fadeOut(300);
                    }, 500);
                }
            });
        }
    </script>

}
