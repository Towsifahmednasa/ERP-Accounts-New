@section Scripts
{
    <script type="text/javascript">
        $(function () {
            //$("#divSelect").hide();
            //$("#divAdd").hide();

            LoadReferenceType();
        });
        //$("input[type='radio']").click(function () {
        //    var radioValue = $("input[name='rbSelect']:checked").val();
        //    if (radioValue == 'Select') {
        //        $("#divSelect").show();
        //        $("#divAdd").hide();
        //    }

        //    if (radioValue == 'NewAdd') {
        //        $("#divSelect").hide();
        //        $("#divAdd").show();

        //    }
        //});


        function un(o) {
            return o != null ? o : '';
        }
        function LoadReferenceType() {
            $.ajax({
                url: "/Utility/GetReferanceType",
                contentType: "application/json; charset=utf-8",
                dataType: 'json',
                type: "Get",
                data: {},
                async: false,
                success: function (data) {

                    $('#ddlReferenceType').empty();
                    $('#ddlReferenceType').append("<option value='0'>--Select  Reference Type--</option>");

                    for (var i = 0; i < data.length; i++) {

                        $('#ddlReferenceType').append($("<option></option>").val(data[i].ReferanceTypeId).html(data[i].ReferanceTypeName));
                    }
                }
            });
        }



        function LoadDataByReferenceType() {
            var urlpath = '@Url.Action("LoadReferenceInfoInPartialView", "Refference")';

            var ReferenceType = //$("#ddlReferenceType:selected").text();
                $("#ddlReferenceType option:selected").text();
            $("#lblSubType").empty();
            $("#lblSubType").append(ReferenceType+" List");

            $.ajax({
                url: urlpath,
                dataType: 'html',
                type: "Get",
                async: true,
                data: { ReferenceType: ReferenceType},
                beforeSend: function () {
                    $('#detailsR').empty();
                    $("#overlay").fadeIn(300);


                },
                success: function (data) {
                    $('#detailsR').append(data);
                } ,
                complete: function () {
                    setTimeout(function () {
                        $("#overlay").fadeOut(300);
                    }, 500);
                }

            });



            var urlpath3 = '@Url.Action("LoadRefTableInfo", "Refference")';

            $.ajax({
                url: urlpath3,
                dataType: 'json',
                type: "Get",
                async: true,
                data: { ReferenceType: ReferenceType },
                beforeSend: function () {

                    $("#overlay").fadeIn(300);


                },
                success: function (data) {


                    var result = JSON.parse(data);
                    var row = "";
                    $('#dtTableBody').html("");
                    for (var i = 0; i < result.length; i++) {
                        row += "<tr>";



                        row += "<td>" + un(result[i].Description) + "</td>";

                        if (un(result[i].isReadOnly) == 1) {
                            row += "<td><button type='button'  onclick = 'productDelete(this);' disabled='disabled' class= 'btn btn-default btn-sm' > " + "<i class='fa fa-times' aria-hidden='true'></i>" + "</button> </td>";
                        }

                        else {
                            row += "<td><button type='button'  onclick = 'productDelete(this);'  class= 'btn btn-default btn-sm' > " + "<i class='fa fa-times' aria-hidden='true'></i>" + "</button> </td>";
                        }
                    }
                    $('#dtTableBody').html(row);




                },
                complete: function () {
                    setTimeout(function () {
                        $("#overlay").fadeOut(300);
                    }, 500);
                }
            });
        }

        function DescriptionValidation() {

            var isValid = true;



                if ($('#txtDescription').val() == '' || $('#txtDescription').val() == null) {
                ValidationColorChangeNew("txtDescription", "divDescription", "Description Required", true);

                isValid = false;
            }
            return isValid;
        }

        function DescriptionAddToTable() {

            if (DescriptionValidation() == true) {
            // First check if a <tbody> tag exists, add one if not
            if ($("#tblDescription tbody").length == 0) {
                $("#tblDescription").append("<tbody></tbody>");
            }

            // Append product to the table
            $("#tblDescription tbody").append("<tr>" +
                "<td>" + $("#txtDescription").val() + "</td>" +

                "<td>" +
                "<button type='button'  onclick = 'productDelete(this);'  class= 'btn btn-default btn-sm' > " + "<i class='fa fa-times' aria-hidden='true'></i>" + "</button>" + "</td>" +
                "</tr>");

                $("#txtDescription").val("");
            }
        }
        function productDelete(ctl) {
            $(ctl).parents("tr").remove();
        }


        function CheckAll() {
            if ($('#checkAll').is(':checked')) {

                $('.chk').prop('checked', true);
            } else {
                $('.chk').prop('checked', false);
            }
        }


        function Save() {


            SaveSelected();
            //if (SaveValidation()) {

            //}
        }


          function SaveSelected() {
              var jsonObj = [];
           /*   var Selectted = false;*/
            /*  var radioValue = $("input[name='rbSelect']:checked").val();*/



                  $('#reportTableR tbody tr').each(function () {
                      var idr = $(this).attr('id');
                      var id = idr.substring(3);


                      if ($('#chk_' + id).is(':checked')) {
                          var jsonData = {};
                          var idr = $(this).attr('id');
                          var id = idr.substring(3);
                          // alert(idr);
                          // alert(id);

                          var R_InfoName = $(this).find('td:eq(1)').text().trim();

                          var result = R_InfoName.split(':')[0].trim();
                          //var isrefrence = $('#isrefrence_' + id).val();

                          //if ( isrefrence != 0) {
                          //    id = isrefrence;
                          //}
                          //alert(isrefrence);
                          var ReferenceTypeId = $("#ddlReferenceType").val();

                          jsonData["R_Info_Id"] = id;
                          jsonData["IsSelect"] = true;
                          jsonData["ReferenceTypeId"] = ReferenceTypeId;
                          jsonData["Description"] = result;
                          jsonObj.push(jsonData);
                      }
                  });






                  $("#tblDescription > tbody > tr").each(function () {

                      var jsonData = {};


                      var des = $(this).find('td').eq(0).text()

                      var ReferenceTypeId = $("#ddlReferenceType").val();

                      jsonData["Description"] = des;
                      jsonData["IsSelect"] = false;
                      jsonData["ReferenceTypeId"] = ReferenceTypeId;

                      jsonObj.push(jsonData);
                  });



            var urlpath = '@Url.Action("SaveRefInfoDetails", "ChartOfAccount")';

            $.ajax({
                url: urlpath,
                contentType: "application/json; charset=utf-8",
                data: JSON.stringify(jsonObj),
                dataType: 'json',
                type: "POST",
                success: function (result) {
                    
                    if (result == true) {
                        swal({
                            title: 'Save Successfully!!',
                            type: 'success',
                            closeOnCancel: true

                        },
                            function () {
                                $('#details').empty();
                                window.location.href = '@Url.Action("ReferenceInfo", "Refference")';

                            });

                    }


                }
            });
        }
    </script>

}
