 function GetContraMaster(id) {
  var urlpath = '@Url.Action("GetContraMasterId", "Contra")'
  $.ajax({
    url: urlpath,
    dataType: "json",
    type: "Get",
    data: { id: id },
    async: false,
    beforeSend: () => {
      $("#loadingSpinner").show()
    },
    success: (data) => {
      try {
        // Set basic form fields
        $("#ddlCompany").val(data.CompanyInfoId).trigger("change")

        // Load dependent dropdowns
        LoadDDlbyCom()
        LoadFinansialYearSingle()

        // Set financial year after loading
        setTimeout(() => {
          $("#ddlFyMain").val(data.FinancialYearId).trigger("change")
        }, 100)

        // Set other basic fields
        $("#txtPostingDate").val(data.PostingDateStr || "")
        $("#txtVoucherNo").val(data.VoucherNo || "")
        $("#ddlCurrency").val(data.CurrencyId || 1)
        $("#txtConversionRate").val(data.CurrencyCovRate || 1)

        // Set transfer type radio button with proper timing and triggering
        var transferType = data.VoucherCategoryID || 1
        console.log("Setting transfer type:", transferType) // Debug log

        // Clear all radio buttons first
        $('input[name="transferType"]').prop("checked", false)

        // Use a small delay to ensure DOM is ready
        setTimeout(() => {
          switch (transferType) {
            case 1: // Bank to Bank
              $("#bankToBank").prop("checked", true)
              console.log("Set Bank to Bank radio")
              break
            case 2: // Cash to Cash
              $("#cashToCash").prop("checked", true)
              console.log("Set Cash to Cash radio")
              break
            case 3: // Cash to Bank
              $("#cashToBank").prop("checked", true)
              console.log("Set Cash to Bank radio")
              break
            case 4: // Bank to Cash
              $("#bankToCash").prop("checked", true)
              console.log("Set Bank to Cash radio")
              break
            default:
              $("#bankToBank").prop("checked", true)
              console.log("Set default Bank to Bank radio")
              break
          }

          // Verify the radio button was set
          var checkedValue = $('input[name="transferType"]:checked').val()
          console.log("Radio button set to value:", checkedValue)

          // Manually trigger the change event to show appropriate section
          $('input[name="transferType"]:checked').trigger("change")

          // Also call toggleTransferSections directly as backup
          toggleTransferSections()
        }, 200) // Small delay to ensure DOM is ready

        // Show appropriate section and load data
        //toggleTransferSections()

        // Set form fields based on transfer type after ensuring sections are visible
        setTimeout(() => {
          populateFormFields(data, transferType)
        }, 1000) // Increased delay to 1500ms to ensure sections are loaded
      } catch (error) {
        console.log("Error in GetContraMaster success: ", error)
      }
    },
    error: (xhr, status, error) => {
      console.log("GetContraMaster Error: " + error)
      console.log("Status: " + status)
      console.log("Response: " + xhr.responseText)
    },
    complete: () => {
      setTimeout(() => {
        $("#loadingSpinner").hide()
      }, 1000)
    },
  })
}

function populateFormFields(data, transferType) {
  console.log("populateFormFields called with transferType:", transferType)
  console.log("Data received:", data)

  try {
    switch (transferType) {
      case 1: // Bank to Bank
        // Load dropdowns first, then set values
        LoadFromBankAccount()
        LoadToBankAccount()

        // Wait for dropdowns to load, then set values
        setTimeout(() => {
          if (data.BankAccountId) {
            console.log("Setting From Bank Account:", data.BankAccountId)
            $("#ddlFromBankAccount").val(data.BankAccountId).trigger("change")
            // Wait a bit more for the change to process, then load info
            setTimeout(() => {
              LoadFromBankInfo()
            }, 200)
          }
          if (data.CashAccountId) {
            console.log("Setting To Bank Account:", data.CashAccountId)
            $("#ddlToBankAccount").val(data.CashAccountId).trigger("change")
            setTimeout(() => {
              LoadToBankInfo()
            }, 200)
          }
          $("#txtToBankBalance").val(data.TotalAmount || "")
          $("#txtToChequeNo").val(data.ChequeNo || "")
          $("#txtToChequeDate").val(data.ChequeDateStr || "")
          $("#txtToBankNarration").val(data.Narration || "")
        }, 300)
        break

      case 2: // Cash to Cash
        LoadFromCashAccount()
        LoadToCashAccount()

        setTimeout(() => {
          if (data.CashAccountId) {
              console.log("Setting From Cash Account:", data.BankAccountId)
              $("#ddlFromCashAccount").val(data.BankAccountId).trigger("change")
            setTimeout(() => {
              LoadFromCashInfo()
            }, 200)
          }
          if (data.BankAccountId) {
              console.log("Setting To Cash Account:", data.CashAccountId)
              $("#ddlToCashAccount").val(data.CashAccountId).trigger("change")
            setTimeout(() => {
              LoadToCashInfo()
            }, 200)
          }
          $("#txtToCashBalance").val(data.TotalAmount || "")
          $("#txtToRefNo").val(data.CashRefNo || "")
          $("#txtToRefDate").val(data.CashRefDateStr || "")
          $("#txtToBankNarration").val(data.Narration || "")
        }, 500)
        break

      case 3: // Cash to Bank
        LoadFromCashAccountCB()
        LoadToBankAccountCB()

        setTimeout(() => {
          if (data.CashAccountId) {
              console.log("Setting From Cash Account CB:", data.BankAccountId)
              $("#ddlFromCashAccountCB").val(data.BankAccountId).trigger("change")
            setTimeout(() => {
              LoadFromCashInfo()
            }, 200)
          }
          if (data.BankAccountId) {
              console.log("Setting To Bank Account CB:", data.CashAccountId)
              $("#ddlToBankAccountCB").val(data.CashAccountId).trigger("change")
            setTimeout(() => {
              LoadToBankInfo()
            }, 200)
          }
          $("#txtToBankBalanceCB").val(data.TotalAmount || "")
          //$("#txtChequeNoCB").val(data.ChequeNo || "")
          //$("#txtChequeDateCB").val(data.ChequeDateStr || "")
            $("#txtToBankNarration").val(data.Narration || "")
        }, 500)
        break

      case 4: // Bank to Cash
        LoadFromBankAccountBC()
        LoadToCashAccountBC()

        setTimeout(() => {
          if (data.BankAccountId) {
              console.log("Setting From Bank Account BC:", data.CashAccountId)
              $("#ddlFromBankAccountBC").val(data.CashAccountId).trigger("change")
            setTimeout(() => {
              LoadFromBankInfo()
            }, 500)
          }
          if (data.CashAccountId) {
              console.log("Setting To Cash Account BC:", data.BankAccountId)
              $("#ddlToCashAccountBC").val(data.BankAccountId).trigger("change")
            setTimeout(() => {
              LoadToCashInfo()
            }, 500)
          }
          $("#txtToCashBalanceBC").val(data.TotalAmount || "")
          $("#txtToRefNoBC").val(data.CashRefNo || "")
          $("#txtToRefDateBC").val(data.CashRefDateStr || "")
            $("#txtToBankNarration").val(data.Narration || "")
        }, 500)
        break
    }
  } catch (error) {
    console.log("Error in populateFormFields: ", error)
  }
}
