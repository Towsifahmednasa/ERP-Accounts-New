                    break;
                case "4": // Bank to Cash
                    BankAccountID = $('#ddlFromBankAccountBC').val();
                    BankName = $("#ddlFromBankAccountBC option:selected").text();
                    break;
            }

            console.log("Bank Account ID: " + BankAccountID); // CHANGED: Added console logging
            console.log("Bank Name: " + BankName);

            if (!BankAccountID || BankAccountID == '0') {
                console.log("No bank account selected, returning"); // CHANGED: Added console logging
                return;
            }

            var FinancialYearID = $('#ddlFyMain').val();
            // CHANGED: Fixed date format to use proper format for controller
            var FromDate = $('#txtfrmDate').val();
            var ToDate = $('#txtToDate').val();
            var BankBookFinancialYearStartDate = $('#txtfrmDate').val();

            console.log("Financial Year ID: " + FinancialYearID); // CHANGED: Added console logging
            console.log("From Date: " + FromDate);
            console.log("To Date: " + ToDate);

            var urlpath = '@Url.Action("GetBankInfoMasterId", "BankPayments")';
            console.log("URL Path: " + urlpath); // CHANGED: Added console logging

            $.ajax({
                url: urlpath,
                dataType: 'json',
                type: "GET", // CHANGED: Standardized to GET
                data: {
                    CompanyID: CompanyID,
                    BankAccountID: BankAccountID,
                    FinancialYearID: FinancialYearID,
                    FromDate: FromDate,
                    ToDate: ToDate,
                    BankNAme: BankName,
                    BankBookFinancialYearStartDate: BankBookFinancialYearStartDate
                },
                async: false,
                beforeSend: function () {
                    // Show the full-screen loading spinner
                    $("#loadingSpinner").show();
                },
                success: function (data) {
                    console.log("Success response received:", data); // CHANGED: Added success logging
                    switch(transferType) {
                        case "1": // Bank to Bank
                            $("#lblFromBankBalance").html(data.BankBlnc || '0.00'); // CHANGED: Added null safety
                            $("#lblFromBankName").html(data.BankName || '');
                            $("#lblFromBranchName").html(data.BranchName || '');
                            break;
                        case "4": // Bank to Cash
                            $("#lblFromBankBalanceBC").html(data.BankBlnc || '0.00'); // CHANGED: Added null safety
                            $("#lblFromBankNameBC").html(data.BankName || '');
                            $("#lblFromBranchNameBC").html(data.BranchName || '');
                            break;
                    }
                },
                error: function(xhr, status, error) { // CHANGED: Enhanced error handling
                    console.log("AJAX Error Details:");
                    console.log("Status: " + status);
                    console.log("Error: " + error);
                    console.log("Response Text: " + xhr.responseText);
                    console.log("Status Code: " + xhr.status);

                    if (xhr.status === 404) {
                        console.log("Controller action not found - check routing");
                    } else if (xhr.status === 500) {
                        console.log("Server error - check controller implementation");
                    }
                },
                complete: function () {
                    setTimeout(function () {
                        $("#loadingSpinner").hide();
                    }, 500);
                }
            });
        }

