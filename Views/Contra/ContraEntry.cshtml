        function LoadFromBankInfo() {
            console.log("LoadFromBankInfo called"); // CHANGED: Added console logging
            var transferType = $('input[name="transferType"]:checked').val();
            var CompanyID = $('#ddlCompany').val();
            var BankAccountID = '';
            var BankName = '';

            console.log("Transfer Type: " + transferType); // CHANGED: Added console logging
            console.log("Company ID: " + CompanyID);

            // Get the appropriate dropdown based on transfer type
            switch(transferType) {
                case "1": // Bank to Bank
                    BankAccountID = $('#ddlFromBankAccount').val();
