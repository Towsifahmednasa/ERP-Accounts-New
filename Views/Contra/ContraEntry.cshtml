        function SaveContraFinal() {


            swal({
                title: "Are you sure?",
                text: "Do you want to save this data?",
                type: "warning",
                showCancelButton: true,
                cancelButtonClass: 'btn-secondary waves-effect',
                confirmButtonClass: 'btn-success waves-effect waves-light',
                confirmButtonText: 'Yes, Save it!',
                cancelButtonText: 'Cancel',
                closeOnConfirm: false, // Don't close on confirm
                closeOnCancel: false // Don't close on cancel
            }, function (isConfirm) {
                if (isConfirm) {
 
                    $('#btnSave').prop('disabled', true);

                    // Show the loading overlay
                    $("#overlay").fadeIn(300);

            var jsonData = {};

            jsonData["VoucherMasterId"] = $('#masterId').val();
            jsonData["CompanyInfoId"] = $('#ddlCompany').val();
            jsonData["FinancialYearId"] = $('#ddlFyMain').val(); // Updated to match validation
            jsonData["PostingDate"] = $('#txtPostingDate').val();
            jsonData["VoucherNo"] = $('#txtVoucherNo').val();
            jsonData["CurrencyId"] = $('#ddlCurrency').val();
            jsonData["CurrencyCovRate"] = $('#txtConversionRate').val();
            jsonData["Narration"] = $('#txtToBankNarration').val();

            var transferType = $('input[name="transferType"]:checked').val();
            jsonData["TransferType"] = transferType;

            // Initialize fields that may not be used
            jsonData["CashAccountId"] = null;
            jsonData["BankAccountId"] = null;
            jsonData["ChequeNo"] = null;
            jsonData["ChequeDate"] = null;
            jsonData["Narration"] = null;
            jsonData["TotalAmount"] = null;

            // Set data based on transfer type (matching validation logic)
            switch (transferType) {
                case '1': // Bank to Bank
                    jsonData["BankAccountId"] = $('#ddlFromBankAccount').val(); // From Bank
                    jsonData["CashAccountId"] = $('#ddlToBankAccount').val(); // To Bank (using CashAccountId field)
                    jsonData["TotalAmount"] = $('#txtToBankBalance').val();
                    jsonData["ChequeNo"] = $('#txtToChequeNo').val();
                    jsonData["ChequeDate"] = $('#txtToChequeDate').val();
                    break;

                case '2': // Cash to Cash
                    jsonData["CashAccountId"] = $('#ddlFromCashAccount').val(); // From Cash
                    jsonData["BankAccountId"] = $('#ddlToCashAccount').val(); // To Cash (using BankAccountId field)
                    jsonData["TotalAmount"] = $('#txtToCashBalance').val();
                    jsonData["CashRefNo"] = $('#txtToRefNo').val();
                    jsonData["CashRefDate"] = $('#txtToRefDate').val();
                    break;

                case '3': // Cash to Bank
                    jsonData["CashAccountId"] = $('#ddlFromCashAccountCB').val(); // From Cash
                    jsonData["BankAccountId"] = $('#ddlToBankAccountCB').val(); // To Bank
                    jsonData["TotalAmount"] = $('#txtToBankBalanceCB').val();
                    jsonData["CashRefNo"] = $('#txtFromRefNoCB').val();
                    jsonData["CashRefDate"] = $('#txtFromRefDateCB').val();
                    break;

                case '4': // Bank to Cash
                    jsonData["BankAccountId"] = $('#ddlFromBankAccountBC').val(); // From Bank
                    jsonData["CashAccountId"] = $('#ddlToCashAccountBC').val(); // To Cash
                    jsonData["TotalAmount"] = $('#txtToCashBalanceBC').val();
                    jsonData["CashRefNo"] = $('#txtToRefNo').val();
                    jsonData["CashRefDate"] = $('#txtToRefDate').val();
                    jsonData["ChequeNo"] = $('#txtChequeNoBC').val();
                    jsonData["ChequeDate"] = $('#txtChequeDateBC').val();
                    break;
            }

            var urlpath = '@Url.Action("SaveContra", "Contra")';
         $.ajax({
                contentType: "application/json",
                data: JSON.stringify(jsonData),
                dataType: 'json',
                url: urlpath,
                type: "POST",
                success: function (result) {
                    // Hide the overlay and re-enable the button after success
                    setTimeout(function () {
                        $("#overlay").fadeOut(300);
                        $('#btnSave').prop('disabled', false); // Re-enable the button
                    }, 500);

                    if (result.pk > 0) {
                        swal({
                            title: "Saved Successfully!",
                            text: '',
                            type: "success",
                            showCancelButton: false,
                            cancelButtonClass: 'btn-secondary waves-effect',
                            confirmButtonClass: 'btn-success waves-effect waves-light',
                            confirmButtonText: 'Yes!',
                            closeOnConfirm: false
                        }, function () {
                            window.location.href = '@Url.Action("ContraList", "Contra")';
                        });
                    }
                },
                error: function () {
                    // In case of error, hide the overlay and re-enable the button
                    setTimeout(function () {
                        $("#overlay").fadeOut(300);
                        $('#btnSave').prop('disabled', false); // Re-enable the button
                    }, 500);

                    swal({
                        title: "Error!",
                        text: 'Something went wrong while saving data.',
                        type: "error",
                        confirmButtonText: 'OK'
                    });
                }
            });
                } else {
                    swal.close(); 
            // If user cancels, re-enable the button and hide the loading overlay
                    $('#btnSave').prop('disabled', false);
            $("#overlay").fadeOut(300);
        }
    });
}

