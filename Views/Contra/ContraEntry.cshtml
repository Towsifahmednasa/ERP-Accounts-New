        function Contra_Validation() {
            var isValid = true;
            var message = "Some Values Required";

            // Basic form validation
            if ($('#ddlCompany').val() == 0 || $('#ddlCompany').val() == '') {
                ValidationColorChangeNew("ddlCompany", "divCompany", "Company Required", true);
                isValid = false;
            }

            if ($('#ddlFyMain').val() == 0 || $('#ddlFyMain').val() == '' || $('#ddlFyMain').val() == null) {
                ValidationColorChangeNew("ddlFyMain", "divFyMain", "Financial Year Required", true);
                isValid = false;
            }

            if ($('#txtPostingDate').val() == '' || $('#txtPostingDate').val() == null) {
                ValidationColorChangeNew("txtPostingDate", "divPostingDate", "Posting Date Required", false);
                isValid = false;
            }

            if ($('#ddlCurrency').val() == 0 || $('#ddlCurrency').val() == '' || $('#ddlCurrency').val() == null) {
                ValidationColorChangeNew("ddlCurrency", "divCurrency", "Currency Required", true);
                isValid = false;
            }

            if ($('#txtConversionRate').val() == '' || $('#txtConversionRate').val() == null) {
                ValidationColorChangeNew("txtConversionRate", "divtConversionRate", "Currency Rate Required", false);
                isValid = false;
            }
            if ($('#txtToBankNarration').val().trim() == '' || $('#txtToBankNarration').val().trim() == null) {
                ValidationColorChangeNew("txtToBankNarration", "", "Narration Required", false);
                isValid = false;
            }
            // Check if transfer type is selected
            var transferType = $('input[name="transferType"]:checked').val();
            if (!transferType) {
                swal("Please select a transfer type!", "", "error");
                isValid = false;
                return isValid;
            }

            // Validate based on transfer type
            switch (transferType) {
                case '1': // Bank to Bank
                    if ($('#ddlFromBankAccount').val() == 0 || $('#ddlFromBankAccount').val() == '' || $('#ddlFromBankAccount').val() == null) {
                        ValidationColorChangeNew("ddlFromBankAccount", "divFromBankAccount", "From Bank Account Required", true);
                        isValid = false;
                    }
                    // Check from bank balance
                    var fromBankBalance = parseFloat($('#lblFromBankBalance').text().replace(/[^0-9.-]/g, '')) || 0;
                    if (fromBankBalance <= 0) {
                        ValidationColorChangeNew("ddlFromBankAccount", "divFromBankAccount", "From Bank Account has insufficient balance", true);
                        isValid = false;
                    }
                    if ($('#ddlToBankAccount').val() == 0 || $('#ddlToBankAccount').val() == '' || $('#ddlToBankAccount').val() == null) {
                        ValidationColorChangeNew("ddlToBankAccount", "divToBankAccount", "To Bank Account Required", true);
                        isValid = false;
                    }
                    if ($('#txtToBankBalance').val().trim() == '' || $('#txtToBankBalance').val().trim() == null) {
                        ValidationColorChangeNew("txtToBankBalance", "", "Amount Required", false);
                        isValid = false;
                    }
                    // Check if transfer amount exceeds available balance
                    var transferAmount = parseFloat($('#txtToBankBalance').val()) || 0;
                    if (transferAmount > 0 && transferAmount > fromBankBalance) {
                        ValidationColorChangeNew("txtToBankBalance", "", "Transfer amount exceeds available balance", false);
                        isValid = false;
                    }
                    if ($('#txtToChequeNo').val().trim() == '' || $('#txtToChequeNo').val().trim() == null) {
                        ValidationColorChangeNew("txtToChequeNo", "", "Cheque No Required", false);
                        isValid = false;
                    }
                    if ($('#txtToChequeDate').val() == '' || $('#txtToChequeDate').val() == null) {
                        ValidationColorChangeNew("txtToChequeDate", "", "Cheque Date Required", false);
                        isValid = false;
                    }
                    // Check if same accounts selected
                    if (isValid && $('#ddlFromBankAccount').val() == $('#ddlToBankAccount').val()) {
                        swal("From Account & To Account cannot be same!", "", "error");
                        isValid = false;
                    }
                    break;

                case '2': // Cash to Cash
                    if ($('#ddlFromCashAccount').val() == 0 || $('#ddlFromCashAccount').val() == '' || $('#ddlFromCashAccount').val() == null) {
                        ValidationColorChangeNew("ddlFromCashAccount", "divFromCashAccount", "From Cash Account Required", true);
                        isValid = false;
                    }
                    // Check from cash balance
                    var fromCashBalance = parseFloat($('#lblFromCashBalance').text().replace(/[^0-9.-]/g, '')) || 0;
                    if (fromCashBalance <= 0) {
                        ValidationColorChangeNew("ddlFromCashAccount", "divFromCashAccount", "From Cash Account has insufficient balance", true);
                        isValid = false;
                    }
                    if ($('#ddlToCashAccount').val() == 0 || $('#ddlToCashAccount').val() == '' || $('#ddlToCashAccount').val() == null) {
                        ValidationColorChangeNew("ddlToCashAccount", "divToCashAccount", "To Cash Account Required", true);
                        isValid = false;
                    }
                    if ($('#txtToCashBalance').val().trim() == '' || $('#txtToCashBalance').val().trim() == null) {
                        ValidationColorChangeNew("txtToCashBalance", "", "Amount Required", false);
                        isValid = false;
                    }
                    // Check if transfer amount exceeds available balance
                    var transferAmount = parseFloat($('#txtToCashBalance').val()) || 0;
                    if (transferAmount > 0 && transferAmount > fromCashBalance) {
                        ValidationColorChangeNew("txtToCashBalance", "", "Transfer amount exceeds available balance", false);
                        isValid = false;
                    }
                    // Check if same accounts selected
                    if (isValid && $('#ddlFromCashAccount').val() == $('#ddlToCashAccount').val()) {
                        swal("From Account & To Account cannot be same!", "", "error");
                        isValid = false;
                    }
                    break;

                case '3': // Cash to Bank
                    if ($('#ddlFromCashAccountCB').val() == 0 || $('#ddlFromCashAccountCB').val() == '' || $('#ddlFromCashAccountCB').val() == null) {
                        ValidationColorChangeNew("ddlFromCashAccountCB", "divFromCashAccountCB", "From Cash Account Required", true);
                        isValid = false;
                    }
                    // Check from cash balance
                    var fromCashBalanceCB = parseFloat($('#lblFromCashBalanceCB').text().replace(/[^0-9.-]/g, '')) || 0;
                    if (fromCashBalanceCB <= 0) {
                        ValidationColorChangeNew("ddlFromCashAccountCB", "divFromCashAccountCB", "From Cash Account has insufficient balance", true);
                        isValid = false;
                    }
                    if ($('#ddlToBankAccountCB').val() == 0 || $('#ddlToBankAccountCB').val() == '' || $('#ddlToBankAccountCB').val() == null) {
                        ValidationColorChangeNew("ddlToBankAccountCB", "divToBankAccountCB", "To Bank Account Required", true);
                        isValid = false;
                    }
                    if ($('#txtToBankBalanceCB').val().trim() == '' || $('#txtToBankBalanceCB').val().trim() == null) {
                        ValidationColorChangeNew("txtToBankBalanceCB", "", "Amount Required", false);
                        isValid = false;
                    }
                    if ($('#txtFromRefNoCB').val().trim() == '' || $('#txtFromRefNoCB').val().trim() == null) {
                        ValidationColorChangeNew("txtFromRefNoCB", "", "Ref No Required", false);
                        isValid = false;
                    }
                    if ($('#txtFromRefDateCB').val().trim() == '' || $('#txtFromRefDateCB').val().trim() == null) {
                        ValidationColorChangeNew("txtFromRefDateCB", "", "Ref Date Required", false);
                        isValid = false;
                    }
                    // Check if transfer amount exceeds available balance
                    var transferAmountCB = parseFloat($('#txtToBankBalanceCB').val()) || 0;
                    if (transferAmountCB > 0 && transferAmountCB > fromCashBalanceCB) {
                        ValidationColorChangeNew("txtToBankBalanceCB", "", "Transfer amount exceeds available balance", false);
                        isValid = false;
                    }
                    break;

                case '4': // Bank to Cash
                    if ($('#ddlFromBankAccountBC').val() == 0 || $('#ddlFromBankAccountBC').val() == '' || $('#ddlFromBankAccountBC').val() == null) {
                        ValidationColorChangeNew("ddlFromBankAccountBC", "divFromBankAccountBC", "From Bank Account Required", true);
                        isValid = false;
                    }
                    // Check from bank balance
                    var fromBankBalanceBC = parseFloat($('#lblFromBankBalanceBC').text().replace(/[^0-9.-]/g, '')) || 0;
                    if (fromBankBalanceBC <= 0) {
                        ValidationColorChangeNew("ddlFromBankAccountBC", "divFromBankAccountBC", "From Bank Account has insufficient balance", true);
                        isValid = false;
                    }
                    if ($('#ddlToCashAccountBC').val() == 0 || $('#ddlToCashAccountBC').val() == '' || $('#ddlToCashAccountBC').val() == null) {
                        ValidationColorChangeNew("ddlToCashAccountBC", "divToCashAccountBC", "To Cash Account Required", true);
                        isValid = false;
                    }
                    if ($('#txtToCashBalanceBC').val().trim() == '' || $('#txtToCashBalanceBC').val().trim() == null) {
                        ValidationColorChangeNew("txtToCashBalanceBC", "", "Amount Required", false);
                        isValid = false;
                    }
                    if ($('#txtChequeDateBC').val().trim() == '' || $('#txtChequeDateBC').val().trim() == null) {
                        ValidationColorChangeNew("txtChequeDateBC", "", "Amount Required", false);
                        isValid = false;
                    }
                    if ($('#txtChequeNoBC').val().trim() == '' || $('#txtChequeNoBC').val().trim() == null) {
                        ValidationColorChangeNew("txtChequeNoBC", "", "Amount Required", false);
                        isValid = false;
                    }

                    // Check if transfer amount exceeds available balance
                    var transferAmountBC = parseFloat($('#txtToCashBalanceBC').val()) || 0;
                    if (transferAmountBC > 0 && transferAmountBC > fromBankBalanceBC) {
                        ValidationColorChangeNew("txtToCashBalanceBC", "", "Transfer amount exceeds available balance", false);
                        isValid = false;
                    }
                    break;
            }

            return isValid;
        }


