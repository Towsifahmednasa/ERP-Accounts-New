@section Scripts
{
    <script type="text/javascript">
        function un(o) {
            return o != null ? o : '';
        }

        var RowId = 0;
        $("#CheckAll").click(function () {

            for (var i = 0; i < $('#dtTb tr').length; i++) {
                RowId = i;
                RowId++;
                $("input[name='CheckBox[" + RowId + "].rowCount']").not(this).prop('checked', this.checked);
            }


        });

        $(document).ready(function () {
        //    LoadFilterData();
           // ShowReport();

        });


              function LoadFilterData() {
            var urlpath = '@Url.Action("LoadFilterInPartialView", "Dashboard")';



            $.ajax({
                url: urlpath,
                dataType: 'html',
                type: "Get",
                async: true,
                data: { },
                beforeSend: function () {
                    $('#detailsR').empty();



                },
                success: function (data) {

                    $('#detailsR').append(data);
                    // $('#reportTable1').dataTable();
                }
            });




        }

         function ShowReport() {
             //


             var param = '';


             var comID = $('#ddlCompany').val();
             var finID = $('#ddlFinansialYear').val();
             var frmD = $('#txtPostingFDate').val();
             var toD = $('#txtPostingTDate').val();
             var Status = $('#ddlApprovalStatus').val();



             if (jQuery.type(comID) === "undefined") { }
             else {
                 if (comID !== "0" && comID !== null) {
                     param = param + " and prp.BusinessUnitId='" + comID + "'";
                 }
             }
             
             param = param + " and  ISNULL(mas.ApproveStatus, 'Posted') = 'Posted'";

            var urlpath = '@Url.Action("Get_BankChargeList", "LCRelatedBankPayment")';
            $.ajax({
                url: urlpath,
                dataType: 'html',
                type: "Get",
                data: { param: param},
                async: false,
                beforeSend: function () {

                    $("#overlay").fadeIn(300);
                },
                success: function (data) {

                    data = JSON.parse(data);
                    $("#manuallist").html("");
                    if (data.length > 0) {



                        var row = "";
                        var count = 1;
                        $("#manuallist").html("");

                        var count = 1;
                        for (var i = 0; i < data.length; i++) {

                            RowId++;

                            row += "<tr>";
                            row += "<td  >" + count + "</td>";
                            row += "<td>" + '<input type = "hidden" style = "text-align:center" id = "HfFieldName"  name ="DoctorList[' + RowId + '].BankChargeId" value = "' + data[i].BankChargeId + '" />' + '<input type="checkbox" id="CheckBox" name="CheckBox[' + RowId + '].rowCount">' + "</td>";

                            row += "<td>" + un(data[i].CompanyName) + "</td>";
                            row += "<td>" + un(data[i].SupplierTypeName) + "</td>";
                            row += "<td>" + un(data[i].SupplierName) + "</td>";
                            row += "<td>" + un(data[i].LCNo) + "</td>";
                            row += "<td>" + un(data[i].LCDate) + "</td>";
                            row += "<td>" + un(data[i].CurrencyName) + "</td>";
                            row += "<td>" + un(data[i].Conversionrate) + "</td>";
                            row += "<td>" + un(data[i].TypeName) + "</td>";

                            row += "<td>" + un(data[i].ChargeBasisof) + "</td>";
                            row += "<td>" + un(data[i].TotalAmountBDT) + "</td>";
                            row += "<td>" + un(data[i].TotalAmountFC) + "</td>";
                            row += "<td>" + un(data[i].PaymentFrom) + "</td>";
                            row += "<td>" + un(data[i].LoanAccID) + "</td>";
                            row += "<td>" + un(data[i].COAID) + "</td>";
                            //row += "<td>" + un(data[i].EntryBy) + "</td>";
                            //row += "<td>" + un(data[i].EntryDate) + "</td>";
                            //row += "<td>" + un(data[i].Updateby) + "</td>";
                            //row += "<td>" + un(data[i].Updatedate) + "</td>";
                           

                            row += "</tr>";
                            count = count + 1;

                        }
                        $("#manuallist").html(row);
                    }
                },
                complete: function () {



                    setTimeout(function () {
                        $("#overlay").fadeOut(300);
                    }, 500);
                }
            });
         }



        function editClick(id) {

            location.href = '../Journal/JRCreate?MasterId=' + id + '';

        }



    function PrintReport(MasterId)
        {
            var urlpath = '@Url.Action("rptDebitVoucher", "AccountingTaskReport")';
        var reportValue = "AllVoucherReport";

        $.ajax({
            url: urlpath,
            data: { MasterId: MasterId, reportValue: reportValue},
                dataType: 'json',
                type: "Get",
                success: function (data) {
                    if (data.isSuccess) {
                        //OpenPopUp('BasicReportViewer.aspx');
                        window.open("/CrystalViewer/CrystalViewer.aspx", "_blank", "WIDTH=1024,HEIGHT=768,scrollbars=no, menubar=no,resizable=yes,directories=no,location=no");
                    }
                }
            });
        }




        function validation() {

            var Isvalid = true;
            var NotValid = false;

            var countCh = 0;

            for (var i = 0; i < $('#dtTb tr').length; i++) {
                RowId = i;
                RowId++;

                var Cb = $("input[name='CheckBox[" + RowId + "].rowCount']").is(':checked');

                if (Cb != true) {
                    countCh++;
                }


            }

            if (countCh == i) {

                alert("Please select at least one row from List!!!")
                return NotValid;
            }

            return Isvalid;
        }


        function SaveApproval() {
            $("#overlay").fadeIn(300);
            if (validation()) {

                var jsonData = {};
                jsonData["Id"] = 0;

                // var jsonObjs = [];

                var MyArry = [];

                var id = "";

                for (var i = 0; i < $('#dtTb tr').length; i++) {

                    RowId = i;
                    RowId++;

                    var BankChargeId = $("input[name='DoctorList[" + RowId + "].BankChargeId']").val();
                    var check = $("input[name='CheckBox[" + RowId + "].rowCount']").is(':checked');
                    if (check == true) {


                        id = id + BankChargeId + ',';
                     }


                }

                var index = id.lastIndexOf(',');

                var srt = id.substring(0, index);


                var radioValue = $("input[name='rbApprove']:checked").val();

                var rbValue = true;
                if (radioValue == "Approve") {
                    rbValue = true;
                }
                else {
                    rbValue = false;

                }

                //  console.log(MyArry);


                    var urlpath3 = '@Url.Action("Approve_AllBankCharge", "AllApproval")';

                 $.ajax({
                contentType: "application/json",
                     data: JSON.stringify({ MyArry: srt, rbValue: rbValue }),
                dataType: 'json',
                     url: urlpath3,
                type: "POST",
                beforeSend: function () {
                    $("#overlay").fadeIn(300);
                }
            })
                .success(function (result) {
                    setTimeout(function () {
                        $("#overlay").fadeOut(300);
                    }, 500);
                    if (result.isSuccess == true) {
                        swal({
                            title: " Submit Successfully",
                            text: '',
                            type: "success",
                            showCancelButton: false,
                            cancelButtonClass: 'btn-secondary waves-effect',
                            confirmButtonClass: 'btn-success waves-effect waves-light',
                            confirmButtonText: 'Yes!',
                            closeOnConfirm: false
                         }, function () {
                                window.location.href = '@Url.Action("BankChargeApproval", "AllApproval")';

                        });
                    }

                });

            }
        }



    </script>

}

