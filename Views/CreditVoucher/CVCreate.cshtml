                                    </div>
                                    <div class="col-md-4">

                                        <div class="form-group">
                                            <div class="row">
                                                <div class="col-md-4">   <label for="chkIsMannualVoucher" class="bold col-form-label"> </label></div>
                                                <div class="col-md-8">


                                                </div>
                                            </div>
                                        </div>

                                        <div class="form-group">
                                            <div class="row">
                                                <div class="col-md-4">   <label for="ddlCashAccount" class="bold col-form-label">Cash Account : <span class="required"> *</span></label></div>
                                                <div class="col-md-8" id="divCashAccount">    <select class="form-select form-select-sm mb-3 select2" style="width: 100%;" onchange="LoadCashInfoIndoById()" id="ddlCashAccount"></select> </div>
                                            </div>
                                        </div>



                                        <div class="form-group">
                                            <div class="row">
                                                <div class="col-md-4">   <label for="lblCashBalance" class="bold col-form-label">Cash Balance: </label></div>
                                                <div class="col-md-8">    <label class="form-control form-control-sm mb-3" id="lblCashBalance"></label> </div>
                                            </div>
                                        </div>

                                        <div class="form-group" id="divRefNo">
                                            <div class="row">
                                                <div class="col-md-4">   <label for="txtRefNo" class="bold col-form-label">Ref. No:  </label></div>
                                                <div class="col-md-8">       <input type="text" id="txtRefNo" class="form-control form-control-sm mb-3" /></div>
                                            </div>

                                        </div>

                                        <div class="form-group" id="divRefDate">
                                            <div class="row">
                                                <div class="col-md-4">   <label for="txtRefDate" class="bold col-form-label">Ref. Date:  </label></div>
                                                <div class="col-md-8">     <input type="text" id="txtRefDate" class="form-control form-control-sm mb-3 datepicker" value="@DateTime.Now.ToString("dd MMMM, yyyy")" /> </div>
                                            </div>
                                        </div>
                                        <div class="form-group">
                                            <div class="row">
                                                <div class="col-md-4">   <label for="txtNaration" class="bold col-form-label">Narration: <span class="required"> *</span></label></div>
                                                <div class="col-md-8" id="divNaration">    <textarea id="txtNaration" rows="4" cols="50" class="form-control form-control-sm"> </textarea> </div>
                                            </div>
                                        </div>




                                    </div>
                                </div>


                                <div class="row table-responsive" style="padding-top:10px">
                                    <div class="col-md-12">
                                        <div class="card-body">
                                            <div class="row">
                                                <div class="col-md-5"></div>
                                                <div class="col-md-2" style="text-align:center">
                                                    <h6>Payment Information</h6>
                                                </div>
                                                <div class="col-md-5"></div>


                                            </div>

                                            <table class="table table-bordered table-striped table-hover" id="debitVoucher">
                                                <thead>
                                                    <tr>



                                                        <th style="width: 340px">GL</th>
                                                        <th style="width: 220px">Subsidiary  Ledger</th>
                                                        <th style="width: 220px">Cost Center</th>
                                                        <th style="width: 220px">Ref. Info.</th>


                                                        <th style="width: 120px">Amount (BDT)</th>
                                                        <th style="width: 120px">Amount (FC)</th>
                                                        <th>Remarks</th>
                                                        <th style="width: 100px">Action</th>
                                                    </tr>
                                                </thead>
                                                <tbody></tbody>
                                            </table>
                                        </div>
                                    </div>
                                </div>

                                <div style="display:none">
                                    <div class="form-group">
                                        <div class="row">
                                            <div class="col-md-4">   <label for="txtfrmDate" class="bold col-form-label">From Date: <span class="required"> *</span></label></div>
                                            <div class="col-md-8">     <input type="text" id="txtfrmDate" class="form-control form-control-sm mb-3 datepicker" value="@DateTime.Now.ToString("dd MMMM, yyyy")" /> </div>
                                        </div>
                                    </div>


                                    <div class="form-group">
                                        <div class="row">
                                            <div class="col-md-4">   <label for="txtToDate" class="bold col-form-label">To Date: <span class="required"> *</span></label></div>
                                            <div class="col-md-8">     <input type="text" id="txtToDate" class="form-control form-control-sm mb-3 datepicker" value="@DateTime.Now.ToString("dd MMMM, yyyy")" /> </div>
                                        </div>
                                    </div>
                                </div>
                                <div class="container" style="padding-top: 10px;">

                                    <div class="row">
                                        <div class="col-md-2">
                                        </div>
                                        <div class="col-md-4">
                                            <!-- Fieldset for BDT -->
                                            <fieldset class="form-panel">
                                                <legend>Total BDT</legend>


                                                <!-- Section for Total Amounts in BDT -->
                                                <div class="row">


                                                    <!-- Total Amount for BDT Debit and Credit -->
                                                    <div class="col-md-12">
                                                        <div class="form-group row">
                                                            <label for="lblTotalAmountBDT" class="col-sm-6 text-right bold col-form-label">  Amount :</label>
                                                            <div class="col-sm-6">
                                                                <label id="lblTotalAmountBDT">0</label>
                                                            </div>
                                                        </div>


                                                    </div>
                                                </div>
                                            </fieldset>
                                        </div>
                                        <div class="col-md-4">
                                            <fieldset class="form-panel">
                                                <legend>Total FC</legend>
                                                <div class="row">


                                                    <!-- Total Amount for FC Debit and Credit -->
                                                    <div class="col-md-12">
                                                        <div class="form-group row">
                                                            <label for="lblTotalAmountFC" class="col-sm-6 text-right bold col-form-label">  Amount :</label>
                                                            <div class="col-sm-6">
                                                                <label id="lblTotalAmountFC">0</label>
                                                            </div>
                                                        </div>


                                                    </div>
                                                </div>
                                            </fieldset>
                                        </div>
                                    </div>


                                    <!-- Fieldset for FC (Foreign Currency) -->

                                </div>

                            </div>


                            <div style="padding-top: 1.5%">

                                <div class="wrapper">
                                    <div class="row">
                                        <div class="col-md-5" style="margin: 0 44.5% !important;">
                                            <div class="form-group">

                                                <button class="small blue button" id="Reject" onclick="SaveB_Payment()">
                                                    <i class="fa fa-paper-plane" aria-hidden="true"></i>
                                                    Process Payment
                                                </button>
                                            </div>
