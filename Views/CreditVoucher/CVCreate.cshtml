@* Ported from Accounts\CSTL_Pro_to_Pay\Views\CreditVoucher\CVCreate.cshtml - page markup and inline scripts unchanged; presentation comes from the Fiori shell/stylesheet. *@

@{
    ViewBag.Title = "Credit Voucher Entry";
