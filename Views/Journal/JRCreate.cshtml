        function CalculateAll() {


            var ConversionRate =    isNaN(parseFloat($('#txtConversionRate').val())) ? 0 : parseFloat($('#txtConversionRate').val());
            var grandTotal = 0;
            var grandTotalCR = 0;

            var grandTotal_fc = 0;
            var grandTotalCR_fc = 0;
            var proCout = 0;
            var lines = 0, drLines = 0, crLines = 0;
            $('#debitVoucher tbody tr').each(function () {



                var idr = $(this).attr('id');
                var id = idr.substring(3);

                var DRCR = $('#ddlDRCR_' + id).val();
                lines++;
                if (DRCR == "Debit") { drLines++; } else if (DRCR == "Credit") { crLines++; }
                $(this).toggleClass('is-dr', DRCR == "Debit").toggleClass('is-cr', DRCR == "Credit");

                if (DRCR == "Debit") {

                    var amount = isNaN(parseFloat($('#amount_' + id).val())) ? 0 : parseFloat($('#amount_' + id).val());
                    //   var amountFC = isNaN(parseFloat($('#amount_FC' + id).val())) ? 0 : parseFloat($('#amount_FC' + id).val());

                    var amountFC = ConversionRate * amount;
                    $('#amount_FC_' + id).val(amountFC.toFixed(4));
                    grandTotal += amount;
                    grandTotal_fc += amountFC;
                }

                if (DRCR == "Credit") {

                    var amountCR = isNaN(parseFloat($('#amount_' + id).val())) ? 0 : parseFloat($('#amount_' + id).val());
                  //  var amountCRFC = isNaN(parseFloat($('#amount_FC_' + id).val())) ? 0 : parseFloat($('#amount_FC_' + id).val());

                    var amountFC = ConversionRate * amountCR;
                    $('#amount_FC_' + id).val(amountFC.toFixed(4));
                    grandTotalCR += amountCR;
                    grandTotalCR_fc += amountFC;
                }




            });
            $('#lblTotalAmountBDT').html(grandTotal.toFixed(4));
            $('#lblTotalAmountBDTCR').html(grandTotalCR.toFixed(4));
            $('#lblTotalAmountFC').html(grandTotal_fc.toFixed(4));
            $('#lblTotalAmountFCCr').html(grandTotalCR_fc.toFixed(4));

            // wireframe 81: line count beside the table title, running difference + balance status in the footer
            var diff = grandTotal - grandTotalCR;
            var empty = grandTotal === 0 && grandTotalCR === 0;
            var balanced = Math.abs(diff) < 0.00005;
            $('#lblLineCount').text('(' + lines + (lines == 1 ? ' line' : ' lines') + ' · ' + drLines + ' Dr · ' + crLines + ' Cr)');
            $('#lblDiffBDT').text(diff.toFixed(4)).toggleClass('pos', balanced).toggleClass('neg', !balanced);
            $('#balStatus').attr('class', 'objstat ' + (empty ? 'neu' : balanced ? 'pos' : 'neg'))
                .find('b').text(empty ? 'No amounts yet' : balanced ? 'Balanced' : 'Out of balance');
            $('#balStatus use').attr('href', empty ? '#s-alert' : balanced ? '#s-ok' : '#s-no');
            if ($('#simSection').is(':visible')) { RenderSimulation(); }
        }

        // wireframe 81 "Simulation - document preview": read-only view of what the voucher would post, with the checks
        // that can be answered from the screen. Period / budget / reconciliation-account checks need server data and are not here.
        function jrEsc(s) { return $('<div>').text(s == null ? '' : s).html(); }
        function jrMoney(n) { return n.toLocaleString('en-IN', { minimumFractionDigits: 2, maximumFractionDigits: 4 }); }
        function jrIcon(ok) { return '<svg width="13" height="13"><use href="' + (ok ? '#s-ok' : '#s-no') + '"/></svg>'; }

        function RenderSimulation() {
            var body = '', totDr = 0, totCr = 0, missingGl = 0, zeroAmt = 0;
            $('#debitVoucher tbody tr').each(function () {
                var id = $(this).attr('id').substring(3);
                var accId = parseFloat($('#COAId_' + id).val()) || 0;
                var amt = parseFloat($('#amount_' + id).val()) || 0;
                var isDr = $('#ddlDRCR_' + id).val() == 'Debit';
                var problem = !accId ? 'Select GL' : amt <= 0 ? 'Amount is 0' : '';
                if (!accId) { missingGl++; }
                if (amt <= 0) { zeroAmt++; }
                if (isDr) { totDr += amt; } else { totCr += amt; }
                body += '<tr><td>' + (accId ? jrEsc($('#COAId_' + id + ' option:selected').text()) : '<span class="mini">&mdash;</span>') + '</td>'
                    + '<td class="num">' + (isDr ? jrMoney(amt) : '&mdash;') + '</td>'
                    + '<td class="num">' + (isDr ? '&mdash;' : jrMoney(amt)) + '</td>'
                    + '<td><span class="objstat ' + (problem ? 'neg' : 'pos') + '">' + jrIcon(!problem) + (problem || 'ok') + '</span></td></tr>';
            });
            body += '<tr class="tot-row"><td>Document total</td><td class="num">' + jrMoney(totDr) + '</td><td class="num">' + jrMoney(totCr) + '</td><td></td></tr>';
            $('#simBody').html(body);

            var diff = totDr - totCr;
            var checks = [
                { ok: totDr > 0 && Math.abs(diff) < 0.00005, t: 'Debits equal credits', d: 'Difference ' + diff.toFixed(4) },
                { ok: missingGl === 0, t: 'Every line has a GL account', d: missingGl ? missingGl + ' line(s) without GL' : '' },
                { ok: zeroAmt === 0, t: 'Every line has an amount', d: zeroAmt ? zeroAmt + ' line(s) with amount 0' : '' },
                { ok: (parseFloat($('#txtConversionRate').val()) || 0) > 0, t: "Today's conversion rate declared", d: '' },
                { ok: $.trim($('#txtNaration').val()) !== '', t: 'Narration entered', d: '' }
            ];
            var html = '';
            $.each(checks, function (i, c) {
                html += '<div style="display:flex;gap:8px;margin-top:8px"><span class="objstat ' + (c.ok ? 'pos' : 'neg') + '">' + jrIcon(c.ok) + '</span>'
                    + '<div><b style="font-size:13px"' + (c.ok ? '' : ' class="neg"') + '>' + jrEsc(c.t) + '</b>'
                    + (c.d ? '<div class="mini' + (c.ok ? '' : ' neg') + '">' + jrEsc(c.d) + '</div>' : '') + '</div></div>';
            });
            $('#simChecks').html(html);
        }

