        function LoadCoaRow(elementId, selectedAccountId, selectedAccountText) {
            var $ddl = $('#' + elementId);
            if ($ddl.length === 0) {
                return;
            }

            if ($ddl.data('select2')) {
                $ddl.select2('destroy');
            }

            $ddl.empty();
            $ddl.append("<option value='0'>--Select GL--</option>");

            $ddl.select2({
                placeholder: '--Select GL--',
                width: '100%',
                minimumInputLength: 1,
                ajax: {
                    url: "/Utility/GetCOAALLComIdAuto",
                    dataType: 'json',
                    delay: 250,
                    cache: true,
                    data: function (params) {
                        return {
                            companyId: $("#ddlCompany").val(),
                            term: params.term || '',
                            take: 50
                        };
                    },
                    processResults: function (data) {
                        return {
                            results: $.map(data, function (item) {
                                return {
                                    id: item.AccountId,
                                    text: item.AccountName,
                                    subControlName: item.SubControlName || ''
                                };
                            })
                        };
                    }
                },
                templateResult: function (item) {
                    if (item.loading || !item.id) {
                        return item.text;
                    }

                    if (!item.subControlName) {
                        return item.text;
                    }

                    var $container = $('<div></div>');
                    $container.append($('<div style="font-size:11px;color:#6c757d"></div>').text(item.subControlName));
                    $container.append($('<div></div>').text(item.text));
                    return $container;
                },
                templateSelection: function (item) {
                    return item.text || '--Select GL--';
                }
            });

            var selectedId = parseInt(selectedAccountId, 10);
            if (selectedId > 0) {
                var selectedText = selectedAccountText || GetCoaTextById(selectedId);
                if (selectedText) {
                    var selectedOption = new Option(selectedText, selectedId, true, true);
                    $ddl.append(selectedOption).trigger('change.select2');
                } else {
                    $.ajax({
                        url: "/Utility/GetCOAALLComIdByAccountId",
                        dataType: 'json',
                        type: "Get",
                        data: { companyId: $("#ddlCompany").val(), accountId: selectedId },
                        success: function (item) {
                            if (item && item.AccountId) {
                                var fallbackOption = new Option(item.AccountName, item.AccountId, true, true);
                                $ddl.append(fallbackOption).trigger('change.select2');
                            }
                        }
                    });
                }
            } else {
                $ddl.val('0').trigger('change.select2');
            }
        }



