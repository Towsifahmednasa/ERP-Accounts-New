        function GetDDlbyCOAId(COAId, selectedValues) {
            var cId = $('#COAId_' + COAId).val();
            var selected = selectedValues || {};

            if (!cId || cId === "0") {
                return $.when(
                    InitCostCenterSelect2(COAId),
                    InitRefInfoSelect2(COAId),
                    InitSubsidiarySelect2(COAId)
                );
            }

            coaDdlPendingLoads++;
            if (coaDdlPendingLoads === 1) {
                $("#overlay").fadeIn(300);
            }

            var costCenterRequest = InitCostCenterSelect2(COAId, selected.costCenterId);
            var refInfoRequest = InitRefInfoSelect2(COAId, selected.refInfoId);
            var subsidiaryRequest = InitSubsidiarySelect2(COAId, selected.subsidiaryId);

            return $.when(costCenterRequest, refInfoRequest, subsidiaryRequest).always(function () {
                coaDdlPendingLoads = Math.max(0, coaDdlPendingLoads - 1);
                if (coaDdlPendingLoads === 0) {
                    $("#overlay").fadeOut(300);
                }
            });
        }


