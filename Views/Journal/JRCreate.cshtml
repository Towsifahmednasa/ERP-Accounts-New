            if ($('#ddlCompany').val() == 0 || $('#ddlCompany').val() == '') {
                ValidationColorChangeNew("ddlCompany", "divCompany", "Company Required", true);
                isValid = false;
            }


            if ($('#ddlFinansialYear').val() == 0 || $('#ddlFinansialYear').val() == '' || $('#ddlFinansialYear').val() == null) {
                ValidationColorChangeNew("ddlFinansialYear", "divFinansialYear", "Financial Year Required", true);
                isValid = false;
            }
            if ($('#txtPostingDate').val() == '' || $('#txtPostingDate').val() == null) {
                ValidationColorChangeNew("txtPostingDate", "divPostingDate", "Posting Date Required", false);
                isValid = false;
            }

            if ($('#txtConversionRate').val() == '' || $('#txtConversionRate').val() == null) {
                ValidationColorChangeNew("txtConversionRate", "divtConversionRate", "Currency Rate Required", false);
                isValid = false;
            }

            var ConversionRate = $('#txtConversionRate').val();
            if (ConversionRate == 0) {
                // Show toast notification for today's conversion rate

                toastr.options = {
                    "closeButton": true,
                    "progressBar": true,
                    "positionClass": "toast-bottom-right", // Shows the toastr message at the bottom-right
                    "timeOut": "5000" // Auto-close after 5 seconds
                };

                toastr.warning("Today's conversion rate is required.");
                ValidationColorChangeNew("txtConversionRate", "divtConversionRate", "Today's conversion rate is required.", false);
                isValid = false;
            }





            if ($('#txtNaration').val().trim() == '' || $('#txtNaration').val().trim() == null) {
                ValidationColorChangeNew("txtNaration", "divNaration", "Narration Required", false);
                isValid = false;
            }

            $('#debitVoucher tbody tr').each(function () {


                var idr = $(this).attr('id');
                var id = idr.substring(3);

                var AccountId = isNaN(parseFloat($('#COAId_' + id).val())) ? 0 : parseFloat($('#COAId_' + id).val());

                var amount = isNaN(parseFloat($('#amount_' + id).val())) ? 0 : parseFloat($('#amount_' + id).val());

                if (AccountId === 0) {
                    isValid = false;
                    message = "Please select GL";
                    $('#COAId_' + id).css('border-bottom', '2px solid red');
                    toastr.options = {
                        "closeButton": true,
                        "progressBar": true,
                        "positionClass": "toast-bottom-right", // Shows the toastr message at the bottom-right
                        "timeOut": "5000" // Auto-close after 5 seconds
                    };

                    toastr.warning("Please select GL");
                    return;
                }


                if (amount === 0 && !isPark) {
                    isValid = false;
                    message = "Pay Amount Cannot be 0 ";
                    $('#amount_' + id).addClass('is-invalid');

                    toastr.options = {
                        "closeButton": true,
                        "progressBar": true,
                        "positionClass": "toast-bottom-right", // Shows the toastr message at the bottom-right
                        "timeOut": "5000" // Auto-close after 5 seconds
                    };

                    toastr.warning("Pay Amount Cannot be 0");
                    return;
                }


            });

            var DR = isNaN(parseFloat($('#lblTotalAmountBDT').html())) ? 0 : parseFloat($('#lblTotalAmountBDT').html());
            var CR = isNaN(parseFloat($('#lblTotalAmountBDTCR').html())) ? 0 : parseFloat($('#lblTotalAmountBDTCR' ).html());


            if (DR != CR && !isPark) {
                isValid = false;

                toastr.options = {
                    "closeButton": true,
                    "progressBar": true,
                    "positionClass": "toast-bottom-right", // Shows the toastr message at the bottom-right
                    "timeOut": "5000" // Auto-close after 5 seconds
                };

                toastr.warning("DR or CR must be same Amount!");
            }





            return isValid;


        }

    </script>

}
