        function PrintReport() {


            var CompanyID = $('#ddlCompany').val();
            var ComName = $("#ddlCompany option:selected").text();
            var FinYear = $("#ddlFinansialYear option:selected").text();
            var FinancialYearID = $('#ddlFinansialYear').val();
            var FromDate = $('#txtfrmDate').val();
            var ToDate = $('#txtToDate').val();
            var ledgerType = $('input[name="category"]:checked').val();

            if (!ledgerType) {
                toastr.error("Please select a type.");
                return;
            }

            if (!CompanyID || CompanyID === "0") {
                toastr.error("Please select a company.");
                $('#ddlCompany').focus();
                return;
            }
            if (!FinancialYearID || FinancialYearID === "0") {
                toastr.error("Please select a financial year.");
                $('#ddlFinansialYear').focus();
                return;
            }
            if (!FromDate) {
                toastr.error("Please enter From Date.");
                $('#txtfrmDate').focus();
                return;
            }
            if (!ToDate) {
                toastr.error("Please enter To Date.");
                $('#txtToDate').focus();
                return;
            }

            var subsidiaryInfoId = 0;
            var referenceInfoId = 0;
            var costCenterId = 0;

            //$('#ddlSubsidiary').trigger('change.select2');
            //$('#ddlReferenceType').trigger('change.select2');
            //$('#ddlReference').trigger('change.select2');

            if (ledgerType === 'subsidiary') {
                subsidiaryInfoId = $('#ddlSubsidiary').length ? $('#ddlSubsidiary').val() : 0;

                if (!subsidiaryInfoId || subsidiaryInfoId === "0") {
                    toastr.error("Please select subsidiary.");
                    $('#ddlSubsidiary').focus();
                    return;
                }
            }

            if (ledgerType === 'cost-center') {
                costCenterId = $('#ddlCS').length ? $('#ddlCS').val() : 0;

                if (!costCenterId || costCenterId === "0") {
                    toastr.error("Please select cost center.");
                    $('#ddlCS').focus();
                    return;
                }
            }

            if (ledgerType === 'reference') {
                referenceInfoId = $('#ddlReference').length ? $('#ddlReference').val() : 0;

                if (!referenceInfoId || referenceInfoId === "0") {
                    toastr.error("Please select reference.");
                    $('#ddlReference').focus();
                    return;
                }
            }

            if (ledgerType === 'coa') {
                subsidiaryInfoId = 0;
                referenceInfoId = 0;
                costCenterId = 0;
            }

            var glHead = 0, controlLadger = 0, subsidiary = 0, subsubsidiary = 0;

            if ($('#ddlLedgerHead').val() != 0 && $('#ddlLedgerHead').val() != '' && $('#ddlLedgerHead').val() != null)
                glHead = $('#ddlLedgerHead').val();
            if ($('#ddlControlLedger').val() != 0 && $('#ddlControlLedger').val() != '' && $('#ddlControlLedger').val() != null)
                controlLadger = $('#ddlControlLedger').val();
            if ($('#ddlSubControlLedger').val() != 0 && $('#ddlSubControlLedger').val() != '' && $('#ddlSubControlLedger').val() != null)
                subsidiary = $('#ddlSubControlLedger').val();
            if ($('#ddlSubSubControlLedger').val() != 0 && $('#ddlSubSubControlLedger').val() != '' && $('#ddlSubSubControlLedger').val() != null)
                subsubsidiary = $('#ddlSubSubControlLedger').val();

            var TrailBalanceType = "";
            if ($('#CumulativeReportRadio').is(':checked')) TrailBalanceType = "TTT";
            if ($('#DetailReportRadio').is(':checked')) TrailBalanceType = "TB";
            if ($('#DetailReportTransactionRadio').is(':checked')) TrailBalanceType = "TBOT";
            if ($('#OracleTreeReportRadio').is(':checked')) TrailBalanceType = "TB_TREE";
            if ($('#SubsidiarySummaryReportRadio').is(':checked')) TrailBalanceType = "TBS";
            if (TrailBalanceType == "") TrailBalanceType = "TBOT_new";

            var urlpath = '@Url.Action("GetTrialBalance_Report", "TrialBalance")';

            $.ajax({
                url: urlpath,
                data: {
                    CompanyID: CompanyID, FinancialYearID: FinancialYearID,
                    FromDate: FromDate, ToDate: ToDate,
                    TrailBalanceType: TrailBalanceType,
                    ledgerType: ledgerType,
                    glHead: glHead, controlLadger: controlLadger,
                    subsidiary: subsidiary, subsubsidiary: subsubsidiary,
                    subsidiaryInfoId: subsidiaryInfoId,
                    referenceInfoId: referenceInfoId,
                    costCenterId: costCenterId,
                    ComName: ComName, FinYear: FinYear
                },
                dataType: 'json',
                type: "Get",
                beforeSend: function () {
                    $("#loadingSpinner").show();
                },
                success: function (data) {
                    console.log("Full response:", data);

                    $('#ledgerlist').empty();

                    var dtmaintable = [];

                    if (data && data.dtMainTable) {
                        dtmaintable = data.dtMainTable;
                    }

                    var reportFormat = 'TB';

                    if ($('#DetailReportTransactionRadio').is(':checked')) {
                        reportFormat = 'TBOT';
                    }

                    if ($('#OracleTreeReportRadio').is(':checked')) {
                        reportFormat = 'TB_TREE';
                    }

                    if (!dtmaintable || dtmaintable.length === 0) {
                        toastr.warning("No data found.");

                        if (reportFormat === 'TB_TREE') {
                            setOracleTreeReportHeader();

                            $('#ledgerlist').append(
                                '<tr>' +
                                    '<td colspan="5" style="text-align:center;color:#777;padding:18px;font-weight:bold;">No data found.</td>' +
                                '</tr>'
                            );

                            $('#expandAllButton').hide();
                            $('#collapseAllButton').hide();
                        } else {
                            setNormalTrialBalanceHeader();

                            $('#ledgerlist').append(
                                '<tr>' +
                                    '<td colspan="7" style="text-align:center;color:#777;padding:18px;font-weight:bold;">No data found.</td>' +
                                '</tr>'
                            );
                        }

                        $('#lblFromDate').text(formatDateToDDMMMYYYY(FromDate) || '');
                        $('#lblToDate').text(formatDateToDDMMMYYYY(ToDate) || '');
                        $('#lblBusinessUnit').text(ComName);
                        $('#lblFinancialYear').text(FinYear);

                        return;
                    }

                    if (reportFormat === 'TB_TREE') {
                        setOracleTreeReportHeader();
                        renderOracleTreeReport(dtmaintable);

                        $('#expandAllButton').show();
                        $('#collapseAllButton').show();
                    } else {
                        setNormalTrialBalanceHeader();
                        renderGroupedTable(dtmaintable, reportFormat);

                        $('#expandAllButton').hide();
                        $('#collapseAllButton').hide();
                    }

                    $('#lblFromDate').text(formatDateToDDMMMYYYY(FromDate) || '');
                    $('#lblToDate').text(formatDateToDDMMMYYYY(ToDate) || '');
                    $('#lblBusinessUnit').text(ComName);
                    $('#lblFinancialYear').text(FinYear);
                },
                error: function (xhr, status, error) {
                    $('#ledgerlist').empty();

                    $('#ledgerlist').append(
                        '<tr>' +
                            '<td colspan="7" style="text-align:center;color:red;padding:18px;font-weight:bold;">Failed to load report data.</td>' +
                        '</tr>'
                    );

                    $('#expandAllButton').hide();
                    $('#collapseAllButton').hide();

                    toastr.error("Failed to load report data.");
                    console.log("Trial Balance Error:", error, xhr.responseText);
                },
                complete: function () {
                    setTimeout(function () {
                        $("#loadingSpinner").hide();
                    }, 2000);
                }
            });
        }

        // ============================================================
        //  GROUPED TABLE RENDERING FUNCTION
        //  reportFormat: 'TB' = Report Format 1, 'TBOT' = Report Format 2
        // ============================================================
        function renderGroupedTable(data, reportFormat) {
            var $tbody = $('#ledgerlist');
            $tbody.empty();

            var globalSL = 1;
            var grandTotalDebit = 0;
            var grandTotalCredit = 0;
            var grandTotalOpening = 0;
            var grandTotalClosing = 0;

            // ---- Step 1: Group by GLName ----
            var glGroups = groupBy(data, 'GLName');

            $.each(glGroups, function (glName, glRows) {

                var glTotalDebit = 0, glTotalCredit = 0, glTotalOpening = 0, glTotalClosing = 0;

                // ---- Step 2: Group by ControlLName ----
                var controlGroups = groupBy(glRows, 'ControlLName');

                var glHasValid = false;
                $.each(glRows, function (idx, row) {
                    if (shouldRenderTrialBalanceRow(row)) {
                        glHasValid = true;
                        return false;
                    }
                });
                if (!glHasValid) return;

                // GLName header row
                $tbody.append(`
                    <tr style="background-color: #1a3a5c;">
                        <td colspan="6" style="font-weight: bold; font-size: 14px; color: #ffffff; padding: 6px 10px; letter-spacing: 0.5px;">
                            ${glName || ''}
                        </td>
                    </tr>
                `);

                $.each(controlGroups, function (controlName, controlRows) {

                    var controlHasValid = false;
                    $.each(controlRows, function (idx, row) {
                        if (shouldRenderTrialBalanceRow(row)) {
                            controlHasValid = true;
                            return false;
                        }
                    });
                    if (!controlHasValid) return;

                    // ControlLName sub-header row
                    $tbody.append(`
                        <tr style="background-color: #d0dff0;">
                            <td colspan="6" style="font-weight: bold; font-size: 13px; color: #1a3a5c; padding: 5px 20px;">
                                ${controlName || ''}
                            </td>
                        </tr>
                    `);

                    var controlTotalDebit = 0, controlTotalCredit = 0, controlTotalOpening = 0, controlTotalClosing=0;

                    // ---- Step 3: Group by SubsidiryLName ----
                    var subsidiaryGroups = groupBy(controlRows, 'SubsidiryLName');

                    $.each(subsidiaryGroups, function (subsidiaryName, subsidiaryRows) {

                        var hasValidRows = false;
                        $.each(subsidiaryRows, function (idx, row) {
                            if (shouldRenderTrialBalanceRow(row)) {
                                hasValidRows = true;
                                return false;
                            }
                        });
                        if (!hasValidRows) return;

                        // SubsidiryLName group label row
                        if (subsidiaryName && subsidiaryName.trim() !== '') {
                            $tbody.append(`
                                <tr style="background-color: #eef3fa;">
                                    <td colspan="6" style="font-weight: bold; font-size: 12px; color: #285B86; padding: 4px 35px; border-left: 3px solid #285B86;">
                                        ${subsidiaryName}
                                    </td>
                                </tr>
                            `);
                        }

                        var subTotalDebit = 0, subTotalCredit = 0, subTotalOpening = 0, subTotalClosing=0 ;

                        // ---- Step 4: Actual data rows ----
                        $.each(subsidiaryRows, function (idx, row) {
                            var OpeningBalance = parseFloat(row.OpeningBalance) || 0;
                            var DebitAmount = parseFloat(row.DebitAmount) || 0;
                            var CreditAmount = parseFloat(row.CreditAmount) || 0;
                            var ClosingBalance = OpeningBalance + DebitAmount - CreditAmount;

                            if (!shouldRenderTrialBalanceRow(row)) {
                                return;
                            }

                            subTotalDebit   += DebitAmount;
                            subTotalCredit  += CreditAmount;
                            subTotalOpening += OpeningBalance;
                            subTotalClosing += ClosingBalance;
                            $tbody.append(`
                                <tr style="background-color: #ffffff;">
                                    <td style="text-align: center; padding: 3px 6px;">${globalSL++}</td>
                                    <td style="text-align: left; padding: 3px 6px; padding-left: 45px;">${row.AccountCode || ''}</td>
                                    <td style="text-align: left; padding: 3px 6px;">${row.AccountName || ''}</td>
                                    <td style="text-align: right; padding: 3px 6px;">${fmt(OpeningBalance)}</td>
                                    <td style="text-align: right; padding: 3px 6px;">${fmt(DebitAmount)}</td>
                                    <td style="text-align: right; padding: 3px 6px;">${fmt(CreditAmount)}</td>
                                    <td style="text-align: right; padding: 3px 6px;">${fmt(ClosingBalance)}</td>
                                </tr>
                            `);
                        });

                        // Subsidiary Total row
                        $tbody.append(`
                            <tr style="background-color: #dce8f7; font-weight: bold;">
                                <td colspan="3" style="text-align: right; padding: 3px 10px; color: #1a3a5c; font-size: 12px;">Subsidiary Total</td>
                                <td style="text-align: right; padding: 3px 6px;">${fmt(subTotalOpening)}</td>
                                <td style="text-align: right; padding: 3px 6px;">${fmt(subTotalDebit)}</td>
                                <td style="text-align: right; padding: 3px 6px;">${fmt(subTotalCredit)}</td>
                                <td style="text-align: right; padding: 3px 6px;">${fmt(subTotalClosing)}</td>
                            </tr>
                        `);

                        controlTotalDebit   += subTotalDebit;
                        controlTotalCredit  += subTotalCredit;
                        controlTotalOpening += subTotalOpening;
                        controlTotalClosing += subTotalClosing;
                    });

                    // Control Ledger Total row
                    $tbody.append(`
                        <tr style="background-color: #b8cfe8; font-weight: bold;">
                            <td colspan="3" style="text-align: right; padding: 4px 10px; color: #0d2a45; font-size: 12px;">${controlName} Total</td>
                            <td style="text-align: right; padding: 4px 6px;">${fmt(controlTotalOpening)}</td>
                            <td style="text-align: right; padding: 4px 6px;">${fmt(controlTotalDebit)}</td>
                            <td style="text-align: right; padding: 4px 6px;">${fmt(controlTotalCredit)}</td>
                            <td style="text-align: right; padding: 4px 6px;">${fmt(controlTotalClosing)}</td>
                        </tr>
                    `);

                    glTotalDebit   += controlTotalDebit;
                    glTotalCredit  += controlTotalCredit;
                    glTotalOpening += controlTotalOpening;
                    glTotalClosing += controlTotalClosing;
                });

                // GL Head Total row
                $tbody.append(`
                    <tr style="background-color: #7a9fc2; font-weight: bold;">
                        <td colspan="3" style="text-align: right; padding: 5px 10px; color: #fff; font-size: 13px;">${glName} Total</td>
                        <td style="text-align: right; padding: 5px 6px; color: #fff;">${fmt(glTotalOpening)}</td>
                        <td style="text-align: right; padding: 5px 6px; color: #fff;">${fmt(glTotalDebit)}</td>
                        <td style="text-align: right; padding: 5px 6px; color: #fff;">${fmt(glTotalCredit)}</td>
                        <td style="text-align: right; padding: 5px 6px; color: #fff;">${fmt(glTotalClosing)}</td>
                    </tr>
                    <tr><td colspan="6" style="padding: 3px;"></td></tr>
                `);

                grandTotalDebit   += glTotalDebit;
                grandTotalCredit  += glTotalCredit;
                grandTotalOpening += glTotalOpening;
                grandTotalClosing += glTotalClosing;
            });

            // Grand Total row
            $tbody.append(`
                <tr style="background-color: #d6e0f0; font-weight: bold; border-top: 2px solid #285B86;">
                    <td colspan="3" style="text-align: right; padding: 6px 10px; font-size: 14px;">Grand Total</td>
                    <td style="text-align: right; padding: 6px 6px; font-size: 14px;">${fmt(grandTotalOpening)}</td>
                    <td style="text-align: right; padding: 6px 6px; font-size: 14px;">${fmt(grandTotalDebit)}</td>
                    <td style="text-align: right; padding: 6px 6px; font-size: 14px;">${fmt(grandTotalCredit)}</td>
                    <td style="text-align: right; padding: 6px 6px; font-size: 14px;">${fmt(grandTotalClosing)}</td>
                </tr>
            `);
        }

        // Helper: Group array of objects by a key
        function groupBy(array, key) {
            var result = {};
            $.each(array, function (i, item) {
                var groupKey = item[key] || '';
                if (!result[groupKey]) result[groupKey] = [];
                result[groupKey].push(item);
            });
            return result;
        }

        // Helper: Format number
        function fmt(num) {
            return (parseFloat(num) || 0).toLocaleString('en-IN', {
                minimumFractionDigits: 2,
                maximumFractionDigits: 2
            });
        }

        function shouldRenderTrialBalanceRow(row) {
            var openingBalance = parseFloat(row.OpeningBalance) || 0;
            var debitAmount = parseFloat(row.DebitAmount) || 0;
            var creditAmount = parseFloat(row.CreditAmount) || 0;
            var closingBalance = openingBalance + debitAmount - creditAmount;

            return closingBalance !== 0;
        }

        function formatDateToDDMMMYYYY(dateString) {
            if (!dateString) return "";
            var date = new Date(dateString);
            if (isNaN(date)) return "";
            var day = ("0" + date.getDate()).slice(-2);
            var monthNames = ["Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"];
            var month = monthNames[date.getMonth()];
            var year = date.getFullYear();
            return day + "-" + month + "-" + year;
        }

        // ---- Print Button ----
        document.getElementById("printButton").addEventListener("click", function () {
            var printContents = document.getElementById("dtTb").outerHTML;
            document.body.innerHTML = `
                <html>
                    <head>
                        <title>Print Table</title>
                        <link rel="stylesheet" href="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/css/bootstrap.min.css">
                        <style>
                            table { width: 100%; border-collapse: collapse; }
                            th, td { border: 1px solid #ccc; padding: 4px 8px; font-size: 12px; }
                        </style>
                    </head>
                    <body>
                        <div>${printContents}</div>
                    </body>
                </html>`;
            window.print();
            location.reload();
        });

        // ---- Export to Excel Button ----
        $('#exportButton').click(function () {
            $("#loadingSpinner").show();
            setTimeout(function () {
                var table = document.getElementById("dtTb");
                var workbook = XLSX.utils.table_to_book(table, { sheet: "Sheet1" });

                var now = new Date();
                var day = ("0" + now.getDate()).slice(-2);
                var monthNames = ["Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"];
                var month = monthNames[now.getMonth()];
                var year = now.getFullYear();
                var hour = ("0" + now.getHours()).slice(-2);
                var minute = ("0" + now.getMinutes()).slice(-2);
                var second = ("0" + now.getSeconds()).slice(-2);
                var dateTime = day + "-" + month + "-" + year + " " + hour + "-" + minute + "-" + second;
                var fileName = 'Trial Balance Report ' + dateTime + '.xlsx';

                XLSX.writeFile(workbook, fileName);
                $("#loadingSpinner").hide();
            }, 3000);
        });


        // ============================================================
        //  REPORT FORMAT HEADER
        // ============================================================
        function setNormalTrialBalanceHeader() {
            $('#dtTb').removeClass('oracle-tree-table');

            $('#dtTb thead').eq(0).html(`
        <tr>
            <th colspan="7" style="text-align: center; font-weight: bold; font-size: 16px; color: blue;">
                <label id="lblheading">Trial Balance Report</label>
            </th>
        </tr>
        <tr>
            <td colspan="2" style="font-weight: bold; font-size: 15px !important;">Business Unit:</td>
            <td colspan="2"><label style="font-size: 15px !important;" id="lblBusinessUnit"></label></td>
            <td style="font-weight: bold; font-size: 15px !important;">From Date:</td>
            <td colspan="2"><label style="font-size: 15px !important;" id="lblFromDate"></label></td>
