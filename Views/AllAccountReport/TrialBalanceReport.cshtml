        function showOracleTreeChildren(parentId) {
            $('#ledgerlist tr[data-parent="' + parentId + '"]').show();
        }

        function collapseOracleTreeChildren(parentId) {
            var $children = $('#ledgerlist tr[data-parent="' + parentId + '"]');

            $children.each(function () {
                var childId = $(this).attr('data-id');

                collapseOracleTreeChildren(childId);

                $(this).hide();
                $(this).removeClass('tree-open');
                $(this).find('.tree-toggle').first().text('+');
            });
        }

        function expandOracleTreeAll() {
            $('#ledgerlist tr').show();

            $('#ledgerlist tr.tree-clickable').each(function () {
                $(this).addClass('tree-open');
                $(this).find('.tree-toggle').first().text('-');
            });

            $('#ledgerlist tr.tree-grand-total-row').show();
        }

        function collapseOracleTreeAll() {
            $('#ledgerlist tr.tree-level-2, #ledgerlist tr.tree-level-3, #ledgerlist tr.tree-level-4, #ledgerlist tr.tree-level-5').hide();

            $('#ledgerlist tr.tree-gl-row').show();
            $('#ledgerlist tr.tree-grand-total-row').show();

            $('#ledgerlist tr.tree-clickable').each(function () {
                $(this).removeClass('tree-open');
                $(this).find('.tree-toggle').first().text('+');
            });
        }

        function sortOracleTreeData(a, b) {
            var sideA = getNaturalBalanceSideOrder(a);
            var sideB = getNaturalBalanceSideOrder(b);

            if (sideA !== sideB) return sideA - sideB;

            var glA = parseInt(a.GLHeadId || 0);
            var glB = parseInt(b.GLHeadId || 0);

            if (glA !== glB) return glA - glB;

            var controlCompare = compareText(a.ControlLCode, b.ControlLCode);
            if (controlCompare !== 0) return controlCompare;

            var subCompare = compareText(a.SubControlCode, b.SubControlCode);
            if (subCompare !== 0) return subCompare;

            var subSubCompare = compareText(a.SubSubControlCode, b.SubSubControlCode);
            if (subSubCompare !== 0) return subSubCompare;

            return compareText(a.AccountCode, b.AccountCode);
        }

        function getNaturalBalanceSide(row) {
            var glName = (row.GLName || '').toString().trim().toLowerCase();
            if (glName === 'assets' || glName === 'asset' || glName === 'expenses' || glName === 'expense') {
                return 'Debit Balance';
            }
            return 'Credit Balance';
        }

        function getNaturalBalanceSideOrder(row) {
            var side = getNaturalBalanceSide(row);

            if (side === 'Debit Balance') return 1;
            if (side === 'Credit Balance') return 2;

            return 3;
        }

        function getActualBalanceSide(row) {
            var dc = getOracleBalanceDebitCredit(row);

            if (dc.debit > 0) return 'Debit Balance';
            if (dc.credit > 0) return 'Credit Balance';

            return 'Zero Balance';
        }

        function getActualBalanceSideOrder(row) {
            var side = getActualBalanceSide(row);

            if (side === 'Debit Balance') return 1;
            if (side === 'Credit Balance') return 2;

            return 3;
        }

        function getOracleBalanceDebitCredit(row) {
            if (row.BalanceDebit != null || row.BalanceCredit != null) {
                return {
                    debit: parseFloat(row.BalanceDebit) || 0,
                    credit: parseFloat(row.BalanceCredit) || 0
                };
            }

            var closing = parseFloat(row.ClosingBalance) || 0;
            var balanceType = (row.BalanceType || '').toString().trim().toLowerCase();

            if (balanceType === 'dr') {
                return closing >= 0
                    ? { debit: closing, credit: 0 }
                    : { debit: 0, credit: Math.abs(closing) };
            }

            if (balanceType === 'cr') {
                return closing >= 0
                    ? { debit: 0, credit: closing }
                    : { debit: Math.abs(closing), credit: 0 };
            }

            return closing >= 0
                ? { debit: closing, credit: 0 }
                : { debit: 0, credit: Math.abs(closing) };
        }

        function sumOracleTreeRows(rows, isCreditSide) {
            var total = {
                debit: 0,
                credit: 0
            };

            $.each(rows, function (i, row) {
                var dc = getOracleBalanceDebitCredit(row);
                total.debit += dc.debit;
                total.credit += dc.credit;
            });

            if (isCreditSide) {
                var net = total.credit - total.debit;
                if (net >= 0) {
                    total.credit = net;
                    total.debit = 0;
                } else {
                    total.credit = 0;
                    total.debit = Math.abs(net);
                }
            } else {
                var net = total.debit - total.credit;
                if (net >= 0) {
                    total.debit = net;
                    total.credit = 0;
                } else {
                    total.debit = 0;
                    total.credit = Math.abs(net);
                }
            }

            return total;
        }

        function oracleGroupBy(array, keySelector) {
            var result = {};

            $.each(array, function (i, item) {
                var key = keySelector(item) || 'N/A';

                if (!result[key]) {
                    result[key] = [];
                }

                result[key].push(item);
            });

            return result;
        }

        function compareText(a, b) {
            a = (a || '').toString();
            b = (b || '').toString();

            return a.localeCompare(b);
        }

        function fmtTree(num) {
            var value = parseFloat(num) || 0;

            if (Math.abs(value) <= 0.0001) {
                return '-';
            }

            return value.toLocaleString('en-IN', {
                minimumFractionDigits: 2,
                maximumFractionDigits: 2
            });
        }

        function htmlEncode(value) {
            return $('<div/>').text(value == null ? '' : value).html();
        }

    </script>
