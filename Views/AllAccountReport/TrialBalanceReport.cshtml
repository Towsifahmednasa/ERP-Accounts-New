@* Trial Balance Report laid out like the wireframe "Trial balance" screen: title, filter bar (company / type / ledger drill-down /
   period / report format) with Expand, Collapse, Export, Print and Go actions, and one report card with the statement header and
   the table. The grouped sub-totals (Subsidiary / Control / GL head / Grand Total rows) are kept. Element ids, inline handlers,
   the table (#dtTb / #ledgerlist) and the page scripts are the same contract as before. *@
@{
    ViewBag.Title = "Trial Balance Report";
    Layout = "~/Views/Shared/_Layout.cshtml";
}


<style>
    .hidden { display: none; }
    .rp-filter { border-radius: 12px; box-shadow: var(--sapContent_Shadow0); margin-bottom: 14px; padding: 12px 20px 14px; }
    .rp-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(230px, 1fr)); gap: 12px 18px; align-items: end; }
    .rp-grid .fld { min-width: 0; }
    .rp-grid .form-control, .rp-grid .form-select { width: 100%; }
    .rp-full { grid-column: 1 / -1; }
    .rp-wide { grid-column: span 2; }
    .rp-radios { display: flex; gap: 18px; flex-wrap: wrap; align-items: center; min-height: 34px; }
    .rp-radios label { display: inline-flex; align-items: center; gap: 6px; font-size: 13px !important; color: var(--sapTextColor) !important; cursor: pointer; padding: 0 !important; }
    .rp-acts { display: flex; gap: 7px; flex-wrap: wrap; justify-content: flex-end; margin-top: 12px; }
    .rp-card { background: #fff; border-radius: 12px; box-shadow: var(--sapContent_Shadow0); overflow: hidden; }
    .rp-hd { padding: 10px 14px; border-bottom: 1px solid var(--sapList_HeaderBorderColor); display: flex; align-items: center; gap: 8px; }
    .rp-hd b { font-size: 13.5px; }
    .rp-scroll { max-height: calc(100vh - 260px); min-height: 200px; overflow: auto; }

    #dtTb { width: 100%; margin: 0; border-collapse: collapse; font-size: 12.5px; }
    #dtTb td, #dtTb th { border: 0; border-bottom: 1px solid var(--sapList_BorderColor); padding: 7px 10px; vertical-align: middle; font-variant-numeric: tabular-nums; }
    #dtTb thead.rp-meta td, #dtTb thead.rp-meta th { padding: 6px 14px; border-bottom: 0; background: #fff; }
    #dtTb thead.rp-meta .rp-title { text-align: center; font-size: 15px; font-weight: 600; padding-top: 12px; color: var(--sapTextColor) !important; }
    #dtTb thead.rp-meta .k { color: var(--sapContent_LabelColor); font-size: 12px; font-weight: 400; white-space: nowrap; }
    #dtTb thead.rp-meta label { font-size: 13px !important; color: var(--sapTextColor) !important; font-weight: 600 !important; padding: 0 !important; }
    #dtTb thead.rp-cols th { position: sticky; top: 0; z-index: 2; background: #fafbfc !important; color: var(--sapContent_LabelColor) !important; font-size: 12px; font-weight: 600; border-top: 1px solid var(--sapList_HeaderBorderColor); border-bottom: 1px solid var(--sapList_HeaderBorderColor); white-space: nowrap; }

    /* Report format 1 rows are rendered with inline colours; map the group headers onto the wireframe's grey band.
       The sub-total / total rows (#dce8f7, #b8cfe8, #7a9fc2, #d6e0f0) are intentionally left as they were. */
    #ledgerlist tr[style*="background-color: #1a3a5c"] td { background: #f2f4f6 !important; color: var(--sapTextColor) !important; font-size: 13px !important; letter-spacing: 0 !important; }
    #ledgerlist tr[style*="background-color: #d0dff0"] td { background: #f8fafc !important; color: var(--sapTextColor) !important; }
    #ledgerlist tr[style*="background-color: #eef3fa"] td { color: var(--sapLinkColor) !important; border-left-color: var(--sapBrandColor) !important; }
    #ledgerlist tr[style*="background-color: #ffffff"]:hover { background: #f5f9fe !important; }

    /* Report format 2: tree table */
    .oracle-tree-wrap { overflow-x: auto; }
    #dtTb.oracle-tree-table { min-width: 900px; table-layout: auto; }
    #dtTb.oracle-tree-table .tree-sl { min-width: 60px; width: 60px; text-align: center; color: var(--sapContent_LabelColor); }
    #dtTb.oracle-tree-table .tree-code { min-width: 130px; white-space: nowrap; color: var(--sapLinkColor); font-weight: 600; }
    #dtTb.oracle-tree-table .tree-name { min-width: 320px; white-space: nowrap; }
    #dtTb.oracle-tree-table .tree-amount { min-width: 150px; text-align: right !important; white-space: nowrap; }
    #dtTb.oracle-tree-table .tree-side-row td,
    #dtTb.oracle-tree-table .tree-debit-side td,
    #dtTb.oracle-tree-table .tree-credit-side td { background: #f2f4f6 !important; color: var(--sapTextColor) !important; font-weight: 700; font-size: 13px; }
    #dtTb.oracle-tree-table .tree-gl-row td { font-weight: 700; }
    #dtTb.oracle-tree-table .tree-control-row td { background: #f8fafc !important; color: var(--sapTextColor) !important; font-weight: 600; }
    #dtTb.oracle-tree-table .tree-sub-row td { background: #fff !important; color: var(--sapLinkColor) !important; font-weight: 600; }
    #dtTb.oracle-tree-table .tree-subsub-row td { background: #fff !important; color: var(--sapTextColor) !important; font-weight: 600; }
    #dtTb.oracle-tree-table .tree-account-row td { background: #fff !important; }
    #dtTb.oracle-tree-table .tree-account-row:hover td { background: #f5f9fe !important; }
    #dtTb.oracle-tree-table .tree-grand-total-row td { background: #dce8f7 !important; color: #102f4f !important; font-weight: 800; font-size: 13.5px; border-top: 2px solid #285b86 !important; }
    #dtTb.oracle-tree-table .tree-clickable { cursor: pointer; user-select: none; }
    #dtTb.oracle-tree-table .tree-toggle { display: inline-block; width: 18px; font-weight: bold; text-align: center; }
    #dtTb.oracle-tree-table .tree-toggle-empty { visibility: hidden; }
    #dtTb.oracle-tree-table .tree-account-row { cursor: default; }
    #dtTb.oracle-tree-table .tree-level-1 .tree-name { padding-left: 34px !important; }
    #dtTb.oracle-tree-table .tree-level-2 .tree-name { padding-left: 58px !important; }
    #dtTb.oracle-tree-table .tree-level-3 .tree-name { padding-left: 82px !important; }
    #dtTb.oracle-tree-table .tree-level-4 .tree-name { padding-left: 106px !important; }
    #dtTb.oracle-tree-table .tree-level-5 .tree-name { padding-left: 130px !important; }
</style>


<div id="loadingSpinner" style="display:none;">
    <div class="overlay"></div>
    <div class="spinner-container">
        <div class="spinner"></div>
        <div class="loading-text">Loading...</div>
    </div>
</div>

<div style="margin:0 0 12px"><h5 class="mb-0 cstlfs" style="font-size:20px !important">Trial Balance Report</h5></div>

<div class="filterbar rp-filter">
    <div class="rp-grid">
        <div class="fld" id="divCompany">
            <label for="ddlCompany">Company <span class="required">*</span></label>
            <select class="form-select form-select-sm select2" style="width: 100%;" id="ddlCompany" onchange="LoadDDlbyCom()"></select>
        </div>
        <div class="fld rp-wide">
            <label>Type <span class="required">*</span></label>
            <div class="rp-radios">
                <label for="COA"><input type="radio" id="COA" name="category" value="coa" checked="checked" onchange="OnLedgerTypeChange()" /> GL</label>
                <label for="subsidiary"><input type="radio" id="subsidiary" name="category" value="subsidiary" onchange="OnLedgerTypeChange()" /> Subsidiary</label>
                <label for="cost-center"><input type="radio" id="cost-center" name="category" value="cost-center" onchange="OnLedgerTypeChange()" /> Cost Center</label>
                <label for="reference"><input type="radio" id="reference" name="category" value="reference" onchange="OnLedgerTypeChange()" /> Reference</label>
            </div>
        </div>

        <div class="rp-full" id="coa-div">
            <div class="rp-grid">
                <div class="fld">
                    <label for="ddlLedgerHead">Ledger Head</label>
                    <select class="form-select form-select-sm select2" style="width: 100%;" onchange="LoadControlLedger()" id="ddlLedgerHead"></select>
                </div>
                <div class="fld">
                    <label for="ddlControlLedger">Control Ledger</label>
                    <select class="form-select form-select-sm select2" style="width: 100%;" onchange="LoadSubsidaryLedger()" id="ddlControlLedger"></select>
                </div>
                <div class="fld">
                    <label for="ddlSubControlLedger">Sub Control Ledger</label>
                    <select class="form-select form-select-sm select2" style="width: 100%;" onchange="LoadSubSubControlLedger()" id="ddlSubControlLedger"></select>
                </div>
                <div class="fld">
                    <label for="ddlSubSubControlLedger">Sub Sub Control Ledger</label>
                    <select class="form-select form-select-sm select2" style="width: 100%;" id="ddlSubSubControlLedger"></select>
                </div>
            </div>
        </div>

        <div class="rp-full hidden" id="subsidiary-div">
            <div class="rp-grid">
                <div class="fld">
                    <label for="ddlSubsidiaryType">Subsidiary Type <span style="color: orangered !important;">*</span></label>
                    <select class="form-select form-select-sm select2" onchange="GetSubsidoryByType()" style="width: 100%;" id="ddlSubsidiaryType"></select>
                </div>
                <div class="fld">
                    <label for="ddlSubsidiary">Subsidiary <span style="color: orangered !important;">*</span></label>
                    <select class="form-select form-select-sm select2" style="width: 100%;" id="ddlSubsidiary"></select>
                </div>
            </div>
        </div>

        <div class="rp-full hidden" id="reference-div">
            <div class="rp-grid">
                <div class="fld">
                    <label for="ddlReferenceType">Reference Type <span style="color: orangered !important;">*</span></label>
                    <select class="form-select form-select-sm select2" onchange="GetReferenceByType()" style="width: 100%;" id="ddlReferenceType"></select>
                </div>
                <div class="fld">
                    <label for="ddlReference">Reference <span style="color: orangered !important;">*</span></label>
                    <select class="form-select form-select-sm select2" style="width: 100%;" id="ddlReference"></select>
                </div>
            </div>
        </div>

        <div class="rp-full hidden" id="cs-div">
            <div class="rp-grid">
                <div class="fld">
                    <label for="ddlCS">Cost Center <span style="color: orangered !important;">*</span></label>
                    <select class="form-select form-select-sm select2" style="width: 100%;" id="ddlCS"></select>
                </div>
            </div>
        </div>

        <div class="fld" id="divFinansialYear">
            <label for="ddlFinansialYear">Financial Year <span class="required">*</span></label>
            <select class="form-select form-select-sm select2" style="width: 100%;" id="ddlFinansialYear" onchange="LoadDaterangebyFiscal()"></select>
        </div>
        <div class="fld">
            <label for="txtfrmDate">From Date <span class="required">*</span></label>
            <input type="text" id="txtfrmDate" class="form-control form-control-sm datepicker" value="@DateTime.Now.ToString("dd MMMM, yyyy")" />
        </div>
        <div class="fld">
            <label for="txtToDate">To Date <span class="required">*</span></label>
            <input type="text" id="txtToDate" class="form-control form-control-sm datepicker" value="@DateTime.Now.ToString("dd MMMM, yyyy")" />
        </div>
        <div class="fld" id="divTransactionType">
            <label>Report Format</label>
            <div class="rp-radios">
                <input style="display:none" type="radio" name="rbTransactionType" value="TTT" id="CumulativeReportRadio" />
                <label for="CumulativeReportRadio" style="display: none">Cumulative Report</label>

                <label for="DetailReportRadio"><input type="radio" id="DetailReportRadio" name="rbTransactionType" value="TB"> Report Format 1</label>

                <input type="radio" style="display:none" id="DetailReportTransactionRadio" name="rbTransactionType" value="TBOT">
                <label for="DetailReportTransactionRadio" style="display:none">Report Format 2</label>

                <label for="OracleTreeReportRadio"><input type="radio" id="OracleTreeReportRadio" name="rbTransactionType" value="TB_TREE"> Report Format 2</label>

                <input type="radio" style="display:none" id="SubsidiarySummaryReportRadio" name="rbTransactionType" value="TBS">
                <label for="SubsidiarySummaryReportRadio" style="display: none">Subsidiary Summary Report</label>
            </div>
        </div>
    </div>

    <div class="rp-acts">
        <button id="expandAllButton" class="btn sm" type="button" style="display:none;"><svg width="13" height="13"><use href="#s-plus"/></svg> Expand All</button>
        <button id="collapseAllButton" class="btn sm" type="button" style="display:none;"><svg width="13" height="13"><use href="#s-up"/></svg> Collapse All</button>
        <button id="exportButton" class="btn sm" type="button"><svg width="13" height="13"><use href="#s-dl"/></svg> Export to Excel</button>
        <button id="printButton" class="btn sm" type="button"><svg width="13" height="13"><use href="#s-doc"/></svg> Print</button>
        <button class="btn emph" id="Reject" type="button" onclick="PrintReport()"><svg width="13" height="13"><use href="#s-search"/></svg> Go</button>
    </div>
</div>

<div class="rp-card">
    <div class="rp-hd"><b>Trial balance</b></div>
    <div class="rp-scroll">
        <table id="dtTb">
            <thead class="rp-meta">
                <tr><th colspan="7" class="rp-title"><label id="lblheading">Trial Balance Report</label></th></tr>
                <tr>
                    <td colspan="2" class="k">Business Unit</td>
                    <td colspan="2"><label id="lblBusinessUnit"></label></td>
                    <td class="k">From Date</td>
                    <td colspan="2"><label id="lblFromDate"></label></td>
                </tr>
                <tr>
                    <td colspan="2" class="k">Financial Year</td>
                    <td colspan="2"><label id="lblFinancialYear"></label></td>
                    <td class="k">To Date</td>
                    <td colspan="2"><label id="lblToDate"></label></td>
                </tr>
            </thead>

            <thead class="rp-cols">
                <tr>
                    <th style="text-align: center; width: 5%;">SL</th>
                    <th style="text-align: left; width: 20%;">Code</th>
                    <th style="text-align: left; width: 30%;">Account Name</th>
                    <th style="text-align: right; width: 15%;">Opening Balance</th>
                    <th style="text-align: right; width: 15%;">Debit Amount</th>
                    <th style="text-align: right; width: 15%;">Credit Amount</th>
                    <th style="text-align: right; width: 14%;">Closing Balance</th>
                </tr>
            </thead>

            <tbody id="ledgerlist">
                <!-- Grouped rows will be rendered here -->
            </tbody>
        </table>
    </div>
</div>


@section Scripts
{
    <script type="text/javascript">

        $(document).ready(function () {
            LoadCompany('ddlCompany');
            LoadLadgerHead();
            GetSubsidaryType();
            GetReferenceType();
            initializeLedgerTypeDropdowns();
            OnLedgerTypeChange();
            $('#expandAllButton').hide();
            $('#collapseAllButton').hide();
            $('#expandAllButton').off('click').on('click', function () {
                expandOracleTreeAll();
            });
            $('#collapseAllButton').off('click').on('click', function () {
                collapseOracleTreeAll();
            });
            $('input[name="rbTransactionType"]').off('change').on('change', function () {
                resetTrialBalanceGridByFormat();
            });
        });

        function resetTrialBalanceGridByFormat() {
            $('#ledgerlist').empty();
            $('#expandAllButton').hide();
            $('#collapseAllButton').hide();

            if ($('#OracleTreeReportRadio').is(':checked')) {
                setOracleTreeReportHeader();
            } else {
                setNormalTrialBalanceHeader();
            }

            $('#lblBusinessUnit').text('');
            $('#lblFinancialYear').text('');
            $('#lblFromDate').text('');
            $('#lblToDate').text('');
        }

        function initializeLedgerTypeDropdowns() {
            $('#ddlSubsidiaryType').empty().append("<option value='0'>--Select--</option>");
            $('#ddlSubsidiary').empty().append("<option value='0'>--Select Subsidiary--</option>");
            $('#ddlReferenceType').empty().append("<option value='0'>--Select--</option>");
            $('#ddlReference').empty().append("<option value='0'>--Select--</option>");
            $('#ddlCS').empty().append("<option value='0'>--Select Cost Center--</option>");
        }

        function OnLedgerTypeChange() {
            var ledgerType = $('input[name="category"]:checked').val();

            if (!ledgerType) {
                ledgerType = 'coa';
                $('#COA').prop('checked', true);
            }

            $('#ledgerlist').empty();
            $('#lblBusinessUnit').text('');
            $('#lblFinancialYear').text('');
            $('#lblFromDate').text('');
            $('#lblToDate').text('');
            $('#coa-div').hide();
            $('#subsidiary-div').hide();
            $('#reference-div').hide();
            $('#cs-div').hide();

            if (ledgerType === 'coa') {
                $('#coa-div').show();
                $('#ddlLedgerHead').prop('disabled', false);
                $('#ddlControlLedger').prop('disabled', false);
                $('#ddlSubControlLedger').prop('disabled', false);
                $('#ddlSubSubControlLedger').prop('disabled', false);

                if ($.fn.select2) {
                    $('#ddlLedgerHead').trigger('change.select2');
                    $('#ddlControlLedger').trigger('change.select2');
                    $('#ddlSubControlLedger').trigger('change.select2');
                    $('#ddlSubSubControlLedger').trigger('change.select2');
                }

                return;
            }

            $('#ddlLedgerHead').val('0').prop('disabled', true);
            $('#ddlControlLedger').empty().append("<option value='0'>--Select Control Ledger--</option>").prop('disabled', true);
            $('#ddlSubControlLedger').empty().append("<option value='0'>--Select Control Ledger--</option>").prop('disabled', true);
            $('#ddlSubSubControlLedger').empty().append("<option value='0'>--Select Sub Sub Control Ledger--</option>").prop('disabled', true);

            if (ledgerType === 'subsidiary') {
                $('#subsidiary-div').show();
                if ($('#ddlSubsidiaryType option').length <= 1) {
                    GetSubsidaryType();
                }
                if (($('#ddlSubsidiaryType').val() || '0') === '0' && $('#ddlSubsidiaryType option').length > 1) {
                    $('#ddlSubsidiaryType').val($('#ddlSubsidiaryType option:eq(1)').val());
                }
                GetSubsidoryByType();
            } else if (ledgerType === 'reference') {
                $('#reference-div').show();
                if ($('#ddlReferenceType option').length <= 1) {
                    GetReferenceType();
                }
                if (($('#ddlReferenceType').val() || '0') === '0' && $('#ddlReferenceType option').length > 1) {
                    $('#ddlReferenceType').val($('#ddlReferenceType option:eq(1)').val());
                }
                GetReferenceByType();
            } else if (ledgerType === 'cost-center') {
                $('#cs-div').show();
                GetCostCenterList();
            }

            if ($.fn.select2) {
                $('#ddlLedgerHead').trigger('change.select2');
                $('#ddlControlLedger').trigger('change.select2');
                $('#ddlSubControlLedger').trigger('change.select2');
                $('#ddlSubSubControlLedger').trigger('change.select2');
                $('#ddlSubsidiaryType').trigger('change.select2');
                $('#ddlSubsidiary').trigger('change.select2');
                $('#ddlReferenceType').trigger('change.select2');
                $('#ddlReference').trigger('change.select2');
                $('#ddlCS').trigger('change.select2');
            }
        }

        function LoadDDlbyCom() {
            LoadFinansialYear();
            _loadCashAccountbyCom();
            if ($('input[name="category"]:checked').val() === 'reference') {
                $('#ddlReference').empty().append("<option value='0'>--Select--</option>");
            }
            if ($('input[name="category"]:checked').val() === 'cost-center') {
                $('#ddlCS').empty().append("<option value='0'>--Select Cost Center--</option>");
            }
            OnLedgerTypeChange();
        }

        function LoadLadgerHead() {
            $.ajax({
                url: "/Utility/GetLadgerHead",
                contentType: "application/json; charset=utf-8",
                dataType: 'json',
                type: "Get",
                data: {},
                async: false,
                success: function (data) {
                    $('#ddlLedgerHead').empty();
                    $('#ddlLedgerHead').append("<option value='0'>--Select  Ledger Head--</option>");
                    for (var i = 0; i < data.length; i++) {
                        $('#ddlLedgerHead').append($("<option></option>").val(data[i].GLHeadId).html(data[i].GLName));
                    }
                }
            });
        }

        function LoadControlLedger() {
            var LedgerHeadId = $("#ddlLedgerHead").val();
            $.ajax({
                url: "/Utility/LoadControlLedgerByLedgerHeadId",
                contentType: "application/json; charset=utf-8",
                dataType: 'json',
                type: "Get",
                data: { LedgerHeadId: LedgerHeadId },
                async: false,
                success: function (data) {
                    $('#ddlControlLedger').empty();
                    $('#ddlControlLedger').append("<option value='0'>--Select Control Ledger--</option>");
                    for (var i = 0; i < data.length; i++) {
                        $('#ddlControlLedger').append($("<option></option>").val(data[i].ControlLId).html(data[i].ControlLName));
                    }
                }
            });
        }

        function LoadSubsidaryLedger() {
            var ControlLedgerId = $("#ddlControlLedger").val();
            $.ajax({
                url: "/Utility/LoadSubsidaryByControlLedgerId",
                contentType: "application/json; charset=utf-8",
                dataType: 'json',
                type: "Get",
                data: { ControlLedgerId: ControlLedgerId },
                async: false,
                success: function (data) {
                    $('#ddlSubControlLedger').empty();
                    $('#ddlSubControlLedger').append("<option value='0'>--Select Control Ledger--</option>");
                    for (var i = 0; i < data.length; i++) {
                        $('#ddlSubControlLedger').append($("<option></option>").val(data[i].SubsidiryLId).html(data[i].SubsidiryLName));
                    }
                }
            });
        }

        function LoadSubSubControlLedger() {
            var SubControlLedgerId = $("#ddlSubControlLedger").val();
            $.ajax({
                url: "/Utility/LoadSubSubControlLedgerId",
                contentType: "application/json; charset=utf-8",
                dataType: 'json',
                type: "Get",
                data: { SubControlLedgerId: SubControlLedgerId },
                async: false,
                success: function (data) {
                    $('#ddlSubSubControlLedger').empty();
                    $('#ddlSubSubControlLedger').append("<option value='0'>--Select Sub Sub Control Ledger--</option>");
                    for (var i = 0; i < data.length; i++) {
                        $('#ddlSubSubControlLedger').append($("<option></option>").val(data[i].SubSubControlLedgerId).html(data[i].SubSubControlLedgerName));
                    }
                }
            });
        }

        function LoadDaterangebyFiscal() {
            var companyId = $("#ddlCompany").val();
            var FinancialYearId = $("#ddlFinansialYear").val();
            $.ajax({
                url: "/Utility/GetDaterangebyFiscal",
                contentType: "application/json; charset=utf-8",
                dataType: 'json',
                type: "Get",
                data: { companyId: companyId, FinancialYearId: FinancialYearId },
                async: false,
                success: function (data) {
                    $('#txtfrmDate').val((data.StartDate));
                    $('#txtToDate').val((data.EndDate));
                }
            });
        }

        function LoadFinansialYear() {
            var companyId = $("#ddlCompany").val();
            $.ajax({
                url: "/Utility/GetFinansialYearComId",
                contentType: "application/json; charset=utf-8",
                dataType: 'json',
                type: "Get",
                data: { companyId: companyId },
                async: false,
                success: function (data) {
                    $('#ddlFinansialYear').empty();
                    $('#ddlFinansialYear').append("<option value='0'>--Select Financial Year--</option>");
                    for (var i = 0; i < data.length; i++) {
                        $('#ddlFinansialYear').append($("<option></option>").val(data[i].FinancialYearId).html(data[i].FinancialYearDesc));
                    }
                }
            });
        }

        function _loadCashAccountbyCom() {
            var companyId = $("#ddlCompany").val();
            $.ajax({
                url: "/Utility/GetCashAccountbyCom",
                contentType: "application/json; charset=utf-8",
                dataType: 'json',
                type: "Get",
                data: { companyId: companyId },
                async: false,
                success: function (data) {
                    $('#ddlcashAccount').empty();
                    $('#ddlcashAccount').append("<option value='0'>--Select Cash Account --</option>");
                    for (var i = 0; i < data.length; i++) {
                        $('#ddlcashAccount').append($("<option></option>").val(data[i].AccountId).html(data[i].AccountName));
                    }
                }
            });
        }

        function PrintReport() {


            var CompanyID = $('#ddlCompany').val();
            var ComName = $("#ddlCompany option:selected").text();
            var FinYear = $("#ddlFinansialYear option:selected").text();
            var FinancialYearID = $('#ddlFinansialYear').val();
            var FromDate = $('#txtfrmDate').val();
            var ToDate = $('#txtToDate').val();
            var ledgerType = $('input[name="category"]:checked').val();

            if (!ledgerType) {
                toastr.error("Please select a type.");
                return;
            }

            if (!CompanyID || CompanyID === "0") {
                toastr.error("Please select a company.");
                $('#ddlCompany').focus();
                return;
            }
            if (!FinancialYearID || FinancialYearID === "0") {
                toastr.error("Please select a financial year.");
                $('#ddlFinansialYear').focus();
                return;
            }
            if (!FromDate) {
                toastr.error("Please enter From Date.");
                $('#txtfrmDate').focus();
                return;
            }
            if (!ToDate) {
                toastr.error("Please enter To Date.");
                $('#txtToDate').focus();
                return;
            }

            var subsidiaryInfoId = 0;
            var referenceInfoId = 0;
            var costCenterId = 0;

            //$('#ddlSubsidiary').trigger('change.select2');
            //$('#ddlReferenceType').trigger('change.select2');
            //$('#ddlReference').trigger('change.select2');

            if (ledgerType === 'subsidiary') {
                subsidiaryInfoId = $('#ddlSubsidiary').length ? $('#ddlSubsidiary').val() : 0;

                if (!subsidiaryInfoId || subsidiaryInfoId === "0") {
                    toastr.error("Please select subsidiary.");
                    $('#ddlSubsidiary').focus();
                    return;
                }
            }

            if (ledgerType === 'cost-center') {
                costCenterId = $('#ddlCS').length ? $('#ddlCS').val() : 0;

                if (!costCenterId || costCenterId === "0") {
                    toastr.error("Please select cost center.");
                    $('#ddlCS').focus();
                    return;
                }
            }

            if (ledgerType === 'reference') {
                referenceInfoId = $('#ddlReference').length ? $('#ddlReference').val() : 0;

                if (!referenceInfoId || referenceInfoId === "0") {
                    toastr.error("Please select reference.");
                    $('#ddlReference').focus();
                    return;
                }
            }

            if (ledgerType === 'coa') {
                subsidiaryInfoId = 0;
                referenceInfoId = 0;
                costCenterId = 0;
            }

            var glHead = 0, controlLadger = 0, subsidiary = 0, subsubsidiary = 0;

            if ($('#ddlLedgerHead').val() != 0 && $('#ddlLedgerHead').val() != '' && $('#ddlLedgerHead').val() != null)
                glHead = $('#ddlLedgerHead').val();
            if ($('#ddlControlLedger').val() != 0 && $('#ddlControlLedger').val() != '' && $('#ddlControlLedger').val() != null)
                controlLadger = $('#ddlControlLedger').val();
            if ($('#ddlSubControlLedger').val() != 0 && $('#ddlSubControlLedger').val() != '' && $('#ddlSubControlLedger').val() != null)
                subsidiary = $('#ddlSubControlLedger').val();
            if ($('#ddlSubSubControlLedger').val() != 0 && $('#ddlSubSubControlLedger').val() != '' && $('#ddlSubSubControlLedger').val() != null)
                subsubsidiary = $('#ddlSubSubControlLedger').val();

            var TrailBalanceType = "";
            if ($('#CumulativeReportRadio').is(':checked')) TrailBalanceType = "TTT";
            if ($('#DetailReportRadio').is(':checked')) TrailBalanceType = "TB";
            if ($('#DetailReportTransactionRadio').is(':checked')) TrailBalanceType = "TBOT";
            if ($('#OracleTreeReportRadio').is(':checked')) TrailBalanceType = "TB_TREE";
            if ($('#SubsidiarySummaryReportRadio').is(':checked')) TrailBalanceType = "TBS";
            if (TrailBalanceType == "") TrailBalanceType = "TBOT_new";

            var urlpath = '@Url.Action("GetTrialBalance_Report", "TrialBalance")';

            $.ajax({
                url: urlpath,
                data: {
                    CompanyID: CompanyID, FinancialYearID: FinancialYearID,
                    FromDate: FromDate, ToDate: ToDate,
                    TrailBalanceType: TrailBalanceType,
                    ledgerType: ledgerType,
                    glHead: glHead, controlLadger: controlLadger,
                    subsidiary: subsidiary, subsubsidiary: subsubsidiary,
                    subsidiaryInfoId: subsidiaryInfoId,
                    referenceInfoId: referenceInfoId,
                    costCenterId: costCenterId,
                    ComName: ComName, FinYear: FinYear
                },
                dataType: 'json',
                type: "Get",
                beforeSend: function () {
                    $("#loadingSpinner").show();
                },
                success: function (data) {
                    console.log("Full response:", data);

                    $('#ledgerlist').empty();

                    var dtmaintable = [];

                    if (data && data.dtMainTable) {
                        dtmaintable = data.dtMainTable;
                    }

                    var reportFormat = 'TB';

                    if ($('#DetailReportTransactionRadio').is(':checked')) {
                        reportFormat = 'TBOT';
                    }

                    if ($('#OracleTreeReportRadio').is(':checked')) {
                        reportFormat = 'TB_TREE';
                    }

                    if (!dtmaintable || dtmaintable.length === 0) {
                        toastr.warning("No data found.");

                        if (reportFormat === 'TB_TREE') {
                            setOracleTreeReportHeader();

                            $('#ledgerlist').append(
                                '<tr>' +
                                    '<td colspan="5" style="text-align:center;color:#777;padding:18px;font-weight:bold;">No data found.</td>' +
                                '</tr>'
                            );

                            $('#expandAllButton').hide();
                            $('#collapseAllButton').hide();
                        } else {
                            setNormalTrialBalanceHeader();

                            $('#ledgerlist').append(
                                '<tr>' +
                                    '<td colspan="7" style="text-align:center;color:#777;padding:18px;font-weight:bold;">No data found.</td>' +
                                '</tr>'
                            );
                        }

                        $('#lblFromDate').text(formatDateToDDMMMYYYY(FromDate) || '');
                        $('#lblToDate').text(formatDateToDDMMMYYYY(ToDate) || '');
                        $('#lblBusinessUnit').text(ComName);
                        $('#lblFinancialYear').text(FinYear);

                        return;
                    }

                    if (reportFormat === 'TB_TREE') {
                        setOracleTreeReportHeader();
                        renderOracleTreeReport(dtmaintable);

                        $('#expandAllButton').show();
                        $('#collapseAllButton').show();
                    } else {
                        setNormalTrialBalanceHeader();
                        renderGroupedTable(dtmaintable, reportFormat);

                        $('#expandAllButton').hide();
                        $('#collapseAllButton').hide();
                    }

                    $('#lblFromDate').text(formatDateToDDMMMYYYY(FromDate) || '');
                    $('#lblToDate').text(formatDateToDDMMMYYYY(ToDate) || '');
                    $('#lblBusinessUnit').text(ComName);
                    $('#lblFinancialYear').text(FinYear);
                },
                error: function (xhr, status, error) {
                    $('#ledgerlist').empty();

                    $('#ledgerlist').append(
                        '<tr>' +
                            '<td colspan="7" style="text-align:center;color:red;padding:18px;font-weight:bold;">Failed to load report data.</td>' +
                        '</tr>'
                    );

                    $('#expandAllButton').hide();
                    $('#collapseAllButton').hide();

                    toastr.error("Failed to load report data.");
                    console.log("Trial Balance Error:", error, xhr.responseText);
                },
                complete: function () {
                    setTimeout(function () {
                        $("#loadingSpinner").hide();
                    }, 2000);
                }
            });
        }

        // ============================================================
        //  GROUPED TABLE RENDERING FUNCTION
        //  reportFormat: 'TB' = Report Format 1, 'TBOT' = Report Format 2
        // ============================================================
        function renderGroupedTable(data, reportFormat) {
            var $tbody = $('#ledgerlist');
            $tbody.empty();

            var globalSL = 1;
            var grandTotalDebit = 0;
            var grandTotalCredit = 0;
            var grandTotalOpening = 0;
            var grandTotalClosing = 0;

            // ---- Step 1: Group by GLName ----
            var glGroups = groupBy(data, 'GLName');

            $.each(glGroups, function (glName, glRows) {

                var glTotalDebit = 0, glTotalCredit = 0, glTotalOpening = 0, glTotalClosing = 0;

                // ---- Step 2: Group by ControlLName ----
                var controlGroups = groupBy(glRows, 'ControlLName');

                var glHasValid = false;
                $.each(glRows, function (idx, row) {
                    if (shouldRenderTrialBalanceRow(row)) {
                        glHasValid = true;
                        return false;
                    }
                });
                if (!glHasValid) return;

                // GLName header row
                $tbody.append(`
                    <tr style="background-color: #1a3a5c;">
                        <td colspan="7" style="font-weight: bold; font-size: 14px; color: #ffffff; padding: 6px 10px; letter-spacing: 0.5px;">
                            ${glName || ''}
                        </td>
                    </tr>
                `);

                $.each(controlGroups, function (controlName, controlRows) {

                    var controlHasValid = false;
                    $.each(controlRows, function (idx, row) {
                        if (shouldRenderTrialBalanceRow(row)) {
                            controlHasValid = true;
                            return false;
                        }
                    });
                    if (!controlHasValid) return;

                    // ControlLName sub-header row
                    $tbody.append(`
                        <tr style="background-color: #d0dff0;">
                            <td colspan="7" style="font-weight: bold; font-size: 13px; color: #1a3a5c; padding: 5px 20px;">
                                ${controlName || ''}
                            </td>
                        </tr>
                    `);

                    var controlTotalDebit = 0, controlTotalCredit = 0, controlTotalOpening = 0, controlTotalClosing=0;

                    // ---- Step 3: Group by SubsidiryLName ----
                    var subsidiaryGroups = groupBy(controlRows, 'SubsidiryLName');

                    $.each(subsidiaryGroups, function (subsidiaryName, subsidiaryRows) {

                        var hasValidRows = false;
                        $.each(subsidiaryRows, function (idx, row) {
                            if (shouldRenderTrialBalanceRow(row)) {
                                hasValidRows = true;
                                return false;
                            }
                        });
                        if (!hasValidRows) return;

                        // SubsidiryLName group label row
                        if (subsidiaryName && subsidiaryName.trim() !== '') {
                            $tbody.append(`
                                <tr style="background-color: #eef3fa;">
                                    <td colspan="7" style="font-weight: bold; font-size: 12px; color: #285B86; padding: 4px 35px; border-left: 3px solid #285B86;">
                                        ${subsidiaryName}
                                    </td>
                                </tr>
                            `);
                        }

                        var subTotalDebit = 0, subTotalCredit = 0, subTotalOpening = 0, subTotalClosing=0 ;

                        // ---- Step 4: Actual data rows ----
                        $.each(subsidiaryRows, function (idx, row) {
                            var OpeningBalance = parseFloat(row.OpeningBalance) || 0;
                            var DebitAmount = parseFloat(row.DebitAmount) || 0;
                            var CreditAmount = parseFloat(row.CreditAmount) || 0;
                            var ClosingBalance = OpeningBalance + DebitAmount - CreditAmount;

                            if (!shouldRenderTrialBalanceRow(row)) {
                                return;
                            }

                            subTotalDebit   += DebitAmount;
                            subTotalCredit  += CreditAmount;
                            subTotalOpening += OpeningBalance;
                            subTotalClosing += ClosingBalance;
                            $tbody.append(`
                                <tr style="background-color: #ffffff;">
                                    <td style="text-align: center; padding: 3px 6px;">${globalSL++}</td>
                                    <td style="text-align: left; padding: 3px 6px; padding-left: 45px;">${row.AccountCode || ''}</td>
                                    <td style="text-align: left; padding: 3px 6px;">${row.AccountName || ''}</td>
                                    <td style="text-align: right; padding: 3px 6px;">${fmt(OpeningBalance)}</td>
                                    <td style="text-align: right; padding: 3px 6px;">${fmt(DebitAmount)}</td>
                                    <td style="text-align: right; padding: 3px 6px;">${fmt(CreditAmount)}</td>
                                    <td style="text-align: right; padding: 3px 6px;">${fmt(ClosingBalance)}</td>
                                </tr>
                            `);
                        });

                        // Subsidiary Total row
                        $tbody.append(`
                            <tr style="background-color: #dce8f7; font-weight: bold;">
                                <td colspan="3" style="text-align: right; padding: 3px 10px; color: #1a3a5c; font-size: 12px;">Subsidiary Total</td>
                                <td style="text-align: right; padding: 3px 6px;">${fmt(subTotalOpening)}</td>
                                <td style="text-align: right; padding: 3px 6px;">${fmt(subTotalDebit)}</td>
                                <td style="text-align: right; padding: 3px 6px;">${fmt(subTotalCredit)}</td>
                                <td style="text-align: right; padding: 3px 6px;">${fmt(subTotalClosing)}</td>
                            </tr>
                        `);

                        controlTotalDebit   += subTotalDebit;
                        controlTotalCredit  += subTotalCredit;
                        controlTotalOpening += subTotalOpening;
                        controlTotalClosing += subTotalClosing;
                    });

                    // Control Ledger Total row
                    $tbody.append(`
                        <tr style="background-color: #b8cfe8; font-weight: bold;">
                            <td colspan="3" style="text-align: right; padding: 4px 10px; color: #0d2a45; font-size: 12px;">${controlName} Total</td>
                            <td style="text-align: right; padding: 4px 6px;">${fmt(controlTotalOpening)}</td>
                            <td style="text-align: right; padding: 4px 6px;">${fmt(controlTotalDebit)}</td>
                            <td style="text-align: right; padding: 4px 6px;">${fmt(controlTotalCredit)}</td>
                            <td style="text-align: right; padding: 4px 6px;">${fmt(controlTotalClosing)}</td>
                        </tr>
                    `);

                    glTotalDebit   += controlTotalDebit;
                    glTotalCredit  += controlTotalCredit;
                    glTotalOpening += controlTotalOpening;
                    glTotalClosing += controlTotalClosing;
                });

                // GL Head Total row
                $tbody.append(`
                    <tr style="background-color: #7a9fc2; font-weight: bold;">
                        <td colspan="3" style="text-align: right; padding: 5px 10px; color: #fff; font-size: 13px;">${glName} Total</td>
                        <td style="text-align: right; padding: 5px 6px; color: #fff;">${fmt(glTotalOpening)}</td>
                        <td style="text-align: right; padding: 5px 6px; color: #fff;">${fmt(glTotalDebit)}</td>
                        <td style="text-align: right; padding: 5px 6px; color: #fff;">${fmt(glTotalCredit)}</td>
                        <td style="text-align: right; padding: 5px 6px; color: #fff;">${fmt(glTotalClosing)}</td>
                    </tr>
                    <tr><td colspan="7" style="padding: 3px;"></td></tr>
                `);

                grandTotalDebit   += glTotalDebit;
                grandTotalCredit  += glTotalCredit;
                grandTotalOpening += glTotalOpening;
                grandTotalClosing += glTotalClosing;
            });

            // Grand Total row
            $tbody.append(`
                <tr style="background-color: #d6e0f0; font-weight: bold; border-top: 2px solid #285B86;">
                    <td colspan="3" style="text-align: right; padding: 6px 10px; font-size: 14px;">Grand Total</td>
                    <td style="text-align: right; padding: 6px 6px; font-size: 14px;">${fmt(grandTotalOpening)}</td>
                    <td style="text-align: right; padding: 6px 6px; font-size: 14px;">${fmt(grandTotalDebit)}</td>
                    <td style="text-align: right; padding: 6px 6px; font-size: 14px;">${fmt(grandTotalCredit)}</td>
                    <td style="text-align: right; padding: 6px 6px; font-size: 14px;">${fmt(grandTotalClosing)}</td>
                </tr>
            `);
        }

        // Helper: Group array of objects by a key
        function groupBy(array, key) {
            var result = {};
            $.each(array, function (i, item) {
                var groupKey = item[key] || '';
                if (!result[groupKey]) result[groupKey] = [];
                result[groupKey].push(item);
            });
            return result;
        }

        // Helper: Format number
        function fmt(num) {
            return (parseFloat(num) || 0).toLocaleString('en-IN', {
                minimumFractionDigits: 2,
                maximumFractionDigits: 2
            });
        }

        function shouldRenderTrialBalanceRow(row) {
            var openingBalance = parseFloat(row.OpeningBalance) || 0;
            var debitAmount = parseFloat(row.DebitAmount) || 0;
            var creditAmount = parseFloat(row.CreditAmount) || 0;
            var closingBalance = openingBalance + debitAmount - creditAmount;

            return closingBalance !== 0;
        }

        function formatDateToDDMMMYYYY(dateString) {
            if (!dateString) return "";
            var date = new Date(dateString);
            if (isNaN(date)) return "";
            var day = ("0" + date.getDate()).slice(-2);
            var monthNames = ["Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"];
            var month = monthNames[date.getMonth()];
            var year = date.getFullYear();
            return day + "-" + month + "-" + year;
        }

