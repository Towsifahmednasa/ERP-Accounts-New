@* Ported from Accounts\CSTL_Pro_to_Pay\Views\AllAccountReport\TrialBalanceReport.cshtml - page markup and inline scripts unchanged; presentation comes from the Fiori shell/stylesheet. *@
@{
    ViewBag.Title = "Trial Balance Report";
    Layout = "~/Views/Shared/_Layout.cshtml";
}


<style>
    .hidden {
        display: none;
    }

    .search-panel .form-group {
        margin-bottom: 6px !important;
    }

    .search-panel .row {
        align-items: center;
    }

    .search-panel .col-form-label {
        padding-top: 2px !important;
        padding-bottom: 2px !important;
    }

    .search-panel .form-select,
    .search-panel .form-control {
        margin-bottom: 0 !important;
    }

    .search-panel .type-radio-group {
        padding-top: 2px;
        padding-bottom: 2px;
        line-height: 20px;
    }

    .search-panel .type-radio-group input[type="radio"] {
        margin-right: 4px;
        vertical-align: middle;
    }

    .search-panel .type-radio-group label {
        margin-right: 10px;
        margin-bottom: 0;
        vertical-align: middle;
    }

    .search-panel #subsidiary-div .row + .row,
    .search-panel #reference-div .row + .row {
        margin-top: 6px;
    }

    /* Report Format 3: Oracle-style tree table with existing blue concept */
    .oracle-tree-wrap {
        overflow-x: auto;
    }

        #dtTb.oracle-tree-table {
        min-width: 1200px;
        table-layout: auto;
        border-collapse: separate !important;
        border-spacing: 0;
        font-size: 13px;
        border: 1px solid #d6dce5;
    }

        #dtTb.oracle-tree-table thead th {
            background: #285B86 !important;
            color: #ffffff !important;
            padding: 10px 9px !important;
            border-right: 1px solid rgba(255,255,255,.22) !important;
            white-space: nowrap;
            font-weight: 700;
            position: sticky;
            top: 0;
            z-index: 2;
        }

        #dtTb.oracle-tree-table td {
            padding: 7px 9px !important;
            border-right: 1px solid #e3e8ef !important;
            border-bottom: 1px solid #e3e8ef !important;
            vertical-align: middle;
        }

        #dtTb.oracle-tree-table .tree-sl {
            min-width: 60px;
            width: 60px;
            text-align: center;
            color: #344054;
        }

        #dtTb.oracle-tree-table .tree-code {
            min-width: 150px;
            font-family: Consolas, "Courier New", monospace;
            white-space: nowrap;
            color: #1f2937;
        }

        #dtTb.oracle-tree-table .tree-name {
            min-width: 420px;
            white-space: nowrap;
        }

        #dtTb.oracle-tree-table .tree-amount {
            min-width: 165px;
            text-align: right !important;
            white-space: nowrap;
            font-variant-numeric: tabular-nums;
        }

        #dtTb.oracle-tree-table .tree-side-row td {
            background: #102F4F !important;
            color: #ffffff !important;
            font-weight: 800;
            font-size: 14px;
        }

        #dtTb.oracle-tree-table .tree-gl-row td {
            font-weight: 700;
        }

        #dtTb.oracle-tree-table .tree-debit-side td {
            background: #173A5A !important;
            color: #ffffff !important;
        }

        #dtTb.oracle-tree-table .tree-credit-side td {
            background: #214F73 !important;
            color: #ffffff !important;
        }

        #dtTb.oracle-tree-table .tree-control-row td {
            background: #D0DFF0 !important;
            color: #102F4F !important;
            font-weight: 700;
        }

        #dtTb.oracle-tree-table .tree-sub-row td {
            background: #EEF3FA !important;
            color: #285B86 !important;
            font-weight: 700;
        }

        #dtTb.oracle-tree-table .tree-subsub-row td {
            background: #F7FAFD !important;
            color: #2B4F70 !important;
            font-weight: 700;
        }

        #dtTb.oracle-tree-table .tree-account-row td {
            background: #ffffff !important;
        }

        #dtTb.oracle-tree-table .tree-account-row:hover td {
            background: #F8FBFE !important;
        }

        #dtTb.oracle-tree-table .tree-grand-total-row td {
            background: #DCE8F7 !important;
            color: #102F4F !important;
            font-weight: 800;
            font-size: 14px;
            border-top: 2px solid #285B86 !important;
        }

        #dtTb.oracle-tree-table .tree-clickable {
            cursor: pointer;
            user-select: none;
        }

        #dtTb.oracle-tree-table .tree-toggle {
            display: inline-block;
            width: 18px;
            font-weight: bold;
            text-align: center;
        }

        #dtTb.oracle-tree-table .tree-toggle-empty {
            visibility: hidden;
        }

        #dtTb.oracle-tree-table .tree-account-row {
            cursor: default;
        }

        #dtTb.oracle-tree-table .tree-level-1 .tree-name { padding-left: 34px !important; }
        #dtTb.oracle-tree-table .tree-level-2 .tree-name { padding-left: 58px !important; }
        #dtTb.oracle-tree-table .tree-level-3 .tree-name { padding-left: 82px !important; }
        #dtTb.oracle-tree-table .tree-level-4 .tree-name { padding-left: 106px !important; }
        #dtTb.oracle-tree-table .tree-level-5 .tree-name { padding-left: 130px !important; }
</style>


