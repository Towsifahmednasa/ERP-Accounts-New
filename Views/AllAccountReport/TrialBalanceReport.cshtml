        // ============================================================
        //  REPORT FORMAT 3 - ORACLE STYLE TREE REPORT
        // ============================================================
        function renderOracleTreeReport(data) {
            var $tbody = $('#ledgerlist');
            $tbody.empty();

            if (!data || data.length === 0) {
                $tbody.append('<tr><td colspan="5" style="text-align:center;color:#777;padding:18px;">No data found.</td></tr>');
                return;
            }

            data = data.filter(function (row) {
                var dc = getOracleBalanceDebitCredit(row);
                return isNonZeroAmount(dc.debit, dc.credit);
            });

            if (!data || data.length === 0) {
                $tbody.append('<tr><td colspan="5" style="text-align:center;color:#777;padding:18px;">No data found.</td></tr>');
                return;
            }

            data = data.slice().sort(sortOracleTreeData);

            var rowId = 1;
            var grandDebit = 0;
            var grandCredit = 0;
            var rootSL = 1;

            var sideGroups = oracleGroupBy(data, function (row) {
                return getNaturalBalanceSide(row);
            });

            $.each(sideGroups, function (sideName, sideRows) {
                var isCreditSide = sideName === 'Credit Balance';

                var glGroups = oracleGroupBy(sideRows, function (row) {
                    return row.GLName || 'N/A';
                });

                $.each(glGroups, function (glName, glRows) {
                    var glId = 'gl_' + rowId++;
                    var glTotal = sumOracleTreeRows(glRows, isCreditSide);
                    if (!isNonZeroAmount(glTotal.debit, glTotal.credit)) {
                        return;
                    }
                    var firstGlRow = glRows[0] || {};
                    var glSL = rootSL.toString();

                    grandDebit += glTotal.debit;
                    grandCredit += glTotal.credit;

                    appendOracleTreeRow($tbody, {
                        rowId: glId,
                        parentId: '',
                        rowClass: isCreditSide ? 'tree-gl-row tree-credit-side' : 'tree-gl-row tree-debit-side',
                        level: 1,
                        isClickable: true,
                        sl: glSL,
                        code: firstGlRow.GLHeadId || '',
                        name: glName,
                        debit: glTotal.debit,
                        credit: glTotal.credit
                    });

                    var controlIndex = 1;
                    var controlGroups = oracleGroupBy(glRows, function (row) {
                        return row.ControlLName || 'N/A';
                    });

                    $.each(controlGroups, function (controlName, controlRows) {
                        var controlId = 'control_' + rowId++;
                        var controlTotal = sumOracleTreeRows(controlRows, isCreditSide);
                        if (!isNonZeroAmount(controlTotal.debit, controlTotal.credit)) {
                            return;
                        }
                        var firstControlRow = controlRows[0] || {};
                        var controlSL = glSL + '.' + controlIndex;

                        appendOracleTreeRow($tbody, {
                            rowId: controlId,
                            parentId: glId,
                            rowClass: 'tree-control-row',
                            level: 2,
                            isClickable: true,
                            sl: controlSL,
                            code: firstControlRow.ControlLCode || '',
                            name: controlName,
                            debit: controlTotal.debit,
                            credit: controlTotal.credit
                        });

                        var subIndex = 1;
                        var subGroups = oracleGroupBy(controlRows, function (row) {
                            return row.SubsidiryLName || 'N/A';
                        });

                        $.each(subGroups, function (subName, subRows) {
                            var subId = 'sub_' + rowId++;
                            var subTotal = sumOracleTreeRows(subRows, isCreditSide);
                            if (!isNonZeroAmount(subTotal.debit, subTotal.credit)) {
                                return;
                            }
                            var firstSubRow = subRows[0] || {};
                            var subSL = controlSL + '.' + subIndex;

                            appendOracleTreeRow($tbody, {
                                rowId: subId,
                                parentId: controlId,
                                rowClass: 'tree-sub-row',
                                level: 3,
                                isClickable: true,
                                sl: subSL,
                                code: firstSubRow.SubControlCode || '',
                                name: subName,
                                debit: subTotal.debit,
                                credit: subTotal.credit
                            });

                            var subSubIndex = 1;
                            var subSubGroups = oracleGroupBy(subRows, function (row) {
                                return row.SubSubControlLedgerName || 'N/A';
                            });

                            $.each(subSubGroups, function (subSubName, subSubRows) {
                                var subSubId = 'subsub_' + rowId++;
                                var subSubTotal = sumOracleTreeRows(subSubRows, isCreditSide);
                                if (!isNonZeroAmount(subSubTotal.debit, subSubTotal.credit)) {
                                    return;
                                }
                                var firstSubSubRow = subSubRows[0] || {};
                                var subSubSL = subSL + '.' + subSubIndex;

                                appendOracleTreeRow($tbody, {
                                    rowId: subSubId,
                                    parentId: subId,
                                    rowClass: 'tree-subsub-row',
                                    level: 4,
                                    isClickable: true,
                                    sl: subSubSL,
                                    code: firstSubSubRow.SubSubControlCode || '',
                                    name: subSubName,
                                    debit: subSubTotal.debit,
                                    credit: subSubTotal.credit
                                });

                                var accountIndex = 1;
                                $.each(subSubRows, function (i, row) {
                                    var dc = getOracleBalanceDebitCredit(row);
                                    if (!isNonZeroAmount(dc.debit, dc.credit)) {
                                        return;
                                    }
                                    var accountSL = subSubSL + '.' + accountIndex;

                                    appendOracleTreeRow($tbody, {
                                        rowId: 'acc_' + rowId++,
                                        parentId: subSubId,
                                        rowClass: 'tree-account-row',
                                        level: 5,
                                        isClickable: false,
                                        sl: accountSL,
                                        code: row.AccountCode || '',
                                        name: row.AccountName || '',
                                        debit: dc.debit,
                                        credit: dc.credit
                                    });

                                    accountIndex++;
                                });

                                subSubIndex++;
                            });

                            subIndex++;
                        });

                        controlIndex++;
                    });

                    rootSL++;
                });
            });

            if (!isNonZeroAmount(grandDebit, grandCredit)) {
                $tbody.empty();
                $tbody.append('<tr><td colspan="5" style="text-align:center;color:#777;padding:18px;">No data found.</td></tr>');
                return;
            }

            appendOracleTreeRow($tbody, {
                rowId: 'grand_total',
                parentId: '',
                rowClass: 'tree-grand-total-row',
                level: 1,
                isClickable: false,
                sl: '',
                code: '',
                name: 'Grand Total',
                debit: grandDebit,
                credit: grandCredit
            });

            // Initial state:
            // GL rows visible, Grand Total visible.
            // Child layers hidden.
            $('#ledgerlist tr.tree-level-2, #ledgerlist tr.tree-level-3, #ledgerlist tr.tree-level-4, #ledgerlist tr.tree-level-5').hide();
            $('#ledgerlist tr.tree-gl-row').show();
            $('#ledgerlist tr.tree-grand-total-row').show();

            bindOracleTreeClick();
        }

        function isNonZeroAmount(debit, credit) {
            debit = parseFloat(debit) || 0;
            credit = parseFloat(credit) || 0;

            return Math.abs(debit) > 0.0001 || Math.abs(credit) > 0.0001;
        }

        function appendOracleTreeRow($tbody, opt) {
            var toggle = opt.isClickable
                ? '<span class="tree-toggle">+</span>'
                : '<span class="tree-toggle tree-toggle-empty"></span>';

            $tbody.append(
                '<tr ' +
                'data-id="' + htmlEncode(opt.rowId) + '" ' +
                'data-parent="' + htmlEncode(opt.parentId) + '" ' +
                'class="' + opt.rowClass + ' tree-level-' + opt.level + (opt.isClickable ? ' tree-clickable' : '') + '">' +
                '<td class="tree-sl">' + htmlEncode(opt.sl) + '</td>' +
                '<td class="tree-code">' + htmlEncode(opt.code) + '</td>' +
                '<td class="tree-name">' + toggle + htmlEncode(opt.name) + '</td>' +
                '<td class="tree-amount">' + fmtTree(opt.debit) + '</td>' +
                '<td class="tree-amount">' + fmtTree(opt.credit) + '</td>' +
                '</tr>'
            );
        }

        function bindOracleTreeClick() {
            $('#ledgerlist').off('click', 'tr.tree-clickable');

            $('#ledgerlist').on('click', 'tr.tree-clickable', function () {
                var $row = $(this);
                var rowId = $row.attr('data-id');
                var isOpen = $row.hasClass('tree-open');

                if (isOpen) {
                    collapseOracleTreeChildren(rowId);
                    $row.removeClass('tree-open');
                    $row.find('.tree-toggle').first().text('+');
                } else {
                    showOracleTreeChildren(rowId);
                    $row.addClass('tree-open');
                    $row.find('.tree-toggle').first().text('-');
                }
            });
        }

        function GetSubsidoryByType() {
            var suppliertypeId = $("#ddlSubsidiaryType").val() || 0;
            var $ddlSubsidiary = $('#ddlSubsidiary');

            if ($.fn.select2 && $ddlSubsidiary.hasClass('select2-hidden-accessible')) {
                $ddlSubsidiary.select2('destroy');
            }

            $ddlSubsidiary.empty().append("<option value='0'>--Select Subsidiary--</option>").val('0');

            if (!suppliertypeId || suppliertypeId === "0") {
                if ($.fn.select2) {
                    $ddlSubsidiary.select2({
                        placeholder: "--Select Subsidiary--",
                        allowClear: true,
                        width: '100%'
                    });
                }
                return;
            }

            if ($.fn.select2) {
                $ddlSubsidiary.select2({
                    placeholder: "--Select Subsidiary--",
                    allowClear: true,
                    width: '100%',
                    minimumInputLength: 1,
                    ajax: {
                        url: "/Utility/GetSubsidoryLedgerBySupplierTypeId",
                        dataType: 'json',
                        delay: 300,
                        data: function (params) {
                            return {
                                SupplierTypeId: $("#ddlSubsidiaryType").val(),
                                SearchText: params.term || ''
                            };
                        },
                        processResults: function (data) {
                            return {
                                results: $.map(data || [], function (item) {
                                    return {
                                        id: item.id != null ? item.id : item.SubsidiryLId,
                                        text: item.text != null ? item.text : item.SubsidiryLName
                                    };
                                })
                            };
                        },
                        cache: true
                    }
                });
            }
        }

