        // ============================================================
        //  REPORT FORMAT 3 - ORACLE STYLE TREE REPORT
        // ============================================================
        function renderOracleTreeReport(data) {
            var $tbody = $('#ledgerlist');
            $tbody.empty();

            if (!data || data.length === 0) {
                $tbody.append('<tr><td colspan="5" style="text-align:center;color:#777;padding:18px;">No data found.</td></tr>');
                return;
            }

            data = data.filter(function (row) {
                var dc = getOracleBalanceDebitCredit(row);
                return isNonZeroAmount(dc.debit, dc.credit);
            });

            if (!data || data.length === 0) {
                $tbody.append('<tr><td colspan="5" style="text-align:center;color:#777;padding:18px;">No data found.</td></tr>');
                return;
            }

            data = data.slice().sort(sortOracleTreeData);

            var rowId = 1;
            var grandDebit = 0;
            var grandCredit = 0;
            var rootSL = 1;

            var sideGroups = oracleGroupBy(data, function (row) {
                return getNaturalBalanceSide(row);
            });

            $.each(sideGroups, function (sideName, sideRows) {
                var isCreditSide = sideName === 'Credit Balance';

                var glGroups = oracleGroupBy(sideRows, function (row) {
                    return row.GLName || 'N/A';
                });

                $.each(glGroups, function (glName, glRows) {
                    var glId = 'gl_' + rowId++;
                    var glTotal = sumOracleTreeRows(glRows, isCreditSide);
                    if (!isNonZeroAmount(glTotal.debit, glTotal.credit)) {
                        return;
                    }
                    var firstGlRow = glRows[0] || {};
                    var glSL = rootSL.toString();

                    grandDebit += glTotal.debit;
                    grandCredit += glTotal.credit;

                    appendOracleTreeRow($tbody, {
                        rowId: glId,
                        parentId: '',
                        rowClass: isCreditSide ? 'tree-gl-row tree-credit-side' : 'tree-gl-row tree-debit-side',
                        level: 1,
                        isClickable: true,
                        sl: glSL,
                        code: firstGlRow.GLHeadId || '',
                        name: glName,
                        debit: glTotal.debit,
                        credit: glTotal.credit
                    });

                    var controlIndex = 1;
                    var controlGroups = oracleGroupBy(glRows, function (row) {
                        return row.ControlLName || 'N/A';
                    });

                    $.each(controlGroups, function (controlName, controlRows) {
                        var controlId = 'control_' + rowId++;
                        var controlTotal = sumOracleTreeRows(controlRows, isCreditSide);
                        if (!isNonZeroAmount(controlTotal.debit, controlTotal.credit)) {
                            return;
                        }
                        var firstControlRow = controlRows[0] || {};
                        var controlSL = glSL + '.' + controlIndex;

                        appendOracleTreeRow($tbody, {
                            rowId: controlId,
                            parentId: glId,
                            rowClass: 'tree-control-row',
                            level: 2,
                            isClickable: true,
                            sl: controlSL,
                            code: firstControlRow.ControlLCode || '',
                            name: controlName,
                            debit: controlTotal.debit,
                            credit: controlTotal.credit
                        });

                        var subIndex = 1;
                        var subGroups = oracleGroupBy(controlRows, function (row) {
                            return row.SubsidiryLName || 'N/A';
                        });

                        $.each(subGroups, function (subName, subRows) {
                            var subId = 'sub_' + rowId++;
                            var subTotal = sumOracleTreeRows(subRows, isCreditSide);
                            if (!isNonZeroAmount(subTotal.debit, subTotal.credit)) {
                                return;
                            }
                            var firstSubRow = subRows[0] || {};
                            var subSL = controlSL + '.' + subIndex;

                            appendOracleTreeRow($tbody, {
                                rowId: subId,
                                parentId: controlId,
                                rowClass: 'tree-sub-row',
                                level: 3,
                                isClickable: true,
                                sl: subSL,
                                code: firstSubRow.SubControlCode || '',
                                name: subName,
                                debit: subTotal.debit,
                                credit: subTotal.credit
                            });

                            var subSubIndex = 1;
                            var subSubGroups = oracleGroupBy(subRows, function (row) {
                                return row.SubSubControlLedgerName || 'N/A';
                            });

                            $.each(subSubGroups, function (subSubName, subSubRows) {
                                var subSubId = 'subsub_' + rowId++;
                                var subSubTotal = sumOracleTreeRows(subSubRows, isCreditSide);
                                if (!isNonZeroAmount(subSubTotal.debit, subSubTotal.credit)) {
                                    return;
                                }
                                var firstSubSubRow = subSubRows[0] || {};
                                var subSubSL = subSL + '.' + subSubIndex;

                                appendOracleTreeRow($tbody, {
                                    rowId: subSubId,
                                    parentId: subId,
                                    rowClass: 'tree-subsub-row',
                                    level: 4,
                                    isClickable: true,
                                    sl: subSubSL,
                                    code: firstSubSubRow.SubSubControlCode || '',
                                    name: subSubName,
                                    debit: subSubTotal.debit,
                                    credit: subSubTotal.credit
                                });

                                var accountIndex = 1;
                                $.each(subSubRows, function (i, row) {
                                    var dc = getOracleBalanceDebitCredit(row);
                                    if (!isNonZeroAmount(dc.debit, dc.credit)) {
                                        return;
                                    }
                                    var accountSL = subSubSL + '.' + accountIndex;

                                    appendOracleTreeRow($tbody, {
                                        rowId: 'acc_' + rowId++,
                                        parentId: subSubId,
                                        rowClass: 'tree-account-row',
                                        level: 5,
                                        isClickable: false,
                                        sl: accountSL,
                                        code: row.AccountCode || '',
                                        name: row.AccountName || '',
                                        debit: dc.debit,
                                        credit: dc.credit
                                    });

                                    accountIndex++;
                                });

                                subSubIndex++;
                            });

                            subIndex++;
                        });

                        controlIndex++;
                    });

                    rootSL++;
                });
            });

            if (!isNonZeroAmount(grandDebit, grandCredit)) {
                $tbody.empty();
                $tbody.append('<tr><td colspan="5" style="text-align:center;color:#777;padding:18px;">No data found.</td></tr>');
                return;
            }

            appendOracleTreeRow($tbody, {
                rowId: 'grand_total',
                parentId: '',
                rowClass: 'tree-grand-total-row',
                level: 1,
                isClickable: false,
                sl: '',
                code: '',
                name: 'Grand Total',
                debit: grandDebit,
                credit: grandCredit
            });

            // Initial state:
            // GL rows visible, Grand Total visible.
            // Child layers hidden.
            $('#ledgerlist tr.tree-level-2, #ledgerlist tr.tree-level-3, #ledgerlist tr.tree-level-4, #ledgerlist tr.tree-level-5').hide();
            $('#ledgerlist tr.tree-gl-row').show();
            $('#ledgerlist tr.tree-grand-total-row').show();

            bindOracleTreeClick();
        }

        function isNonZeroAmount(debit, credit) {
            debit = parseFloat(debit) || 0;
            credit = parseFloat(credit) || 0;

            return Math.abs(debit) > 0.0001 || Math.abs(credit) > 0.0001;
        }

        function appendOracleTreeRow($tbody, opt) {
            var toggle = opt.isClickable
                ? '<span class="tree-toggle">+</span>'
                : '<span class="tree-toggle tree-toggle-empty"></span>';

            $tbody.append(
                '<tr ' +
                'data-id="' + htmlEncode(opt.rowId) + '" ' +
                'data-parent="' + htmlEncode(opt.parentId) + '" ' +
                'class="' + opt.rowClass + ' tree-level-' + opt.level + (opt.isClickable ? ' tree-clickable' : '') + '">' +
                '<td class="tree-sl">' + htmlEncode(opt.sl) + '</td>' +
                '<td class="tree-code">' + htmlEncode(opt.code) + '</td>' +
                '<td class="tree-name">' + toggle + htmlEncode(opt.name) + '</td>' +
                '<td class="tree-amount">' + fmtTree(opt.debit) + '</td>' +
                '<td class="tree-amount">' + fmtTree(opt.credit) + '</td>' +
                '</tr>'
            );
        }

        function bindOracleTreeClick() {
            $('#ledgerlist').off('click', 'tr.tree-clickable');

            $('#ledgerlist').on('click', 'tr.tree-clickable', function () {
                var $row = $(this);
                var rowId = $row.attr('data-id');
                var isOpen = $row.hasClass('tree-open');

                if (isOpen) {
                    collapseOracleTreeChildren(rowId);
                    $row.removeClass('tree-open');
                    $row.find('.tree-toggle').first().text('+');
                } else {
                    showOracleTreeChildren(rowId);
                    $row.addClass('tree-open');
                    $row.find('.tree-toggle').first().text('-');
                }
            });
        }

        function GetSubsidoryByType() {
            var suppliertypeId = $("#ddlSubsidiaryType").val() || 0;
            var $ddlSubsidiary = $('#ddlSubsidiary');

            if ($.fn.select2 && $ddlSubsidiary.hasClass('select2-hidden-accessible')) {
                $ddlSubsidiary.select2('destroy');
            }

            $ddlSubsidiary.empty().append("<option value='0'>--Select Subsidiary--</option>").val('0');

            if (!suppliertypeId || suppliertypeId === "0") {
                if ($.fn.select2) {
                    $ddlSubsidiary.select2({
                        placeholder: "--Select Subsidiary--",
                        allowClear: true,
                        width: '100%'
                    });
                }
                return;
            }

            if ($.fn.select2) {
                $ddlSubsidiary.select2({
                    placeholder: "--Select Subsidiary--",
                    allowClear: true,
                    width: '100%',
                    minimumInputLength: 1,
                    ajax: {
                        url: "/Utility/GetSubsidoryLedgerBySupplierTypeId",
                        dataType: 'json',
                        delay: 300,
                        data: function (params) {
                            return {
                                SupplierTypeId: $("#ddlSubsidiaryType").val(),
                                SearchText: params.term || ''
                            };
                        },
                        processResults: function (data) {
                            return {
                                results: $.map(data || [], function (item) {
                                    return {
                                        id: item.id != null ? item.id : item.SubsidiryLId,
                                        text: item.text != null ? item.text : item.SubsidiryLName
                                    };
                                })
                            };
                        },
                        cache: true
                    }
                });
            }
        }

        function GetReferenceByType() {
            var referenceTypeId = $("#ddlReferenceType").val() || 0;
            var businessUnitId = $("#ddlCompany").val() || 0;
            var $ddlReference = $('#ddlReference');

            if ($.fn.select2 && $ddlReference.hasClass('select2-hidden-accessible')) {
                $ddlReference.select2('destroy');
            }

            $ddlReference.empty().append("<option value='0'>--Select--</option>").val('0');

            if (!referenceTypeId || referenceTypeId === "0" || !businessUnitId || businessUnitId === "0") {
                if ($.fn.select2) {
                    $ddlReference.select2({
                        placeholder: "--Select--",
                        allowClear: true,
                        width: '100%'
                    });
                }
                return;
            }

            if ($.fn.select2) {
                $ddlReference.select2({
                    placeholder: "--Select--",
                    allowClear: true,
                    width: '100%',
                    minimumInputLength: 1,
                    ajax: {
                        url: "/Utility/GetReferenceByReferenceTypeComWiseIdSearch",
                        dataType: 'json',
                        delay: 300,
                        data: function (params) {
                            return {
                                ReferenceTypeId: $("#ddlReferenceType").val() || 0,
                                BusinessUnitId: $("#ddlCompany").val() || 0,
                                SearchText: params.term || ''
                            };
                        },
                        processResults: function (data) {
                            return {
                                results: data || []
                            };
                        },
                        cache: true
                    }
                });
            }
        }

        function GetSubsidaryType() {
            $.ajax({
                url: "/Utility/LoadSubsidaryType",
                contentType: "application/json; charset=utf-8",
                dataType: 'json',
                type: "Get",
                data: {},
                async: false,
                success: function (data) {
                    $("#ddlSubsidiaryType").empty();
                    $("#ddlSubsidiaryType").append("<option value='0'>--Select--</option>");

                    for (var i = 0; i < data.length; i++) {
                        $("#ddlSubsidiaryType").append($("<option></option>").val(data[i].SubsidiryTypeId).html(data[i].SubsidiryTypeName));
                    }
                }
            });
        }

        function GetReferenceType() {
            $.ajax({
                url: "/Utility/LoadReferenceType",
                contentType: "application/json; charset=utf-8",
                dataType: 'json',
                type: "Get",
                data: {},
                async: false,
                success: function (data) {
                    $("#ddlReferenceType").empty();
                    $("#ddlReferenceType").append("<option value='0'>--Select--</option>");

                    for (var i = 0; i < data.length; i++) {
                        $("#ddlReferenceType").append($("<option></option>").val(data[i].ReferenceTypeId).html(data[i].ReferenceType));
                    }
                }
            });
        }

        function GetCostCenterList() {
            var $ddlCostCenter = $('#ddlCS');

            $ddlCostCenter.empty().append("<option value='0'>--Select Cost Center--</option>").val('0');

            if ($.fn.select2 && $ddlCostCenter.hasClass('select2-hidden-accessible')) {
                $ddlCostCenter.select2('destroy');
            }

            $ddlCostCenter.select2({
                placeholder: '--Select Cost Center--',
                allowClear: true,
                width: '100%',
                minimumInputLength: 1,
                ajax: {
                    url: "/Utility/GetProfitCenterListSearch",
                    dataType: 'json',
                    delay: 300,
                    data: function (params) {
                        return {
                            BusinessUnitId: $("#ddlCompany").val() || 0,
                            SearchText: params.term || ''
                        };
                    },
                    processResults: function (data) {
                        return {
                            results: data || []
                        };
                    },
                    cache: true
                }
            });
        }

        function showOracleTreeChildren(parentId) {
            $('#ledgerlist tr[data-parent="' + parentId + '"]').show();
        }

        function collapseOracleTreeChildren(parentId) {
            var $children = $('#ledgerlist tr[data-parent="' + parentId + '"]');

            $children.each(function () {
                var childId = $(this).attr('data-id');

                collapseOracleTreeChildren(childId);

                $(this).hide();
                $(this).removeClass('tree-open');
                $(this).find('.tree-toggle').first().text('+');
            });
        }

        function expandOracleTreeAll() {
            $('#ledgerlist tr').show();

            $('#ledgerlist tr.tree-clickable').each(function () {
                $(this).addClass('tree-open');
                $(this).find('.tree-toggle').first().text('-');
            });

            $('#ledgerlist tr.tree-grand-total-row').show();
        }

        function collapseOracleTreeAll() {
            $('#ledgerlist tr.tree-level-2, #ledgerlist tr.tree-level-3, #ledgerlist tr.tree-level-4, #ledgerlist tr.tree-level-5').hide();

            $('#ledgerlist tr.tree-gl-row').show();
            $('#ledgerlist tr.tree-grand-total-row').show();

            $('#ledgerlist tr.tree-clickable').each(function () {
                $(this).removeClass('tree-open');
                $(this).find('.tree-toggle').first().text('+');
            });
        }

        function sortOracleTreeData(a, b) {
            var sideA = getNaturalBalanceSideOrder(a);
            var sideB = getNaturalBalanceSideOrder(b);

            if (sideA !== sideB) return sideA - sideB;

            var glA = parseInt(a.GLHeadId || 0);
            var glB = parseInt(b.GLHeadId || 0);

            if (glA !== glB) return glA - glB;

            var controlCompare = compareText(a.ControlLCode, b.ControlLCode);
            if (controlCompare !== 0) return controlCompare;

            var subCompare = compareText(a.SubControlCode, b.SubControlCode);
            if (subCompare !== 0) return subCompare;

            var subSubCompare = compareText(a.SubSubControlCode, b.SubSubControlCode);
            if (subSubCompare !== 0) return subSubCompare;

            return compareText(a.AccountCode, b.AccountCode);
        }

        function getNaturalBalanceSide(row) {
            var glName = (row.GLName || '').toString().trim().toLowerCase();
            if (glName === 'assets' || glName === 'asset' || glName === 'expenses' || glName === 'expense') {
                return 'Debit Balance';
            }
            return 'Credit Balance';
        }

        function getNaturalBalanceSideOrder(row) {
            var side = getNaturalBalanceSide(row);

            if (side === 'Debit Balance') return 1;
            if (side === 'Credit Balance') return 2;

            return 3;
        }

        function getActualBalanceSide(row) {
            var dc = getOracleBalanceDebitCredit(row);

            if (dc.debit > 0) return 'Debit Balance';
            if (dc.credit > 0) return 'Credit Balance';

            return 'Zero Balance';
        }

        function getActualBalanceSideOrder(row) {
            var side = getActualBalanceSide(row);

            if (side === 'Debit Balance') return 1;
            if (side === 'Credit Balance') return 2;

            return 3;
        }

        function getOracleBalanceDebitCredit(row) {
            if (row.BalanceDebit != null || row.BalanceCredit != null) {
                return {
                    debit: parseFloat(row.BalanceDebit) || 0,
                    credit: parseFloat(row.BalanceCredit) || 0
                };
            }

            var closing = parseFloat(row.ClosingBalance) || 0;
            var balanceType = (row.BalanceType || '').toString().trim().toLowerCase();

            if (balanceType === 'dr') {
                return closing >= 0
                    ? { debit: closing, credit: 0 }
                    : { debit: 0, credit: Math.abs(closing) };
            }

            if (balanceType === 'cr') {
                return closing >= 0
                    ? { debit: 0, credit: closing }
                    : { debit: Math.abs(closing), credit: 0 };
            }

            return closing >= 0
                ? { debit: closing, credit: 0 }
                : { debit: 0, credit: Math.abs(closing) };
        }

        function sumOracleTreeRows(rows, isCreditSide) {
            var total = {
                debit: 0,
                credit: 0
            };

            $.each(rows, function (i, row) {
                var dc = getOracleBalanceDebitCredit(row);
                total.debit += dc.debit;
                total.credit += dc.credit;
            });

            if (isCreditSide) {
                var net = total.credit - total.debit;
                if (net >= 0) {
                    total.credit = net;
                    total.debit = 0;
                } else {
                    total.credit = 0;
                    total.debit = Math.abs(net);
                }
            } else {
                var net = total.debit - total.credit;
                if (net >= 0) {
                    total.debit = net;
                    total.credit = 0;
                } else {
                    total.debit = 0;
                    total.credit = Math.abs(net);
                }
            }

            return total;
        }

        function oracleGroupBy(array, keySelector) {
            var result = {};

            $.each(array, function (i, item) {
                var key = keySelector(item) || 'N/A';

                if (!result[key]) {
                    result[key] = [];
                }

                result[key].push(item);
            });

            return result;
        }

        function compareText(a, b) {
            a = (a || '').toString();
            b = (b || '').toString();

            return a.localeCompare(b);
        }

        function fmtTree(num) {
            var value = parseFloat(num) || 0;

            if (Math.abs(value) <= 0.0001) {
                return '-';
            }

            return value.toLocaleString('en-IN', {
                minimumFractionDigits: 2,
                maximumFractionDigits: 2
            });
        }

        function htmlEncode(value) {
            return $('<div/>').text(value == null ? '' : value).html();
        }

    </script>
}
