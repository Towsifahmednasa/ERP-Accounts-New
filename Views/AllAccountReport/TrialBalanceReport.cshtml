@section Scripts
{
    <script type="text/javascript">

        $(document).ready(function () {
            LoadCompany('ddlCompany');
            LoadLadgerHead();
            GetSubsidaryType();
            GetReferenceType();
            initializeLedgerTypeDropdowns();
            OnLedgerTypeChange();
            $('#expandAllButton').hide();
            $('#collapseAllButton').hide();
            $('#expandAllButton').off('click').on('click', function () {
                expandOracleTreeAll();
            });
            $('#collapseAllButton').off('click').on('click', function () {
                collapseOracleTreeAll();
            });
            $('input[name="rbTransactionType"]').off('change').on('change', function () {
                resetTrialBalanceGridByFormat();
            });
        });

        function resetTrialBalanceGridByFormat() {
            $('#ledgerlist').empty();
            $('#expandAllButton').hide();
            $('#collapseAllButton').hide();

            if ($('#OracleTreeReportRadio').is(':checked')) {
                setOracleTreeReportHeader();
            } else {
                setNormalTrialBalanceHeader();
            }

            $('#lblBusinessUnit').text('');
            $('#lblFinancialYear').text('');
            $('#lblFromDate').text('');
            $('#lblToDate').text('');
        }

        function initializeLedgerTypeDropdowns() {
            $('#ddlSubsidiaryType').empty().append("<option value='0'>--Select--</option>");
            $('#ddlSubsidiary').empty().append("<option value='0'>--Select Subsidiary--</option>");
            $('#ddlReferenceType').empty().append("<option value='0'>--Select--</option>");
            $('#ddlReference').empty().append("<option value='0'>--Select--</option>");
            $('#ddlCS').empty().append("<option value='0'>--Select Cost Center--</option>");
        }

        function OnLedgerTypeChange() {
            var ledgerType = $('input[name="category"]:checked').val();

            if (!ledgerType) {
                ledgerType = 'coa';
                $('#COA').prop('checked', true);
            }

            $('#ledgerlist').empty();
            $('#lblBusinessUnit').text('');
            $('#lblFinancialYear').text('');
            $('#lblFromDate').text('');
            $('#lblToDate').text('');
            $('#coa-div').hide();
            $('#subsidiary-div').hide();
            $('#reference-div').hide();
            $('#cs-div').hide();

            if (ledgerType === 'coa') {
                $('#coa-div').show();
                $('#ddlLedgerHead').prop('disabled', false);
                $('#ddlControlLedger').prop('disabled', false);
                $('#ddlSubControlLedger').prop('disabled', false);
                $('#ddlSubSubControlLedger').prop('disabled', false);

                if ($.fn.select2) {
                    $('#ddlLedgerHead').trigger('change.select2');
                    $('#ddlControlLedger').trigger('change.select2');
                    $('#ddlSubControlLedger').trigger('change.select2');
                    $('#ddlSubSubControlLedger').trigger('change.select2');
                }

                return;
            }

            $('#ddlLedgerHead').val('0').prop('disabled', true);
            $('#ddlControlLedger').empty().append("<option value='0'>--Select Control Ledger--</option>").prop('disabled', true);
            $('#ddlSubControlLedger').empty().append("<option value='0'>--Select Control Ledger--</option>").prop('disabled', true);
            $('#ddlSubSubControlLedger').empty().append("<option value='0'>--Select Sub Sub Control Ledger--</option>").prop('disabled', true);

            if (ledgerType === 'subsidiary') {
                $('#subsidiary-div').show();
                if ($('#ddlSubsidiaryType option').length <= 1) {
                    GetSubsidaryType();
                }
                if (($('#ddlSubsidiaryType').val() || '0') === '0' && $('#ddlSubsidiaryType option').length > 1) {
                    $('#ddlSubsidiaryType').val($('#ddlSubsidiaryType option:eq(1)').val());
                }
                GetSubsidoryByType();
            } else if (ledgerType === 'reference') {
                $('#reference-div').show();
                if ($('#ddlReferenceType option').length <= 1) {
                    GetReferenceType();
                }
                if (($('#ddlReferenceType').val() || '0') === '0' && $('#ddlReferenceType option').length > 1) {
                    $('#ddlReferenceType').val($('#ddlReferenceType option:eq(1)').val());
                }
                GetReferenceByType();
            } else if (ledgerType === 'cost-center') {
                $('#cs-div').show();
                GetCostCenterList();
