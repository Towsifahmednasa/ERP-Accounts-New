                                : parseFloat(OpeningBalance) + parseFloat(item.CreditAmountBDT);

                            debitAmountBDT += debitAdjustment;
                            creditAmountBDT += creditAdjustment;

                            // Format debit and credit amounts with commas
                            var formattedDebitAmount = parseFloat(item.DebitAmountBDT).toLocaleString(undefined, { minimumFractionDigits: 4, maximumFractionDigits: 4 });
                            var formattedCreditAmount = parseFloat(item.CreditAmountBDT).toLocaleString(undefined, { minimumFractionDigits: 4, maximumFractionDigits: 4 });

                            var row = `
                                    <tr>
                                        <td style='text-align: center !important;'>${index + 1}</td>
                                        <td style='text-align: center !important;'>${formatDateToMMMDDYYYY(item.PostingDate)}</td>
                                        <td style='text-align:center'>
                                            <a data-bs-toggle='modal' onclick='PrintVoucherReport(${item.VoucherMasterId})' style='text-decoration: underline; cursor: pointer;' class='link-primary bold popupLink'>${item.VoucherCode}</a>
                                        </td>
                                        <td style='text-align: center !important;'>${item.AccountCode}</td>
                                        <td style='text-align: left !important;'>${item.AccountName}</td>
                                        <td style='word-wrap: break-word; white-space: normal;'>

                                            <span class='narration-full'>${item.Narration}</span>

                                        </td>
                                        <td style='text-align: center !important;'>${item.VoucherType}</td>
                                        
                                        <td style='text-align: right !important;'>${formattedDebitAmount}</td>
                                        <td style='text-align: right !important;'>${formattedCreditAmount}</td>
                                    </tr>`;

                            // Append row to tbody
                            $('#lblCurrency').text(item.CurrencyName);


                            $("#ledgerlist").append(row);
                        });

                       
                        //<td style='text-align: center !important;'>${item.CurrencyName}</td>
                       
                        //${
                        //    item.Narration.length > 50 ? `
                        //                        <span class='narration-short noExcel'>${item.Narration.substring(0, 50)}...</span>

                        //                        <a href='#' class='narration-toggle noExcel' onclick='toggleNarration(this); return false;'>Read More</a>
                        //                    ` : `
                        //                        <span class='narration-short'>${item.Narration}</span>
                        //                    `}

                        closingBalance = creditAmountBDT - debitAmountBDT;

                        var formattedDebitAmount = parseFloat(debitAmountBDT).toLocaleString(undefined, { minimumFractionDigits: 4, maximumFractionDigits: 4 });
                        var formattedCreditAmount = parseFloat(creditAmountBDT).toLocaleString(undefined, { minimumFractionDigits: 4, maximumFractionDigits: 4 });

                        var formattedclosingBalance = parseFloat(closingBalance).toLocaleString(undefined, { minimumFractionDigits: 4, maximumFractionDigits: 4 });

                        _myclosCheck = 0;
                        if (categoryrb == 'subsidiary' || categoryrb == 'reference') {
                            _closingBlnc = (_OpeningBalance + debitAmountBDT) - creditAmountBDT;
                            _myclosCheck = (_OpeningBalance + debitAmountBDT) - creditAmountBDT;

                            // Check if _closingBlnc is NaN, and if so, set it to 0
                            if (isNaN(_closingBlnc)) {
                                _closingBlnc = 0;
                            }
                            if (isNaN(_myclosCheck)) {
                                _myclosCheck = 0;
                            }
                            // Format the result to 4 decimal places
                            _closingBlnc = _closingBlnc.toLocaleString(undefined, { minimumFractionDigits: 4, maximumFractionDigits: 4 });
                        }
                        if (categoryrb == 'coa') {

                            if (_glHead == 'Assets' || _glHead == 'Expenses') {

                                _closingBlnc = (_OpeningBalance + debitAmountBDT) - creditAmountBDT;
                                _myclosCheck = (_OpeningBalance + debitAmountBDT) - creditAmountBDT;

                                // Check if _closingBlnc is NaN, and if so, set it to 0
                                if (isNaN(_closingBlnc)) {
                                    _closingBlnc = 0;
                                }
                                if (isNaN(_myclosCheck)) {
                                    _myclosCheck = 0;
                                }
                                // Format the result to 4 decimal places
                                _closingBlnc = _closingBlnc.toLocaleString(undefined, { minimumFractionDigits: 4, maximumFractionDigits: 4 });
                            }
                            else {
                                _closingBlnc = (_OpeningBalance + creditAmountBDT) - debitAmountBDT;
                                _myclosCheck = (_OpeningBalance + creditAmountBDT) - debitAmountBDT;

                                // Check if _closingBlnc is NaN, and if so, set it to 0
                                if (isNaN(_closingBlnc)) {
                                    _closingBlnc = 0;
                                }

                                if (isNaN(_myclosCheck)) {
                                    _myclosCheck = 0;
                                }

                                // Format the result to 4 decimal places
                                _closingBlnc = _closingBlnc.toLocaleString(undefined, { minimumFractionDigits: 4, maximumFractionDigits: 4 });
                            }
                        }


                       // alert(_myclosCheck);

                        if (_myclosCheck == 0) {
                            _closingBlnc = _OpeningBalance;
                        }

                        console.log('_closingBlnc:', _closingBlnc);

                        var footerRow1 = "<tr>" +
                            "<td colspan='7' style='text-align: right !important; font-weight: bold;'>Total</td>" +
                            "<td style='text-align: right !important; font-weight: bold;'>" + formattedDebitAmount + "</td>" +
                            "<td style='text-align: right !important; font-weight: bold;'>" + formattedCreditAmount + "</td>" +
                            "</tr>";

                        var footerRow2 = "<tr>" +
                            "<td colspan='7' style='text-align: right !important; font-weight: bold; font-size: 18px !important; color: forestgreen !important;'>Closing Balance</td>" +
                            "<td colspan='2' style='text-align: right !important; font-weight: bold; font-size: 18px !important; color: forestgreen !important;'>" + _closingBlnc + "</td>" +
                            "</tr>";

                        // Append the footer rows to your table

                        var row = footerRow1 + footerRow2;

                        $("#ledgerlist").append(row);

                        NarationHideShow();


                    }
                }
               , complete: function () {
                    setTimeout(function () {
                        $("#loadingSpinner").hide();
                    }, 5000);
                }
            });

                $("#loadingSpinner").hide(); // Hide spinner
            }, 3000);
        }

        // Function to toggle between short and full narration

        function toggleNarration(element) {
            var shortText = $(element).siblings('.narration-short');
            var fullText = $(element).siblings('.narration-full');

            if (shortText.is(':visible')) {
                shortText.hide();
                fullText.show();
                $(element).text('Read Less');
            } else {
                fullText.hide();
                shortText.show();
                $(element).text('Read More');
            }
        }

