            //$('#dtTb').DataTable();

        });


        $('#exportButton').click(function () {
            // Show the loading spinner
            $("#loadingSpinner").show();

            // Use a small timeout to allow spinner to render before blocking operation
            setTimeout(function () {
                var table = document.getElementById('dtTb');
                var html = table.outerHTML;

                var now = new Date();
                var day = ("0" + now.getDate()).slice(-2);
                var monthNames = ["Jan", "Feb", "Mar", "Apr", "May", "Jun",
                    "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"];
                var month = monthNames[now.getMonth()];
                var year = now.getFullYear();

                var hour = ("0" + now.getHours()).slice(-2);
                var minute = ("0" + now.getMinutes()).slice(-2);
                var second = ("0" + now.getSeconds()).slice(-2);

                var dateTime = day + "-" + month + "-" + year + " " + hour + "-" + minute + "-" + second;
                var fileName = 'Ledger Report ' + dateTime + '.xls';

                var url = 'data:application/vnd.ms-excel,' + encodeURIComponent(html);
                var link = document.createElement('a');
                link.href = url;
                link.download = fileName;
                link.click();

                // Hide the spinner after export
                $("#loadingSpinner").hide();

            }, 3000); // Slight delay for smoother UX
        });



        function NarationHideShow() {

            var rows = $('#ledgerlist tr');

            rows.each(function () {

                var row = $(this);

                if ($('#chkNarration').is(':checked')) {

                    $(row).find('.nested-table-container').show();

                } else {

                    $(row).find('.nested-table-container').hide();
                }

            })



        }

        function formatDateToMMMDDYYYY(dateStr) {

            var months = ["Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"];
            var dateObj = new Date(dateStr);

            var day = dateObj.getDate(); // Get day of the month (1-31)
            var month = months[dateObj.getMonth()]; // Get month (0-11, hence we use it as an index for the months array)
            var year = dateObj.getFullYear(); // Get the full year (e.g., 2024)

            // Return the formatted date as "26 - Aug - 2024"
            return `${day} - ${month} - ${year}`;

        }


