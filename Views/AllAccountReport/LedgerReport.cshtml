@* Ledger Report laid out like the wireframe report screens: title, filter bar (company / ledger type / account / period) with
   Export and Go actions, and one report card holding the statement header and the ledger table. Element ids, inline handlers,
   the table (#dtTb / #ledgerlist, read by Export) and the page scripts are the same contract as before. *@

@{
    ViewBag.Title = "Ledger Report";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<style>
    .hidden { display: none; }
    .rp-filter { border-radius: 12px; box-shadow: var(--sapContent_Shadow0); margin-bottom: 14px; padding: 12px 20px 14px; }
    .rp-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(230px, 1fr)); gap: 12px 18px; align-items: end; }
    .rp-grid .fld { min-width: 0; }
    .rp-grid .form-control, .rp-grid .form-select { width: 100%; }
    .rp-full { grid-column: 1 / -1; }
    .rp-radios { display: flex; gap: 18px; flex-wrap: wrap; align-items: center; min-height: 34px; }
    .rp-radios label { display: inline-flex; align-items: center; gap: 6px; font-size: 13px !important; color: var(--sapTextColor) !important; cursor: pointer; padding: 0 !important; }
    .rp-acts { display: flex; gap: 7px; flex-wrap: wrap; justify-content: flex-end; margin-top: 12px; }
    .rp-card { background: #fff; border-radius: 12px; box-shadow: var(--sapContent_Shadow0); overflow: hidden; }
    .rp-hd { padding: 10px 14px; border-bottom: 1px solid var(--sapList_HeaderBorderColor); display: flex; align-items: center; gap: 8px; }
    .rp-hd b { font-size: 13.5px; }
    .rp-scroll { max-height: calc(100vh - 260px); min-height: 200px; overflow: auto; }

    #dtTb { width: 100%; margin: 0; border-collapse: collapse; font-size: 12.5px; }
    #dtTb td, #dtTb th { border: 0; border-bottom: 1px solid var(--sapList_BorderColor); padding: 7px 10px; background: #fff; vertical-align: middle; }
    #dtTb thead.rp-meta td, #dtTb thead.rp-meta th { padding: 6px 14px; border-bottom: 0; background: #fff; }
    #dtTb thead.rp-meta .rp-title { text-align: center; font-size: 15px; font-weight: 600; padding-top: 12px; }
    #dtTb thead.rp-meta .k { color: var(--sapContent_LabelColor); font-size: 12px; font-weight: 400; white-space: nowrap; }
    #dtTb thead.rp-meta label { font-size: 13px !important; color: var(--sapTextColor) !important; font-weight: 600 !important; padding: 0 !important; }
    #dtTb thead.rp-cols th { position: sticky; top: 0; z-index: 1; background: #fafbfc; color: var(--sapContent_LabelColor); font-size: 12px; font-weight: 600; text-align: center; border-bottom-color: var(--sapList_HeaderBorderColor); border-top: 1px solid var(--sapList_HeaderBorderColor); white-space: nowrap; }
    #dtTb tbody tr:hover td { background: #f5f9fe; }
    #ledgerlist td { color: var(--sapTextColor) !important; font-variant-numeric: tabular-nums; }
    #ledgerlist td[colspan] { background: #f2f4f6 !important; font-weight: 600; }
    #ledgerlist a.popupLink { color: var(--sapLinkColor); font-weight: 600; text-decoration: none !important; }
    #ledgerlist a.popupLink:hover { text-decoration: underline !important; }
</style>
<div id="loadingSpinner" style="display:none;">
    <div class="overlay"></div>
    <div class="spinner-container">
        <div class="spinner"></div>
        <div class="loading-text">Loading...</div>
    </div>
</div>

<div style="margin:0 0 12px"><h5 class="mb-0 cstlfs" style="font-size:20px !important">Ledger Report</h5></div>

<div class="filterbar rp-filter">
    <div class="rp-grid">
        <div class="fld" id="divCompany">
            <label for="ddlCompany">Company <span class="required">*</span></label>
            <select class="form-select form-select-sm select2" style="width: 100%;" id="ddlCompany" onchange="LoadDDlbyCom()"></select>
        </div>
        <div class="fld">
            <label>Ledger Type <span class="required">*</span></label>
            <div class="rp-radios">
                <label for="COA"><input type="radio" id="COA" name="category" value="coa"> GL</label>
                <label for="subsidiary"><input type="radio" id="subsidiary" name="category" value="subsidiary"> Subsidiary</label>
                <label for="cost-center"><input type="radio" id="cost-center" name="category" value="cost-center"> Cost Center</label>
                <label for="reference"><input type="radio" id="reference" name="category" value="reference"> Reference</label>
            </div>
        </div>

        <div class="fld" id="coa-div">
            <label for="ddlcoa">Chart of Account <span id="requiredCoa" style="color: orangered !important;"></span></label>
            <select class="form-select form-select-sm select2" style="width: 100%;" id="ddlcoa" onchange="GetSubsidoryorCSDDlbyCOAId()"></select>
        </div>

        <div class="rp-full hidden" id="subsidiary-div">
            <div class="rp-grid">
                <div class="fld" id="divSubsidiaryType">
                    <label for="ddlSubsidiaryType">Subsidiary Type <span id="requiredSubsidiaryType" style="color: orangered !important;">*</span></label>
                    <select class="form-select form-select-sm select2" onchange="GetSubsidoryByType()" style="width: 100%;" id="ddlSubsidiaryType"></select>
                </div>
                <div class="fld" id="divSubsidiary">
                    <label for="ddlSubsidiary">Subsidiary <span id="requiredSubsidiary" style="color: orangered !important;">*</span></label>
                    <select class="form-select form-select-sm select2" style="width: 100%;" id="ddlSubsidiary"></select>
                </div>
            </div>
        </div>

        <div class="rp-full hidden" id="reference-div">
            <div class="rp-grid">
                <div class="fld" id="divReferenceType">
                    <label for="ddlReferenceType">Reference Type <span id="requiredReferenceType" style="color: orangered !important;">*</span></label>
                    <select class="form-select form-select-sm select2" onchange="GetReferenceByType()" style="width: 100%;" id="ddlReferenceType"></select>
                </div>
                <div class="fld" id="divReference">
                    <label for="ddlReference">Reference <span id="requiredReference" style="color: orangered !important;">*</span></label>
                    <select class="form-select form-select-sm select2" style="width: 100%;" id="ddlReference"></select>
                </div>
            </div>
        </div>

        <div class="fld hidden" id="cs-div">
            <label for="ddlCS">Cost Center <span style="color: orangered !important;">*</span></label>
            <div id="divCS"><select class="form-select form-select-sm select2" style="width: 100%;" id="ddlCS"></select></div>
        </div>

        <div class="fld" id="divFinansialYear">
            <label for="ddlFinansialYear">Financial Year <span class="required">*</span></label>
            <select class="form-select form-select-sm select2" style="width: 100%;" id="ddlFinansialYear" onchange="LoadDaterangebyFiscal()"></select>
        </div>
        <div class="fld">
            <label for="txtfrmDate">From Date <span class="required">*</span></label>
            <input type="text" id="txtfrmDate" class="form-control form-control-sm datepicker" value="@DateTime.Now.ToString("dd MMMM, yyyy")" />
        </div>
        <div class="fld">
            <label for="txtToDate">To Date <span class="required">*</span></label>
            <input type="text" id="txtToDate" class="form-control form-control-sm datepicker" value="@DateTime.Now.ToString("dd MMMM, yyyy")" />
        </div>
    </div>

    <div style="display:none" id="divTransactionType">
        <input class="form-check-input" checked type="checkbox" id="customSwitch1">
        <input class="form-check-input" onchange="NarationHideShow()" type="checkbox" id="chkNarration">
        <input class="form-check-input" type="checkbox" id="chkAllCompany">
        <button type="button" id="Reject" onclick="PrintReport()">Search</button>
    </div>

    <div class="rp-acts">
        <button id="exportButton" class="btn sm" type="button"><svg width="13" height="13"><use href="#s-dl"/></svg> Export to Excel</button>
        <button class="btn emph" type="button" onclick="GetDetailLedgerReport()"><svg width="13" height="13"><use href="#s-search"/></svg> Go</button>
    </div>
</div>

<div class="rp-card">
    <div class="rp-hd"><b>Ledger account</b></div>
    <div class="rp-scroll">
        <table id="dtTb">
            <thead class="rp-meta">
                <tr><th colspan="9" class="rp-title"><label id="lblheading">LEDGER ACCOUNT</label></th></tr>
                <tr class="jobRow">
                    <td colspan="2" class="k">Job Type</td>
                    <td colspan="7"><label id="lblJobType"></label></td>
                </tr>
                <tr class="jobRow">
                    <td colspan="2" class="k">Job Code</td>
                    <td colspan="7"><label id="lblJobCode"></label></td>
                </tr>
                <tr>
                    <td colspan="2" class="k">Business Unit</td>
                    <td colspan="3"><label id="lblBusinessUnit"></label></td>
                    <td colspan="2" class="k">From Date</td>
                    <td colspan="2"><label id="lblFromDate"></label></td>
                </tr>
                <tr>
                    <td colspan="2" class="k">Financial Year</td>
                    <td colspan="3"><label id="lblFinancialYear"></label></td>
                    <td colspan="2" class="k">To Date</td>
                    <td colspan="2"><label id="lblToDate"></label></td>
                </tr>
                <tr>
                    <td colspan="2" class="k">Currency</td>
                    <td colspan="3"><label id="lblCurrency"></label></td>
                    <td colspan="2" class="k">Opening Balance</td>
                    <td colspan="2"><label id="lblOpeningBalance"></label></td>
                </tr>
            </thead>
            <thead class="rp-cols">
                <tr>
                    <th style="width: 40px"># SL</th>
                    <th>Date</th>
                    <th>Voucher No</th>
                    <th>GL Code</th>
                    <th>GL</th>
                    <th>Narration</th>
                    <th>Voucher Type</th>
                    <th>Debit</th>
                    <th>Credit</th>
                </tr>
            </thead>
            <tbody id="ledgerlist">
            </tbody>
        </table>
    </div>
</div>

@section Scripts
{

    <script type="text/javascript">

        $(document).ready(function () {
            $(".jobRow").hide();
            LoadCompany('ddlCompany');
            // Load Subsidiary Type

            GetSubsidaryType();
            GetReferenceType();

            $('#subsidiary-div').hide();
            $('#cs-div').hide();

            $('input[name="category"]').change(function () {
                GetSubsidoryorCSDDlbyCOAId();
            });

            //$('#dtTb').DataTable();

        });


        $('#exportButton').click(function () {
            // Show the loading spinner
            $("#loadingSpinner").show();

            // Use a small timeout to allow spinner to render before blocking operation
            setTimeout(function () {
                var table = document.getElementById('dtTb');
                var html = table.outerHTML;

                var now = new Date();
                var day = ("0" + now.getDate()).slice(-2);
                var monthNames = ["Jan", "Feb", "Mar", "Apr", "May", "Jun",
                    "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"];
                var month = monthNames[now.getMonth()];
                var year = now.getFullYear();

                var hour = ("0" + now.getHours()).slice(-2);
                var minute = ("0" + now.getMinutes()).slice(-2);
                var second = ("0" + now.getSeconds()).slice(-2);

                var dateTime = day + "-" + month + "-" + year + " " + hour + "-" + minute + "-" + second;
                var fileName = 'Ledger Report ' + dateTime + '.xls';

                var url = 'data:application/vnd.ms-excel,' + encodeURIComponent(html);
                var link = document.createElement('a');
                link.href = url;
                link.download = fileName;
                link.click();

                // Hide the spinner after export
                $("#loadingSpinner").hide();

            }, 3000); // Slight delay for smoother UX
        });



        function NarationHideShow() {

            var rows = $('#ledgerlist tr');

            rows.each(function () {

                var row = $(this);

                if ($('#chkNarration').is(':checked')) {

                    $(row).find('.nested-table-container').show();

                } else {

                    $(row).find('.nested-table-container').hide();
                }

            })



        }

        function formatDateToMMMDDYYYY(dateStr) {

            var months = ["Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"];
            var dateObj = new Date(dateStr);

            var day = dateObj.getDate(); // Get day of the month (1-31)
            var month = months[dateObj.getMonth()]; // Get month (0-11, hence we use it as an index for the months array)
            var year = dateObj.getFullYear(); // Get the full year (e.g., 2024)

            // Return the formatted date as "26 - Aug - 2024"
            return `${day} - ${month} - ${year}`;

        }


