          function PrintReport()
        {
            var urlpath = '@Url.Action("rptLedgerReport", "AccountingTaskReport")';
              var reportValue = "LedgerRpt";




              var CompanyID = $('#ddlCompany').val();
              var Company = $("#ddlCompany option:selected").text();

              var coaID = $('#ddlcoa').val();
              var FinancialYearID = $('#ddlFinansialYear').val();
              var  FinancialYearText = $("#ddlFinansialYear option:selected").text();

              var FromDate = $('#txtfrmDate').val();
              var ToDate = $('#txtToDate').val();
              var BankBookBankNAme = $("#ddlcashAccount option:selected").text();
              var Monthly = "";
              var Narration = "";
              if ($('#customSwitch1').is(':checked')) {
                  Monthly = "True";
              }
              if ($('#chkNarration').is(':checked')) {
                  Narration = "True";
              }
              var LedgerOtherCurrency = false;
              if ($('#chkNarration').is(':checked')) {
                  Narration = "True";
              }

              var SubsidiaryID = 0;
              var CsID = 0;
              var selectedValue = $('input[name="category"]:checked').val();


              if (selectedValue === "subsidiary") {

                    SubsidiaryID = $('#ddlSubsidiary').val();
              } else if (selectedValue === "cost-center") {

                    CsID = $('#ddlCS').val();
              }

              if (selectedValue == 'undefined') {
                  selectedValue = "";
              }
              var prm = "CompanyID=" + CompanyID + "&coaID=" + coaID + "&FinancialYearID=" + FinancialYearID + "&FromDate=" + FromDate + "&ToDate=" + ToDate + "&Company=" + Company + "&Monthly=" + Monthly + "&Narration=" + Narration + "&FinancialYearText=" + FinancialYearText + "&BankBookBankNAme=" + BankBookBankNAme + "&LedgerOtherCurrency=" + LedgerOtherCurrency + "&TypeSubCS=" + selectedValue + "&SubsidiaryID=" + SubsidiaryID + "&CsID=" + CsID;


        $.ajax({
            url: urlpath,
            data: { MasterId: 0, reportValue: reportValue},
                dataType: 'json',
                type: "Get",
                success: function (data) {
                    if (data.isSuccess) {
                        //OpenPopUp('BasicReportViewer.aspx');
                        window.open("/CrystalViewer/CrystalViewer.aspx?" + prm+ "", "_blank", "WIDTH=1024,HEIGHT=768,scrollbars=no, menubar=no,resizable=yes,directories=no,location=no");
                    }
                }
            });
        }

