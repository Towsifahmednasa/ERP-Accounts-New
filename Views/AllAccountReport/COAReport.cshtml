    .coa-level-1 .coa-name { padding-left: 12px !important; }
    .coa-level-2 .coa-name { padding-left: 36px !important; }
    .coa-level-3 .coa-name { padding-left: 60px !important; }
    .coa-level-4 .coa-name { padding-left: 84px !important; }
    .coa-level-5 .coa-name { padding-left: 108px !important; }

    .coa-gl-row td {
        background: #173A5A !important;
        color: #ffffff !important;
        font-weight: bold;
    }

    .coa-control-row td {
        background: #D0DFF0 !important;
        color: #102F4F !important;
        font-weight: bold;
    }

    .coa-sub-row td {
        background: #EEF3FA !important;
        color: #285B86 !important;
        font-weight: bold;
    }

    .coa-subsub-row td {
        background: #F7FAFD !important;
        color: #2B4F70 !important;
        font-weight: bold;
    }

    .coa-account-row td {
        background: #ffffff !important;
    }

    .coa-account-row {
        cursor: default;
    }

    .coa-copy-code {
        cursor: pointer;
        user-select: text;
    }

    .coa-copy-code:hover {
        text-decoration: underline;
    }

    #expandCOAAllButton,
    #collapseCOAAllButton,
    #exportButton {
        display: inline-block;
        width: auto !important;
        min-width: auto !important;
        white-space: nowrap;
