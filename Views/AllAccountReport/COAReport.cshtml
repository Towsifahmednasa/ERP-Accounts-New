@* Chart of Account Report laid out like wireframe screen 81 "Chart of accounts": filter bar, "Account hierarchy" master list
   (expand/collapse tree) and a read-only account master pane for the selected row. Element ids, the tree table (#dtTb / #ledgerlist,
   used by the Excel export) and the data calls are the same contract as before. *@

@{
    ViewBag.Title = "Chart of Account Report";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<style>
    .coa-filter { display: flex; gap: 14px; flex-wrap: wrap; align-items: flex-end; border-radius: 12px; box-shadow: var(--sapContent_Shadow0); margin-bottom: 14px; padding: 10px 20px 12px; }
    .coa-filter .fld { min-width: 280px; }
    .coa-filter .coa-acts { margin-left: auto; display: flex; gap: 7px; flex-wrap: wrap; }
    .coa-split { display: flex; gap: 14px; align-items: flex-start; flex-wrap: wrap; }
    .coa-master { flex: 1 1 520px; max-width: 760px; background: #fff; border-radius: 12px; box-shadow: var(--sapContent_Shadow0); overflow: hidden; }
    .coa-detail { flex: 1 1 320px; background: #fff; border-radius: 12px; box-shadow: var(--sapContent_Shadow0); overflow: hidden; }
    .coa-hd { padding: 10px 14px; border-bottom: 1px solid var(--sapList_HeaderBorderColor); display: flex; align-items: center; gap: 8px; }
    .coa-hd b { font-size: 13.5px; }
    .coa-hd .mini { margin-left: auto; }
    .coa-scroll { max-height: calc(100vh - 330px); min-height: 220px; overflow: auto; }

    #dtTb { width: 100%; margin: 0; border-collapse: collapse; font-size: 12.5px; }
    #dtTb td, #dtTb th { border: 0; border-bottom: 1px solid var(--sapList_BorderColor); padding: 7px 10px; background: #fff; vertical-align: middle; }
    #dtTb thead th { position: sticky; top: 0; z-index: 1; background: #fafbfc; color: var(--sapContent_LabelColor); font-size: 12px; font-weight: 600; text-align: left; border-bottom-color: var(--sapList_HeaderBorderColor); }
    #dtTb .coa-xl-only { display: none; }
    #dtTb .coa-sl { width: 76px; color: var(--sapContent_LabelColor); font-size: 12px; font-variant-numeric: tabular-nums; }
    #dtTb .coa-code { width: 120px; }
    #dtTb .coa-tp { width: 130px; text-align: right; }
    #dtTb .coa-hint td { text-align: center; color: var(--sapContent_LabelColor); padding: 26px 10px; }

    .coa-name { display: flex; align-items: center; gap: 7px; }
    .coa-name svg { flex: none; color: #556b82; }
    .coa-tree-clickable { cursor: pointer; user-select: none; }
    .coa-tree-clickable:not(.coa-tree-open) .coa-caret { transform: rotate(-90deg); }
    .coa-level-1 .coa-name { padding-left: 0; }
    .coa-level-2 .coa-name { padding-left: 16px; }
    .coa-level-3 .coa-name { padding-left: 32px; }
    .coa-level-4 .coa-name { padding-left: 48px; }
    .coa-level-5 .coa-name { padding-left: 64px; }
    .coa-level-5 .coa-name svg { color: #8b9aab; }
    tr.coa-level-1 td { background: #f2f4f6; font-weight: 600; }
    tr.coa-level-2 td { font-weight: 600; }
    tr.coa-tree-clickable:hover td, tr.coa-account-row:hover td { background: #f5f9fe; }
    tr.coa-sel td { background: var(--sapList_SelectionBackgroundColor); font-weight: 600; }
    tr.coa-sel td:first-child { box-shadow: inset 3px 0 0 var(--sapBrandColor); }
    .coa-copy-code { color: var(--sapLinkColor); font-weight: 600; cursor: pointer; }
    .coa-copy-code:hover { text-decoration: underline; }
    .coa-chip { display: inline-block; font-size: 11.5px; line-height: 1; padding: 3px 8px; border-radius: 10px; background: #eef2f6; color: var(--sapContent_LabelColor); font-weight: 400; }

    .coa-id { display: flex; align-items: center; gap: 12px; padding: 14px; border-bottom: 1px solid var(--sapList_BorderColor); }
    .coa-id .cd { min-width: 52px; padding: 9px 8px; border-radius: 8px; background: #eef2f6; text-align: center; font-weight: 700; word-break: break-all; }
    .coa-id h4 { margin: 0; font-size: 15px; font-weight: 600; }
    .coa-fields { display: grid; grid-template-columns: repeat(auto-fill, minmax(170px, 1fr)); gap: 14px 20px; padding: 14px; }
    .coa-fields .k { font-size: 12px; color: var(--sapContent_LabelColor); }
    .coa-fields .v { margin-top: 2px; }
    .coa-fields .wide { grid-column: 1 / -1; }
    .coa-empty { padding: 40px 14px; text-align: center; color: var(--sapContent_LabelColor); }
</style>
<div id="loadingSpinner" style="display:none;">
    <div class="overlay"></div>
    <div class="spinner-container">
        <div class="spinner"></div>
        <div class="loading-text">Loading...</div>
    </div>
</div>

<div class="page-title" style="margin:0 0 12px">
    <h5 class="mb-0 cstlfs" style="font-size:20px !important">Chart of Account Report</h5>
</div>

<div class="strip info">
    <svg width="15" height="15" style="flex:none;margin-top:1px"><use href="#s-i"/></svg>
    <div><b>Chart of accounts &mdash; master&ndash;detail over the ledger tree.</b> The hierarchy on the left is the operational chart; the right pane shows the master data of whatever is selected. Click a code to copy it.</div>
</div>

<div class="filterbar coa-filter">
    <div class="fld">
        <label for="ddlCompany">Company <span class="required">*</span></label>
        <select class="form-select form-select-sm select2" style="width: 100%;" id="ddlCompany"></select>
    </div>
    <div class="coa-acts">
        <button id="expandCOAAllButton" class="btn sm" type="button" style="display:none;"><svg width="13" height="13"><use href="#s-plus"/></svg> Expand All</button>
        <button id="collapseCOAAllButton" class="btn sm" type="button" style="display:none;"><svg width="13" height="13"><use href="#s-up"/></svg> Collapse All</button>
        <button id="exportButton" class="btn sm" type="button"><svg width="13" height="13"><use href="#s-dl"/></svg> Export to Excel</button>
        <button class="btn emph" id="Reject" type="button" onclick="ShowReport()"><svg width="13" height="13"><use href="#s-search"/></svg> Go</button>
    </div>
</div>

<div class="coa-split">
    <div class="coa-master">
        <div class="coa-hd">
            <b>Account hierarchy</b>
            <span class="mini" id="coaCounts"></span>
        </div>
        <div class="coa-scroll">
            <table id="dtTb">
                <thead>
                    <tr class="coa-xl-only"><th colspan="4" style="text-align:center"><label id="lblheading">Chart Of Account</label></th></tr>
                    <tr class="coa-xl-only"><th colspan="2">Company Name:</th><th colspan="2"><label id="lblGetCompanyName"></label></th></tr>
                    <tr>
                        <th class="coa-sl">SL</th>
                        <th class="coa-code">Code</th>
                        <th>Particular Name</th>
                        <th class="coa-tp">Type</th>
                    </tr>
                </thead>
                <tbody id="ledgerlist">
                    <tr class="coa-hint"><td colspan="4">Select a company and press Go to load the chart of accounts.</td></tr>
                </tbody>
            </table>
        </div>
    </div>

    <div class="coa-detail">
        <div class="coa-hd"><b>Account master</b><span class="mini">Read-only</span></div>
        <div id="coaDetail"><div class="coa-empty">Select an account in the hierarchy to see its master data.</div></div>
    </div>
</div>

@section Scripts
{

    <script type="text/javascript">

        $(document).ready(function () {
            LoadCompany('ddlCompany');
            $('#expandCOAAllButton').hide();
            $('#collapseCOAAllButton').hide();
            $('#expandCOAAllButton').off('click').on('click', function () {
                expandCOATreeAll();
            });
            $('#collapseCOAAllButton').off('click').on('click', function () {
                collapseCOATreeAll();
            });

        });



        function ShowReport()
        {
            var companyId = $('#ddlCompany').val();
        $.ajax({
            url: "/ChartOfAccount/GetChartofAccount_ByCompanyId",
            data: { id: companyId },
            dataType: 'json',
            type: "Get",
            beforeSend: function () {
                // Show the full-screen loading spinner
                $("#loadingSpinner").show();
            },
            success: function (data) {
                
                console.log('data:-' + data);
                    data = JSON.parse(data);
                    $("#ledgerlist").empty();

                    if (data) {

                        $("#lblGetCompanyName").text($('#ddlCompany option:selected').text());
                        renderCOATreeView(data);

                    }


            }

            ,
            complete: function () {
                setTimeout(function () {
                    $("#loadingSpinner").hide();
                }, 5000); 
            }
            });
        }

        function renderCOATreeView(data) {
            var $tbody = $("#ledgerlist");
            $tbody.empty();

            if (!data || data.length === 0) {
                $('#expandCOAAllButton').hide();
                $('#collapseCOAAllButton').hide();
                $tbody.append('<tr class="coa-hint"><td colspan="4">No data found.</td></tr>');
                $('#coaCounts').text('');
                return;
            }

            var rowId = 1;
            var rootSL = 1;

            var glGroups = groupByCOA(data, function (row) {
                return getGroupKey(row.GLHeadId, row.GLCode, row.GLName);
            });

            $.each(glGroups, function (glKey, glRows) {
                var firstGL = glRows[0] || {};
                var glId = 'gl_' + rowId++;
                var glSL = rootSL.toString();
                var glInfo = getCodeAndName(firstGL.GLCode, firstGL.GLName, firstGL.GLHeadId);

                appendCOATreeRow($tbody, {
                    rowId: glId,
                    parentId: '',
                    rowClass: 'coa-gl-row',
                    level: 1,
                    isClickable: true,
                    sl: glSL,
                    code: glInfo.code,
                    name: glInfo.name,
                    type: 'GL Head',
                    status: getStatusText(firstGL.GLIsActive)
                });

                var controlIndex = 1;
                var controlGroups = groupByCOA(glRows, function (row) {
                    return getGroupKey(row.ControlLId, row.ControlLCode, row.ControlLName);
                });

                $.each(controlGroups, function (controlKey, controlRows) {
                    var firstControl = controlRows[0] || {};
                    var controlId = 'control_' + rowId++;
                    var controlSL = glSL + '.' + controlIndex;
                    var controlInfo = getCodeAndName(firstControl.ControlLCode, firstControl.ControlLName, firstControl.ControlLId);

                    appendCOATreeRow($tbody, {
                        rowId: controlId,
                        parentId: glId,
                        rowClass: 'coa-control-row',
                        level: 2,
                        isClickable: true,
                        sl: controlSL,
                        code: controlInfo.code,
                        name: controlInfo.name,
                        type: 'Control',
                        status: getStatusText(firstControl.ControlIsActive || firstControl.IsActive)
                    });

                    var subIndex = 1;
                    var subGroups = groupByCOA(controlRows, function (row) {
                        return getGroupKey(row.SubsidiryLId, row.SubsidiryLCode, row.SubsidiryLName);
                    });

                    $.each(subGroups, function (subKey, subRows) {
                        var firstSub = subRows[0] || {};
                        var subId = 'sub_' + rowId++;
                        var subSL = controlSL + '.' + subIndex;
                        var subInfo = getCodeAndName(firstSub.SubsidiryLCode, firstSub.SubsidiryLName, firstSub.SubsidiryLId);

                        appendCOATreeRow($tbody, {
                            rowId: subId,
                            parentId: controlId,
                            rowClass: 'coa-sub-row',
                            level: 3,
                            isClickable: true,
                            sl: subSL,
                            code: subInfo.code,
                            name: subInfo.name,
                            type: 'Sub Control',
                            status: getStatusText(firstSub.SubsidiryIsActive || firstSub.IsActive)
                        });

                        var subSubIndex = 1;
                        var subSubGroups = groupByCOA(subRows, function (row) {
                            return getGroupKey(
                                row.SubSubControlLedgerId,
                                row.SubSubControlLedgerCode,
                                row.SubSubControlLedgerName || row.SubsubsidiryLName
                            );
                        });

                        $.each(subSubGroups, function (subSubKey, subSubRows) {
                            var firstSubSub = subSubRows[0] || {};
                            var subSubId = 'subsub_' + rowId++;
                            var subSubSL = subSL + '.' + subSubIndex;
                            var subSubInfo = getCodeAndName(
                                firstSubSub.SubSubControlLedgerCode,
                                firstSubSub.SubSubControlLedgerName || firstSubSub.SubsubsidiryLName,
                                firstSubSub.SubSubControlLedgerId
                            );

                            appendCOATreeRow($tbody, {
                                rowId: subSubId,
                                parentId: subId,
                                rowClass: 'coa-subsub-row',
                                level: 4,
                                isClickable: true,
                                sl: subSubSL,
                                code: subSubInfo.code,
                                name: subSubInfo.name,
                                type: 'Sub Sub Control',
                                status: getStatusText(firstSubSub.SubSubControlIsActive || firstSubSub.IsActive)
                            });

                            var accountIndex = 1;

                            $.each(subSubRows, function (i, row) {
                                var accountSL = subSubSL + '.' + accountIndex;
                                var accountInfo = getCodeAndName(row.COACode, row.AccountName, row.AccountId);

                                appendCOATreeRow($tbody, {
                                    rowId: 'acc_' + rowId++,
                                    parentId: subSubId,
                                    rowClass: 'coa-account-row',
                                    level: 5,
                                    isClickable: false,
                                    sl: accountSL,
                                    code: accountInfo.code,
                                    name: accountInfo.name,
                                    type: 'GL',
                                    status: getStatusText(row.AccountIsActive || row.IsActive)
                                });

                                accountIndex++;
                            });

                            subSubIndex++;
                        });

                        subIndex++;
                    });

                    controlIndex++;
                });

                rootSL++;
            });

            $('#ledgerlist tr[data-parent!=""]').hide();
            bindCOATreeClick();
            bindCOACodeCopyClick();
            $('#ledgerlist').off('click.coasel').on('click.coasel', 'tr', selectCOARow);
            updateCOACounts();
            $('#coaDetail').html('<div class="coa-empty">Select an account in the hierarchy to see its master data.</div>');
            $('#expandCOAAllButton').show();
            $('#collapseCOAAllButton').show();
        }

        function appendCOATreeRow($tbody, opt) {
            var icon = opt.isClickable
                ? '<svg class="coa-caret" width="12" height="12"><use href="#s-down"/></svg>'
                : '<svg width="12" height="12"><use href="#s-doc"/></svg>';

            $tbody.append(
                '<tr ' +
                    'data-id="' + htmlEncodeCOA(opt.rowId) + '" ' +
                    'data-parent="' + htmlEncodeCOA(opt.parentId) + '" ' +
                    'data-status="' + htmlEncodeCOA(opt.status) + '" ' +
                    'class="' + opt.rowClass + ' coa-level-' + opt.level + (opt.isClickable ? ' coa-tree-clickable' : '') + '">' +
                    '<td class="coa-sl">' + htmlEncodeCOA(opt.sl) + '</td>' +
                    '<td class="coa-code coa-copy-code" data-code="' + htmlEncodeCOA(opt.code) + '" title="Click to copy">' + htmlEncodeCOA(opt.code) + '</td>' +
                    '<td><div class="coa-name">' + icon + '<span>' + htmlEncodeCOA(opt.name) + '</span></div></td>' +
                    '<td class="coa-tp"><span class="coa-chip">' + htmlEncodeCOA(opt.type) + '</span></td>' +
                '</tr>'
            );
        }

        function updateCOACounts() {
            var heads = $('#ledgerlist tr.coa-level-1').length;
            var groups = $('#ledgerlist tr.coa-level-2, #ledgerlist tr.coa-level-3, #ledgerlist tr.coa-level-4').length;
            var ledgers = $('#ledgerlist tr.coa-level-5').length;
            $('#coaCounts').text(heads + ' heads \u00b7 ' + groups + ' groups \u00b7 ' + ledgers + ' ledgers');
        }

        function coaCell($tr, idx) {
            return $.trim($tr.children('td').eq(idx).text());
        }

        function selectCOARow() {
            var $tr = $(this);
            if ($tr.hasClass('coa-hint')) return;

            $('#ledgerlist tr.coa-sel').removeClass('coa-sel');
            $tr.addClass('coa-sel');

            var path = [];
            var $cur = $tr;
            while ($cur.length) {
                path.unshift(coaCell($cur, 1) + ' ' + coaCell($cur, 2));
                var pid = $cur.attr('data-parent');
                $cur = pid ? $('#ledgerlist tr[data-id="' + pid + '"]') : $();
            }

            var status = $tr.attr('data-status');
            var statusHtml = status === 'Active' ? '<span class="objstat"><svg width="13" height="13" style="color:var(--sapPositiveColor)"><use href="#s-ok"/></svg>Active</span>'
                : status === 'Inactive' ? '<span class="objstat"><svg width="13" height="13" style="color:var(--sapNegativeColor)"><use href="#s-no"/></svg>Inactive</span>'
                : '&mdash;';

            $('#coaDetail').html(
                '<div class="coa-id"><div class="cd">' + htmlEncodeCOA(coaCell($tr, 1)) + '</div>' +
                    '<div><h4>' + htmlEncodeCOA(coaCell($tr, 2)) + '</h4><span class="mini">' + htmlEncodeCOA(coaCell($tr, 3)) + '</span></div></div>' +
                '<div class="coa-fields">' +
                    '<div><div class="k">Account code</div><div class="v">' + htmlEncodeCOA(coaCell($tr, 1)) + '</div></div>' +
                    '<div><div class="k">Account type</div><div class="v">' + htmlEncodeCOA(coaCell($tr, 3)) + '</div></div>' +
                    '<div><div class="k">Serial</div><div class="v">' + htmlEncodeCOA(coaCell($tr, 0)) + '</div></div>' +
                    '<div><div class="k">Status</div><div class="v">' + statusHtml + '</div></div>' +
                    '<div class="wide"><div class="k">Company</div><div class="v">' + htmlEncodeCOA($('#lblGetCompanyName').text()) + '</div></div>' +
                    '<div class="wide"><div class="k">Hierarchy</div><div class="v">' + htmlEncodeCOA(path.join(' \u203a ')) + '</div></div>' +
                '</div>'
            );
        }

        function bindCOATreeClick() {
            $('#ledgerlist').off('click', 'tr.coa-tree-clickable');

            $('#ledgerlist').on('click', 'tr.coa-tree-clickable', function () {
                var $row = $(this);
                var rowId = $row.attr('data-id');
                var isOpen = $row.hasClass('coa-tree-open');

                if (isOpen) {
                    collapseCOAChildren(rowId);
                    $row.removeClass('coa-tree-open');
                } else {
                    showCOAChildren(rowId);
                    $row.addClass('coa-tree-open');
                }
            });
        }

        function bindCOACodeCopyClick() {
            $('#ledgerlist').off('click', '.coa-copy-code');

            $('#ledgerlist').on('click', '.coa-copy-code', function (e) {
                e.stopPropagation();

                var code = ($(this).attr('data-code') || '').trim();

                if (!code) {
                    return;
                }

                copyCOATextToClipboard(code);
            });
        }

        function copyCOATextToClipboard(text) {
            if (!text) return;

            if (navigator.clipboard && window.isSecureContext) {
                navigator.clipboard.writeText(text).then(function () {
                    toastr.success('Code copied: ' + text);
                }).catch(function () {
                    fallbackCopyCOATextToClipboard(text);
                });
            } else {
                fallbackCopyCOATextToClipboard(text);
            }
        }

        function fallbackCopyCOATextToClipboard(text) {
            var textArea = document.createElement("textarea");
            textArea.value = text;
            textArea.style.position = "fixed";
            textArea.style.left = "-999999px";
            textArea.style.top = "-999999px";

            document.body.appendChild(textArea);
            textArea.focus();
            textArea.select();

            try {
                var successful = document.execCommand('copy');

                if (successful) {
                    toastr.success('Code copied: ' + text);
                } else {
                    toastr.error('Code copy failed.');
                }
            } catch (err) {
                toastr.error('Code copy failed.');
            }

            document.body.removeChild(textArea);
        }

        function showCOAChildren(parentId) {
            $('#ledgerlist tr[data-parent="' + parentId + '"]').show();
        }

        function collapseCOAChildren(parentId) {
            var $children = $('#ledgerlist tr[data-parent="' + parentId + '"]');

            $children.each(function () {
                var childId = $(this).attr('data-id');

                collapseCOAChildren(childId);

                $(this).hide();
                $(this).removeClass('coa-tree-open');
            });
        }

        function expandCOATreeAll() {
            $('#ledgerlist tr').show();

            $('#ledgerlist tr.coa-tree-clickable').each(function () {
                $(this).addClass('coa-tree-open');
            });
        }

        function collapseCOATreeAll() {
            $('#ledgerlist tr.coa-level-2, #ledgerlist tr.coa-level-3, #ledgerlist tr.coa-level-4, #ledgerlist tr.coa-level-5').hide();

            $('#ledgerlist tr.coa-level-1').show();

            $('#ledgerlist tr.coa-tree-clickable').each(function () {
                $(this).removeClass('coa-tree-open');
            });
        }

        function groupByCOA(array, keySelector) {
            var result = {};

            $.each(array, function (i, item) {
                var key = keySelector(item) || 'N/A';

                if (!result[key]) {
                    result[key] = [];
                }

                result[key].push(item);
            });

            return result;
        }

        function getGroupKey(id, code, name) {
            return (id || '') + '|' + (code || '') + '|' + (name || '');
        }

        function getCodeAndName(code, name, fallbackId) {
            code = code || '';
            name = name || '';

            if (code) {
                return {
                    code: code,
                    name: cleanNameOnly(name)
                };
            }

            var parsed = extractNumericCodeAndName(name);

            return {
                code: parsed.accountCode || fallbackId || '',
                name: parsed.nameOnly || name
            };
        }

        function extractNumericCodeAndName(str) {
            str = str || '';

            var codeMatch = str.match(/\((\d+)\)/);
            var accountCode = codeMatch ? codeMatch[1] : '';
            var nameOnly = codeMatch ? str.replace(codeMatch[0], '').trim().replace(/\s{2,}/g, ' ') : str;

            return {
                accountCode: accountCode,
                nameOnly: nameOnly
            };
        }

        function cleanNameOnly(str) {
            str = str || '';
            var parsed = extractNumericCodeAndName(str);
            return parsed.nameOnly || str;
        }

        function getStatusText(value) {
            if (value === true || value === 1 || value === '1' || value === 'True' || value === 'true') {
                return 'Active';
            }

            if (value === false || value === 0 || value === '0' || value === 'False' || value === 'false') {
                return 'Inactive';
            }

            return '';
        }

        function htmlEncodeCOA(value) {
            return $('<div/>').text(value == null ? '' : value).html();
        }


        $('#exportButton').click(function () {
            expandCOATreeAll();

            // Get the table element
            var table = document.getElementById('dtTb');

            // Clone the table to modify it without affecting the original
            var clonedTable = table.cloneNode(true);

            // Find and remove columns with the `.noExcel` class
            $(clonedTable).find('tr').each(function () {
                $(this).find('.noExcel').remove();
            });

            // Convert the modified table to a worksheet
            var workbook = XLSX.utils.table_to_book(clonedTable, { sheet: "Chart Of Account" });
            var worksheet = workbook.Sheets["Chart Of Account"];

            // Specify the column indexes (0-based) for GL Code, Debit (BDT), and Credit (BDT)
            var glCodeColIndex = 3;       // GL Code column
            var debitColIndex = 8;        // Debit (BDT) column
            var creditColIndex = 9;       // Credit (BDT) column

            // Convert GL Code cells to string format
            var range = XLSX.utils.decode_range(worksheet['!ref']);
            for (var row = range.s.r + 1; row <= range.e.r; row++) { // Skip header row
                // Handle GL Code as string
                var glCodeCellRef = XLSX.utils.encode_cell({ c: glCodeColIndex, r: row });
                var glCodeCell = worksheet[glCodeCellRef];
                if (glCodeCell && glCodeCell.v !== undefined) {
                    glCodeCell.t = 's'; // Set cell type to string
                    glCodeCell.v = String(glCodeCell.v); // Ensure the value is a string
                }

                // Handle Debit (BDT) as number with 4 decimal places
                var debitCellRef = XLSX.utils.encode_cell({ c: debitColIndex, r: row });
                var debitCell = worksheet[debitCellRef];
                if (debitCell && debitCell.v !== undefined) {
                    debitCell.t = 'n'; // Set cell type to number
                    debitCell.v = parseFloat(debitCell.v).toFixed(4); // Ensure the value is a number with 4 decimal places
                    debitCell.z = '0.0000'; // Set cell format to 4 decimal places
                }

                // Handle Credit (BDT) as number with 4 decimal places
                var creditCellRef = XLSX.utils.encode_cell({ c: creditColIndex, r: row });
                var creditCell = worksheet[creditCellRef];
                if (creditCell && creditCell.v !== undefined) {
                    creditCell.t = 'n'; // Set cell type to number
                    creditCell.v = parseFloat(creditCell.v).toFixed(4); // Ensure the value is a number with 4 decimal places
                    creditCell.z = '0.0000'; // Set cell format to 4 decimal places
                }
            }

            // Generate Excel file and prompt download
            XLSX.writeFile(workbook, 'Chart_Of_Account.xlsx');

        });

