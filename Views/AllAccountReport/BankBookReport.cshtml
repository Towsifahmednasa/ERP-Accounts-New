@* Bank Book Report laid out like the wireframe report screens: title, filter bar (company / bank / account / period) with Export,
   Print and Go actions, and one report card holding the statement header and the ledger table. Element ids, inline handlers,
   the table (#dtTb / #ledgerlist, read by Export and Print) and the page scripts are the same contract as before. *@

@{
    ViewBag.Title = "Bank Book Report ";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    .hidden { display: none; }
    .rp-filter { border-radius: 12px; box-shadow: var(--sapContent_Shadow0); margin-bottom: 14px; padding: 12px 20px 14px; }
    .rp-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(230px, 1fr)); gap: 12px 18px; align-items: end; }
    .rp-grid .fld { min-width: 0; }
    .rp-grid .form-control, .rp-grid .form-select { width: 100%; }
    .rp-acts { display: flex; gap: 7px; flex-wrap: wrap; justify-content: flex-end; margin-top: 12px; }
    .rp-card { background: #fff; border-radius: 12px; box-shadow: var(--sapContent_Shadow0); overflow: hidden; }
    .rp-hd { padding: 10px 14px; border-bottom: 1px solid var(--sapList_HeaderBorderColor); display: flex; align-items: center; gap: 8px; }
    .rp-hd b { font-size: 13.5px; }
    .rp-scroll { max-height: calc(100vh - 260px); min-height: 200px; overflow: auto; }

    #dtTb { width: 100%; margin: 0; border-collapse: collapse; font-size: 12.5px; }
    #dtTb td, #dtTb th { border: 0; border-bottom: 1px solid var(--sapList_BorderColor); padding: 7px 10px; background: #fff; vertical-align: middle; }
    #dtTb thead.rp-meta td, #dtTb thead.rp-meta th { padding: 6px 14px; border-bottom: 0; background: #fff; }
    #dtTb thead.rp-meta .rp-title { text-align: center; font-size: 15px; font-weight: 600; padding-top: 12px; }
    #dtTb thead.rp-meta .k { color: var(--sapContent_LabelColor); font-size: 12px; font-weight: 400; white-space: nowrap; }
    #dtTb thead.rp-meta label { font-size: 13px !important; color: var(--sapTextColor) !important; font-weight: 600 !important; padding: 0 !important; }
    #dtTb thead.rp-cols th { position: sticky; top: 0; z-index: 1; background: #fafbfc; color: var(--sapContent_LabelColor); font-size: 12px; font-weight: 600; text-align: center; border-bottom-color: var(--sapList_HeaderBorderColor); border-top: 1px solid var(--sapList_HeaderBorderColor); white-space: nowrap; }
    #dtTb tbody tr:hover td { background: #f5f9fe; }
    #ledgerlist td { color: var(--sapTextColor) !important; }
    #ledgerlist td strong { font-weight: 400; font-variant-numeric: tabular-nums; }
    #ledgerlist tr[style*="font-weight: bold"] td { background: #f2f4f6 !important; font-weight: 600; }
    #ledgerlist a.popupLink { color: var(--sapLinkColor); font-weight: 600; text-decoration: none !important; }
    #ledgerlist a.popupLink:hover { text-decoration: underline !important; }
</style>
<div id="loadingSpinner" style="display:none;">
    <div class="overlay"></div>
    <div class="spinner-container">
        <div class="spinner"></div>
        <div class="loading-text">Loading...</div>
    </div>
</div>

<div style="margin:0 0 12px"><h5 class="mb-0 cstlfs" style="font-size:20px !important">Bank Book Report</h5></div>

<div class="filterbar rp-filter">
    <div class="rp-grid">
        <div class="fld" id="divCompany">
            <label for="ddlCompany">Company <span class="required">*</span></label>
            <select class="form-select form-select-sm select2" style="width: 100%;" id="ddlCompany" onchange="LoadDDlbyCom()"></select>
        </div>
        <div class="fld" id="divBankName">
            <label for="ddlBankName">Bank Name <span class="required">*</span></label>
            <select class="form-select form-select-sm select2" style="width: 100%;" id="ddlBankName" onchange="LoadAccountNObyBankCom()"></select>
        </div>
        <div class="fld" id="divBankNameAccountNO">
            <label for="ddlBankNameAccountNO">Bank Account No. <span class="required">*</span></label>
            <select class="form-select form-select-sm select2" style="width: 100%;" id="ddlBankNameAccountNO"></select>
        </div>
        <div class="fld" id="divFinansialYear">
            <label for="ddlFinansialYear">Financial Year</label>
            <select class="form-select form-select-sm select2" style="width: 100%;" id="ddlFinansialYear" onchange="LoadDaterangebyFiscal()"></select>
        </div>
        <div class="fld">
            <label for="txtfrmDate">From Date <span class="required">*</span></label>
            <input type="text" id="txtfrmDate" class="form-control form-control-sm datepicker" value="@DateTime.Now.ToString("dd MMMM, yyyy")" />
        </div>
        <div class="fld">
            <label for="txtToDate">To Date <span class="required">*</span></label>
            <input type="text" id="txtToDate" class="form-control form-control-sm datepicker" value="@DateTime.Now.ToString("dd MMMM, yyyy")" />
        </div>
    </div>

    <div style="display:none" id="divTransactionType">
        <input type="radio" checked name="rbTransactionType" value="Monthly" id="MonthlyRadio" />
        <label for="MonthlyRadio">Monthly</label>
        <input type="radio" id="NarrationRadio" name="rbTransactionType" value="Narration">
        <label for="NarrationRadio">Narration</label>
    </div>

    <div class="rp-acts">
        <button id="exportButton" class="btn sm" type="button"><svg width="13" height="13"><use href="#s-dl"/></svg> Export to Excel</button>
        <button id="printButton" class="btn sm" type="button"><svg width="13" height="13"><use href="#s-doc"/></svg> Print</button>
        <button class="btn emph" id="Reject" type="button" onclick="PrintReport()"><svg width="13" height="13"><use href="#s-search"/></svg> Go</button>
    </div>
</div>

<div class="rp-card">
    <div class="rp-hd"><b>Bank book</b></div>
    <div class="rp-scroll">
        <table id="dtTb">
            <thead class="rp-meta">
                <tr><th colspan="12" class="rp-title"><label id="lblheading">Bank Book Report</label></th></tr>
                <tr>
                    <td colspan="2" class="k">Business Unit</td>
                    <td colspan="4"><label id="lblBusinessUnit"></label></td>
                    <td colspan="2" class="k">From Date</td>
                    <td colspan="4"><label id="lblFromDate"></label></td>
                </tr>
                <tr>
                    <td colspan="2" class="k">Financial Year</td>
                    <td colspan="4"><label id="lblFinancialYear"></label></td>
                    <td colspan="2" class="k">To Date</td>
                    <td colspan="4"><label id="lblToDate"></label></td>
                </tr>
                <tr>
                    <td colspan="2" class="k">GL</td>
                    <td colspan="4"><label id="lblAccount"></label></td>
                    <td colspan="2" class="k">Opening Balance</td>
                    <td colspan="4"><label id="lblOpeningBalance"></label></td>
                </tr>
                <tr>
                    <td colspan="2" class="k">Currency</td>
                    <td colspan="10"><label id="lblCurrency"></label></td>
                </tr>
            </thead>
            <thead class="rp-cols">
                <tr>
                    <th style="width: 40px">#</th>
                    <th>Date</th>
                    <th>Voucher No</th>
                    <th>GL</th>
                    <th>Narration</th>
                    <th>Subsidiary Type</th>
                    <th>Subsidiary Ledger</th>
                    <th>Cost Center</th>
                    <th>Referrence</th>
                    <th>Debit</th>
                    <th>Credit</th>
                    <th>Balance</th>
                </tr>
            </thead>
            <tbody id="ledgerlist">
            </tbody>
        </table>
    </div>
</div>

@section Scripts
{

    <script type="text/javascript">

        $(document).ready(function () {
            LoadCompany('ddlCompany');
            LoadBankName('ddlBankName');
        });

        function LoadDDlbyCom() {
            LoadFinansialYear();
            _loadAccountNObyBankCom();
        }



        function LoadAccountNObyBankCom() {
            _loadAccountNObyBankCom();
        }

        function LoadDaterangebyFiscal() {
            var companyId = $("#ddlCompany").val();
            var FinancialYearId = $("#ddlFinansialYear").val();
            $.ajax({
                url: "/Utility/GetDaterangebyFiscal",
                contentType: "application/json; charset=utf-8",
                dataType: 'json',
                type: "Get",
                data: { companyId: companyId, FinancialYearId: FinancialYearId },
                async: false,
                success: function (data) {

                    $('#txtfrmDate').val((data.StartDate));
                    $('#txtToDate').val((data.EndDate));
                }
            });
        }
        function LoadFinansialYear() {
            var companyId = $("#ddlCompany").val();
            $.ajax({
                url: "/Utility/GetFinansialYearComId",
                contentType: "application/json; charset=utf-8",
                dataType: 'json',
                type: "Get",
                data: { companyId: companyId },
                async: false,
                success: function (data) {

                    $('#ddlFinansialYear').empty();
                    $('#ddlFinansialYear').append("<option value='0'>--Select Financial Year--</option>");

                    for (var i = 0; i < data.length; i++) {

                        $('#ddlFinansialYear').append($("<option></option>").val(data[i].FinancialYearId).html(data[i].FinancialYearDesc));
                    }
                    if (data.length > 0) {
                        // Select the first real financial year (index 1)
                        $('#ddlFinansialYear').val(data[0].FinancialYearId).trigger('change');
                    }
                }
            });
        }

        function _loadAccountNObyBankCom() {
            var companyId = $("#ddlCompany").val();
            var BankNameId = $("#ddlBankName").val();
            $.ajax({
                url: "/Utility/GetAccountNObyBankCom",
                contentType: "application/json; charset=utf-8",
                dataType: 'json',
                type: "Get",
                data: { companyId: companyId, BankNameId: BankNameId },
                async: false,
                success: function (data) {

                    $('#ddlBankNameAccountNO').empty();
                    $('#ddlBankNameAccountNO').append("<option value='0'>--Select Account NO --</option>");

                    for (var i = 0; i < data.length; i++) {

                        $('#ddlBankNameAccountNO').append($("<option></option>").val(data[i].AccountId).html(data[i].AccountNo));
                    }
                }
            });
        }


        function formatDateToDDMMMYYYY(dateString) {
            if (!dateString) return "";

            var date = new Date(dateString);
            if (isNaN(date)) return ""; // invalid date check

            var day = ("0" + date.getDate()).slice(-2);
            var monthNames = ["Jan", "Feb", "Mar", "Apr", "May", "Jun",
                "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"];
            var month = monthNames[date.getMonth()];
            var year = date.getFullYear();

            return day + "-" + month + "-" + year;
        }


        function PrintReport() {

            var CompanyID = $('#ddlCompany').val();
            var BankAccountID = $('#ddlBankNameAccountNO').val();
            var FinancialYearID = $('#ddlFinansialYear').val() || null;
            var FromDate = $('#txtfrmDate').val();
            var ToDate = $('#txtToDate').val();
            var BankBookBankNAme = $("#ddlBankNameAccountNO option:selected").text();

            if (!CompanyID) {
                toastr.warning("Please select a Company.");
                $('#ddlCompany').focus();
                return false;
            }

            if (!BankAccountID) {
                toastr.warning("Please select a Bank Account.");
                $('#ddlBankNameAccountNO').focus();
                return false;
            }

            //if (!FinancialYearID) {
            //    toastr.warning("Please select a Financial Year.");
            //    $('#ddlFinansialYear').focus();
            //    return false;
            //}

            if (!FromDate) {
                toastr.warning("Please enter From Date.");
                $('#txtfrmDate').focus();
                return false;
            }

            if (!ToDate) {
                toastr.warning("Please enter To Date.");
                $('#txtToDate').focus();
                return false;
            }

            var Monthly = "";
            var Narration = "";
            if ($('#MonthlyRadio').is(':checked')) {
                Monthly = "True";
            }
            if ($('#NarrationRadio').is(':checked')) {
                Narration = "True";
            }


            var prm = "CompanyID=" + CompanyID + "&BankAccountID=" + BankAccountID + "&FinancialYearID=" + FinancialYearID + "&FromDate=" + FromDate + "&ToDate=" + ToDate + "&BankBookBankNAme=" + BankBookBankNAme + "&Monthly=" + Monthly + "&Narration=" + Narration;


            $.ajax({
                url: '/BankBook/GetBankBook_Report',
                data: { CompanyID: CompanyID, BankAccountID: BankAccountID, FinancialYearID: FinancialYearID, FromDate: FromDate, ToDate: ToDate, BankNAme: BankBookBankNAme, Monthly: Monthly, Narration: Narration },
                dataType: 'json',
                type: "Get",
                beforeSend: function () {
                    // Show the full-screen loading spinner
                    $("#loadingSpinner").show();
                },
                success: function (data) {
                    console.log("Full response:", data);

                    var bankBookDataTable = data.BankBookDataTable || [];
                    var table = data.Table || [];
                    if (bankBookDataTable.length === 0) {
                        // Show toastr warning
                        toastr.warning("No data found.");


                    }
                    // Clear old rows
                    $('#ledgerlist').empty();

                    var finalClosingBalance = 0;
                    var grandTotalDebitBDT = 0;
                    var grandTotalCreditBDT = 0;

                    // Calculate totals once across the dataset
                    for (var i = 0; i < bankBookDataTable.length; i++) {
                        grandTotalDebitBDT += bankBookDataTable[i].DebitAmountBDT || 0;
                        grandTotalCreditBDT += bankBookDataTable[i].CreditAmountBDT || 0;
                    }
                    var openingBalanceMain = 0;
                    // Calculate closing balance
                    for (var cb = 0; cb < table.length; cb++) {
                        var glName = table[cb].GLName;
                        var openingBalance = table[cb].OpeningBalance || 0;
                        openingBalanceMain = openingBalance;
                        var closingBalance = 0;
                        if (glName === "Assets" || glName === "Expenses") {
                            closingBalance = (openingBalance + grandTotalDebitBDT) - grandTotalCreditBDT;
                        } else if (glName === "Revenue/Income" || glName === "Liability") {
                            closingBalance = (openingBalance + grandTotalCreditBDT) - grandTotalDebitBDT;
                        }
                        finalClosingBalance = closingBalance;
                    }

                    // Render table rows
                    let runningBlnc = openingBalanceMain;

                    for (var i = 0; i < bankBookDataTable.length; i++) {
                        var row = bankBookDataTable[i];

                        // Update running balance
                        runningBlnc = runningBlnc + ((row.DebitAmountBDT || 0) - (row.CreditAmountBDT || 0));

                        var html = `<tr>
        <td style="width: 40px !important; text-align: center;">${i + 1}</td>
        <td style="text-align: center;">${formatDateToDDMMMYYYY(row.PostingDate) || ''}</td>
        <td style="text-align: center;">
            <a data-bs-toggle='modal' onclick='PrintVoucherReport(${row.VoucherMasterId})' style='text-decoration: underline; cursor: pointer;' class='link-primary bold popupLink'>
                ${row.VoucherNo}
            </a>
        </td>
        <td style="text-align: left; word-wrap: break-word; white-space: normal;">${row.AccountName || ''}</td>
        <td style="text-align: left; word-wrap: break-word; white-space: normal;">${row.Narration || ''}</td>
        <td style="text-align: center;">${row.SubsidiaryType || ''}</td>
        <td style="text-align: center;">${row.SubsidiaryLedger || ''}</td>
        <td style="text-align: center;">${row.CostCenter || ''}</td>
        <td style="text-align: center;">${row.Referrence || ''}</td>
        <td style="text-align: right; color: green;"><strong>${(row.DebitAmountBDT || 0).toLocaleString('en-IN', { minimumFractionDigits: 2, maximumFractionDigits: 2 })}</strong></td>
        <td style="text-align: right; color: green;"><strong>${(row.CreditAmountBDT || 0).toLocaleString('en-IN', { minimumFractionDigits: 2, maximumFractionDigits: 2 })}</strong></td>
        <td style="text-align: right; color: green;"><strong>${runningBlnc.toLocaleString('en-IN', { minimumFractionDigits: 2, maximumFractionDigits: 2 })}</strong></td>
    </tr>`;

                        $('#ledgerlist').append(html);
                    }


                    //Append Total Value

                    var TotalRow = `
<tr style="font-weight: bold; background-color: #f0f0f0;">
    <td colspan="9" style="text-align: right;">Total Balance</td>
    <td colspan="1" style="text-align: right; color: green;">
        ${(grandTotalDebitBDT || 0).toLocaleString('en-IN', { minimumFractionDigits: 2, maximumFractionDigits: 2 })}
    </td>
    <td colspan="1" style="text-align: right; color: green;">
    ${(grandTotalCreditBDT || 0).toLocaleString('en-IN', { minimumFractionDigits: 2, maximumFractionDigits: 2 })}
</td>
        <td colspan="1" style="text-align: right; color: green;">
    
</td>
</tr>`;
                    $('#ledgerlist').append(TotalRow);

                    // Append final total row only once
                    var finalTotalRow = `
<tr style="font-weight: bold; background-color: #f0f0f0;">
    <td style="width: 40px !important; text-align: center;"></td>
    <td colspan="8" style="text-align: right;">Closing Balance</td>
    <td colspan="3" style="text-align: right; color: green;">
        ${(finalClosingBalance || 0).toLocaleString('en-IN', { minimumFractionDigits: 2, maximumFractionDigits: 2 })}
    </td>
</tr>`;
                    $('#ledgerlist').append(finalTotalRow);

                    // Set header labels once
                    const firstRow = bankBookDataTable[0] || {};
                    $('#lblAccount').text(firstRow.ChartofAccountName || '');
                    $('#lblFromDate').text(formatDateToDDMMMYYYY(firstRow.FromDate) || '');
                    $('#lblToDate').text(formatDateToDDMMMYYYY(firstRow.ToDate) || '');
                    $('#lblBusinessUnit').text(firstRow.CompanyName || '');
                    $('#lblFinancialYear').text(firstRow.FinancialYearDesc || '');
                    $('#lblOpeningBalance').text((table[0]?.OpeningBalance || 0).toFixed(2));
                    $('#lblCurrency').text(firstRow.CurrencyName || '');
                },
                complete: function () {
                    setTimeout(function () {
                        $("#loadingSpinner").hide();
                    }, 5000);
                }
            });
        }

        document.getElementById("printButton").addEventListener("click", function () {
            var printContents = document.getElementById("dtTb").outerHTML;
            var originalContents = document.body.innerHTML;

            document.body.innerHTML = `
        <html>
            <head>
                <title>Print Table</title>
                <link rel="stylesheet" href="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/css/bootstrap.min.css">
            </head>
            <body>
                <div class="">
                    ${printContents}
                </div>
            </body>
        </html>
    `;

            window.print();
            document.body.innerHTML = originalContents;
            location.reload(); // Refresh to restore any lost scripts/styles
        });

