@section Scripts
{

    <script type="text/javascript">

        document.getElementById("printButton").addEventListener("click", function () {
            var printContents = document.getElementById("dtTb").outerHTML;
            var originalContents = document.body.innerHTML;

            document.body.innerHTML = `
            <html>
                <head>
                    <title>Print Table</title>
                    <link rel="stylesheet" href="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/css/bootstrap.min.css">
                </head>
                <body>
                    <div class="">
                        ${printContents}
                    </div>
                </body>
            </html>
        `;

            window.print();
            document.body.innerHTML = originalContents;
            location.reload(); // Refresh to restore any lost scripts/styles
        });
		$(document).ready(function () {
			LoadCompany('ddlCompany');

		});

		function LoadDDlbyCom() {
			LoadFinansialYear();
			_loadCashAccountbyCom();
		}





		function LoadDaterangebyFiscal() {
			var companyId = $("#ddlCompany").val();
			var FinancialYearId = $("#ddlFinansialYear").val();
			$.ajax({
				url: "/Utility/GetDaterangebyFiscal",
				contentType: "application/json; charset=utf-8",
				dataType: 'json',
				type: "Get",
				data: { companyId: companyId, FinancialYearId: FinancialYearId },
				async: false,
				success: function (data) {

					$('#txtfrmDate').val((data.StartDate));
					$('#txtToDate').val((data.EndDate));
				}
			});
		}
		function LoadFinansialYear() {
			var companyId = $("#ddlCompany").val();
			$.ajax({
				url: "/Utility/GetFinansialYearComId",
				contentType: "application/json; charset=utf-8",
				dataType: 'json',
				type: "Get",
				data: { companyId: companyId },
				async: false,
				success: function (data) {

					$('#ddlFinansialYear').empty();
					$('#ddlFinansialYear').append("<option value='0'>--Select Financial Year--</option>");

					for (var i = 0; i < data.length; i++) {

						$('#ddlFinansialYear').append($("<option></option>").val(data[i].FinancialYearId).html(data[i].FinancialYearDesc));
                    }
                    if (data.length > 0) {
                        // Select the first real financial year (index 1)
                        $('#ddlFinansialYear').val(data[0].FinancialYearId).trigger('change');
                    }
				}
			});
		}

		function _loadCashAccountbyCom() {
			var companyId = $("#ddlCompany").val();

			$.ajax({
				url: "/Utility/GetCashAccountbyCom",
				contentType: "application/json; charset=utf-8",
				dataType: 'json',
				type: "Get",
				data: { companyId: companyId },
				async: false,
				success: function (data) {

					$('#ddlcashAccount').empty();
					$('#ddlcashAccount').append("<option value='0'>--Select Cash Account --</option>");

					for (var i = 0; i < data.length; i++) {

						$('#ddlcashAccount').append($("<option></option>").val(data[i].AccountId).html(data[i].AccountName));
					}
				}
			});
		}


        function formatDateToDDMMMYYYY(dateString) {
            if (!dateString) return "";

            var date = new Date(dateString);
            if (isNaN(date)) return ""; // invalid date check

            var day = ("0" + date.getDate()).slice(-2);
            var monthNames = ["Jan", "Feb", "Mar", "Apr", "May", "Jun",
                "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"];
            var month = monthNames[date.getMonth()];
            var year = date.getFullYear();

            return day + "-" + month + "-" + year;
        }

	function PrintReport()
	{
        var urlpath = '';

        var CompanyID = $('#ddlCompany').val();
        var CashAccountID = $('#ddlcashAccount').val();
        var FinancialYearID = $('#ddlFinansialYear').val() || null;
        var FromDate = $('#txtfrmDate').val();
        var ToDate = $('#txtToDate').val();
        if (CompanyID === "0" || CompanyID === "") {
            toastr.warning("Please select a Company.");
            $('#ddlCompany').focus();
            return;
        }

        if (CashAccountID === "0" || CashAccountID === "") {
            toastr.warning("Please select a Cash Account.");
            $('#ddlcashAccount').focus();
            return;
        }

        //if (FinancialYearID === "0" || FinancialYearID === "") {
        //    toastr.warning("Please select a Financial Year.");
        //    $('#ddlFinansialYear').focus();
        //    return;
        //}

        if (FromDate === "") {
            toastr.warning("Please enter From Date.");
            $('#txtfrmDate').focus();
            return;
        }

        if (ToDate === "") {
            toastr.warning("Please enter To Date.");
            $('#txtToDate').focus();
            return;
        }

		if ($('#customSwitch1').is(':checked')) {
		urlpath = '@Url.Action("GetCashBook_ReportOther", "CashBook")';

		} else {

		urlpath = '@Url.Action("GetCashBook_Report", "CashBook")';

		}

		
		var BankBookBankNAme = $("#ddlcashAccount option:selected").text();
		var Monthly = "";
		var Narration = "";
		if ($('#MonthlyRadio').is(':checked')) {
			Monthly = "True";
		}
		if ($('#NarrationRadio').is(':checked')) {
			Narration = "True";
		}

		var prm = "CompanyID=" + CompanyID + "&CashAccountID=" + CashAccountID + "&FinancialYearID=" + FinancialYearID + "&FromDate=" + FromDate + "&ToDate=" + ToDate + "&BankBookBankNAme=" + BankBookBankNAme + "&Monthly=" + Monthly + "&Narration=" + Narration;


		$.ajax({
			url: urlpath,
			data: { CompanyID: CompanyID, CashAccountID: CashAccountID, FinancialYearID: FinancialYearID, FromDate: FromDate, ToDate: ToDate, CashbookNAme: BankBookBankNAme, Monthly: Monthly, Narration: Narration },
			dataType: 'json',
            type: "Get",
            beforeSend: function () {
                // Show the full-screen loading spinner
                $("#loadingSpinner").show();
            },
            success: function (data) {
                console.log("Full response:", data);

                var bankBookDataTable = data.BankBookDataTable || [];
                var table = data.Table || [];
                if (bankBookDataTable.length === 0 ) {
                    // Show toastr warning
                    toastr.warning("No data found.");

                    
                }
                // Clear old rows
                $('#ledgerlist').empty();

                var finalClosingBalance = 0;
                var grandTotalDebitBDT = 0;
                var grandTotalCreditBDT = 0;

                // Calculate totals once across the dataset
                for (var i = 0; i < bankBookDataTable.length; i++) {
                    grandTotalDebitBDT += bankBookDataTable[i].DebitAmountBDT || 0;
                    grandTotalCreditBDT += bankBookDataTable[i].CreditAmountBDT || 0;
                }
                var openingBalanceMain = 0; 
                // Calculate closing balance
                for (var cb = 0; cb < table.length; cb++) {
                    var glName = table[cb].GLName;
                    var openingBalance = table[cb].OpeningBalance || 0;
                    openingBalanceMain = openingBalance;
                    var closingBalance = 0;
                    if (glName === "Assets" || glName === "Expenses") {
                        closingBalance = (openingBalance + grandTotalDebitBDT) - grandTotalCreditBDT;
                    } else if (glName === "Revenue/Income" || glName === "Liability") {
                        closingBalance = (openingBalance + grandTotalCreditBDT) - grandTotalDebitBDT;
                    }
                    finalClosingBalance = closingBalance;
                }

                // Render table rows
                let runningBlnc = openingBalanceMain;

                for (var i = 0; i < bankBookDataTable.length; i++) {
                    var row = bankBookDataTable[i];

                    // Update running balance
                    runningBlnc = runningBlnc + ((row.DebitAmountBDT || 0) - (row.CreditAmountBDT || 0));

                    var html = `<tr>
        <td style="width: 40px !important; text-align: center;">${i + 1}</td>
        <td style="text-align: center;">${formatDateToDDMMMYYYY(row.PostingDate) || ''}</td>
        <td style="text-align: center;">
            <a data-bs-toggle='modal' onclick='PrintVoucherReport(${row.VoucherMasterId})' style='text-decoration: underline; cursor: pointer;' class='link-primary bold popupLink'>
                ${row.VoucherNo}
            </a>
        </td>
        <td style="text-align: left; word-wrap: break-word; white-space: normal;">${row.AccountName || ''}</td>
        <td style="text-align: left; word-wrap: break-word; white-space: normal;">${row.Narration || ''}</td>
        <td style="text-align: center;">${row.SubsidiaryType || ''}</td>
        <td style="text-align: center;">${row.SubsidiaryLedger || ''}</td>
        <td style="text-align: center;">${row.CostCenter || ''}</td>
        <td style="text-align: center;">${row.Referrence || ''}</td>
        <td style="text-align: right; color: green;"><strong>${(row.DebitAmountBDT || 0).toLocaleString('en-IN', { minimumFractionDigits: 2, maximumFractionDigits: 2 })}</strong></td>
        <td style="text-align: right; color: green;"><strong>${(row.CreditAmountBDT || 0).toLocaleString('en-IN', { minimumFractionDigits: 2, maximumFractionDigits: 2 })}</strong></td>
        <td style="text-align: right; color: green;"><strong>${runningBlnc.toLocaleString('en-IN', { minimumFractionDigits: 2, maximumFractionDigits: 2 })}</strong></td>
    </tr>`;

                    $('#ledgerlist').append(html);
                }


                //Append Total Value

                var TotalRow = `
<tr style="font-weight: bold; background-color: #f0f0f0;">
    <td colspan="9" style="text-align: right;">Total Balance</td>
    <td colspan="1" style="text-align: right; color: green;">
        ${(grandTotalDebitBDT || 0).toLocaleString('en-IN', { minimumFractionDigits: 2, maximumFractionDigits: 2 })}
    </td>
    <td colspan="1" style="text-align: right; color: green;">
    ${(grandTotalCreditBDT || 0).toLocaleString('en-IN', { minimumFractionDigits: 2, maximumFractionDigits: 2 })}
</td>
        <td colspan="1" style="text-align: right; color: green;">
    ${(grandTotalCreditBDT || 0).toLocaleString('en-IN', { minimumFractionDigits: 2, maximumFractionDigits: 2 })}
</td>
</tr>`;
                $('#ledgerlist').append(TotalRow);

                // Append final total row only once
                var finalTotalRow = `
<tr style="font-weight: bold; background-color: #f0f0f0;">
    <td style="width: 40px !important; text-align: center;"></td>
    <td colspan="8" style="text-align: right;">Closing Balance</td>
    <td colspan="3" style="text-align: right; color: green;">
        ${(finalClosingBalance || 0).toLocaleString('en-IN', { minimumFractionDigits: 2, maximumFractionDigits: 2 })}
    </td>
</tr>`;
                $('#ledgerlist').append(finalTotalRow);

                // Set header labels once
                const firstRow = bankBookDataTable[0] || {};
                $('#lblAccount').text(firstRow.ChartofAccountName || '');
                $('#lblFromDate').text(formatDateToDDMMMYYYY(firstRow.FromDate) || '');
                $('#lblToDate').text(formatDateToDDMMMYYYY(firstRow.ToDate) || '');
                $('#lblBusinessUnit').text(firstRow.CompanyName || '');
                $('#lblFinancialYear').text(firstRow.FinancialYearDesc || '');
                $('#lblOpeningBalance').text((table[0]?.OpeningBalance || 0).toFixed(2));
                $('#lblCurrency').text(firstRow.CurrencyName || '');
            }
,
            complete: function () {
                setTimeout(function () {
                    if ($('#ledgerlist tr').length === 0) {
                        $('#ledgerlist').html('<tr><td colspan="100%" class="text-center text-danger fw-bold">No Data Found</td></tr>');
                    }

                    $("#loadingSpinner").hide();
                }, 3000);

            }
        });
        }


            function PrintVoucherReport(MasterId)
    {
        var urlpath = '@Url.Action("rptDebitVoucher", "AccountingTaskReport")';
        var reportValue = "AllVoucherReport";

    $.ajax({
        url: urlpath,
        data: { MasterId: MasterId, reportValue: reportValue},
            dataType: 'json',
            type: "Get",
            success: function (data) {
                if (data.isSuccess) {
                    //OpenPopUp('BasicReportViewer.aspx');
                    window.open("/CrystalViewer/CrystalViewer.aspx", "_blank", "WIDTH=1024,HEIGHT=768,scrollbars=no, menubar=no,resizable=yes,directories=no,location=no");
                }
            }
        });
    }

        $('#exportButton').click(function () {
            // Show the loading spinner
            $("#loadingSpinner").show();
            setTimeout(function () {
                var table = document.getElementById("dtTb");
                var workbook = XLSX.utils.table_to_book(table, { sheet: "Sheet1" });

                var now = new Date();
                var day = ("0" + now.getDate()).slice(-2);
                var monthNames = ["Jan", "Feb", "Mar", "Apr", "May", "Jun",
                    "Jul", "Aug", "Sep", "Oct", "Nov", "Dec"];
                var month = monthNames[now.getMonth()];
                var year = now.getFullYear();

                var hour = ("0" + now.getHours()).slice(-2);
                var minute = ("0" + now.getMinutes()).slice(-2);
                var second = ("0" + now.getSeconds()).slice(-2);

                var dateTime = day + "-" + month + "-" + year + " " + hour + "-" + minute + "-" + second;
                var fileName = 'Cash Book Report ' + dateTime + '.xlsx';

                XLSX.writeFile(workbook, fileName);

                $("#loadingSpinner").hide(); // Hide spinner
            }, 3000); // Delay for smoother UX
            // Use a small timeout to allow spinner to render before blocking operation
            //setTimeout(function () {

            //    //With Design
            //    //var table = document.getElementById('dtTb');
