@{
    ViewBag.Title = "Add Voucher";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<style>
   
</style>

<div class="page-wrapper">
    <div class="page-content">
        <div class="row">
            <div class="col">
                <div class="card border-top border-0 border-4 border-dark mt-3" style="margin-top: 3px !important">
                    <div class="card-body" style="border-style: none !important;">
                        <div class="border p-2 rounded">

                            <div class="page-breadcrumb d-none d-sm-flex align-items-center  headerBorderBottom"  >
                                <div class="breadcrumb-title pe-3">
                                    <div class="card-title d-flex align-items-center">
                                        <div>
                                            <i class="bx bxs-right-arrow-square me-1 font-22 text-inverse"></i>
                                        </div>
                                        <h5 class="mb-0 text-dark cstlfs">
                                            Voucher Info
                                        </h5>
                                    </div>
                                </div>

                                <div class="ms-auto">
                                    <div class="btn-group">


                                        <a class="small blue button" href="@Url.Action("Index", "Test")">
                                            <span class="fa fa-share"></span> Back to List

                                        </a>

                                    </div>
                                </div>
                            </div>
                          

                            <!-- /.card-header -->
                            <!-- form start -->
                            <div class="col-md-12" style="margin-top:5px;">

                                <div class="row">
                                    <div class="col-md-2">
                                        <div class="form-group" id="divCompany">
                                            <label for="ddlCompany" class="bold col-form-label">Company</label>
                                            <select class="form-select form-select-sm mb-3 select2" style="width: 100%;" id="ddlCompany" onchange="LoadBusinessUnit()"></select>
                                        </div>
                                    </div>
                                    <div class="col-md-2">
                                        <div class="form-group" id="divBusinessUnit">
                                            <label class="bold col-form-label" for="ddlBusinessUnit">Business Unit</label>
                                            <select class="form-select form-select-sm mb-3 select2" style="width: 100%;" id="ddlBusinessUnit"></select>
                                        </div>
                                    </div>

                                    <div class="col-md-2">
                                        <div class="form-group" id="divVoucherDate">
                                            <label class="bold col-form-label" for="txtVoucherDate">Voucher Date</label>
                                            <input type="text" id="txtVoucherDate" class="form-control form-control-sm mb-3 datepicker" value="@DateTime.Now.ToString("dd MMMM, yyyy")" />
                                        </div>
                                    </div>



                                    <div class="col-md-2">
                                        <div class="form-group" id="divCurrencyRate">
                                            <label class="bold col-form-label" for="txtCurrencyRate">Currency Rate</label>
                                            <input type="text" id="txtCurrencyRate" class="form-control form-control-sm mb-3" value="1" />
                                        </div>
                                    </div>
                                    <div class="col-md-2">
                                        <label class="bold col-form-label" for="cashRadio">Payment Type</label>
                                        <div class="form-group clearfix">
                                            <div class="icheck-success d-inline col-md-6">
                                                <input type="radio" id="bankRadio" name="paymentType" value="1" checked="">
                                                <label for="bankRadio">Bank</label>
                                            </div>
                                            <div class="icheck-success d-inline col-md-6">
                                                <input type="radio" id="cashRadio" name="paymentType" value="2">
                                                <label for="cashRadio">Cash</label>
                                            </div>
                                        </div>
                                    </div>

                                </div>

                                <div class="row table-responsive" style="padding-top:10px">
                                    <div class="col-md-12">
                                        <div class="card-body">
                                            <table class="table table-bordered table-striped table-hover" id="debitVoucher">
                                                <thead>
                                                    <tr>

                                                        <th style="width: 320px">Country</th>

                                                        <th style="width: 180px">City</th>


                                                        <th style="width: 100px">Amount</th>
                                                        <th>Remarks</th>
                                                        <th class="action">Action</th>
                                                    </tr>
                                                </thead>
                                                <tbody></tbody>
                                            </table>
                                        </div>
                                    </div>
                                </div>
                                <div class="row" style="padding-top:10px">
                                    <div class="col-md-2">
                                    </div>
                                    <div class="col-md-6">

                                        <div class="form-group row">
                                            <div class="col-sm-2">
                                            </div>
                                            <label for="lblRestAmount" class="col-sm-2 bold col-form-label">Total Amount :</label>
                                            <div class="col-sm-3">
                                                <label class="bold col-form-label" id="lblTotalAmountAmount">0</label>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                <div class="row" style="padding-top:10px">
                                    <div class="col-md-3">
                                    </div>
                                    <div class="col-md-6">
                                        <div class="form-group row">
                                            <label for="lblNarration" class="col-sm-2 bold col-form-label">Narration :</label>
                                            <div class="col-sm-3" id="divNarration">
                                                <textarea id="txtaNarration" rows="4" cols="50" style="text-align:left"></textarea>
                                            </div>
                                        </div>
                                    </div>
                                </div>


                                <br />
                                <div class="wrapper">
                                    <div class="row">
                                        <div class="col-md-5" style="margin: 0 44.5% !important;">
                                            <div class="form-group">

                                                <button class="small blue button" onclick="SaveDebitVoucher()">Submit</button>



                                            </div>
                                        </div>
                                    </div>
                                </div>

                            </div>
                        </div>
                        
                    </div>
                </div>
                <!-- /.row -->
            </div><!-- /.container-fluid -->
            <input id="TestMasterId" type="number" style="display: none;" value="@ViewBag.VoucherId">
            <input id="eflag" type="text" style="display: none;" value="@ViewBag.eflag">
            <input type="hidden" id="FromAccClosingBalance" />
        </div>
    </div>
</div>
@section Scripts
{

    <script>
         
