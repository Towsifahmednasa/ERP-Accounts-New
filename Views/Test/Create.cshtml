        function RemoveRow(id) {
           

            var trLength = $('#debitVoucher tbody tr:visible').length;
         
            if (trLength == 1) {
                $('#ConId_' + id).val(0).trigger('change');
                $('#city_' + id).val(0).trigger('change');
               
                $('#amount_' + id).val(0);
                $('#remarks_' + id).val('');
               
                CalculateAll();
                 
            }

            if (trLength > 1) {

                var detailsId = $('#details_' + id).val();
                if (detailsId > 0) {
                    var glId = isNaN(parseFloat($('#ConId_' + id).val())) ? 0 : parseFloat($('#ConId_' + id).val());
 

                }
                $('#tr_' + id).remove();
                SerialTable();
                CalculateAll();
                
            } else {
                return;
            }

        }

        function AddRow() {
             
            var tr = $('#debitVoucher tbody tr').length + 1;
            var values = $("#debitVoucher tbody tr")
                .map(function () { return parseInt($(this).attr('id').substring(3)); }).get();
            var index = values.indexOf(tr);
            if (index >= 0) {
                tr = Math.max.apply(Math, values) + 1;
            }
            var urlpath = '@Url.Action("AddRowForCountry", "Test")';
            $.ajax({
                url: urlpath,
                type: "Get",
                dataType: 'html',
                data: { tr: tr },
                async: false,
                success: function (data) {

                    $('#debitVoucher tbody').append(data);
                    LoadCountryRow("ConId_" + tr);


                }
            });
            $('#ConId_' + tr).select2();
            $('#city_' + tr).select2();
          
            SerialTable();
           
            
        }

        function SerialTable() {
            $('#debitVoucher tbody tr').each(function (index, element) {

                var idr = $(this).attr('id');
                var id = idr.substring(3);
                $('#ts_' + id).html(index + 1);


            });
        }

        function LoadCountryRow(elementId) {

            $('#' + elementId + '').append("<option value='0'>--Select Country--</option>");
            for (var i = 0; i < CountryList.length; i++) {

                $('#' + elementId + '').append($("<option></option>").val(CountryList[i].CountryId).html(CountryList[i].CountryName));
            }


        }




        function GetCountry() {


            var urlpath = '@Url.Action("LoadCountry", "Utility")';
            $.ajax({
                url: urlpath,
                type: "Get",
                data: {},
                async: false,
                success: function (data) {

                    CountryList = data;

                }
            });
        }


