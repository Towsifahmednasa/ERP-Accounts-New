        }


        function BankWishEffect() {
             
            if ($('#bankRadio').is(':checked')) {
                $("#ddlBank").prop("disabled", true);
                $("#ddlBranch").prop("disabled", true);
                $("#txtChequeNo").prop("disabled", false);
                $("#txtChequeDate").prop("disabled", false);
                $("#txtRefNo").prop("disabled", true);
                $("#txtRefDate").prop("disabled", true);

                $("#txtRefNo").val('');
                $("#txtRefDate").val('');


                $.ajax({
                    url: "/Utility/GetGLBankAccounts",
                    contentType: "application/json; charset=utf-8",
                    dataType: 'json',
                    type: "Get",
                    data: {},
                    async: false,
                    success: function (data) {

                        $('#ddlFromAccount').empty();
                        $('#ddlFromAccount').append("<option value='0'>--Select From Account--</option>");

                        for (var i = 0; i < data.length; i++) {

                            $('#ddlFromAccount').append($("<option></option>").val(data[i].CALayerSevenId).html(data[i].AccountNo));
                        }
                    }
                });
            }
        }
        $("#ddlFromAccount").change(function () {

            var glId = $("#ddlFromAccount").val();
            var urlpath1 = '@Url.Action("GetClosingBalanceOfGL", "JournalVoucher")';
            $.ajax({
                url: urlpath1,
                type: "Get",
                dataType: 'json',
                data: { glId: glId, refdetailid: null },
                async: false,
                success: function (data) {
                     

                    $('#FromAccClosingBalance').val(data.Balance.toFixed(2));
                    $('#ClosingBalance').html("(Closing Balance:" + data.Balance.toFixed(2) + ")");


                }
            });
        });
        function CashWishEffect() {
             
            if ($('#cashRadio').is(':checked')) {
                $("#ddlBank").prop("disabled", true);
                $("#ddlBranch").prop("disabled", true);
                $("#txtChequeNo").prop("disabled", true);
                $("#txtChequeDate").prop("disabled", true);
                $("#txtRefNo").prop("disabled", false);
                $("#txtRefDate").prop("disabled", false);

                $("#ddlBank").val(0);
                $("#ddlBranch").val(0);
                $("#txtChequeNo").val('');
                $("#txtChequeDate").val('');


                $.ajax({
                    url: "/Utility/GetGLCashAccounts",
                    contentType: "application/json; charset=utf-8",
                    dataType: 'json',
                    type: "Get",
                    data: {},
                    async: false,
                    success: function (data) {
                        $('#ddlFromAccount').empty();
                        $('#ddlFromAccount').append("<option value='0'>--Select From Account--</option>");
                        for (var i = 0; i < data.length; i++) {
                            $('#ddlFromAccount').append($("<option></option>").val(data[i].CALayerSevenId).html(data[i].AccountName));
                        }
                    }
                });
            }
        }

        function LoadBankBranchInfo() {
            var CALayerSevenId = $("#ddlFromAccount").val();
            var urlpath = '@Url.Action("GetBankBranch", "DebitVoucher")';
            $.ajax({
                url: urlpath,
                type: "Get",
                dataType: 'json',
                data: { CALayerSevenId: CALayerSevenId },
                async: false,
                success: function (data) {
                     
                    if ($('#bankRadio').is(':checked')) {
                        $('#ddlBank').val(data.BankId);
                        LoadBankBranch('ddlBranch', data.BankId);
                        $('#ddlBranch').val(data.BranchId);
                    } else {
                        $('#ddlBank').val(0);
                        $('#ddlBranch').val(0);
                    }

                }
            });

        }


        function LoadBusinessUnit() {
            var companyId = $("#ddlCompany").val();
            $.ajax({
                url: "/Utility/LoadBusinessUnit",
                contentType: "application/json; charset=utf-8",
                dataType: 'json',
                type: "Get",
                data: { companyId: companyId },
                async: false,
                success: function (data) {

                    $('#ddlBusinessUnit').empty();
                    $('#ddlBusinessUnit').append("<option value='0'>--Select Business Unit--</option>");

                    for (var i = 0; i < data.length; i++) {

                        $('#ddlBusinessUnit').append($("<option></option>").val(data[i].BUId).html(data[i].Name));
                    }
                }
            });
        }

        function LoadCurrency() {
            $.ajax({
                url: "/Utility/GetCurrency",
                contentType: "application/json; charset=utf-8",
                dataType: 'json',
                type: "Get",
                data: {},
                async: false,
                success: function (data) {

                    $('#ddlCurrency').empty();
                    $('#ddlCurrency').append("<option value='0'>--Select Currency--</option>");

                    for (var i = 0; i < data.length; i++) {

                        $('#ddlCurrency').append($("<option></option>").val(data[i].CurrencyId).html(data[i].CurrencyCode));
                    }
                }
            });
        }

        function GetVoucherMaster(id) {

            var urlpath = '@Url.Action("GetVoucherByMasterId", "DebitVoucher")';
            $.ajax({
                url: urlpath,
                dataType: 'json',
                type: "Get",
                data: { id: id },
                async: false,
                success: function (data) {
                    $("#ddlCompany").val(data.CompanyId).trigger('change');
                    $("#ddlCompany").prop("disabled", true);
                    LoadBusinessUnit();
                    $("#ddlBusinessUnit").val(data.BUId).trigger('change');
                    $("#ddlBusinessUnit").prop("disabled", true);
                    $("#ddlFiscalYear").val(data.FinancialYearId).trigger('change');
                    $("#ddlFiscalYear").prop("disabled", true);
                    $('#txtVoucherDate').val(ToJavaScriptDate(data.VoucherDate));
                    $("#txtVoucherDate").prop("disabled", true);
                    $("#ddlCurrency").val(data.CurrencyId).trigger('change');
                    $("#ddlCurrency").prop("disabled", true);
                    $('#txtCurrencyRate').val(data.CurrencyConRate);
                    $("#txtCurrencyRate").prop("disabled", true);

                    if (data.VoucherTypeId == 3)
                    {
                        $('#bankRadio').prop('checked', true);
                    }
                    if (data.VoucherTypeId == 4) {
                        $('#cashRadio').prop('checked', true);
                    }
                    $("#bankRadio").prop("disabled", true);
                    $("#cashRadio").prop("disabled", true);
                    $("#ddlFromAccount").prop("disabled", true);

                    LoadBankName('ddlBank');
                    $('#ddlBank').val(data.BankId);
                    $("#ddlBank").prop("disabled", true);
                    LoadBankBranch('ddlBranch', data.BankId);
                    $('#ddlBranch').val(data.BranchId);
                    $("#ddlBranch").prop("disabled", true);

                    $('#txtChequeNo').val(data.ChequeNo);
                    if (data.ChequeDate != "" && data.ChequeDate != null)
                    {
                        $('#txtChequeDate').val(ToJavaScriptDate(data.ChequeDate));
                    }


                    $('#txtRefNo').val(data.RefNo);
                    if (data.RefDate != "" && data.RefDate != null)
                    {
                        $('#txtRefDate').val(ToJavaScriptDate(data.RefDate));
                    }

                    $('#lblTotalAmountAmount').html(data.TotalAmount);
                    $('#txtaNarration').val(data.Narration);


                    BankWishEffect()
                    CashWishEffect()

                    $('#txtChequeNo').val(data.ChequeNo);
                    if (data.ChequeDate != "" && data.ChequeDate != null) {
                        $('#txtChequeDate').val(ToJavaScriptDate(data.ChequeDate));
                    }


                    $('#txtRefNo').val(data.RefNo);
                    if (data.RefDate != "" && data.RefDate != null) {
                        $('#txtRefDate').val(ToJavaScriptDate(data.RefDate));
                    }
                     
                    //GetProducts();
                    //var typeid = $("#ddlCustomerType").val();

                    for (var i = 0; i < data.VoucherDetails.length; i++) {
                         
                        var tr = $('#debitVoucher tbody tr').length + 1;
                        AddRow();
                        if (data.VoucherDetails[i].DrCr == "Cr")
                        {
                            var glId = isNaN(parseFloat(data.VoucherDetails[i].CALayerSevenId)) ? 0 : parseFloat(data.VoucherDetails[i].CALayerSevenId);
                            if (glId != 1268 && glId != 1083)
                            {
                                $("#SevenLayerCr_" + tr).val(data.VoucherDetails[i].CALayerSevenId);
                                $('#ddlFromAccount').val(data.VoucherDetails[i].CALayerSevenId).trigger('change');
                                $('#txtPaymentAmounthidden').val(data.VoucherDetails[i].CALayerSevenId)
                               // $('#amount_' + tr).val(data.VoucherDetails[i].CrAmt.toFixed(2));
                                $('#txtPaymentAmount').val(data.VoucherDetails[i].CrAmt.toFixed(2));
                                $('#details_' + tr).val(data.VoucherDetails[i].VoucherDetailId);
                                $('#details_transaction_' + tr).val(data.VoucherDetails[i].VoucherTransectionId);
                                $('#DrCr_' + tr).val(data.VoucherDetails[i].DrCr);
                                $("#tr_" + tr).css("display", "none");
                            }
                            if (glId == 1268) {
                                $("#SevenLayerCr_" + tr).val(data.VoucherDetails[i].CALayerSevenId);
                                $('#txtDiscounthidden').val(data.VoucherDetails[i].CALayerSevenId)
                                //$('#ddlFromAccount').val(data.VoucherDetails[i].CALayerSevenId).trigger('change');
                                //$('#amount_' + tr).val(data.VoucherDetails[i].CrAmt.toFixed(2));
                                $('#txtDiscount').val(data.VoucherDetails[i].CrAmt.toFixed(2));
                                $('#details_' + tr).val(data.VoucherDetails[i].VoucherDetailId);
                                $('#details_transaction_' + tr).val(data.VoucherDetails[i].VoucherTransectionId);
                                $('#DrCr_' + tr).val(data.VoucherDetails[i].DrCr);
                                $("#tr_" + tr).css("display", "none");
                            }
                            if (glId == 1083) {
                                $("#SevenLayerCr_" + tr).val(data.VoucherDetails[i].CALayerSevenId);
                                $('#txtTaxhidden').val(data.VoucherDetails[i].CALayerSevenId)
                                //$('#ddlFromAccount').val(data.VoucherDetails[i].CALayerSevenId).trigger('change');
                               // $('#amount_' + tr).val(data.VoucherDetails[i].CrAmt.toFixed(2));
                                $('#txtTax').val(data.VoucherDetails[i].CrAmt.toFixed(2));
                                $('#details_' + tr).val(data.VoucherDetails[i].VoucherDetailId);
                                $('#details_transaction_' + tr).val(data.VoucherDetails[i].VoucherTransectionId);
                                $('#DrCr_' + tr).val(data.VoucherDetails[i].DrCr);
                                $("#tr_" + tr).css("display", "none");
                            }

                        }
                        if (data.VoucherDetails[i].DrCr == "Dr")
                        {


                            $("#glId_" + tr).val(data.VoucherDetails[i].CALayerSevenId).trigger('change');
                            $('#glId_' + tr).prop("disabled", true);
                            $("#costCenter_" + tr).val(data.VoucherDetails[i].CostCenterId).trigger('change');
                            $("#referenceNo_" + tr).val(data.VoucherDetails[i].RefDetailsId).trigger('change');
                            $('#amount_' + tr).val(data.VoucherDetails[i].DrAmt.toFixed(2));
                            $('#remarks_' + tr).val(data.VoucherDetails[i].Remarks);

                            $('#details_' + tr).val(data.VoucherDetails[i].VoucherDetailId);
                            $('#details_transaction_' + tr).val(data.VoucherDetails[i].VoucherTransectionId);
                            $('#DrCr_' + tr).val(data.VoucherDetails[i].DrCr);

                        }

                        if (data.IsPage == false) {
                            $('#costCenter_' + tr).prop("disabled", true);
                            $('#referenceNo_' + tr).prop("disabled", true);
                            $('#amount_' + tr).prop("disabled", true);
                            $('#remarks_' + tr).prop("disabled", true);
                            $('#txtaNarration').prop("disabled", true);
                            $("#btnAdd_" + tr).css("display", "none");
                            $("#btnRemove_" + tr).css("display", "none");
                            $('#Reject').hide();
                        } else {
                            $('#costCenter_' + tr).prop("disabled", false);
                            $('#referenceNo_' + tr).prop("disabled", false);
                            $('#amount_' + tr).prop("disabled", false);
                            $('#remarks_' + tr).prop("disabled", false);
                            $('#txtaNarration').prop("disabled", false);
                            $("#btnAdd_" + tr).css("display", "block");
                            $("#btnRemove_" + tr).css("display", "block");
                            $('#Reject').show();
                        }

                    }

                }
            });
        }







        function SaveDebitVoucher() {

            if (SaveValidation() == true) {
               
                    SaveDebitVoucherFinal();

                
            }
        }

        function SaveDebitVoucherFinal() {
             
            var jsonData = {};

            jsonData["TestMasterId"] = $('#TestMasterId').val();
            jsonData["CompanyId"] = $('#ddlCompany').val();
            jsonData["UnitId"] = $('#ddlBusinessUnit').val();
            

            jsonData["VoucherDate"] = $('#txtVoucherDate').val();
          
            jsonData["CurrencyRate"] = $('#txtCurrencyRate').val();

            var voucherType = 0;
            if ($('#bankRadio').is(':checked')) {
                voucherType = 'Bank';
            }
            if ($('#cashRadio').is(':checked')) {
                voucherType = 'Cash';
            }
            jsonData["PaymentType"] = voucherType; 
         
            jsonData["TotalAmount"] = parseFloat($('#lblTotalAmountAmount').html());
            jsonData["Narration"] = $('#txtaNarration').val().trim();
          


            var jsonObjs = [];

            ////Credit Object
         

            $('#debitVoucher tbody tr').each(function () {

                var theObj = {};
                var transactionObj = {};
                var idr = $(this).attr('id');
                var id = idr.substring(3);

           

                var ConId = isNaN(parseFloat($('#ConId_' + id).val())) ? 0 : parseFloat($('#ConId_' + id).val());

                var City = isNaN(parseFloat($('#city_' + id).val())) ? 0 : parseFloat($('#city_' + id).val());
               
                
                var amount = isNaN(parseFloat($('#amount_' + id).val())) ? 0 : parseFloat($('#amount_' + id).val());
                var remarks = $('#remarks_' + id).val();
             

                if (detailsId == 0) {
                    theObj["TestDetailId"] = detailsId;
                    theObj["CountryId"] = ConId;
                    theObj["CityId"] = City;
                  
                    theObj["Amount"] = amount;
                    
                   
                    theObj["Remarks"] = remarks;
                  
                     
                }
                

                jsonObjs.push(theObj);

            });


            alert(jsonObjs);

            jsonData["TestDetails"] = jsonObjs;

            var urlpath = '@Url.Action("SaveTest", "Test")';
            $.ajax({
                contentType: "application/json",
                data: JSON.stringify(jsonData),
                dataType: 'json',
                url: urlpath,
                type: "POST"
            })
                .success(function (result) {

                    if (result.pk > 0) {
                        @*swal({
                            title: " Saved Successfully!",
                            text: '',
                            type: "success",
                            showCancelButton: false,
                            cancelButtonClass: 'btn-secondary waves-effect',
                            confirmButtonClass: 'btn-success waves-effect waves-light',
                            confirmButtonText: 'Yes!',
                            closeOnConfirm: false
                        }, function () {
                            var eflag = $('#eflag').val();
                            if (eflag == "ed") {
                                window.location.href = '@Url.Action("Index", "DebitVoucher")';
                            } else {*@
                                window.location.href = '@Url.Action("DebitVoucherApproval", "DebitVoucher")';
                           /* }*/


                       /* });*/


                    }
                });


        }

        function SaveValidation() {

             
            var isValid = true;
            var message = "Some Values Required";
            if ($('#ddlCompany').val() == 0 || $('#ddlCompany').val() == '') {
                ValidationColorChangeNew("ddlCompany", "divCompany", "Company Required", true);
                isValid = false;
            }
            if ($('#ddlBusinessUnit').val() == 0 || $('#ddlBusinessUnit').val() == '') {
                ValidationColorChangeNew("ddlBusinessUnit", "divBusinessUnit", "Business Unit Required", true);
                isValid = false;
            }
            
            if ($('#txtVoucherDate').val() == '' || $('#txtVoucherDate').val() == null) {
                ValidationColorChangeNew("txtVoucherDate", "divVoucherDate", "Voucher Date Required", false);
                isValid = false;
            }

            
            if ($('#txtCurrencyRate').val() == '' || $('#txtCurrencyRate').val() == null) {
                ValidationColorChangeNew("txtCurrencyRate", "divCurrencyRate", "Currency Rate Required", false);
                isValid = false;
            }

          

             

 


            if ($('#txtaNarration').val().trim() == '' || $('#txtaNarration').val().trim() == null) {
                ValidationColorChangeNew("txtaNarration", "divNarration", "Narration Required", false);
                isValid = false;
            }

           

            $('#debitVoucher tbody tr').each(function () {

              
                var idr = $(this).attr('id');
                var id = idr.substring(3);

                var conId = isNaN(parseFloat($('#ConId_' + id).val())) ? 0 : parseFloat($('#ConId_' + id).val());
                alert(conId);
                var cityId = isNaN(parseFloat($('#city_' + id).val())) ? 0 : parseFloat($('#city_' + id).val());
                var amount = isNaN(parseFloat($('#amount_' + id).val())) ? 0 : parseFloat($('#amount_' + id).val());
               
                if (conId === 0) {
                    isValid = false;
                    message = "Please select Country";
                    $('#ConId_' + id).css('border-bottom', '2px solid red');
                    return;
                }


                if (cityId === 0) {
                    isValid = false;
                    message = "Please select City";
                    $('#city_' + id).css('border-bottom', '2px solid red');
                    return;
                }
                if (amount === 0) {
                    isValid = false;
                    message = "Pay Amount Cannot be 0 ";
                    $('#amount_' + id).css('border-bottom', '2px solid red');
                    return;
                }


            });
             
            return isValid;


        }

        function CalculateAll() {

             
            var grandTotal = 0;
            var proCout = 0;
            $('#debitVoucher tbody tr').each(function () {


                 
                var idr = $(this).attr('id');
                var id = idr.substring(3);

               
                var amount = isNaN(parseFloat($('#amount_' + id).val())) ? 0 : parseFloat($('#amount_' + id).val());

                grandTotal += amount;
               


                

            });
            $('#lblTotalAmountAmount').html(grandTotal.toFixed(2));
        }

      
