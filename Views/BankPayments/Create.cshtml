        function AddRow(selectedAccountId, selectedAccountText) {
            var values = $("#debitVoucher tbody tr")
                .map(function () { return parseInt($(this).attr('id').substring(3)); }).get();
            if (values.length > 0) {
                var nextFromDom = Math.max.apply(Math, values) + 1;
                if (bpRowSeed < nextFromDom) {
                    bpRowSeed = nextFromDom;
                }
            }
            var tr = bpRowSeed++;
            var urlpath = '@Url.Action("AddRowForCOA", "BankPayments")';
            return $.ajax({
                url: urlpath,
                type: "Get",
                dataType: 'html',
                data: { tr: tr }
            }).then(function (data) {
                $('#debitVoucher tbody').append(data);
                return $.when(LoadCoaRow("COAId_" + tr, selectedAccountId, selectedAccountText)).then(function () {
                    InitCostCenterSelect2(tr);
                    InitRefInfoSelect2(tr);
                    InitSubsidiarySelect2(tr);

                    SerialTable();
                    CalculateAll();
                    return tr;
                });
            });

        }

