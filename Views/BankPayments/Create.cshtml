        function CalculateAll() {

            var ConversionRate = isNaN(parseFloat($('#txtConversionRate').val())) ? 0 : parseFloat($('#txtConversionRate').val());
            var grandTotalFC = 0;
            var grandTotal = 0;
            var proCout = 0;
            $('#debitVoucher tbody tr').each(function () {



                var idr = $(this).attr('id');
                var id = idr.substring(3);


                var amount = isNaN(parseFloat($('#amount_' + id).val())) ? 0 : parseFloat($('#amount_' + id).val());
                var amount = isNaN(parseFloat($('#amount_' + id).val())) ? 0 : parseFloat($('#amount_' + id).val());

                var amountFC = ConversionRate * amount;
                $('#amount_FC_' + id).val(amountFC.toFixed(4));

                grandTotal += amount;
                grandTotalFC += amountFC;





            });
            $('#lblTotalAmountBDT').html(grandTotal.toFixed(4));
            $('#lblTotalAmountFC').html(grandTotalFC.toFixed(4));

            // wireframe 81: line count beside the table title, balance status + pay source in the footer
            var lines = $('#debitVoucher tbody tr').length;
            $('#lblLineCount').text('(' + lines + (lines == 1 ? ' line' : ' lines') + ' · all Dr)');
            var isBank = $('#bankRadio').is(':checked');
            var balance = parseFloat((isBank ? $('#lblBankBalance') : $('#lblCashBalance')).text()) || 0;
            var srcName = $((isBank ? '#ddlBankAccount' : '#ddlCashAccount') + ' option:selected').text();
            $('#lblPaySource').text(srcName && srcName.indexOf('--') !== 0 ? 'Pays from ' + srcName + ' · balance ' + balance.toFixed(2) : '');
            var empty = grandTotal === 0;
            var within = grandTotal > 0 && grandTotal <= balance;
            $('#balStatus').attr('class', 'objstat ' + (empty ? 'neu' : within ? 'pos' : 'neg'))
                .find('b').text(empty ? 'No amounts yet' : within ? 'Within balance' : 'Exceeds balance');
            $('#balStatus use').attr('href', empty ? '#s-alert' : within ? '#s-ok' : '#s-no');
            if ($('#simSection').is(':visible')) { RenderSimulation(); }
        }

        function InitDependentSelect2(config) {
            var $ddl = $('#' + config.elementId);
            if ($ddl.length === 0) {
                return $.Deferred().resolve().promise();
            }

            if ($ddl.data('select2')) {
                $ddl.select2('destroy');
            }

            $ddl.empty();
            $ddl.append("<option value='0'>" + config.placeholder + "</option>");

            $ddl.select2({
                placeholder: config.placeholder,
                width: '100%',
                minimumInputLength: 1,
                ajax: {
                    url: config.autoUrl,
                    dataType: 'json',
                    delay: 250,
                    cache: true,
                    data: function (params) {
                        return {
                            accountId: $('#COAId_' + config.rowId).val() || 0,
                            term: params.term || '',
                            take: 50
                        };
                    },
                    processResults: function (data) {
                        return {
                            results: $.map(data, function (item) {
                                return {
                                    id: item[config.valueField],
                                    text: item[config.textField]
                                };
                            })
                        };
                    }
                }
            });

            var selectedId = parseInt(config.selectedId, 10) || 0;
            var accountId = parseInt($('#COAId_' + config.rowId).val(), 10) || 0;

            if (selectedId <= 0 || accountId <= 0) {
                $ddl.val('0').trigger('change.select2');
                return $.Deferred().resolve().promise();
            }

            var requestData = { accountId: accountId };
            requestData[config.idParam] = selectedId;

            return $.ajax({
                url: config.byIdUrl,
                dataType: 'json',
                type: "Get",
                data: requestData,
                success: function (item) {
                    if (!item || !item[config.valueField]) {
                        return;
                    }

                    if ((parseInt($('#COAId_' + config.rowId).val(), 10) || 0) !== accountId) {
                        return;
                    }

                    var selectedOption = new Option(item[config.textField], item[config.valueField], true, true);
                    $ddl.append(selectedOption).trigger('change.select2');
                }
            });
        }

