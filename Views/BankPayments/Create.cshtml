        function LoadCurrency() {
            return $.ajax({
                url: "/Utility/GetCurrency",
                contentType: "application/json; charset=utf-8",
                dataType: 'json',
                type: "Get",
                data: {},
                success: function (data) {


                    let totalCurrencyRate = 0;
                    for (var i = 0; i < data.length; i++) {
                        totalCurrencyRate += parseFloat(data[i].CurrencyRate) || 0;
                    }

                    // Check if totalCurrencyRate is 0
                    if (totalCurrencyRate === 0) {
                        toastr.options = {
                            "closeButton": true,
                            "progressBar": true,
                            "positionClass": "toast-top-center",
                            "timeOut": "5000"
                        };
                        toastr.warning("Today's conversion rate is not declared yet.");
                        return; // Exit the function to prevent further execution
                    }

                    $('#ddlCurrency').empty();
                    $('#ddlCurrency').append("<option value='0'>--Select Currency--</option>");

                    for (var i = 0; i < data.length; i++) {
                        // Store the CurrencyRate as a data attribute on the option
                        $('#ddlCurrency').append($("<option></option>")
                            .val(data[i].CurrencyId)
                            .html(data[i].CurrencyName)
                            .attr('data-rate', data[i].CurrencyRate)); // Set CurrencyRate as data-rate
                    }

                    $('#ddlCurrency').prop('selectedIndex', 1);

                    // Set default conversion rate based on the selected currency
                    let initialRate = $('#ddlCurrency option:selected').data('rate');
                    $('#txtConversionRate').val(initialRate);

                    // Change event to update txtConversionRate when the currency is changed
                    $('#ddlCurrency').change(function () {
                        var selectedRate = $('#ddlCurrency option:selected').data('rate');
                        $('#txtConversionRate').val(selectedRate);
                        CalculateAll();
                    });
                }
            });
        }

