        function ResetValidation(fields) {
            fields.forEach(function (field) {
                ValidationColorChangeNew(field.id, field.div, "", false);
            });
        }
        function Bankp_Validation(isPark) {

            var isValid = true;
            var message = "Some Values Required";
            ResetValidation([
                { id: 'ddlCompany', div: 'divCompany' },
                { id: 'ddlFinansialYear', div: 'divFinansialYear' },
                { id: 'txtPostingDate', div: 'divPostingDate' },
                { id: 'txtConversionRate', div: 'divtConversionRate' },
                { id: 'txtNaration', div: 'divNaration' },
                { id: 'ddlBankAccount', div: 'divBankAccount' },
                { id: 'txtChequeNo', div: 'divCheque' },
                { id: 'txtChequeDate', div: 'divChequeDate' },
                { id: 'ddlCashAccount', div: 'divCashAccount' },
                { id: 'bankRadio', div: 'divTransactionType' },
                { id: 'cashRadio', div: 'divTransactionType' }
            ]);

            // Validate Company
            if ($('#ddlCompany').val() == 0 || $('#ddlCompany').val() == '') {
                ValidationColorChangeNew("ddlCompany", "divCompany", "Company Required", true);
                isValid = false;
            }

            // Validate Financial Year
            if ($('#ddlFinansialYear').val() == 0 || $('#ddlFinansialYear').val() == '' || $('#ddlFinansialYear').val() == null) {
                ValidationColorChangeNew("ddlFinansialYear", "divFinansialYear", "Financial Year Required", true);
                isValid = false;
            }

            // Validate Posting Date
            if ($('#txtPostingDate').val() == '' || $('#txtPostingDate').val() == null) {
                ValidationColorChangeNew("txtPostingDate", "divPostingDate", "Posting Date Required", false);
                isValid = false;
            }

            // Validate Conversion Rate
            if ($('#txtConversionRate').val() == '' || $('#txtConversionRate').val() == null) {
                ValidationColorChangeNew("txtConversionRate", "divtConversionRate", "Currency Rate Required", false);
                isValid = false;
            }
            var ConversionRate = $('#txtConversionRate').val();
            if (ConversionRate == 0) {
                // Show toast notification for today's conversion rate

                toastr.options = {
                    "closeButton": true,
                    "progressBar": true,
                    "positionClass": "toast-bottom-right", // Shows the toastr message at the bottom-right
                    "timeOut": "5000" // Auto-close after 5 seconds
                };
                ValidationColorChangeNew("txtConversionRate", "divtConversionRate", "Today's conversion rate is required.", false);
                toastr.warning("Today's conversion rate is required.");
                isValid = false;
            }


            // Validate Transaction Type (Bank or Cash)
            var voucherType = 0;
            if ($('#bankRadio').is(':checked')) {
                voucherType = 1;
            } else if ($('#cashRadio').is(':checked')) {
                voucherType = 2;
            }

            if (voucherType == 0) {
                ValidationColorChangeNew("bankRadio", "divTransactionType", "Transaction Type Required", false);
                isValid = false;
            }

            // Validate Narration
            if ($('#txtNaration').val().trim() == '' || $('#txtNaration').val().trim() == null) {
                ValidationColorChangeNew("txtNaration", "divNaration", "Narration Required", false);
                isValid = false;
            }

            // Bank-related validations
            if (voucherType == 1) {
                // Validate Bank Account
                if ($('#ddlBankAccount').val() == 0 || $('#ddlBankAccount').val() == '' || $('#ddlBankAccount').val() == null) {
                    ValidationColorChangeNew("ddlBankAccount", "divBankAccount", "Bank Account Required", true);
                    isValid = false;
                } else {
                    var bankBlncText = $('#lblBankBalance').text() || $('#lblBankBalance').val() || "0";
                    var bankBlncVal = parseFloat(bankBlncText);
                    if ((isNaN(bankBlncVal) || bankBlncVal <= 0) && !isPark) {
                        isValid = false;
                        $('#lblBankBalance').css({ "border": "2px solid red", "color": "#dc3545" });
                        toastr.options = { "closeButton": true, "progressBar": true, "positionClass": "toast-bottom-right", "timeOut": "5000" };
                        toastr.error("Disbursement is not allowed! Bank closing balance is " + (isNaN(bankBlncVal) ? "0.00" : bankBlncVal.toFixed(2)) + " (0 or negative).");
                        swal("Disbursement Not Allowed!", "Selected Bank Account closing balance is " + (isNaN(bankBlncVal) ? "0.00" : bankBlncVal.toFixed(2)) + ". Disbursement is not allowed when balance is 0 or less.", "error");
                        return false;
                    }
                }

                // Validate Cheque Number (not required while parking a draft)
                if (!isPark && ($('#txtChequeNo').val().trim() == '' || $('#txtChequeNo').val().trim() == null)) {
                    ValidationColorChangeNew("txtChequeNo", "divCheque", "Cheque No Required", false);
                    isValid = false;
                }

                // Validate Cheque Date (not required while parking a draft)
                if (!isPark && ($('#txtChequeDate').val().trim() == '' || $('#txtChequeDate').val().trim() == null)) {
                    ValidationColorChangeNew("txtChequeDate", "divChequeDate", "Cheque Date Required", false);
                    isValid = false;
                }
            }

            // Cash-related validations
            if (voucherType == 2) {
                // Validate Cash Account
                if ($('#ddlCashAccount').val() == 0 || $('#ddlCashAccount').val() == '' || $('#ddlCashAccount').val() == null) {
                    ValidationColorChangeNew("ddlCashAccount", "divCashAccount", "Cash Account Required", true);
                    isValid = false;
                } else {
                    var cashBlncText = $('#lblCashBalance').text() || $('#lblCashBalance').val() || "0";
                    var cashBlncVal = parseFloat(cashBlncText);
                    if ((isNaN(cashBlncVal) || cashBlncVal <= 0) && !isPark) {
                        isValid = false;
                        $('#lblCashBalance').css({ "border": "2px solid red", "color": "#dc3545" });
                        toastr.options = { "closeButton": true, "progressBar": true, "positionClass": "toast-bottom-right", "timeOut": "5000" };
                        toastr.error("Disbursement is not allowed! Cash closing balance is " + (isNaN(cashBlncVal) ? "0.00" : cashBlncVal.toFixed(2)) + " (0 or negative).");
                        swal("Disbursement Not Allowed!", "Selected Cash Account closing balance is " + (isNaN(cashBlncVal) ? "0.00" : cashBlncVal.toFixed(2)) + ". Disbursement is not allowed when balance is 0 or less.", "error");
                        return false;
                    }
                }
            }

            $('#debitVoucher tbody tr').each(function () {


                var idr = $(this).attr('id');
                var id = idr.substring(3);

                var AccountId = isNaN(parseFloat($('#COAId_' + id).val())) ? 0 : parseFloat($('#COAId_' + id).val());

                var amount = isNaN(parseFloat($('#amount_' + id).val())) ? 0 : parseFloat($('#amount_' + id).val());

                if (AccountId === 0) {
                    isValid = false;
                    message = "Please select GL";
                    $('#COAId_' + id).css('border-bottom', '2px solid red');
                    toastr.options = {
                        "closeButton": true,
                        "progressBar": true,
                        "positionClass": "toast-bottom-right", // Shows the toastr message at the bottom-right
                        "timeOut": "5000" // Auto-close after 5 seconds
                    };

                    toastr.warning("Please select GL");
                    return;
                }


                if (amount === 0 && !isPark) {
                    isValid = false;
                    message = "Pay Amount Cannot be 0 ";
                    $('#amount_' + id).css('border-bottom', '2px solid red');
                    toastr.options = {
                        "closeButton": true,
                        "progressBar": true,
                        "positionClass": "toast-bottom-right", // Shows the toastr message at the bottom-right
                        "timeOut": "5000" // Auto-close after 5 seconds
                    };

                    toastr.warning("Pay Amount Cannot be 0");
                    return;
                }


            });

            if (!isValid) {
                return false;
            }

            var totalAmountBDT = parseFloat($('#lblTotalAmountBDT').text()) || 0;
            if (voucherType == 1 && !isPark) {
                var currentBankBlnc = parseFloat($('#lblBankBalance').text() || $('#lblBankBalance').val()) || 0;
                if (totalAmountBDT > currentBankBlnc) {
                    isValid = false;
                    toastr.options = { "closeButton": true, "progressBar": true, "positionClass": "toast-bottom-right", "timeOut": "5000" };
                    toastr.error("Total payment amount (" + totalAmountBDT.toFixed(2) + ") exceeds available Bank balance (" + currentBankBlnc.toFixed(2) + ")!");
                    swal("Disbursement Not Allowed!", "Total disbursement amount (" + totalAmountBDT.toFixed(2) + ") cannot exceed available Bank balance (" + currentBankBlnc.toFixed(2) + ").", "error");
                    return false;
                }
            } else if (voucherType == 2 && !isPark) {
                var currentCashBlnc = parseFloat($('#lblCashBalance').text() || $('#lblCashBalance').val()) || 0;
                if (totalAmountBDT > currentCashBlnc) {
                    isValid = false;
                    toastr.options = { "closeButton": true, "progressBar": true, "positionClass": "toast-bottom-right", "timeOut": "5000" };
                    toastr.error("Total payment amount (" + totalAmountBDT.toFixed(2) + ") exceeds available Cash balance (" + currentCashBlnc.toFixed(2) + ")!");
                    swal("Disbursement Not Allowed!", "Total disbursement amount (" + totalAmountBDT.toFixed(2) + ") cannot exceed available Cash balance (" + currentCashBlnc.toFixed(2) + ").", "error");
                    return false;
                }
            }

            return isValid;


        }

    </script>

