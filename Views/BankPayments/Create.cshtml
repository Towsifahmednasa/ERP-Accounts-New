@* Debit Voucher (bank/cash payment) laid out as wireframe screen 81 "Voucher Entry": voucher-type bar, voucher header,
   payment details (the wireframe's payment-voucher variant), attachments, lines card with a running total footer,
   simulation, Park/Submit. Every element id and the page scripts below are the same contract as before. *@

@{
    ViewBag.Title = "Debit Voucher Entry";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<style>
    .jr-types { background: #fff; border-radius: 12px; box-shadow: var(--sapContent_Shadow0); padding: 11px 16px; margin-bottom: 14px; display: flex; align-items: center; gap: 10px; flex-wrap: wrap; }
    .jr-types .lbl { font-size: 12px; font-weight: 700; letter-spacing: .4px; text-transform: uppercase; color: var(--sapContent_LabelColor); }
    .jr-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(210px, 1fr)); gap: 15px 24px; }
    .jr-grid .customLabel p { margin: 2px 0 0; font-size: 12px; }
    .jr-pay { flex: 1; min-width: 300px; border: 1px solid var(--sapList_BorderColor); border-radius: 9px; padding: 11px 13px; }
    .jr-pay .jr-grid { grid-template-columns: repeat(auto-fill, minmax(170px, 1fr)); gap: 12px 18px; }
    .jr-pay h5 { display: flex; align-items: center; gap: 8px; font-size: 13px; margin: 0 0 10px; }
    .jr-pay label.form-control { background: #f5f6f7; }
    #debitVoucher { table-layout: fixed; min-width: 1360px; }
    #debitVoucher td { padding: 6px 8px; }
    #debitVoucher td.hl { border-left-color: var(--sapPositiveColor); }
    .jr-foot { padding: 10px 14px; border-top: 1px solid var(--sapList_BorderColor); display: flex; gap: 18px; flex-wrap: wrap; align-items: center; background: #fafbfc; font-size: 13px; }
    .jr-file { display: flex; align-items: center; gap: 8px; border: 1px solid var(--sapList_BorderColor); border-radius: 8px; padding: 7px 11px; margin-bottom: 5px; font-size: 13px; }
    .jr-file a { color: var(--sapLinkColor); font-weight: 600; text-decoration: none; }
    .jr-file a:hover { text-decoration: underline; }
</style>

<div id="popDiv"></div>

<div class="strip info" id="parkedStrip" style="display:none">
    <svg width="16" height="16" style="flex:none;margin-top:1px"><use href="#s-alert"/></svg>
    <div><b>Parked voucher.</b> It is saved as a draft and is not in the approval queue. Submit posts it; Park keeps it as a draft.</div>
</div>

<div class="strip err" id="periodStrip" style="display:none">
    <svg width="16" height="16" style="flex:none;margin-top:1px;color:var(--sapNegativeColor)"><use href="#s-no"/></svg>
    <div><b>Posting blocked &mdash; <span id="periodText"></span> is closed for financial accounting.</b>
        Change the posting date to an open period, park the voucher as a draft, or re-open the period.
        <div style="margin-top:7px"><a class="btn sm" href="@Url.Action("PeriodClose", "Journal")">Period-close status</a></div>
    </div>
</div>

<div class="jr-types">
    <span class="lbl">Voucher type</span>
    <a class="btn" href="@Url.Action("JRCreate", "Journal")"><svg width="14" height="14"><use href="#s-doc"/></svg>Journal</a>
    <a class="btn emph" href="@Url.Action("Create", "BankPayments")"><svg width="14" height="14"><use href="#s-money"/></svg>Debit Voucher</a>
    <a class="btn" href="@Url.Action("CVCreate", "CreditVoucher")"><svg width="14" height="14"><use href="#s-dn"/></svg>Credit Voucher</a>
    <a class="btn" href="@Url.Action("ContraEntry", "Contra")"><svg width="14" height="14"><use href="#s-up"/></svg>Contra</a>
    <div style="margin-left:auto">
        <a class="btn" href="@Url.Action("Index", "BankPayments")"><span class="fa fa-share"></span> Back to List</a>
    </div>
</div>

<div class="opsect">
    <h4>Voucher header</h4>
    <div class="jr-grid">
        <div class="fld">
            <label for="ddlCompany">Company <span class="required">*</span></label>
            <div id="divCompany"><select class="form-select form-select-sm select2" style="width: 100%;" id="ddlCompany" onchange="LoadDDlbyCom()"></select></div>
        </div>
        <div class="fld">
            <label for="ddlFinansialYear">Financial Year <span class="required">*</span></label>
            <div id="divFinansialYear"><select class="form-select form-select-sm select2" onchange="LoadDaterangebyFiscal()" style="width: 100%;" id="ddlFinansialYear"></select></div>
        </div>
        <div class="fld">
            <label for="txtPostingDate">Posting Date <span class="required">*</span></label>
            <div id="divPostingDate"><input type="text" id="txtPostingDate" class="form-control form-control-sm datepicker" value="@DateTime.Now.ToString("dd MMMM, yyyy")" /></div>
        </div>
        <div class="fld" id="divIsMannualVoucher">
            <label for="txtVoucherNo">Voucher No.</label>
            <input type="text" id="txtVoucherNo" class="form-control form-control-sm" />
        </div>
        <div class="fld" id="divCurrency">
            <label for="ddlCurrency">Currency <span class="required">*</span></label>
            <select class="form-select form-select-sm select2" style="width: 100%;" id="ddlCurrency"></select>
        </div>
        <div class="fld">
            <label for="txtConversionRate">Conversion Rate <span class="required">*</span></label>
            <div id="divtConversionRate"><input type="text" readonly value="0" id="txtConversionRate" class="form-control form-control-sm" /></div>
        </div>
    </div>
</div>

<div class="opsect">
    <h4>Payment details</h4>
    <div style="display:flex;align-items:center;gap:14px;margin-bottom:12px" id="divTransactionType">
        <span class="mini" style="font-weight:700;letter-spacing:.4px;text-transform:uppercase">Pay from</span>
        <input type="radio" name="rbTransactionType" value="Bank" id="bankRadio" />
        <label for="bankRadio" style="font-weight:bold">Bank</label>
        <input type="radio" id="cashRadio" name="rbTransactionType" value="Cash">
        <label for="cashRadio" style="font-weight:bold">Cash</label>
    </div>
    <div style="display:flex;gap:14px;flex-wrap:wrap;align-items:stretch">
        <div class="jr-pay">
            <h5><svg width="15" height="15" style="color:var(--sapBrandColor)"><use href="#s-money"/></svg>Bank</h5>
            <div class="jr-grid">
                <div class="fld">
                    <label for="ddlBankAccount">Bank Account <span class="required">*</span></label>
                    <div id="divBankAccount"><select class="form-select form-select-sm select2" onchange="LoadBankIndoById()" style="width: 100%;" id="ddlBankAccount"></select></div>
                </div>
                <div class="fld">
                    <label for="lblBankBalance">Bank Balance</label>
                    <label class="form-control form-control-sm" id="lblBankBalance"></label>
                </div>
                <div class="fld">
                    <label for="txtChequeNo">Cheque No <span class="required">*</span></label>
                    <div id="divCheque"><input type="text" id="txtChequeNo" class="form-control form-control-sm" /></div>
                </div>
                <div class="fld">
                    <label for="txtChequeDate">Cheque Date <span class="required">*</span></label>
                    <div id="divChequeDate"><input type="text" id="txtChequeDate" class="form-control form-control-sm datepicker" value="@DateTime.Now.ToString("dd MMMM, yyyy")" /></div>
                </div>
                <div class="fld">
                    <label for="lblBankName">Bank Name</label>
                    <label class="form-control form-control-sm" id="lblBankName"></label>
                </div>
                <div class="fld">
                    <label for="lblBranchName">Branch Name</label>
                    <label class="form-control form-control-sm" id="lblBranchName"></label>
                </div>
            </div>
        </div>
        <div class="jr-pay">
            <h5><svg width="15" height="15" style="color:var(--sapBrandColor)"><use href="#s-money"/></svg>Cash</h5>
            <div class="jr-grid">
                <div class="fld">
                    <label for="ddlCashAccount">Cash Account <span class="required">*</span></label>
                    <div id="divCashAccount"><select class="form-select form-select-sm select2" style="width: 100%;" onchange="LoadCashInfoIndoById()" id="ddlCashAccount"></select></div>
                </div>
                <div class="fld">
                    <label for="lblCashBalance">Cash Balance</label>
                    <label class="form-control form-control-sm" id="lblCashBalance"></label>
                </div>
                <div class="fld" id="divRefNo">
                    <label for="txtRefNo">Ref. No</label>
                    <input type="text" id="txtRefNo" class="form-control form-control-sm" />
                </div>
                <div class="fld" id="divRefDate">
                    <label for="txtRefDate">Ref. Date</label>
                    <input type="text" id="txtRefDate" class="form-control form-control-sm datepicker" value="@DateTime.Now.ToString("dd MMMM, yyyy")" />
                </div>
            </div>
        </div>
    </div>
    <div class="fld" style="margin-top:12px;max-width:640px">
        <label for="txtNaration">Narration <span class="required">*</span></label>
        <div id="divNaration"><textarea id="txtNaration" rows="2" class="form-control form-control-sm"> </textarea></div>
    </div>
</div>

<div class="opsect">
    <div style="display:flex;align-items:center;gap:8px;margin-bottom:8px">
        <svg width="15" height="15" style="color:var(--sapBrandColor)"><use href="#s-doc"/></svg>
        <b style="font-size:13px">Attachments</b><span class="mini" id="attachCount"></span>
        <button type="button" class="btn sm" id="btnAttach" style="margin-left:auto" onclick="$('#attachFile').click()">Add</button>
        <input type="file" id="attachFile" style="display:none" onchange="UploadAttachment(this)" />
    </div>
    <div id="attachList"></div>
    <div class="mini" id="attachHint">Save the voucher first, then attach files (max 10 MB each).</div>
</div>

<div class="tblcard" style="margin-bottom:14px">
    <div class="tbar">
        <h3>Voucher lines <span class="cnt" id="lblLineCount">(0 lines)</span></h3>
        <div class="tools">
            <button type="button" class="btn sm" onclick="AddRow()"><svg width="14" height="14"><use href="#s-plus"/></svg>Add line</button>
        </div>
    </div>
    <div class="tblwrap">
        <table class="sap" id="debitVoucher">
            <thead>
                <tr>
                    <th class="num" style="width: 44px">Ln</th>
                    <th style="width: 320px">GL</th>
                    <th style="width: 180px">Subsidiary Ledger</th>
                    <th style="width: 180px">Cost Center</th>
                    <th style="width: 180px">Ref. Info.</th>
                    <th class="num" style="width: 120px">Amount (BDT)</th>
                    <th class="num" style="width: 120px">Amount (FC)</th>
                    <th>Remarks</th>
                    <th style="width: 44px"></th>
                </tr>
            </thead>
            <tbody></tbody>
        </table>
    </div>
    <div class="jr-foot">
        <span class="objstat neu" id="balStatus"><svg width="15" height="15"><use href="#s-alert"/></svg><b>No amounts yet</b></span>
        <span>Total (BDT) <b id="lblTotalAmountBDT">0</b></span>
        <span>Total (FC) <b id="lblTotalAmountFC">0</b></span>
        <span class="mini" id="lblPaySource"></span>
        <div style="margin-left:auto;display:flex;gap:8px">
            <a class="btn tr" href="@Url.Action("Index", "BankPayments")">Cancel</a>
            <button type="button" class="btn" onclick="SimulateJournal()">Simulate</button>
            <button type="button" class="btn" id="btnPark" onclick="SaveB_Payment('Parked')">Park</button>
            <button type="button" class="btn emph" id="Reject" onclick="SaveB_Payment('Posted')">Process Payment</button>
        </div>
    </div>
</div>

@* Simulation: built from the lines + the credit side the posting SP will add automatically. Nothing is sent to the server. *@
<div class="opsect" id="simSection" style="display:none">
    <h4>Simulation &mdash; document preview <span class="mini" style="font-weight:400">&middot; nothing is saved</span></h4>
    <table class="sap" style="font-size:13px">
        <thead><tr><th>Account</th><th class="num">Dr (BDT)</th><th class="num">Cr (BDT)</th><th>Check</th></tr></thead>
        <tbody id="simBody"></tbody>
    </table>
    <div id="simChecks" style="margin-top:12px"></div>
</div>

@* hidden fiscal date range the balance lookups read *@
<div style="display:none">
    <input type="text" id="txtfrmDate" class="form-control form-control-sm datepicker" value="@DateTime.Now.ToString("dd MMMM, yyyy")" />
    <input type="text" id="txtToDate" class="form-control form-control-sm datepicker" value="@DateTime.Now.ToString("dd MMMM, yyyy")" />
</div>

<input id="masterId" value="@ViewBag.MasterId" style="display:none" />
@section Scripts
{

    <script type="text/javascript">
        var coaDdlPendingLoads = 0;
        var bpRowSeed = 1;
        var isInitialDataLoading = false;

        function setInitialLoadState(isLoading) {
            isInitialDataLoading = isLoading;
            $('#Reject, #btnPark').prop('disabled', isLoading);
        }

        var jrActionStatus = 'Posted';
        var jrPeriodClosed = false;

        // ---- FI period close: strip + lock; the server rejects a post into a closed month regardless ----
        function CheckPeriod() {
            var comID = $('#ddlCompany').val();
            var d = $('#txtPostingDate').val();
            if (!comID || comID == '0' || !d) { return; }
            $.get('@Url.Action("PeriodCloseStatus", "Journal")', { companyId: comID, date: d }, function (r) {
                jrPeriodClosed = r.closed;
                $('#periodText').text('posting period of ' + d);
                $('#periodStrip').toggle(r.closed);
                $('#Reject').prop('disabled', r.closed || isInitialDataLoading);
            });
        }

        // ---- Attachments (shared voucher-attachment endpoints; enabled once the voucher is saved) ----
        function fmtSize(b) { return b > 1048576 ? (b / 1048576).toFixed(1) + ' MB' : Math.max(1, Math.round(b / 1024)) + ' KB'; }

        function LoadAttachments() {
            if (!(MasterId > 0)) { $('#btnAttach').prop('disabled', true); return; }
            $('#attachHint').hide();
            $.get('@Url.Action("VoucherAttachmentList", "Journal")', { masterId: MasterId }, function (list) {
                var h = '';
                for (var i = 0; i < list.length; i++) {
                    h += '<div class="jr-file"><svg width="14" height="14" style="color:#556b82;flex:none"><use href="#s-doc"/></svg>'
                        + '<a href="@Url.Action("DownloadVoucherAttachment", "Journal")?id=' + list[i].AttachmentId + '">' + $('<div>').text(list[i].FileName).html() + '</a>'
                        + '<span class="mini" style="margin-left:auto">' + fmtSize(list[i].FileSize) + '</span>'
                        + '<button type="button" class="btn icon" style="width:26px;height:26px" title="Remove" onclick="DeleteAttachment(' + list[i].AttachmentId + ')"><svg width="13" height="13"><use href="#s-no"/></svg></button></div>';
                }
                $('#attachList').html(h);
                $('#attachCount').text(list.length ? list.length + ' file' + (list.length > 1 ? 's' : '') : '');
            });
        }

        function UploadAttachment(input) {
            if (!input.files || !input.files.length) { return; }
            var f = input.files[0];
            input.value = '';
            if (f.size > 10 * 1024 * 1024) { toastr.warning('File is larger than 10 MB.'); return; }
            var fd = new FormData();
            fd.append('masterId', MasterId);
            fd.append('file', f);
            $.ajax({
                url: '@Url.Action("UploadVoucherAttachment", "Journal")',
                type: 'POST', data: fd, processData: false, contentType: false,
                success: function (r) {
                    if (r.isSuccess) { LoadAttachments(); } else { toastr.error(r.msg || 'Upload failed.'); }
                },
                error: function () { toastr.error('Upload failed.'); }
            });
        }

        function DeleteAttachment(id) {
            $.post('@Url.Action("DeleteVoucherAttachment", "Journal")', { id: id }, function (r) {
                if (r.isSuccess) { LoadAttachments(); } else { toastr.error('Delete failed.'); }
            });
        }

        // ---- Simulation: the Dr lines on screen plus the Cr side the posting SP adds from the selected bank/cash account ----
        function jrEsc(s) { return $('<div>').text(s == null ? '' : s).html(); }
        function jrMoney(n) { return n.toLocaleString('en-IN', { minimumFractionDigits: 2, maximumFractionDigits: 4 }); }
        function jrIcon(ok) { return '<svg width="13" height="13"><use href="' + (ok ? '#s-ok' : '#s-no') + '"/></svg>'; }

        function RenderSimulation() {
            var body = '', total = 0, missingGl = 0, zeroAmt = 0;
            $('#debitVoucher tbody tr').each(function () {
                var id = $(this).attr('id').substring(3);
                var accId = parseFloat($('#COAId_' + id).val()) || 0;
                var amt = parseFloat($('#amount_' + id).val()) || 0;
                var problem = !accId ? 'Select GL' : amt <= 0 ? 'Amount is 0' : '';
                if (!accId) { missingGl++; }
                if (amt <= 0) { zeroAmt++; }
                total += amt;
                body += '<tr><td>' + (accId ? jrEsc($('#COAId_' + id + ' option:selected').text()) : '<span class="mini">&mdash;</span>') + '</td>'
                    + '<td class="num">' + jrMoney(amt) + '</td><td class="num">&mdash;</td>'
                    + '<td><span class="objstat ' + (problem ? 'neg' : 'pos') + '">' + jrIcon(!problem) + (problem || 'ok') + '</span></td></tr>';
            });

            var isBank = $('#bankRadio').is(':checked');
            var srcSel = isBank ? '#ddlBankAccount' : '#ddlCashAccount';
            var srcOk = (parseFloat($(srcSel).val()) || 0) > 0;
            var srcName = srcOk ? $(srcSel + ' option:selected').text() : (isBank ? 'Bank account not selected' : 'Cash account not selected');
            var balance = parseFloat((isBank ? $('#lblBankBalance') : $('#lblCashBalance')).text()) || 0;
            body += '<tr><td>' + jrEsc(srcName) + ' <span class="mini">&middot; ' + (isBank ? 'bank' : 'cash') + ', added on posting</span></td>'
                + '<td class="num">&mdash;</td><td class="num">' + jrMoney(total) + '</td>'
                + '<td><span class="objstat ' + (srcOk ? 'pos' : 'neg') + '">' + jrIcon(srcOk) + (srcOk ? 'ok' : 'Select account') + '</span></td></tr>';
            body += '<tr class="tot-row"><td>Document total</td><td class="num">' + jrMoney(total) + '</td><td class="num">' + jrMoney(total) + '</td><td></td></tr>';
            $('#simBody').html(body);

            var checks = [
                { ok: missingGl === 0, t: 'Every line has a GL account', d: missingGl ? missingGl + ' line(s) without GL' : '' },
                { ok: zeroAmt === 0, t: 'Every line has an amount', d: zeroAmt ? zeroAmt + ' line(s) with amount 0' : '' },
                { ok: srcOk, t: (isBank ? 'Bank' : 'Cash') + ' account selected', d: '' },
                { ok: total > 0 && total <= balance, t: 'Within available balance', d: 'Total ' + jrMoney(total) + ' vs balance ' + jrMoney(balance) },
                { ok: (parseFloat($('#txtConversionRate').val()) || 0) > 0, t: "Today's conversion rate declared", d: '' },
                { ok: $.trim($('#txtNaration').val()) !== '', t: 'Narration entered', d: '' }
            ];
            var html = '';
            $.each(checks, function (i, c) {
                html += '<div style="display:flex;gap:8px;margin-top:8px"><span class="objstat ' + (c.ok ? 'pos' : 'neg') + '">' + jrIcon(c.ok) + '</span>'
                    + '<div><b style="font-size:13px"' + (c.ok ? '' : ' class="neg"') + '>' + jrEsc(c.t) + '</b>'
                    + (c.d ? '<div class="mini' + (c.ok ? '' : ' neg') + '">' + jrEsc(c.d) + '</div>' : '') + '</div></div>';
            });
            $('#simChecks').html(html);
        }

        function SimulateJournal() {
            RenderSimulation();
            $('#simSection').show()[0].scrollIntoView({ behavior: 'smooth', block: 'nearest' });
        }

        $(document).on('change', '[id^=COAId_]', function () {
            if ($('#simSection').is(':visible')) { RenderSimulation(); }
        });

        let MasterId = $('#masterId').val();
        $(document).ready(function () {
            LoadCompany('ddlCompany');

            if (MasterId > 0) {
                setInitialLoadState(true);
                LoadCurrencyEdit().then(function () {
                    return GetBankPaymentMaster(MasterId);
                }).fail(function () {
                    setInitialLoadState(false);
                    toastr.error("Failed to load payment master data.");
                });
                $("#Reject").html('<i class="fa fa-edit"></i> Update');
            } else {
                LoadCurrency();
                setInitialLoadState(false);
                // Change the button to "Submit" and set the icon to fa-check
                $("#Reject").html('<i class="fa fa-check"></i> Process Payment');
            }

            LoadAttachments();
            $('#txtPostingDate, #ddlCompany').on('change', CheckPeriod);
            setTimeout(CheckPeriod, 600); // after LoadCompany has selected the default company

        });

        function LoadCurrencyEdit() {
            return $.ajax({
                url: "/Utility/GetCurrency",
                contentType: "application/json; charset=utf-8",
                dataType: 'json',
                type: "Get",
                data: {},
                success: function (data) {

                    $('#ddlCurrency').empty();
                    $('#ddlCurrency').append("<option value='0'>--Select Currency--</option>");

                    for (var i = 0; i < data.length; i++) {

                        $('#ddlCurrency').append($("<option></option>").val(data[i].CurrencyId).html(data[i].CurrencyName));
                    }
                }
            });
        }
        function GetBankPaymentMaster(id) {

            var urlpath = '@Url.Action("GetBankPaymentMasterId", "BankPayments")';
            return $.ajax({
                url: urlpath,
                dataType: 'json',
                type: "Get",
                data: { id: id },
                success: function (data) {
                    $("#ddlCompany").val(data.CompanyInfoId).trigger('change.select2');

                    LoadDDlbyCom({ autoSelectFiscal: false }).done(function () {
                        $("#ddlCompany").prop("disabled", true);

                        $("#ddlFinansialYear").val(data.FinancialYearId).trigger('change.select2');
                        $("#ddlFinansialYear").prop("disabled", true);

                        LoadDaterangebyFiscal(data.FinancialYearId).done(function () {
                            $('#txtVoucherNo').val((data.VoucherNo));
                     /*       $("#txtVoucherNo").prop("disabled", true);*/


                            $('#txtPostingDate').val((data.PostingDateStr));
                            //$("#txtPostingDate").prop("disabled", true);
                            $("#ddlCurrency").val(data.CurrencyId).trigger('change.select2');
                            $("#ddlCurrency").prop("disabled", true);
                            $('#txtConversionRate').val(data.CurrencyCovRate);
                            $("#txtConversionRate").prop("disabled", true);


                            $("#ddlBankAccount").val(data.BankAccountId).trigger('change.select2');
                            //$("#ddlBankAccount").prop("disabled", true);

                            $('#txtChequeNo').val(data.ChequeNo);
                            $('#txtChequeDate').val(data.ChequeDateStr);
                            $('#txtNaration').val(data.Narration);





                            $("#ddlCashAccount").val(data.CashAccountId).trigger('change.select2');
                            //    $("#ddlCashAccount").prop("disabled", true);
                            //alert(data.RefNo);
                            $('#txtRefNo').val(data.RefNo);
                            $('#txtRefDate').val(data.RefDateStr);



                            var balanceRequest = $.Deferred().resolve().promise();
                            if (data.VoucherCategoryID == 1)
                            {
                                 $('#bankRadio').prop('checked', true);

                                $("#ddlCashAccount").prop("disabled", true);
                                $("#txtRefNo").prop("disabled", true);
                                $("#txtRefDate").prop("disabled", true);
                                $("#txtRefNo").val("");

                                balanceRequest = LoadBankIndoById(data.BankAccountId);
                            }
                            if (data.VoucherCategoryID == 2) {
                                $('#cashRadio').prop('checked', true);

                                $("#ddlBankAccount").prop("disabled", true);
                                $("#ddlBankAccount").val("0");

                             $("#lblBankBalance").val("0");
                                $("#txtChequeNo").val("");
                                $("#txtChequeDate").val("");
                                $("#txtChequeNo").prop("disabled", true);
                                $("#txtChequeDate").prop("disabled", true);
                               $("#lblBankName").val("");
